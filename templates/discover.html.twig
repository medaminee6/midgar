    <script>

        const detailRoutePatterns = {
            universe: '{{ path('universe_show', {'id': '__ID__'}) }}',
            personnage: '{{ path('personnage_show', {'id': '__ID__'}) }}',
            oeuvre: '{{ path('oeuvre_show', {'id': '__ID__'}) }}',
            artefact: '{{ path('artefact_show', {'id': '__ID__'}) }}'
        };

        const defaultPlaceholderImage = '{{ asset('uploads/dragon-poster.jpg') }}';

        const rankedPostsFromServer = {{ rankedPosts|default([])|json_encode|raw }};
        const mockContent = rankedPostsFromServer.map((item) => ({
            id: item.id,
            sourceType: String(item.type || '').toLowerCase(),
            type: item.type === 'universe' ? 'univers' : String(item.type || '').toLowerCase(),
            name: String(item.title || `${item.type} #${item.id}`),
            desc: `Tag: ${item.tag}`,
            tagText: String(item.tag || ''),
            genre: [String(item.tag || '').replace('#', '') || 'general'],
            themes: [String(item.tag || '').replace('#', '') || 'general'],
            date: Date.now(),
            likes: Math.round((item.score || 0) * 100),
            personnages: 0,
            oeuvres: 0,
            artefacts: 0,
            avatar: '🧙',
            creator: 'Recommandation',
            imagePath: String(item.imagePath || item.imageUrl || item.image_url || item.photo || '').trim()
        }));


        let filtered = [...mockContent];
        let displayedItems = 12;

        document.addEventListener('DOMContentLoaded', () => {
            renderFeed();
            attachListeners();
        });

        function getTypeLabel(type) {
            const normalizedType = String(type || '').toLowerCase();
            if (normalizedType === 'univers' || normalizedType === 'universe') return 'UNIVERSE';
            if (normalizedType === 'personnage') return 'PERSONNAGE';
            if (normalizedType === 'oeuvre') return 'ŒUVRE';
            if (normalizedType === 'artefact') return 'ARTEFACT';
            return 'UNIVERSE';
        }

        function getTypeBannerFallback(type) {
            const normalizedType = String(type || '').toLowerCase();
            if (normalizedType === 'personnage') return '🧍';
            if (normalizedType === 'oeuvre') return '📖';
            if (normalizedType === 'artefact') return '⚔️';
            return '🌌';
        }

        function getTypeSpecificStats(item) {
            const normalizedType = String(item.type || item.sourceType || '').toLowerCase();

            if (normalizedType === 'personnage') {
                return '<div class="stat">Univers: —</div>';
            }

            if (normalizedType === 'oeuvre') {
                return '<div class="stat">Type: Œuvre</div>';
            }

            if (normalizedType === 'artefact') {
                return `<div class="stat">Type ${item.tagText || '—'}</div>`;
            }

            return `<div class="stat">Personnages ${item.personnages || 0}</div><div class="stat">Œuvres ${item.oeuvres || 0}</div><div class="stat">Artefacts ${item.artefacts || 0}</div>`;
        }

        function buildCardMarkup(item, imageSrc, tagBadge) {
            const typeLabel = getTypeLabel(item.type || item.sourceType);
            const bannerFallback = getTypeBannerFallback(item.type || item.sourceType);
            const statsMarkup = getTypeSpecificStats(item);

            return `
                <button class="why-btn" data-type="${item.sourceType}" data-id="${item.id}">?</button>
                <div class="card-banner"><img src="${imageSrc}" alt="Post Image" onerror="this.onerror=null;this.outerHTML='${bannerFallback}';"></div>
                <div class="card-content">
                    <div class="card-type">${typeLabel}</div>
                    <h3 class="card-title">${item.name}</h3>
                    <div class="card-genre-tags">${tagBadge}</div>
                    <p class="card-description">${item.desc}</p>
                    <div class="card-footer">
                        <div class="card-stats">${statsMarkup}</div>
                        <div class="creator-info"><div class="creator-avatar">${item.avatar}</div><span>${item.creator}</span></div>
                    </div>
                </div>
            `;
        }

        function attachListeners(){
            document.querySelectorAll('.genre-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.theme-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.sort-filter').forEach(r => r.addEventListener('change', filterFeed));
            document.getElementById('searchInput').addEventListener('input', filterFeed);
            document.getElementById('resetFilters').addEventListener('click', () => {
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('sort-newest').checked = true;
                document.getElementById('searchInput').value = '';
                filtered = [...mockContent];
                displayedItems = 12;
                renderFeed();
            });
            document.getElementById('resetPrefsBtn')?.addEventListener('click', () => {
                if(confirm('Confirmer la réinitialisation des préférences ?')) {
                    document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                    document.getElementById('sort-newest').checked = true;
                    document.getElementById('searchInput').value = '';
                    filtered = [...mockContent];
                    displayedItems = 12;
                    renderFeed();
                    alert('Préférences réinitialisées.');
                }
            });
            document.getElementById('loadMoreBtn')?.addEventListener('click', () => { displayedItems += 12; renderFeed(); });
        }

        function filterFeed(){
            const genres = Array.from(document.querySelectorAll('.genre-filter:checked')).map(cb => cb.value);
            const themes = Array.from(document.querySelectorAll('.theme-filter:checked')).map(cb => cb.value);
            const search = document.getElementById('searchInput').value.toLowerCase();
            const sort = document.querySelector('.sort-filter:checked').value;

            filtered = mockContent.filter(item => {
                if(genres.length > 0 && !genres.some(g => item.genre.includes(g))) return false;
                if(themes.length > 0 && !themes.some(t => item.themes.includes(t))) return false;
                if(search && !item.name.toLowerCase().includes(search)) return false;
                return true;
            });

            if(sort === 'newest') filtered.sort((a,b) => b.date - a.date);
            else if(sort === 'popular') filtered.sort((a,b) => (b.likes || b.personnages) - (a.likes || a.personnages));
            else filtered.sort((a,b) => (b.likes || 0) - (a.likes || 0));

            displayedItems = 12;
            renderFeed();
        }

        function renderFeed(){
            const grid = document.getElementById('feedGrid');
            const empty = document.getElementById('emptyState');
            const more = document.getElementById('loadMoreContainer');

            grid.innerHTML = '';
            if(filtered.length === 0) { empty.style.display = 'block'; more.style.display = 'none'; }
            else {
                empty.style.display = 'none';
                filtered.slice(0, displayedItems).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'universe-card';
                    const imageSrc = item.imagePath !== '' ? item.imagePath : defaultPlaceholderImage;
                    const tagBadge = item.tagText ? `<span class="genre-tag">${item.tagText}</span>` : '';
                    card.innerHTML = buildCardMarkup(item, imageSrc, tagBadge);

                    const whyBtn = card.querySelector('.why-btn');
                    whyBtn?.addEventListener('click', (event) => {
                        event.stopPropagation();

                        const type = whyBtn.dataset.type;
                        const id = whyBtn.dataset.id;
                        if (!type || !id) {
                            return;
                        }

                        window.location.href = `/why/${encodeURIComponent(type)}/${encodeURIComponent(id)}`;
                    });

                    card.addEventListener('click', () => {
                        const normalizedType = (item.sourceType || item.type || '').toLowerCase() === 'univers'
                            ? 'universe'
                            : (item.sourceType || item.type || '').toLowerCase();

                        const pattern = detailRoutePatterns[normalizedType];
                        if (!pattern) {
                            return;
                        }

                        window.location.href = pattern.replace('__ID__', String(item.id));
                    });
                    grid.appendChild(card);
                });
                more.style.display = filtered.length > displayedItems ? 'flex' : 'none';
            }
            document.getElementById('displayedCount').textContent = Math.min(displayedItems, filtered.length);
            document.getElementById('totalCount').textContent = filtered.length;
        }
    </script>

