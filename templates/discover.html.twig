                    </div>
                    <span>{{ app.user.username }}</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
