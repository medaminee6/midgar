<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Découvrir - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .discover-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 6px;
            border: 1px solid #2A3139;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #2A3139;
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: #18E3A4;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: #18E3A4;
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: #E6FFF6;
            font-size: 0.9rem;
            margin: 0;
            {% include '_navbar.html.twig' %}
            padding: 10px;
            background-color: #2A3139;
            color: #18E3A4;
            border: 1px solid #18E3A4;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .filter-reset:hover {
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .content-type-toggles {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid #2A3139;
            background-color: transparent;
            color: #B0B9B6;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .toggle-btn.active {
            border-color: #18E3A4;
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .toggle-btn:hover { border-color: #18E3A4; color: #18E3A4; }

        .feed-section { flex: 1; }

        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #2A3139;
        }

        .results-count { color: #B0B9B6; font-size: 0.9rem; }

        /* Preferences action buttons (small, non-intrusive, Midgar style) */
        .feed-actions { display: flex; align-items: center; gap: 1rem; }
        .pref-actions { display: flex; gap: 0.5rem; align-items: center; animation: slideFadeIn 420ms cubic-bezier(.2,.9,.3,1) both; }

        .btn-pref {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, #18E3A4 0%, #0DCF92 100%);
            color: #0B0F0E;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            box-shadow: 0 6px 18px rgba(11,15,14,0.06);
            transition: transform 180ms ease, box-shadow 180ms ease;
        }

        .btn-pref:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16,200,150,0.12); }

        .btn-pref-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 12px;
            border-radius: 999px;
            background: transparent;
            color: #FF6B6B;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255,107,107,0.12);
            transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        }

        .btn-pref-outline:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(255,107,107,0.08); border-color: rgba(255,107,107,0.28); }

        @keyframes slideFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

        @media (max-width: 640px) {
            .feed-actions { gap: 0.5rem; }
            .pref-actions { flex-wrap: wrap; }
        }

        .feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card, .feed-card {
            background-color: #1A1F1E;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #2A3139;
            transition: all 0.3s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }

        .universe-card:hover, .feed-card:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.15);
            transform: translateY(-2px);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-type {
            display: inline-block;
            font-size: 0.75rem;
            color: #18E3A4;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #E6FFF6;
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: #0B0F0E;
            border: 1px solid #18E3A4;
            color: #18E3A4;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .card-description {
            font-size: 0.85rem;
            color: #B0B9B6;
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: #B0B9B6;
            padding-top: 1rem;
            border-top: 1px solid #2A3139;
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .load-more { display: flex; justify-content: center; margin-top: 2rem; }

        .load-more-btn {
            padding: 12px 40px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .load-more-btn:hover { background-color: #0DCF92; }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #B0B9B6;
        }

        .empty-state p { font-size: 1.1rem; margin-bottom: 1rem; }

        @media (max-width: 1024px) {
            .discover-container { grid-template-columns: 1fr; }
            .filter-sidebar { position: static; }
        }

        @media (max-width: 768px) {
            .feed-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/oeuvre">Œuvre</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
        
    </header>

    <main>
        <section class="section">
            <div class="container">
                <h1 style="margin-bottom: 0.5rem;">Découvrir</h1>
                <p style="color: #B0B9B6; margin-bottom: 2rem;">Explorez univers, personnages, œuvres et artefacts créés par notre communauté</p>

                <div class="content-type-toggles" id="contentTypeToggles">
                    <button class="toggle-btn active" data-type="all">🌍 Tous</button>
                    <button class="toggle-btn active" data-type="univers">🌌 Univers</button>
                    <button class="toggle-btn" data-type="personnage">👤 Personnages</button>
                    <button class="toggle-btn" data-type="oeuvre">📖 Œuvres</button>
                    <button class="toggle-btn" data-type="artefact">⚔️ Artefacts</button>
                </div>

                <div class="discover-container">
                    <div class="filter-sidebar">
                        <div class="filter-group">
                            <input type="text" class="search-box" id="searchInput" placeholder="Chercher...">
                        </div>

                        <div class="filter-group">
                            <h4>Genre</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-high-fantasy" value="high-fantasy" class="genre-filter">
                                <label for="genre-high-fantasy">Haute Fantaisie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-dark-fantasy" value="dark-fantasy" class="genre-filter">
                                <label for="genre-dark-fantasy">Sombre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-scifi-fantasy" value="scifi-fantasy" class="genre-filter">
                                <label for="genre-scifi-fantasy">Sci-Fi</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-urban-fantasy" value="urban-fantasy" class="genre-filter">
                                <label for="genre-urban-fantasy">Urban</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Thèmes</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-magie" value="magie" class="theme-filter">
                                <label for="theme-magie">Magie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-guerre" value="guerre" class="theme-filter">
                                <label for="theme-guerre">Guerre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-politique" value="politique" class="theme-filter">
                                <label for="theme-politique">Politique</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-nature" value="nature" class="theme-filter">
                                <label for="theme-nature">Nature</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-mystere" value="mystere" class="theme-filter">
                                <label for="theme-mystere">Mystère</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-aventure" value="aventure" class="theme-filter">
                                <label for="theme-aventure">Aventure</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Tri</h4>
                            <div class="filter-option">
                                <input type="radio" id="sort-newest" name="sort" value="newest" class="sort-filter" checked>
                                <label for="sort-newest">Récent</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-popular" name="sort" value="popular" class="sort-filter">
                                <label for="sort-popular">Populaire</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-trending" name="sort" value="trending" class="sort-filter">
                                <label for="sort-trending">Tendance</label>
                            </div>
                        </div>

                        <button class="filter-reset" id="resetFilters">Réinitialiser</button>
                    </div>

                    <div class="feed-section">
                        <div class="feed-header">
                            <h2 style="margin: 0; color: #E6FFF6;">Flux</h2>
                            <div class="feed-actions">
                                <div class="pref-actions" role="group" aria-label="Préférences">
                                    <a href="/preferences/advanced" class="btn-pref">✨ Éditer mes préférences</a>
                                    <button id="resetPrefsBtn" type="button" class="btn-pref-outline">🗑️ Réinitialiser</button>
                                </div>
                                <div class="results-count">
                                    <span id="displayedCount">0</span> / <span id="totalCount">0</span>
                                </div>
                            </div>
                        </div>

                        <div class="feed-grid" id="feedGrid"></div>

                        <div class="load-more" id="loadMoreContainer" style="display: none;">
                            <button class="load-more-btn" id="loadMoreBtn">Charger Plus</button>
                        </div>

                        <div class="empty-state" id="emptyState" style="display: none;">
                            <p>😔 Aucun résultat</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions</a></li>
                        <li><a href="#">Confidentialité</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script>
        const mockContent = [
            {id:1,name:"Nuit Éternelle",type:"univers",genre:["dark-fantasy"],themes:["mystere","magie"],desc:"Monde plongé dans une nuit perpétuelle",banner:"🌙",creator:"Léa M.",avatar:"L",personnages:12,oeuvres:28,artefacts:7,likes:1240,date:new Date(2026,0,20)},
            {id:2,name:"Châteaux Flottants",type:"univers",genre:["high-fantasy"],themes:["aventure","magie"],desc:"Forteresses majestueuses flottent dans les nuages",banner:"☁️",creator:"Léa M.",avatar:"L",personnages:18,oeuvres:45,artefacts:12,likes:892,date:new Date(2026,0,18)},
            {id:3,name:"Dragons de Lumière",type:"univers",genre:["high-fantasy"],themes:["aventure","nature"],desc:"Univers dominé par les dragons",banner:"🐲",creator:"Alexis S.",avatar:"A",personnages:14,oeuvres:32,artefacts:9,likes:654,date:new Date(2026,0,15)},
            {id:4,name:"Techno-Mystique",type:"univers",genre:["scifi-fantasy"],themes:["magie","guerre"],desc:"Technologie avancée rencontre magie ancienne",banner:"⚡",creator:"Marcus T.",avatar:"M",personnages:22,oeuvres:51,artefacts:15,likes:1120,date:new Date(2026,0,25)},
            {id:5,name:"Forêt Éternelle",type:"univers",genre:["high-fantasy"],themes:["nature","magie"],desc:"Forêt ancienne où les arbres parlent",banner:"🌲",creator:"Elena R.",avatar:"E",personnages:16,oeuvres:37,artefacts:8,likes:756,date:new Date(2026,0,22)},
            {id:6,name:"Royaumes Souterrains",type:"univers",genre:["dark-fantasy","high-fantasy"],themes:["guerre","politique"],desc:"Empires dwarves et gnomes sous les montagnes",banner:"⛏️",creator:"Thor N.",avatar:"T",personnages:20,oeuvres:48,artefacts:14,likes:892,date:new Date(2026,0,19)},
            {id:7,name:"Cités Flottantes",type:"univers",genre:["scifi-fantasy"],themes:["aventure","politique"],desc:"Villes futuristes flottant au-dessus d'un monde post-apocalyptique",banner:"🏙️",creator:"Luna K.",avatar:"L",personnages:19,oeuvres:42,artefacts:11,likes:978,date:new Date(2026,0,17)},
            {id:8,name:"Océan Enchanté",type:"univers",genre:["high-fantasy","urban-fantasy"],themes:["magie","mystere"],desc:"Royaumes sous-marins remplis de créatures magiques",banner:"🌊",creator:"Nerida M.",avatar:"N",personnages:13,oeuvres:29,artefacts:10,likes:645,date:new Date(2026,0,16)},
            {id:9,name:"Domaine des Ombres",type:"univers",genre:["dark-fantasy"],themes:["guerre","mystere"],desc:"Où les ombres ont pris vie",banner:"🌑",creator:"Victor D.",avatar:"V",personnages:17,oeuvres:40,artefacts:13,likes:834,date:new Date(2026,0,14)},
            {id:10,name:"Empire Cristallin",type:"univers",genre:["high-fantasy"],themes:["magie","aventure"],desc:"Empire construit entièrement de cristaux magiques",banner:"💎",creator:"Sylvia P.",avatar:"S",personnages:15,oeuvres:35,artefacts:9,likes:723,date:new Date(2026,0,21)},
            {id:11,name:"Steppes Sauvages",type:"univers",genre:["high-fantasy"],themes:["nature","aventure"],desc:"Prairies infinies peuplées de tribus guerrières",banner:"🏜️",creator:"Khan B.",avatar:"K",personnages:21,oeuvres:44,artefacts:8,likes:567,date:new Date(2026,0,13)},
            {id:12,name:"Métropole Gothique",type:"univers",genre:["urban-fantasy"],themes:["mystere","politique"],desc:"Grande ville moderne cachant secrets magiques",banner:"🏛️",creator:"Isabelle V.",avatar:"I",personnages:18,oeuvres:39,artefacts:7,likes:891,date:new Date(2026,0,12)}
        ];

        let filtered = [...mockContent];
        let displayedItems = 12;

        document.addEventListener('DOMContentLoaded', () => {
            renderFeed();
            attachListeners();
        });

        function attachListeners(){
            document.querySelectorAll('.toggle-btn').forEach(btn => btn.addEventListener('click', () => { btn.classList.toggle('active'); filterFeed(); }));
            document.querySelectorAll('.genre-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.theme-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.sort-filter').forEach(r => r.addEventListener('change', filterFeed));
            document.getElementById('searchInput').addEventListener('input', filterFeed);
            document.getElementById('resetFilters').addEventListener('click', () => {
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('sort-newest').checked = true;
                document.getElementById('searchInput').value = '';
                document.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.type === 'univers'));
                filtered = [...mockContent];
                displayedItems = 12;
                renderFeed();
            });
            // Preferences reset (UI-only placeholder)
            document.getElementById('resetPrefsBtn')?.addEventListener('click', () => {
                if(!confirm('Confirmer la réinitialisation des préférences ?')) return;
                // Reset the same UI controls used by filters as a demo
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('sort-newest').checked = true;
                document.getElementById('searchInput').value = '';
                document.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.type === 'univers'));
                filtered = [...mockContent];
                displayedItems = 12;
                renderFeed();
                alert('Préférences réinitialisées (démo).');
            });
            document.getElementById('loadMoreBtn')?.addEventListener('click', () => { displayedItems += 12; renderFeed(); });
        }

        function filterFeed(){
            const types = Array.from(document.querySelectorAll('.toggle-btn.active')).map(btn => btn.dataset.type);
            const genres = Array.from(document.querySelectorAll('.genre-filter:checked')).map(cb => cb.value);
            const themes = Array.from(document.querySelectorAll('.theme-filter:checked')).map(cb => cb.value);
            const search = document.getElementById('searchInput').value.toLowerCase();
            const sort = document.querySelector('.sort-filter:checked').value;

            filtered = mockContent.filter(item => {
                if(types.length > 0 && !types.includes('all') && !types.includes(item.type)) return false;
                if(genres.length > 0 && !genres.some(g => item.genre.includes(g))) return false;
                if(themes.length > 0 && !themes.some(t => item.themes.includes(t))) return false;
                if(search && !item.name.toLowerCase().includes(search)) return false;
                return true;
            });

            if(sort === 'newest') filtered.sort((a,b) => b.date - a.date);
            else if(sort === 'popular') filtered.sort((a,b) => (b.likes || b.personnages) - (a.likes || a.personnages));
            else filtered.sort((a,b) => (b.likes || 0) - (a.likes || 0));

            displayedItems = 12;
            renderFeed();
        }

        function renderFeed(){
            const grid = document.getElementById('feedGrid');
            const empty = document.getElementById('emptyState');
            const more = document.getElementById('loadMoreContainer');

            grid.innerHTML = '';
            if(filtered.length === 0) { empty.style.display = 'block'; more.style.display = 'none'; }
            else {
                empty.style.display = 'none';
                filtered.slice(0, displayedItems).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'universe-card';
                    const genreMap = {'high-fantasy':'Haute Fantaisie','dark-fantasy':'Sombre','scifi-fantasy':'Sci-Fi','urban-fantasy':'Urban'};
                    const genreTags = item.genre.map(g => `<span class="genre-tag">${genreMap[g] || g}</span>`).join('');
                    card.innerHTML = `
                        <div class="card-banner">${item.banner}</div>
                        <div class="card-content">
                            <div class="card-type">Universe</div>
                            <h3 class="card-title">${item.name}</h3>
                            <div class="card-genre-tags">${genreTags}</div>
                            <p class="card-description">${item.desc}</p>
                            <div class="card-footer">
                                <div class="card-stats"><div class="stat">Characters ${item.personnages}</div><div class="stat">Works ${item.oeuvres}</div><div class="stat">Artifacts ${item.artefacts}</div></div>
                                <div class="creator-info"><div class="creator-avatar">${item.avatar}</div><span>${item.creator}</span></div>
                            </div>
                        </div>
                    `;
                    card.addEventListener('click', () => window.location.href = `/universe-detail?id=${item.id}`);
                    grid.appendChild(card);
                });
                more.style.display = filtered.length > displayedItems ? 'flex' : 'none';
            }
            document.getElementById('displayedCount').textContent = Math.min(displayedItems, filtered.length);
            document.getElementById('totalCount').textContent = filtered.length;
        }
    </script>
</body>
</html>
