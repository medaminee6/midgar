<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Découvrir - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES DISCOVER ===== */
        .discover-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.1);
            height: fit-content;
            position: sticky;
            top: 100px;
            backdrop-filter: blur(5px);
        }

        .filter-sidebar:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: var(--primary-color);
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: var(--primary-color);
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: var(--text-color);
            font-size: 0.9rem;
            margin: 0;
            flex: 1;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .search-box::placeholder { 
            color: var(--text-secondary); 
        }
        
        .search-box:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }

        .filter-reset {
            width: 100%;
            padding: 10px;
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            display: block;
            text-align: center;
            text-decoration: none;
            margin-top: 1rem;
        }

        .filter-reset:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.02);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        /* Toggle buttons */
        .content-type-toggles {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            background-color: transparent;
            color: var(--text-secondary);
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .toggle-btn.active {
            border-color: var(--primary-color);
            background-color: var(--primary-color);
            color: #000;
        }

        .toggle-btn:hover { 
            border-color: var(--primary-color); 
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* Preferences action buttons */
        .feed-actions { display: flex; align-items: center; gap: 1rem; }
        .pref-actions { display: flex; gap: 0.5rem; align-items: center; }
        
        .btn-pref {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--primary-color) 0%, #0DCF92 100%);
            color: #0B0F0E;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .btn-pref:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(24, 227, 164, 0.3);
        }
        
        .btn-pref-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 12px;
            border-radius: 999px;
            background: transparent;
            color: #FF6B6B;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255, 107, 107, 0.3);
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .btn-pref-outline:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 107, 107, 0.6);
            background: rgba(255, 107, 107, 0.1);
        }
        
        .results-count { color: var(--text-secondary); font-size: 0.9rem; }
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.02);
            box-shadow: 0 0 15px var(--primary-color);
        }

        .content-type-toggles {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            background-color: transparent;
            color: var(--text-secondary);
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .toggle-btn.active {
            border-color: var(--primary-color);
            background-color: var(--primary-color);
            color: #000;
        }

        .toggle-btn:hover { 
            border-color: var(--primary-color); 
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }

        .feed-section { flex: 1; }

        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }

        .results-count { color: var(--text-secondary); font-size: 0.9rem; }

        /* Preferences action buttons (small, non-intrusive, Midgar style) */
        .feed-actions { display: flex; align-items: center; gap: 1rem; }
        .pref-actions { display: flex; gap: 0.5rem; align-items: center; animation: slideFadeIn 420ms cubic-bezier(.2,.9,.3,1) both; }

        .btn-pref {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, #18E3A4 0%, #0DCF92 100%);
            color: #0B0F0E;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            box-shadow: 0 6px 18px rgba(11,15,14,0.06);
            transition: transform 180ms ease, box-shadow 180ms ease;
        }

        .btn-pref:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16,200,150,0.12); }

        .btn-pref-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 12px;
            border-radius: 999px;
            background: transparent;
            color: #FF6B6B;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255,107,107,0.12);
            transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        }





        .feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card, .feed-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(5px);
        }

        .universe-card:hover, .feed-card:hover {
            border-color: rgba(24, 227, 164, 0.2);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(24, 227, 164, 0.3);
            transform: translateY(-10px) scale(1.02);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-type {
            display: inline-block;
            font-size: 0.75rem;
            color: var(--primary-color);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: rgba(24, 227, 164, 0.1);
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            transition: transform 0.2s;
        }
        
        .genre-tag:hover {
            transform: scale(1.05);
        }

        .card-description {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
            padding-top: 1rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .load-more { display: flex; justify-content: center; margin-top: 2rem; }

        .load-more-btn {
            padding: 12px 40px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .load-more-btn:hover { background-color: #0DCF92; }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .empty-state p { font-size: 1.1rem; margin-bottom: 1rem; }
        
        .footer-links {
            list-style: none;
        }
        
        .footer-links li {
            margin-bottom: 0.5rem;
        }
        
        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: var(--primary-color);
        }

        @media (max-width: 1024px) {
            .discover-container { 
                grid-template-columns: 1fr; 
            }
            .filter-sidebar { 
                position: static; 
            }
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .feed-grid { 
                grid-template-columns: 1fr; 
            }
            
            .discover-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                <li><a href="/discover" class="magic-btn active">Découvrir</a></li>
                <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                <li><a href="/shop" class="magic-btn">Boutique</a></li>
                <li><a href="/challenges" class="magic-btn">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            {% if app.user %}
                <a href="{{ path('profile') }}" class="profile-link magic-btn">
                    <div class="avatar">
                        {% if app.user.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                        {% else %}
                            <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                        {% endif %}
                    </div>
                    <span>{{ app.user.username }}</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
            {% endif %}
        </div>
    </header>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <div>
                        <h1 style="margin-bottom: 0.5rem; color: var(--primary-color);">Découvrir</h1>
                        <p style="color: var(--text-secondary); margin: 0;">Explorez univers, personnages, œuvres et artefacts créés par notre communauté</p>
                    </div>
                </div>

                <div class="content-type-toggles" id="contentTypeToggles">
                    <button class="toggle-btn active" data-type="all">🌍 Tous</button>
                    <button class="toggle-btn active" data-type="univers">🌌 Univers</button>
                    <button class="toggle-btn" data-type="personnage">👤 Personnages</button>
                    <button class="toggle-btn" data-type="oeuvre">📖 Œuvres</button>
                    <button class="toggle-btn" data-type="artefact">⚔️ Artefacts</button>
                </div>

                <div class="discover-container">
                    <div class="filter-sidebar">
                        <div class="filter-group">
                            <input type="text" class="search-box" id="searchInput" placeholder="Chercher...">
                        </div>

                        <div class="filter-group">
                            <h4>Genre</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-high-fantasy" value="high-fantasy" class="genre-filter">
                                <label for="genre-high-fantasy">Haute Fantaisie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-dark-fantasy" value="dark-fantasy" class="genre-filter">
                                <label for="genre-dark-fantasy">Sombre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-scifi-fantasy" value="scifi-fantasy" class="genre-filter">
                                <label for="genre-scifi-fantasy">Sci-Fi</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-urban-fantasy" value="urban-fantasy" class="genre-filter">
                                <label for="genre-urban-fantasy">Urban</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Thèmes</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-magie" value="magie" class="theme-filter">
                                <label for="theme-magie">Magie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-guerre" value="guerre" class="theme-filter">
                                <label for="theme-guerre">Guerre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-politique" value="politique" class="theme-filter">
                                <label for="theme-politique">Politique</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-nature" value="nature" class="theme-filter">
                                <label for="theme-nature">Nature</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-mystere" value="mystere" class="theme-filter">
                                <label for="theme-mystere">Mystère</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-aventure" value="aventure" class="theme-filter">
                                <label for="theme-aventure">Aventure</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Tri</h4>
                            <div class="filter-option">
                                <input type="radio" id="sort-newest" name="sort" value="newest" class="sort-filter" checked>
                                <label for="sort-newest">Récent</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-popular" name="sort" value="popular" class="sort-filter">
                                <label for="sort-popular">Populaire</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-trending" name="sort" value="trending" class="sort-filter">
                                <label for="sort-trending">Tendance</label>
                            </div>
                        </div>

                        <button class="filter-reset" id="resetFilters">Réinitialiser</button>
                    </div>

                    <div class="feed-section">
                        <div class="feed-header">
                            <h2 style="margin: 0; color: var(--primary-color);">Flux</h2>
                            <div class="feed-actions">
                                <div class="pref-actions" role="group" aria-label="Préférences">
                                    <a href="/preferences/advanced" class="btn-pref">✨ Éditer mes préférences</a>
                                    <button id="resetPrefsBtn" type="button" class="btn-pref-outline">🗑️ Réinitialiser</button>
                                </div>
                                <div class="results-count">
                                    <span id="displayedCount">0</span> / <span id="totalCount">0</span>
                                </div>
                            </div>
                        </div>

                        {# DIRECTLY RENDER CONTENT WITHOUT JS #}
                        {% set hasContent = (universes|length > 0) or (personnages|length > 0) or (oeuvres|length > 0) or (artefacts|length > 0) %}
                        {% if hasContent %}
                        <div class="feed-grid">
                            {# Render Universes #}
                            {% for item in universes %}
                            <div class="universe-card" onclick="window.location.href='/universe-detail?id={{ item.id }}'">
                                <div class="card-banner" style="display:flex;align-items:center;justify-content:center;font-size:2rem;">🌌</div>
                                <div class="card-content">
                                    <div class="card-type">Univers</div>
                                    <h3 class="card-title">{{ item.name }}</h3>
                                    <div class="card-genre-tags">
                                        <span class="genre-tag">{{ item.genre }}</span>
                                    </div>
                                    <p class="card-description">{{ item.shortDescription|slice(0, 150) }}...</p>
                                </div>
                            </div>
                            {% endfor %}
                            
                            {# Render Personnages #}
                            {% for item in personnages %}
                            <div class="universe-card" onclick="window.location.href='/personnage-detail?id={{ item.id }}'">
                                <div class="card-banner" style="display:flex;align-items:center;justify-content:center;font-size:2rem;">👤</div>
                                <div class="card-content">
                                    <div class="card-type">Personnage</div>
                                    <h3 class="card-title">{{ item.name }}</h3>
                                    <div class="card-genre-tags">
                                        <span class="genre-tag">{{ item.classRole }}</span>
                                    </div>
                                    <p class="card-description">{{ item.historyContext|slice(0, 150) }}...</p>
                                </div>
                            </div>
                            {% endfor %}

                            {# Render Artefacts #}
                            {% for item in artefacts %}
                            <div class="universe-card" onclick="window.location.href='/artefact/{{ item.id }}'">
                                <div class="card-banner" style="display:flex;align-items:center;justify-content:center;font-size:2rem;">⚔️</div>
                                <div class="card-content">
                                    <div class="card-type">Artefact</div>
                                    <h3 class="card-title">{{ item.name }}</h3>
                                    <div class="card-genre-tags">
                                        <span class="genre-tag">{{ item.origin }}</span>
                                    </div>
                                    <p class="card-description">{{ item.description|slice(0, 150) }}...</p>
                                </div>
                            </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="empty-state" style="display: block;">
                            <p>😔 Aucun résultat pour vos préférences</p>
                        </div>
                        {% endif %}

                        <div class="feed-grid" id="feedGrid"></div>

                        <div class="load-more" id="loadMoreContainer" style="display: none;">
                            <button class="load-more-btn" id="loadMoreBtn">Charger Plus</button>
                        </div>

                        <div class="empty-state" id="emptyState" style="display: none;">
                            <p>😔 Aucun résultat</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script>
        // DEBUG: Check if Twig variables are set
        console.log('=== TEMPLATE DEBUG ===');
        
        // Convert Symfony data to mockContent format
        const realContent = {
            oeuvres: {{ oeuvres|json_encode|default('[]') }},
            artefacts: {{ artefacts|json_encode|default('[]') }},
            personnages: {{ personnages|json_encode|default('[]') }},
            universes: {{ universes|json_encode|default('[]') }}
        };

        // Build mockContent array from real data
        let mockContent = [];
        
        // DEBUG: Log real content
        console.log('Real Content:', realContent);
        console.log('Universes:', realContent.universes);
        console.log('Personnages:', realContent.personnages);
        console.log('Oeuvres:', realContent.oeuvres);
        console.log('Artefacts:', realContent.artefacts);
        
        // Force show alert even if no content
        if (mockContent.length === 0) {
            alert('ATTENTION: No items loaded!\n\nReal Content keys: ' + Object.keys(realContent).join(', '));
        }
        
        // Add universes
        if (Array.isArray(realContent.universes)) {
            realContent.universes.forEach(item => {
                mockContent.push({
                    id: item.id,
                    type: 'univers',
                    title: item.name,
                    description: item.shortDescription,
                    genre: item.genre,
                    tags: item.tags || '',
                    image: item.bannerImage ? 'data:image/jpeg;base64,' + item.bannerImage : null
                });
            });
        }

        // Add personnages
        if (Array.isArray(realContent.personnages)) {
            realContent.personnages.forEach(item => {
                mockContent.push({
                    id: item.id,
                    type: 'personnage',
                    title: item.name,
                    description: item.historyContext,
                    genre: item.classRole,
                    tags: item.tags || '',
                    image: item.portraitImage ? 'data:image/jpeg;base64,' + item.portraitImage : null
                });
            });
        }

        // Add oeuvres
        if (Array.isArray(realContent.oeuvres)) {
            realContent.oeuvres.forEach(item => {
                mockContent.push({
                    id: item.id,
                    type: 'oeuvre',
                    title: item.title,
                    description: item.description,
                    genre: item.genre,
                    tags: item.tags || '',
                    image: null
                });
            });
        }

        // Add artefacts
        if (Array.isArray(realContent.artefacts)) {
            realContent.artefacts.forEach(item => {
                mockContent.push({
                    id: item.id,
                    type: 'artefact',
                    title: item.name,
                    description: item.description,
                    genre: item.origin,
                    tags: item.tags || '',
                    image: null
                });
            });
        }

        let filtered = [...mockContent];
        let displayedItems = 12;

        document.addEventListener('DOMContentLoaded', () => {
            renderFeed();
            attachListeners();
            // DEBUG: Show data info
            setTimeout(() => {
                alert('DEBUG: ' + mockContent.length + ' items loaded.\nCheck console for details.');
            }, 500);
        });

        function attachListeners(){
            document.querySelectorAll('.toggle-btn').forEach(btn => btn.addEventListener('click', () => { btn.classList.toggle('active'); filterFeed(); }));
            document.querySelectorAll('.genre-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.theme-filter').forEach(cb => cb.addEventListener('change', filterFeed));
            document.querySelectorAll('.sort-filter').forEach(r => r.addEventListener('change', filterFeed));
            document.getElementById('searchInput').addEventListener('input', filterFeed);
            document.getElementById('resetFilters').addEventListener('click', () => {
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('sort-newest').checked = true;
                document.getElementById('searchInput').value = '';
                document.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.type === 'univers'));
                filtered = [...mockContent];
                displayedItems = 12;
                renderFeed();
            });
            document.getElementById('resetPrefsBtn')?.addEventListener('click', () => {
                if(confirm('Confirmer la réinitialisation des préférences ?')) {
                    document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                    document.getElementById('sort-newest').checked = true;
                    document.getElementById('searchInput').value = '';
                    document.querySelectorAll('.toggle-btn').forEach(btn => btn.classList.toggle('active', btn.dataset.type === 'univers'));
                    filtered = [...mockContent];
                    displayedItems = 12;
                    renderFeed();
                    alert('Préférences réinitialisées.');
                }
            });
            document.getElementById('loadMoreBtn')?.addEventListener('click', () => { displayedItems += 12; renderFeed(); });
        }

        function filterFeed(){
            const types = Array.from(document.querySelectorAll('.toggle-btn.active')).map(btn => btn.dataset.type);
            const genres = Array.from(document.querySelectorAll('.genre-filter:checked')).map(cb => cb.value);
            const themes = Array.from(document.querySelectorAll('.theme-filter:checked')).map(cb => cb.value);
            const search = document.getElementById('searchInput').value.toLowerCase();
            const sort = document.querySelector('.sort-filter:checked').value;

            filtered = mockContent.filter(item => {
                // Handle type filter
                if(types.length > 0 && !types.includes('all') && !types.includes(item.type)) return false;
                
                // Handle genre filter - genre can be string or array
                if(genres.length > 0) {
                    const itemGenre = item.genre;
                    if (typeof itemGenre === 'string') {
                        if (!genres.some(g => itemGenre.includes(g))) return false;
                    } else if (Array.isArray(itemGenre)) {
                        if (!genres.some(g => itemGenre.includes(g))) return false;
                    }
                }
                
                // Handle theme filter
                if(themes.length > 0 && item.themes) {
                    if (!themes.some(t => item.themes.includes(t))) return false;
                }
                
                // Handle search - check both title and name
                if(search) {
                    const searchTarget = (item.title || item.name || '').toLowerCase();
                    if (!searchTarget.includes(search)) return false;
                }
                
                return true;
            });

            if(sort === 'newest') filtered.sort((a,b) => b.date - a.date);
            else if(sort === 'popular') filtered.sort((a,b) => (b.likes || b.personnages) - (a.likes || a.personnages));
            else filtered.sort((a,b) => (b.likes || 0) - (a.likes || 0));

            displayedItems = 12;
            renderFeed();
        }

        function renderFeed(){
            const grid = document.getElementById('feedGrid');
            const empty = document.getElementById('emptyState');
            const more = document.getElementById('loadMoreContainer');

            grid.innerHTML = '';
            if(filtered.length === 0) { empty.style.display = 'block'; more.style.display = 'none'; }
            else {
                empty.style.display = 'none';
                filtered.slice(0, displayedItems).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'universe-card';
                    
                    // Map type to French label
                    const typeLabels = {
                        'univers': 'Univers',
                        'personnage': 'Personnage',
                        'oeuvre': 'Œuvre',
                        'artefact': 'Artefact'
                    };
                    const typeLabel = typeLabels[item.type] || item.type;
                    
                    // Handle genre (string or array)
                    let genreTags = '';
                    if (item.genre) {
                        if (typeof item.genre === 'string') {
                            genreTags = `<span class="genre-tag">${item.genre}</span>`;
                        } else if (Array.isArray(item.genre)) {
                            const genreMap = {'high-fantasy':'Haute Fantaisie','dark-fantasy':'Sombre','scifi-fantasy':'Sci-Fi','urban-fantasy':'Urban'};
                            genreTags = item.genre.map(g => `<span class="genre-tag">${genreMap[g] || g}</span>`).join('');
                        }
                    }
                    
                    // Use title or name, description or shortDescription
                    const cardTitle = item.title || item.name || '';
                    const cardDesc = item.description || item.shortDescription || item.desc || '';
                    const cardBanner = item.image || item.banner || '';
                    
                    // Build card HTML based on type
                    let cardHtml = '';
                    if (cardBanner) {
                        cardHtml = `<div class="card-banner">${cardBanner}</div>`;
                    } else {
                        cardHtml = `<div class="card-banner" style="display:flex;align-items:center;justify-content:center;font-size:2rem;">${item.type === 'univers' ? '🌌' : item.type === 'personnage' ? '👤' : item.type === 'oeuvre' ? '📖' : '⚔️'}</div>`;
                    }
                    
                    card.innerHTML = `
                        ${cardHtml}
                        <div class="card-content">
                            <div class="card-type">${typeLabel}</div>
                            <h3 class="card-title">${cardTitle}</h3>
                            <div class="card-genre-tags">${genreTags}</div>
                            <p class="card-description">${cardDesc.substring(0, 150)}${cardDesc.length > 150 ? '...' : ''}</p>
                        </div>
                    `;
                    
                    // Add click handler based on type
                    let url = '#';
                    if (item.type === 'univers') url = `/universe-detail?id=${item.id}`;
                    else if (item.type === 'personnage') url = `/personnage-detail?id=${item.id}`;
                    else if (item.type === 'oeuvre') url = `/oeuvre/${item.id}`;
                    else if (item.type === 'artefact') url = `/artefact/${item.id}`;
                    
                    card.addEventListener('click', () => window.location.href = url);
                    grid.appendChild(card);
                });
                more.style.display = filtered.length > displayedItems ? 'flex' : 'none';
            }
            document.getElementById('displayedCount').textContent = Math.min(displayedItems, filtered.length);
            document.getElementById('totalCount').textContent = filtered.length;
        }

        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .create-cta, .filter-reset').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        const bgVideo = document.getElementById('bg-video');
        const gradientBg = document.getElementById('gradient-bg');
        
        if (bgVideo) {
            bgVideo.addEventListener('error', function() {
                console.log('Background video failed to load, using gradient fallback');
                if (gradientBg) gradientBg.style.display = 'block';
            });
            
            bgVideo.play().catch(function(error) {
                console.log('Video autoplay prevented:', error);
                if (gradientBg) gradientBg.style.display = 'block';
            });
        }
        
        document.addEventListener('visibilitychange', function() {
            if (bgVideo) {
                if (document.hidden) {
                    bgVideo.pause();
                } else {
                    bgVideo.play().catch(e => console.log('Video play error:', e));
                }
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '/discover' && currentPath.includes('/discover'))) {
                link.classList.add('active');
            }
        });
    </script>

        <!-- ===== FOOTER ===== -->
        <footer class="footer" style="background: var(--card-bg); padding: 3rem 0; margin-top: 3rem; border-top: 1px solid rgba(24, 227, 164, 0.1);">
            <div class="container" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem;">
                <div class="footer-section">
                    <h4 style="color: var(--primary-color); margin-bottom: 1rem;">Midgar</h4>
                    <p style="color: var(--text-secondary); font-size: 0.9rem;">Explorez des univers infinis et laissez parler votre créativité.</p>
                </div>
                <div class="footer-section">
                    <h4 style="color: var(--primary-color); margin-bottom: 1rem;">Liens Rapides</h4>
                    <ul class="footer-links">
                        <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                        <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                        <li><a href="/shop" class="magic-btn">Boutique</a></li>
                        <li><a href="/challenges" class="magic-btn">Défis</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4 style="color: var(--primary-color); margin-bottom: 1rem;">Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#" class="magic-btn">Confidentialité</a></li>
                        <li><a href="#" class="magic-btn">CGU</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom" style="text-align: center; color: var(--text-secondary); padding-top: 2rem; margin-top: 2rem; border-top: 1px solid rgba(24, 227, 164, 0.1);">
                <p>&copy; 2024 Midgar. Tous droits réservés.</p>
            </div>
        </footer>
    </div>
    </body>
</html>
