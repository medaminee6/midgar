<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Découvrir - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES DISCOVER ===== */
        .discover-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.1);
            height: fit-content;
            position: sticky;
            top: 100px;
            backdrop-filter: blur(5px);
        }

        .filter-sidebar:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: var(--primary-color);
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: var(--primary-color);
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: var(--text-color);
            font-size: 0.9rem;
            margin: 0;
            flex: 1;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .search-box::placeholder { 
            color: var(--text-secondary); 
        }
        
        .search-box:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }

        .filter-reset {
            width: 100%;
            padding: 10px;
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            display: block;
            text-align: center;
            text-decoration: none;
            margin-top: 1rem;
        }

        .filter-reset:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.02);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        /* Toggle buttons */
        .content-type-toggles {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            background-color: transparent;
            color: var(--text-secondary);
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .toggle-btn.active {
            border-color: var(--primary-color);
            background-color: var(--primary-color);
            color: #000;
        }

        .toggle-btn:hover { 
            border-color: var(--primary-color); 
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* Preferences action buttons */
        .feed-actions { display: flex; align-items: center; gap: 1rem; }
        .pref-actions { display: flex; gap: 0.5rem; align-items: center; }
        
        .btn-pref {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, var(--primary-color) 0%, #0DCF92 100%);
            color: #0B0F0E;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s;
        }
        
        .btn-pref:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(24, 227, 164, 0.3);
        }
        
        .btn-pref-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 12px;
            border-radius: 999px;
            background: transparent;
            color: #FF6B6B;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255, 107, 107, 0.3);
            transition: all 0.3s;
            cursor: pointer;
        }
        
        .btn-pref-outline:hover {
            transform: translateY(-2px);
            border-color: rgba(255, 107, 107, 0.6);
            background: rgba(255, 107, 107, 0.1);
        }
        
        .results-count { color: var(--text-secondary); font-size: 0.9rem; }
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.02);
            box-shadow: 0 0 15px var(--primary-color);
        }

        .content-type-toggles {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            background-color: transparent;
            color: var(--text-secondary);
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            transition: all 0.3s;
        }

        .toggle-btn.active {
            border-color: var(--primary-color);
            background-color: var(--primary-color);
            color: #000;
        }

        .toggle-btn:hover { 
            border-color: var(--primary-color); 
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }

        .feed-section { flex: 1; }

        .feed-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }

        .results-count { color: var(--text-secondary); font-size: 0.9rem; }

        /* Preferences action buttons (small, non-intrusive, Midgar style) */
        .feed-actions { display: flex; align-items: center; gap: 1rem; }
        .pref-actions { display: flex; gap: 0.5rem; align-items: center; animation: slideFadeIn 420ms cubic-bezier(.2,.9,.3,1) both; }

        .btn-pref {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 14px;
            border-radius: 999px;
            background: linear-gradient(135deg, #18E3A4 0%, #0DCF92 100%);
            color: #0B0F0E;
            font-weight: 700;
            font-size: 0.9rem;
            text-decoration: none;
            box-shadow: 0 6px 18px rgba(11,15,14,0.06);
            transition: transform 180ms ease, box-shadow 180ms ease;
        }

        .btn-pref:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16,200,150,0.12); }

        .btn-pref-outline {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 8px 12px;
            border-radius: 999px;
            background: transparent;
            color: #FF6B6B;
            font-weight: 700;
            font-size: 0.9rem;
            border: 1px solid rgba(255,107,107,0.12);
            transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
        }





        .feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card, .feed-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(5px);
            position: relative;
        }

        .why-btn {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1px solid rgba(24, 227, 164, 0.7);
            background: rgba(13, 15, 15, 0.9);
            color: var(--primary-color);
            font-weight: 700;
            font-size: 14px;
            line-height: 1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            z-index: 3;
        }

        .why-tooltip {
            position: absolute;
            top: 40px;
            right: 8px;
            max-width: 260px;
            background: rgba(13, 15, 15, 0.96);
            border: 1px solid rgba(24, 227, 164, 0.35);
            border-radius: 10px;
            padding: 10px 12px;
            color: var(--text-color);
            font-size: 0.82rem;
            line-height: 1.35;
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.35);
            opacity: 0;
            visibility: hidden;
            transform: translateY(-4px);
            transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
            z-index: 4;
        }

        .why-tooltip.visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .universe-card:hover {
            border-color: rgba(24, 227, 164, 0.2);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(24, 227, 164, 0.3);
            transform: translateY(-10px) scale(1.02);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            overflow: hidden;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
        }

        .card-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            display: block;
            transition: transform 0.5s ease;
        }

        .universe-card:hover .card-banner img {
            transform: scale(1.1);
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-type {
            display: inline-block;
            font-size: 0.75rem;
            color: var(--primary-color);
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 0.5rem;
            letter-spacing: 0.5px;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: rgba(24, 227, 164, 0.1);
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            transition: transform 0.2s;
        }
        
        .genre-tag:hover {
            transform: scale(1.05);
        }

        .card-description {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
            padding-top: 1rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .load-more { display: flex; justify-content: center; margin-top: 2rem; }

        .load-more-btn {
            padding: 12px 40px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .load-more-btn:hover { background-color: #0DCF92; }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .empty-state p { font-size: 1.1rem; margin-bottom: 1rem; }
        
        .footer-links {
            list-style: none;
        }
        
        .footer-links li {
            margin-bottom: 0.5rem;
        }
        
        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: var(--primary-color);
        }

        @media (max-width: 1024px) {
            .discover-container { 
                grid-template-columns: 1fr; 
            }
            .filter-sidebar { 
                position: static; 
            }
        }

        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .feed-grid { 
                grid-template-columns: 1fr; 
            }
            
            .discover-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                <li><a href="/discover" class="magic-btn active">Découvrir</a></li>
                <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                <li><a href="/shop" class="magic-btn">Boutique</a></li>
                <li><a href="/challenges" class="magic-btn">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            {% if app.user %}
                <a href="{{ path('profile') }}" class="profile-link magic-btn">
                    <div class="avatar">
                        {% if app.user.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                        {% else %}
                            <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
