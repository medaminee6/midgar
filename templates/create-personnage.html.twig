<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un Personnage - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .creation-container { display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 100vh; }
        .sidebar { position: sticky; top: 0; height: 100vh; background-color: var(--bg-secondary); border-right: 2px solid var(--border-color); overflow-y: auto; padding: 2rem 1.5rem; }
        .sidebar-title { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 1.5rem; letter-spacing: 1px; }
        .sidebar-nav { display: flex; flex-direction: column; gap: 0.75rem; }
        .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: all 0.3s; font-size: 0.9rem; }
        .sidebar-link:hover, .sidebar-link.active { background-color: rgba(24, 227, 164, 0.1); color: var(--accent-primary); border-left: 3px solid var(--accent-primary); padding-left: calc(1rem - 3px); }
        .sidebar-icon { width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; }
        .main-content { padding: 3rem; }
        .form-container { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2.5rem; max-width: 700px; }
        .form-title { font-size: 2.2rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
        .form-subtitle { color: var(--text-secondary); margin-bottom: 2rem; font-size: 0.95rem; }
        .form-group { margin-bottom: 1.5rem; }
        .form-label { display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; color: var(--text-primary); }
        .form-input, .form-textarea, .form-select { width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; transition: all 0.3s; }
        .form-input:focus, .form-textarea:focus, .form-select:focus { outline: none; border-color: var(--accent-primary); box-shadow: 0 0 12px var(--shadow-color); }
        .form-textarea { resize: vertical; min-height: 120px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .file-upload { position: relative; }
        .file-label { display: block; padding: 2rem; border: 2px dashed var(--border-color); border-radius: 8px; text-align: center; cursor: pointer; transition: all 0.3s; background-color: rgba(24, 227, 164, 0.05); }
        .file-label:hover { border-color: var(--accent-primary); background-color: rgba(24, 227, 164, 0.1); }
        .file-icon { width: 48px; height: 48px; margin: 0 auto 0.75rem; display: flex; align-items: center; justify-content: center; background-color: rgba(24, 227, 164, 0.15); border-radius: 8px; }
        .file-text { font-weight: 600; margin-bottom: 0.25rem; color: var(--accent-primary); }
        .file-hint { font-size: 0.85rem; color: var(--text-secondary); }
        #fileInput { display: none; }
        .form-actions { display: flex; gap: 1rem; margin-top: 2rem; }
        .btn { padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; }
        .btn-primary { background-color: var(--accent-primary); color: var(--bg-primary); }
        .btn-primary:hover { background-color: var(--accent-hover); }
        .btn-secondary { background-color: var(--border-color); color: var(--text-primary); border: 1px solid var(--accent-primary); }
        .btn-secondary:hover { background-color: rgba(24, 227, 164, 0.1); }
        /* Form error styling */
        .form-error { color: #ff6b6b; font-size: 0.85rem; margin-top: 0.5rem; }
        .form-row-error input, .form-row-error textarea, .form-row-error select { border-color: #ff6b6b !important; }
        .form-error-list { background-color: rgba(255, 107, 107, 0.1); border: 1px solid #ff6b6b; border-radius: 4px; padding: 1rem; margin-bottom: 1.5rem; color: #ff6b6b; }
        @media (max-width: 1024px) { .creation-container { grid-template-columns: 1fr; } .sidebar { position: static; height: auto; border-right: none; border-bottom: 2px solid var(--border-color); } .sidebar-nav { flex-direction: row; gap: 1rem; overflow-x: auto; } .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <header style="background-color: var(--bg-secondary); border-bottom: 2px solid var(--border-color); padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--accent-primary);">◆ Midgar</div>
        <nav style="display: flex; gap: 2rem;">
            <a href="/" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Accueil</a>
            <a href="/discover" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Découvrir</a>
            <a href="/universes" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Univers</a>
            <a href="/personnages" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Personnages</a>
            <a href="/oeuvre" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Œuvre</a>
            <a href="/shop" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Boutique</a>
            <a href="/challenges" style="color: var(--text-secondary); text-decoration: none; font-weight: 600; transition: all 0.3s;">Défis</a>
        </nav>
        <div style="display: flex; gap: 0.75rem;">
            <a href="/login" style="padding: 0.6rem 1.2rem; border: 1px solid var(--accent-primary); color: var(--accent-primary); text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 0.85rem;">Se connecter</a>
        </div>
    </header>

    <div class="creation-container">
        <aside class="sidebar">
            <div class="sidebar-title">◇ Créer du Contenu</div>
            <nav class="sidebar-nav">
                <a href="{{ path('universe_new') }}" class="sidebar-link">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="2" r="1.5"/>
                    </svg>
                    Univers
                </a>
                <a href="{{ path('personnage_new') }}" class="sidebar-link active">
                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>
                    </svg>
                    Personnage
                </a>
                
            </nav>
        </aside>

        <main class="main-content">
            <div class="form-container">
                <h1 class="form-title">Créer un Personnage</h1>
                <p class="form-subtitle">Définissez un héros ou une créature de votre univers</p>
                
                {% for flash_error in app.flashes('error') %}
                    <div style="background: #ff4d4d; color: white; padding: 1rem; border-radius: 4px; margin-bottom: 1rem;">{{ flash_error }}</div>
                {% endfor %}
                
                {{- form_start(form, {'attr': {'id':'personnageForm', 'enctype':'multipart/form-data'}}) -}}
                    {{ form_errors(form, {'attr': {'class': 'form-error-list'}}) }}
                    <div class="form-group">{{ form_row(form.name, {'attr': {'class':'form-input'}}) }}</div>
                    <div class="form-row">
                        <div class="form-group">{{ form_row(form.universe, {'attr': {'class':'form-select'}}) }}</div>
                        <div class="form-group">{{ form_row(form.classRole, {'attr': {'class':'form-select'}}) }}</div>
                    </div>
                    
                    <h3 style="margin: 2rem 0 1rem 0; color: var(--accent-primary); font-size: 1.1rem;">Statistiques</h3>
                    <div class="form-row" style="grid-template-columns: repeat(4, 1fr);">
                        <div class="form-group">{{ form_row(form.strength, {'attr': {'class':'form-input', 'min':'0', 'max':'100', 'placeholder':'0-100'}}) }}</div>
                        <div class="form-group">{{ form_row(form.agility, {'attr': {'class':'form-input', 'min':'0', 'max':'100', 'placeholder':'0-100'}}) }}</div>
                        <div class="form-group">{{ form_row(form.magic, {'attr': {'class':'form-input', 'min':'0', 'max':'100', 'placeholder':'0-100'}}) }}</div>
                        <div class="form-group">{{ form_row(form.defense, {'attr': {'class':'form-input', 'min':'0', 'max':'100', 'placeholder':'0-100'}}) }}</div>
                    </div>
                    
                    <div class="form-group">{{ form_row(form.historyContext, {'attr': {'class':'form-textarea'}}) }}</div>
                    <div class="form-group">{{ form_row(form.abilitiesPowers, {'attr': {'class':'form-textarea'}}) }}</div>
                    <div class="form-group file-upload">
                        <label for="fileInput" class="file-label">
                            <div class="file-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14.828 14.828a4 4 0 0 1-5.656 0M9 10h1.586a1 1 0 0 1 .707.293l.707.707A1 1 0 0 0 13.414 11H15m-3-3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                                </svg>
                            </div>
                            <div class="file-text">Choisir un portrait</div>
                            <div class="file-hint">PNG, JPG jusqu'à 5MB</div>
                        </label>
                        {{ form_widget(form.portraitFile, {'attr': {'id': 'fileInput'}}) }}
                        {{ form_errors(form.portraitFile) }}
                    </div>
                    <div class="form-actions">
                        <a href="/discover" class="btn btn-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary">Créer le Personnage</button>
                    </div>
                {{ form_end(form) }}
            </div>
        </main>
    </div>

    <script>
        document.getElementById('fileInput')?.addEventListener('change', (e) => {
            const label = document.querySelector('.file-label');
            if(e.target.files.length) {
                label.innerHTML = `<div class="file-icon" style="background-color: rgba(24, 227, 164, 0.2);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 28px; height: 28px; stroke: var(--accent-primary);">
                    <polyline points="20 6 9 17 4 12"/></svg></div><div class="file-text" style="color: var(--accent-primary);">✓ ${e.target.files[0].name}</div>`;
            }
        });
        document.querySelector('.file-label').addEventListener('click', (e) => {
            if(e.target.closest('.file-label')) document.getElementById('fileInput').click();
        });
    </script>
</body>
</html>