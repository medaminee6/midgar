            border: 1px solid #ff4d4d;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 1024px) { 
            .creation-container { 
                grid-template-columns: 1fr; 
            } 
            .sidebar { 
                position: static; 
                height: auto; 
                border-right: none; 
                border-bottom: 2px solid rgba(24, 227, 164, 0.1); 
            } 
            .sidebar-nav { 
                flex-direction: row; 
                gap: 1rem; 
                overflow-x: auto; 
            } 
            .form-row { 
                grid-template-columns: 1fr; 
            } 
            .form-row-4 { 
                grid-template-columns: repeat(2, 1fr); 
            } 
        }
        
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .form-container {
                padding: 1.5rem;
            }
            
            .form-title {
                font-size: 1.8rem;
            }
            
            .form-row-4 {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="/challenges" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <div class="creation-container">
                        <aside class="sidebar">
                            <div class="sidebar-title">◇ Créer du Contenu</div>
                            <nav class="sidebar-nav">
                                <a href="{{ path('universe_new') }}" class="sidebar-link magic-btn">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="2" r="1.5"/>
                                    </svg>
                                    Univers
                                </a>
                                <a href="{{ path('personnage_new') }}" class="sidebar-link active magic-btn">
                                    <svg class="sidebar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z"/>
                                    </svg>
                                    Personnage
                                </a>
                            </nav>
                        </aside>

                        <main class="main-content">
                            <div class="form-container">
                                <h1 class="form-title">Créer un Personnage</h1>
                                <p class="form-subtitle">Définissez un héros ou une créature de votre univers</p>
                                
                                {% for flash_error in app.flashes('error') %}
                                    <div class="flash-error">{{ flash_error }}</div>
                                {% endfor %}
                                
                                {{ form_start(form, {'attr': {'id':'personnageForm', 'enctype':'multipart/form-data', 'class': 'personnage-form'}}) }}
                                    {{ form_errors(form, {'attr': {'class': 'form-error-list'}}) }}
                                    
                                    <div class="form-group">
                                        <label class="form-label">Nom du personnage</label>
                                        {{ form_widget(form.name, {'attr': {'class': 'form-input', 'placeholder': 'Ex: Aragorn, Gandalf, Legolas...'}}) }}
                                        {{ form_errors(form.name, {'attr': {'class': 'form-error'}}) }}
                                    </div>
                                    
                                    <div class="form-row">
                                        <div class="form-group">
                                            <label class="form-label">Univers</label>
                                            {{ form_widget(form.universe, {'attr': {'class': 'form-select'}}) }}
                                            {{ form_errors(form.universe, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Classe / Rôle</label>
                                            {{ form_widget(form.classRole, {'attr': {'class': 'form-select'}}) }}
                                            {{ form_errors(form.classRole, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                    </div>
                                    
                                    <h3 style="margin: 2rem 0 1rem 0; color: var(--primary-color); font-size: 1.1rem;">Statistiques</h3>
                                    <div class="form-row-4">
                                        <div class="form-group">
                                            <label class="form-label">Force</label>
                                            {{ form_widget(form.strength, {'attr': {'class': 'form-input', 'min': '0', 'max': '100', 'placeholder': '0-100'}}) }}
                                            {{ form_errors(form.strength, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Agilité</label>
                                            {{ form_widget(form.agility, {'attr': {'class': 'form-input', 'min': '0', 'max': '100', 'placeholder': '0-100'}}) }}
                                            {{ form_errors(form.agility, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Magie</label>
                                            {{ form_widget(form.magic, {'attr': {'class': 'form-input', 'min': '0', 'max': '100', 'placeholder': '0-100'}}) }}
                                            {{ form_errors(form.magic, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                        <div class="form-group">
                                            <label class="form-label">Défense</label>
                                            {{ form_widget(form.defense, {'attr': {'class': 'form-input', 'min': '0', 'max': '100', 'placeholder': '0-100'}}) }}
                                            {{ form_errors(form.defense, {'attr': {'class': 'form-error'}}) }}
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label">Histoire & Contexte</label>
                                        {{ form_widget(form.historyContext, {'attr': {'class': 'form-textarea', 'placeholder': 'Racontez l\'histoire de votre personnage...'}}) }}
                                        {{ form_errors(form.historyContext, {'attr': {'class': 'form-error'}}) }}
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="form-label">Capacités & Pouvoirs</label>
                                        {{ form_widget(form.abilitiesPowers, {'attr': {'class': 'form-textarea', 'placeholder': 'Décrivez les capacités spéciales de votre personnage...'}}) }}
                                        {{ form_errors(form.abilitiesPowers, {'attr': {'class': 'form-error'}}) }}
                                    </div>
                                    
                                    <div class="form-group file-upload">
                                        <label class="form-label">Portrait</label>
                                        {{ form_widget(form.portraitFile, {'attr': {'id': 'fileInput', 'style': 'display: none;'}}) }}
                                        <label for="fileInput" class="file-label">
                                            <div class="file-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 28px; height: 28px;">
                                                    <path d="M14.828 14.828a4 4 0 0 1-5.656 0M9 10h1.586a1 1 0 0 1 .707.293l.707.707A1 1 0 0 0 13.414 11H15m-3-3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                                                </svg>
                                            </div>
                                            <div class="file-text">Choisir un portrait</div>
                                            <div class="file-hint">PNG, JPG jusqu'à 5MB</div>
                                        </label>
                                        {{ form_errors(form.portraitFile, {'attr': {'class': 'form-error'}}) }}
                                    </div>
                                    
                                    <div class="form-actions">
                                        <a href="{{ path('personnage_index') }}" class="btn btn-secondary magic-btn">Annuler</a>
                                        <button type="submit" class="btn btn-primary magic-btn">Créer le Personnage</button>
                                    </div>
                                {{ form_end(form) }}
                            </div>
                        </main>
                    </div>
                </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .sidebar-link').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
