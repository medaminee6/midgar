<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ personnage.name }} - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        .btn-danger {
            background-color: #d32f2f;
            color: white;
            border: 2px solid #d32f2f;
        }
        
        .btn-danger:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(211, 47, 47, 0.5);
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        /* ===== STYLES SPÉCIFIQUES PERSONNAGE SHOW ===== */
        .hero-banner { 
            width: 100%; 
            height: 300px; 
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            font-size: 3rem; 
            margin: 0 0 2rem 0; 
            overflow: hidden;
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.2);
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .hero-banner:hover {
            border-color: var(--primary-color);
            box-shadow: 0 0 30px rgba(24, 227, 164, 0.3);
            transform: translateY(-5px);
        }
        
        .hero-banner img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            object-position: center;
            transition: transform 0.5s ease;
        }
        
        .hero-banner:hover img {
            transform: scale(1.05);
        }
        
        .personnage-header { 
            display: flex; 
            justify-content: space-between; 
            align-items: flex-start; 
            margin-bottom: 2rem; 
            flex-wrap: wrap; 
            gap: 1rem; 
        }
        
        .personnage-info { 
            flex: 1; 
        }
        
        .personnage-info h1 { 
            font-size: 2.5rem; 
            margin: 0 0 0.5rem 0; 
            text-transform: uppercase; 
            color: var(--primary-color);
        }
        
        .class-badges { 
            display: flex; 
            gap: 0.5rem; 
            margin: 1rem 0; 
            flex-wrap: wrap; 
        }
        
        .class-badge { 
            padding: 6px 14px; 
            background-color: rgba(24, 227, 164, 0.1); 
            color: var(--primary-color); 
            border: 1px solid var(--primary-color);
            border-radius: 20px; 
            font-size: 0.85rem; 
            font-weight: 600; 
            transition: transform 0.2s;
        }
        
        .class-badge:hover {
            transform: scale(1.05);
        }
        
        .personnage-actions { 
            display: flex; 
            gap: 1rem; 
            flex-wrap: wrap; 
            margin-top: 1rem; 
        }
        
        .action-btn { 
            padding: 10px 20px; 
            border: 2px solid var(--primary-color); 
            background-color: transparent; 
            color: var(--primary-color); 
            border-radius: var(--border-radius); 
            cursor: pointer; 
            font-weight: 600; 
            transition: all 0.3s; 
            text-decoration: none; 
        }
        
        .action-btn:hover { 
            background-color: var(--primary-color); 
            color: #000; 
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .action-btn.primary { 
            background-color: var(--primary-color); 
            color: #000; 
        }
        
        .action-btn.primary:hover { 
            background-color: var(--primary-dark); 
        }
        
        .action-btn.danger { 
            border-color: #ff4d4d; 
            color: #ff4d4d; 
        }
        
        .action-btn.danger:hover { 
            background-color: #ff4d4d; 
            color: white; 
            box-shadow: 0 0 15px rgba(255, 77, 77, 0.5);
        }
        
        .stats { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 1rem; 
            margin: 2rem 0; 
        }
        
        .stat { 
            text-align: center; 
            padding: 1.5rem; 
            background-color: var(--card-bg); 
            border-radius: var(--border-radius); 
            border: 1px solid rgba(24, 227, 164, 0.1);
            backdrop-filter: blur(5px);
            transition: all 0.3s;
        }
        
        .stat:hover {
            border-color: rgba(24, 227, 164, 0.3);
            transform: translateY(-5px);
        }
        
        .stat-value { 
            font-size: 1.8rem; 
            font-weight: 700; 
            color: var(--primary-color); 
            margin-bottom: 0.3rem;
        }
        
        .stat-label { 
            font-size: 0.85rem; 
            color: var(--text-secondary); 
        }
        
        .content-wrapper { 
            display: grid; 
            grid-template-columns: 1fr 300px; 
            gap: 2rem; 
        }
        
        .main-content { 
            background-color: var(--card-bg); 
            border: 1px solid rgba(24, 227, 164, 0.1); 
            border-radius: var(--border-radius); 
            padding: 2rem; 
            backdrop-filter: blur(10px);
        }
        
        .tabs { 
            display: flex; 
            gap: 0; 
            border-bottom: 2px solid rgba(24, 227, 164, 0.1); 
            margin-bottom: 2rem; 
            overflow-x: auto; 
        }
        
        .tab-btn { 
            padding: 1rem 1.5rem; 
            background: none; 
            border: none; 
            color: var(--text-secondary); 
            cursor: pointer; 
            font-weight: 600; 
            border-bottom: 3px solid transparent; 
            transition: all 0.3s; 
            white-space: nowrap; 
        }
        
        .tab-btn.active { 
            color: var(--primary-color); 
            border-bottom-color: var(--primary-color); 
        }
        
        .tab-content { 
            display: none; 
        }
        
        .tab-content.active { 
            display: block; 
        }
        
        .creator-card { 
            background-color: var(--card-bg); 
            border: 1px solid rgba(24, 227, 164, 0.1); 
            border-radius: var(--border-radius); 
            padding: 1.5rem; 
            margin-bottom: 2rem; 
            backdrop-filter: blur(10px);
            text-align: center;
        }
        
        .creator-avatar { 
            width: 60px; 
            height: 60px; 
            border-radius: 50%; 
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            color: #000; 
            font-weight: 700; 
            font-size: 1.5rem; 
            margin: 0 auto 1rem; 
        }
        
        .creator-name { 
            font-weight: 600; 
            margin-bottom: 0.25rem; 
        }
        
        .creator-username { 
            font-size: 0.9rem; 
            color: var(--text-secondary); 
            margin-bottom: 1rem; 
        }
        
        .flash-success {
            background-color: rgba(24, 227, 164, 0.2);
            color: var(--primary-color);
            padding: 1rem;
            border-radius: var(--border-radius);
            margin-bottom: 1rem;
            font-weight: 600;
            border: 1px solid var(--primary-color);
        }
        
        .flash-error {
            background-color: rgba(255, 77, 77, 0.2);
            color: #ff4d4d;
            padding: 1rem;
            border-radius: var(--border-radius);
            margin-bottom: 1rem;
            font-weight: 600;
            border: 1px solid #ff4d4d;
        }
        
        /* ===== MODALES STANDARD - VERSION TRÈS COMPACTE ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.2s;
            backdrop-filter: blur(6px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        /* ===== MODALE IMAGE ULTRA COMPACTE ===== */
        .modal-image-compact {
            max-width: 260px;
            width: 60%;
            background: rgba(22, 26, 25, 0.98);
            padding: 0.6rem;
            border: 1px solid var(--primary-color);
            border-radius: 10px;
            position: relative;
            animation: slideUp 0.3s;
            box-shadow: 0 0 15px rgba(24, 227, 164, 0.2);
            margin: auto;
        }
        
        .modal-close-compact {
            position: absolute;
            top: 0.3rem;
            right: 0.3rem;
            font-size: 0.9rem;
            cursor: pointer;
            color: var(--primary-color);
            background: rgba(0, 0, 0, 0.5);
            border: none;
            padding: 0.15rem;
            transition: all 0.2s;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1001;
            line-height: 1;
        }
        
        .modal-close-compact:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-image-container-compact {
            width: 100%;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 0.3rem;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 35vh;
            background: transparent;
        }
        
        .modal-image-container-compact img {
            max-width: 100%;
            max-height: 30vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 4px;
            filter: brightness(1.05);
        }
        
        .modal-title-compact {
            color: var(--primary-color);
            margin-bottom: 0;
            font-size: 0.8rem;
            text-align: center;
            font-weight: 500;
            margin-top: 0.1rem;
            letter-spacing: 0.3px;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .content-wrapper { 
                grid-template-columns: 1fr; 
            }
            
            .stats { 
                grid-template-columns: repeat(2, 1fr); 
            }
            
            .personnage-info h1 {
                font-size: 2rem;
            }
            
            .modal-image-compact {
                max-width: 220px;
                width: 65%;
                padding: 0.5rem;
            }
            
            .modal-image-container-compact {
                max-height: 30vh;
            }
            
            .modal-image-container-compact img {
                max-height: 25vh;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn active">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="/challenges" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            {% for flash_message in app.flashes('success') %}
                <div class="flash-success">{{ flash_message }}</div>
            {% endfor %}
            {% for flash_message in app.flashes('error') %}
                <div class="flash-error">{{ flash_message }}</div>
            {% endfor %}

            <div class="hero-banner" onclick="openImageModal('{{ personnage.getPortraitBase64() ?: '' }}', '{{ personnage.name }}')">
                {% if personnage.getPortraitBase64() %}
                    <img src="{{ personnage.getPortraitBase64() }}" alt="{{ personnage.name }}">
                {% else %}
                    👤
                {% endif %}
            </div>

            <div class="container">
                <div class="personnage-header">
                    <div class="personnage-info">
                        <h1>{{ personnage.name }}</h1>
                        <div class="class-badges">
                            <span class="class-badge">{{ {'warrior':'Guerrier','mage':'Mage','rogue':'Escroc','cleric':'Clerc','ranger':'Rôdeur','other':'Autre'}[personnage.classRole] ?? personnage.classRole }}</span>
                        </div>
                        <p style="color: var(--text-secondary);">Univers: <a href="{{ path('universe_show', {'id': personnage.universe.id}) }}" style="color: var(--primary-color); text-decoration: none;">{{ personnage.universe.name }}</a></p>
                    </div>
                    <div class="personnage-actions">
                        <a href="{{ path('personnage_edit', {'id': personnage.id}) }}" class="action-btn magic-btn">Modifier</a>
                        <form method="post" action="{{ path('personnage_delete', {'id': personnage.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce personnage?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_personnage_' ~ personnage.id) }}">
                            <button type="submit" class="action-btn danger magic-btn">Supprimer</button>
                        </form>
                    </div>
                </div>

                <div class="stats">
                    <div class="stat">
                        <div class="stat-value">{{ personnage.strength ?? '—' }}</div>
                        <div class="stat-label">Force</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">{{ personnage.agility ?? '—' }}</div>
                        <div class="stat-label">Agilité</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">{{ personnage.magic ?? '—' }}</div>
                        <div class="stat-label">Magie</div>
                    </div>
                    <div class="stat">
                        <div class="stat-value">{{ personnage.defense ?? '—' }}</div>
                        <div class="stat-label">Défense</div>
                    </div>
                </div>

                <div class="content-wrapper">
                    <div class="main-content">
                        <div class="tabs">
                            <button class="tab-btn active" data-tab="apropos">À propos</button>
                            <button class="tab-btn" data-tab="pouvoirs">Pouvoirs</button>
                        </div>

                        <div id="apropos" class="tab-content active">
                            <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Histoire & Contexte</h3>
                            <p style="color: var(--text-secondary); line-height: 1.8;">{{ personnage.historyContext }}</p>
                        </div>

                        <div id="pouvoirs" class="tab-content">
                            <h3 style="color: var(--primary-color); margin-bottom: 1rem;">Capacités & Pouvoirs</h3>
                            {% if personnage.abilitiesPowers %}
                                <p style="color: var(--text-secondary); line-height: 1.8;">{{ personnage.abilitiesPowers }}</p>
                            {% else %}
                                <p style="color: var(--text-secondary);">Aucune capacité enregistrée pour ce personnage.</p>
                            {% endif %}
                        </div>
                    </div>

                    <div>
                        <div class="creator-card">
                            <div class="creator-avatar">{{ personnage.name|first|upper }}</div>
                            <div class="creator-name">Créateur</div>
                            <div class="creator-username">Anonyme</div>
                        </div>
                        <div style="margin-top: 1rem;">
                            <a href="{{ path('personnage_index') }}" class="btn btn-secondary magic-btn" style="width: 100%;">← Retour à la liste</a>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALE IMAGE ULTRA COMPACTE ===== -->
    <div id="imageModal" class="modal">
        <div class="modal-image-compact">
            <button class="modal-close-compact" onclick="closeModal('imageModal')">×</button>
            <div class="modal-image-container-compact">
                <img id="modalImage" src="" alt="Portrait agrandi">
            </div>
            <h3 class="modal-title-compact" id="modalImageTitle">{{ personnage.name }}</h3>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .btn-danger, .action-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== TAB FUNCTIONS =====
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll(".tab-btn").forEach(function(btn) {
                btn.addEventListener("click", function() {
                    document.querySelectorAll(".tab-btn").forEach(function(b) { b.classList.remove("active"); });
                    document.querySelectorAll(".tab-content").forEach(function(c) { c.classList.remove("active"); });
                    this.classList.add("active");
                    const tab = this.dataset.tab;
                    const element = document.getElementById(tab);
                    if(element) element.classList.add("active");
                });
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            if (!imageSrc) return;
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || '{{ personnage.name }}';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('personnage_index') }}' && currentPath.includes('/personnages'))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>