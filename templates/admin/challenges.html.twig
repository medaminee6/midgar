{% extends 'base.html.twig' %}

{% block title %}Gestion des défis | Midgar Admin{% endblock %}

{% block content %}
<div class="container">
    <h1 style="color: #18E3A4; margin-bottom: 1.5rem;">Gestion des défis</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="mb-4">
        <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createDefiForm" aria-expanded="false" aria-controls="createDefiForm">
            + Créer un nouveau défi
        </button>
    </div>

    <div class="collapse mb-4 {{ form_errors(form)|raw ? 'show' : '' }}" id="createDefiForm">
        <div class="card card-body">
            <h3 style="color: #18E3A4; margin-bottom: 1rem;">Nouveau défi</h3>
            {{ form_errors(form) }}
            {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.titre) }}
                        {{ form_widget(form.titre, { 'attr': { 'class': 'form-control' } }) }}
                        {{ form_errors(form.titre) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.theme) }}
                        {{ form_widget(form.theme, { 'attr': { 'class': 'form-control' } }) }}
                        {{ form_errors(form.theme) }}
                    </div>
                </div>
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, { 'attr': { 'class': 'form-control', 'rows': 4 } }) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.dateDebut) }}
                        {{ form_widget(form.dateDebut, { 'attr': { 'class': 'form-control' } }) }}
                        {{ form_errors(form.dateDebut) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.dateFin) }}
                        {{ form_widget(form.dateFin, { 'attr': { 'class': 'form-control' } }) }}
                        {{ form_errors(form.dateFin) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.dateLimite) }}
                        {{ form_widget(form.dateLimite, { 'attr': { 'class': 'form-control' } }) }}
                        {{ form_errors(form.dateLimite) }}
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.statut) }}
                        {{ form_widget(form.statut, { 'attr': { 'class': 'form-select' } }) }}
                        {{ form_errors(form.statut) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.imageCoverFile) }}
                        {{ form_widget(form.imageCoverFile, { 'attr': { 'class': 'form-control', 'accept': 'image/*' } }) }}
                        {{ form_errors(form.imageCoverFile) }}
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">Créer le défi</button>
            {{ form_end(form) }}
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Description</th>
                    <th>Statut</th>
                    <th>Date limite</th>
                    <th>Participants</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for defi in defis %}
                    <tr>
                        <td>{{ defi.id }}</td>
                        <td>{{ defi.titre }}</td>
                        <td>{{ defi.description|slice(0, 50) }}{{ defi.description|length > 50 ? '...' : '' }}</td>
                        <td><span class="badge {% if defi.statut.value == 'OUVERT' %}bg-success{% elseif defi.statut.value == 'TERMINE' %}bg-danger{% else %}bg-warning{% endif %}">{{ defi.statut.value }}</span></td>
                        <td>{{ defi.dateLimite ? defi.dateLimite|date('d/m/Y') : '—' }}</td>
                        <td>{{ defi.participations|length }}</td>
                        <td>
                            <a href="{{ path('admin_defi_participations', { id: defi.id }) }}" class="btn btn-sm btn-info" style="color: white;">Participants</a>
                            <a href="{{ path('defi_edit', { id: defi.id }) }}" class="btn btn-sm btn-warning">Modifier</a>
                            <form method="post" action="{{ path('defi_delete', { id: defi.id }) }}" style="display: inline;" onsubmit="return confirm('Supprimer ce défi et toutes ses participations ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ defi.id) }}">
                                <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">Aucun défi trouvé.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
