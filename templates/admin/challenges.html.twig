<script>
    // Animation pour le bouton de création
    document.querySelector('.create-btn')?.addEventListener('click', function() {
        this.classList.add('active');
        setTimeout(() => this.classList.remove('active'), 300);
    });

    // Animation des cartes de statistiques
    document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
        });
    });

    // Gestion du formulaire
    const form = document.querySelector('.defi-form');
    if (form) {
        form.addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Traitement...';
                submitBtn.disabled = true;
            }
        });
    }

    // Toggle du formulaire de création
    const createBtn = document.querySelector('.create-btn');
    const formCard = document.querySelector('#createDefiForm');
    
    if (createBtn && formCard) {
        createBtn.addEventListener('click', function() {
            formCard.classList.toggle('show');
            const icon = this.querySelector('i');
            if (formCard.classList.contains('show')) {
                icon.className = 'fas fa-minus';
                this.innerHTML = '<i class="fas fa-minus"></i> Masquer le formulaire';
            } else {
                icon.className = 'fas fa-plus';
                this.innerHTML = '<i class="fas fa-plus"></i> Créer un nouveau défi';
            }
        });
    }

    // Highlight des lignes au survol
    document.querySelectorAll('tbody tr').forEach(row => {
        row.addEventListener('mouseenter', function() {
            this.style.backgroundColor = 'rgba(24,227,164,0.05)';
        });
        
        row.addEventListener('mouseleave', function() {
            this.style.backgroundColor = '';
        });
    });

    // Animation progressive des lignes du tableau
    document.querySelectorAll('tbody tr').forEach((row, index) => {
        row.style.animationDelay = `${index * 0.05}s`;
    });
</script>

