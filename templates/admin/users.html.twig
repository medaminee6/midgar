<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Admin · Utilisateurs</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-main: #0B0F0E;
            --bg-panel: #141A19;
            --bg-soft: #1A1F1E;
            --border: #2A3139;
            --border-light: #3A424A;

            --accent: #18E3A4;
            --accent-dark: #13c891;
            --accent-light: rgba(24,227,164,0.12);
            --danger: #EF5350;
            --danger-light: rgba(239,83,80,0.12);
            --warning: #FFA726;
            --warning-light: rgba(255,167,38,0.12);
            --success: #66BB6A;

            --text-main: #E6FFF6;
            --text-muted: #9BA6A2;
            --text-light: #CBD5D1;

            --sidebar-width: 260px;
            --radius: 12px;
            --radius-lg: 16px;
            --shadow: 0 10px 25px rgba(0,0,0,.3);
            --shadow-lg: 0 15px 35px rgba(0,0,0,.5);
            --shadow-hover: 0 20px 40px rgba(0,0,0,.6);
        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
        }

        body {
            font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* ===== LAYOUT ===== */
        .admin-layout {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0B0F0E 0%, #161C1B 100%);
            border-right: 1px solid var(--border);
            padding: 2.5rem 0;
            position: fixed;
            height: 100vh;
            z-index: 100;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .sidebar-logo {
            padding: 0 1.5rem 1.5rem;
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo-icon {
            font-size: 1.8rem;
            color: var(--accent);
            filter: drop-shadow(0 0 10px var(--accent-glow));
        }

        .logo-text {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: -0.5px;
        }

        .admin-sidebar ul {
            list-style: none;
        }

        .admin-sidebar a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            margin: 0.25rem 0;
            font-weight: 500;
        }

        .admin-sidebar a i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .admin-sidebar a::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, var(--accent-light), transparent);
            transition: width 0.4s ease;
            z-index: -1;
        }

        .admin-sidebar a:hover::before,
        .admin-sidebar a.active::before {
            width: 100%;
        }

        .admin-sidebar a:hover,
        .admin-sidebar a.active {
            color: var(--accent);
            border-left-color: var(--accent);
            font-weight: 600;
        }

        .admin-sidebar a:hover i,
        .admin-sidebar a.active i {
            transform: scale(1.1);
            filter: drop-shadow(0 0 5px var(--accent-glow));
        }


        /* ===== CONTENT ===== */
        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2.5rem;
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            background: linear-gradient(135deg, var(--bg-main) 0%, #111716 100%);
        }

        /* ===== HEADER ===== */
        .admin-header {
            margin-bottom: 2.5rem;
        }

        .admin-header h1 {
            font-size: 2.2rem;
            color: var(--accent);
            margin-bottom: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .admin-header h1::before {
            content: "👥";
            font-size: 1.8rem;
        }

        .header-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 2.5rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border-light);
        }

        /* ===== SEARCH ===== */
        .search-form {
            display: flex;
            gap: 0.75rem;
            flex: 1;
            max-width: 450px;
        }

        .search-form input {
            padding: 12px 18px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--bg-panel);
            color: var(--text-main);
            flex: 1;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .search-form input:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-light);
        }

        .search-form input::placeholder {
            color: var(--text-muted);
        }

        .search-form button,
        .btn-link {
            padding: 12px 24px;
            border-radius: var(--radius);
            border: none;
            cursor: pointer;
            font-weight: 600;
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: #000;
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
        }

        .search-form button:hover,
        .btn-link:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .search-form button::before {
            content: "🔍";
        }

        .btn-link {
            background: var(--bg-soft);
            color: var(--text-main);
            border: 1px solid var(--border);
        }

        .btn-link:hover {
            background: var(--accent);
            color: #000;
            border-color: var(--accent);
        }

        .btn-link::before {
            content: "←";
        }

        /* ===== DASHBOARD STATS ===== */
        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .stat-card {
            background: linear-gradient(135deg, var(--bg-panel), var(--bg-soft));
            border-radius: var(--radius-lg);
            padding: 1.75rem;
            position: relative;
            overflow: hidden;
            box-shadow: var(--shadow);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid var(--border-light);
            cursor: pointer;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-hover);
            border-color: var(--accent);
        }

        .stat-card::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .stat-card:hover::after {
            opacity: 1;
        }

        .stat-title {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .stat-card:nth-child(1) .stat-title::before { content: "👥"; }
        .stat-card:nth-child(2) .stat-title::before { content: "👑"; }
        .stat-card:nth-child(3) .stat-title::before { content: "✅"; }
        .stat-card:nth-child(4) .stat-title::before { content: "🚫"; }

        .stat-value {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--accent);
            line-height: 1;
            text-shadow: 0 2px 10px rgba(24,227,164,0.3);
        }

        /* ===== PROGRESS GRAPH ===== */
        .progress-box {
            background: var(--bg-panel);
            border-radius: var(--radius-lg);
            padding: 2rem;
            margin-bottom: 2.5rem;
            box-shadow: var(--shadow);
            border: 1px solid var(--border-light);
            transition: all 0.3s ease;
        }

        .progress-box:hover {
            box-shadow: var(--shadow-hover);
        }

        .progress-label {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 1rem;
            margin-bottom: 1.2rem;
            color: var(--text-muted);
        }

        .progress-label strong {
            color: var(--accent);
            font-size: 1.2rem;
            font-weight: 700;
        }

        .progress-track {
            height: 14px;
            background: var(--bg-main);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 2px 5px rgba(0,0,0,0.5);
        }

        .progress-bar {
            height: 100%;
            background: linear-gradient(90deg, var(--accent), var(--accent-dark));
            width: 0;
            border-radius: 20px;
            animation: fillBar 1.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
            position: relative;
            overflow: hidden;
        }

        .progress-bar::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.2),
                transparent
            );
            animation: shimmer 2s infinite;
        }

        @keyframes fillBar {
            from { width: 0; }
            to { width: var(--percent); }
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        /* ===== TABLE ===== */
        .table-wrapper {
            background: var(--bg-panel);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-light);
            position: relative;
        }

        .table-wrapper::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            z-index: 1;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 1000px;
        }

        thead {
            background: linear-gradient(135deg, var(--bg-soft), var(--bg-panel));
            position: sticky;
            top: 0;
            z-index: 10;
        }

        th {
            padding: 1.5rem;
            text-align: left;
            border-bottom: 1px solid var(--border-light);
            font-weight: 600;
            color: var(--accent);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            position: relative;
        }

        th::after {
            content: "";
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 0;
            height: 2px;
            background: var(--accent);
            transition: width 0.3s ease;
        }

        th:hover::after {
            width: 100%;
        }

        td {
            padding: 1.5rem;
            border-bottom: 1px solid var(--border-light);
            color: var(--text-light);
            transition: all 0.2s ease;
        }

        tbody tr {
            animation: fadeRow 0.5s cubic-bezier(0.4, 0, 0.2, 1) both;
            position: relative;
        }

        tbody tr:hover {
            background: var(--accent-light);
        }

        tbody tr:hover td {
            color: var(--text-main);
            transform: translateX(5px);
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        @keyframes fadeRow {
            from { 
                opacity: 0; 
                transform: translateY(10px); 
            }
            to { 
                opacity: 1; 
                transform: translateY(0); 
            }
        }

        /* ===== BADGES ===== */
        .badge {
            padding: 8px 18px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.3px;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            border: 1px solid transparent;
            transition: all 0.3s ease;
        }

        .badge-active {
            background: var(--accent-light);
            color: var(--accent);
            border-color: rgba(24,227,164,0.3);
        }

        .badge-active::before {
            content: "●";
            font-size: 0.6rem;
            animation: pulse 2s infinite;
        }

        .badge-inactive {
            background: var(--danger-light);
            color: var(--danger);
            border-color: rgba(239,83,80,0.3);
        }

        .badge-inactive::before {
            content: "●";
            font-size: 0.6rem;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        /* ===== ACTIONS ===== */
        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 18px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
        }

        .btn::after {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, 0.5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1, 1) translate(-50%);
            transform-origin: 50% 50%;
        }

        .btn:focus:not(:active)::after {
            animation: ripple 1s ease-out;
        }

        @keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }
            100% {
                transform: scale(20, 20);
                opacity: 0;
            }
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .btn:active {
            transform: translateY(0);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: #000;
        }

        .btn-primary::before {
            content: "🔄";
        }

        .btn-warning {
            background: linear-gradient(135deg, var(--warning), #FF9800);
            color: #000;
        }

        .btn-warning::before {
            content: "⚠️";
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--danger), #D32F2F);
            color: #fff;
        }

        .btn-danger::before {
            content: "🗑️";
        }

        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--text-muted);
        }

        .empty-state::before {
            content: "👤";
            font-size: 3rem;
            display: block;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1200px) {
            .dashboard-stats {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .admin-sidebar {
                width: 70px;
                padding: 1rem 0;
            }

            .admin-sidebar .sidebar-logo span {
                display: none;
            }

            .admin-sidebar .sidebar-logo::before {
                margin: 0 auto;
            }

            .admin-sidebar a span {
                display: none;
            }

            .admin-content {
                margin-left: 70px;
                padding: 1.5rem;
            }

            .dashboard-stats {
                grid-template-columns: 1fr;
                gap: 1rem;
            }

            .header-actions {
                flex-direction: column;
                align-items: stretch;
                gap: 1rem;
            }

            .search-form {
                max-width: 100%;
            }
        }

        @media (max-width: 480px) {
            .action-buttons {
                flex-direction: column;
                width: 100%;
            }

            .btn {
                width: 100%;
                justify-content: center;
            }

            .stat-card {
                padding: 1.5rem;
            }

            .stat-value {
                font-size: 2rem;
            }

            .admin-header h1 {
                font-size: 1.8rem;
            }
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-main);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 5px;
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--border-light);
        }

        /* ===== ANIMATION DELAYS FOR ROWS ===== */
        tbody tr:nth-child(1) { animation-delay: 0.1s; }
        tbody tr:nth-child(2) { animation-delay: 0.2s; }
        tbody tr:nth-child(3) { animation-delay: 0.3s; }
        tbody tr:nth-child(4) { animation-delay: 0.4s; }
        tbody tr:nth-child(5) { animation-delay: 0.5s; }
        tbody tr:nth-child(6) { animation-delay: 0.6s; }
        tbody tr:nth-child(7) { animation-delay: 0.7s; }
        tbody tr:nth-child(8) { animation-delay: 0.8s; }
        tbody tr:nth-child(9) { animation-delay: 0.9s; }
        tbody tr:nth-child(10) { animation-delay: 1s; }

        /* ===== LOADING STATES ===== */
        .loading {
            position: relative;
            overflow: hidden;
        }

        .loading::after {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.1),
                transparent
            );
            animation: loading 1.5s infinite;
        }

        @keyframes loading {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }
    </style>
</head>

<body>
{% set sort = sort|default('createdAt') %}
{% set direction = direction|default('DESC') %}

<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">Midgar Admin</div>
        </div>
          <ul>
        <li><a href="{{ path('admin_users') }}" class="active"><i class="fas fa-users"></i><span>Utilisateurs</span></a></li>
        <li><a href="{{ path('admin_oeuvres') }}"><i class="fas fa-book"></i><span>Œuvres</span></a></li>
        <li><a href="{{ path('admin_artefacts') }}"><i class="fas fa-gem"></i><span>Artefacts</span></a></li>
        <li><a href="{{ path('admin_quiz_questions') }}"><i class="fas fa-question-circle"></i><span>Quiz</span></a></li>
        <li><a href="{{ path('admin_produits') }}"><i class="fas fa-shopping-cart"></i><span>Shop</span></a></li>
        <li><a href="{{ path('admin_challenges') }}"><i class="fas fa-trophy"></i><span>Défis</span></a></li>
    </ul>
    </aside>

    <!-- CONTENT -->
    <main class="admin-content">
        {% set total = users|length %}
        {% set admins = users|filter(u => u.isAdmin())|length %}
        {% set blocked = users|filter(u => u.isBlocked)|length %}
        {% set active = total - blocked %}
        {% set activePercent = total > 0 ? (active * 100 / total)|round : 0 %}

        <div class="admin-header">
            <h1>Gestion des utilisateurs</h1>
            
            <div class="dashboard-stats">
                <div class="stat-card">
                    <div class="stat-title">Utilisateurs totaux</div>
                    <div class="stat-value">{{ total }}</div>
                </div>

                <div class="stat-card">
                    <div class="stat-title">Administrateurs</div>
                    <div class="stat-value">{{ admins }}</div>
                </div>

                <div class="stat-card">
                    <div class="stat-title">Comptes actifs</div>
                    <div class="stat-value">{{ active }}</div>
                </div>

                <div class="stat-card">
                    <div class="stat-title">Comptes bloqués</div>
                    <div class="stat-value">{{ blocked }}</div>
                </div>
            </div>

            <div class="progress-box">
                <div class="progress-label">
                    <span>Répartition des comptes</span>
                    <strong>{{ activePercent }}% actifs</strong>
                </div>
                <div class="progress-track">
                    <div class="progress-bar" style="--percent: {{ activePercent }}%"></div>
                </div>
            </div>

            <div class="header-actions">
                <form method="get" action="{{ path('admin_users') }}" class="search-form">
                    <input type="text" name="q" value="{{ search|default('') }}" 
                           placeholder="Rechercher par nom, email ou username...">
                    <button type="submit">Rechercher</button>
                </form>

                <a href="{{ path('home') }}" class="btn-link">Retour au site</a>
            </div>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Rôle</th>
                    <th>Statut</th>
                    <th>Création</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td><strong>#{{ user.id }}</strong></td>
                        <td>{{ user.nom|default('—') }}</td>
                        <td>{{ user.prenom|default('—') }}</td>
                        <td>{{ user.email }}</td>
                        <td><strong>@{{ user.username }}</strong></td>
                        <td>
                            <span class="badge {{ user.isAdmin() ? 'badge-active' : 'badge-inactive' }}">
                                {{ user.isAdmin() ? 'Admin' : 'User' }}
                            </span>
                        </td>
                        <td>
                            <span class="badge {{ user.isBlocked ? 'badge-inactive' : 'badge-active' }}">
                                {{ user.isBlocked ? 'Bloqué' : 'Actif' }}
                            </span>
                        </td>
                        <td>{{ user.createdAt|date('d/m/Y') }}</td>
                        <td>
                            <div class="action-buttons">
                                <form method="post" action="{{ path('admin_user_toggle_role', {'id': user.id}) }}"
                                      onsubmit="return confirm('Changer le rôle de cet utilisateur ?');">
                                    <button class="btn btn-primary">Rôle</button>
                                </form>
                                <form method="post" action="{{ path('admin_user_block', {'id': user.id}) }}"
                                      onsubmit="return confirm('{{ user.isBlocked ? 'Débloquer' : 'Bloquer' }} cet utilisateur ?');">
                                    <button class="btn btn-warning">
                                        {{ user.isBlocked ? 'Débloquer' : 'Bloquer' }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}"
                                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer définitivement cet utilisateur ? Cette action est irréversible.');">
                                    <button class="btn btn-danger">Supprimer</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9">
                            <div class="empty-state">
                                Aucun utilisateur trouvé
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </main>
</div>

</body>
</html>
