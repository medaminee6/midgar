<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Utilisateurs - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        :root { --sidebar-width: 250px; --sidebar-bg: #1A1F1E; --accent: #18E3A4; --muted: #B0B9B6; --panel-bg: #0B0F0E; }
        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; padding: 0; overflow-x: hidden; background: #121818; color: #E6FFF6; font-family: sans-serif; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: var(--sidebar-width); background-color: var(--sidebar-bg); border-right: 1px solid #2A3139; padding: 2rem 0; position: fixed; left: 0; top: 0; height: 100vh; overflow-y: auto; z-index: 1000; }
        .admin-sidebar .logo { padding: 1rem 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid #2A3139; color: var(--accent); font-weight: 700; font-size: 1.2rem; }
        .admin-sidebar nav ul { list-style: none; padding: 0; margin: 0; }
        .admin-sidebar nav li { margin: 0; }
        .admin-sidebar nav a { display: block; padding: 12px 1.5rem; color: var(--muted); text-decoration: none; border-left: 3px solid transparent; transition: all 0.18s ease-in-out; }
        .admin-sidebar nav a:hover, .admin-sidebar nav a.active { background-color: #0B0F0E; color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
        .admin-content { margin-left: var(--sidebar-width); padding: 2rem; min-height: 100vh; overflow-y: auto; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #2A3139; }
        .admin-header h1 { margin: 0; color: var(--accent); }
        .table-wrapper { background-color: #1A1F1E; border-radius: 6px; overflow: auto; }
        table { width: 100%; border-collapse: collapse; table-layout: auto; }
        th { background-color: var(--panel-bg); padding: 1rem 1.5rem; text-align: left; color: var(--accent); font-weight: 600; border-bottom: 1px solid #2A3139; }
        td { padding: 1rem 1.5rem; border-bottom: 1px solid #2A3139; word-break: break-word; }
        tr:hover { background-color: #252A29; }
        .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
        .badge-active { background-color: rgba(24, 227, 164, 0.2); color: var(--accent); }
        .badge-inactive { background-color: rgba(176, 185, 182, 0.2); color: var(--muted); }
        .action-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .action-buttons button { padding: 4px 12px; font-size: 0.85rem; border: none; border-radius: 3px; cursor: pointer; }
        .btn-edit { background-color: var(--accent); color: #0B0F0E; text-decoration:none; display:inline-block; }
        .btn-delete { background-color: #BD3B44; color: #E6FFF6; }
        .search-form { margin-bottom: 1rem; display: flex; gap: 0.5rem; }
        .search-form input { flex: 1; padding: 6px 10px; border-radius: 4px; border: 1px solid #2A3139; background: #0B0F0E; color: #E6FFF6; }
        .search-form button { padding: 6px 12px; background: var(--accent); color: #0B0F0E; border: none; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="logo">Admin</div>
            <nav>
                <ul>
                    <li><a href="/admin/dashboard">Tableau de bord</a></li>
                    <li><a href="/admin/users" class="active">Utilisateurs</a></li>
                    <li><a href="/admin/quiz-questions">Quiz</a></li>
                    <li><a href="/admin/produits">Shop</a></li>
                    <li><a href="/admin/challenges">Défis</a></li>
                </ul>
            </nav>
        </aside>

        <div class="admin-content">
            <div class="admin-header" style="flex-direction: column; align-items:flex-start; gap:1rem;">
                <h1>Gestion des Utilisateurs</h1>
                <div style="display:flex; gap:1rem; flex-wrap:wrap;">
                    <form method="get" action="{{ path('admin_users') }}" class="search-form">
                        <input type="text" name="q" value="{{ search }}" placeholder="Rechercher par username ou email">
                        <button type="submit">Rechercher</button>
                    </form>
                    <a href="{{ path('home') }}" class="search-form">Retour à l'accueil</a>
                </div>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Email</th>
                            <th>Username</th>
                            <th>Rôle</th>
                            <th>Statut</th>
                            <th>Créé le</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                        <tr>
                            <td>#{{ user.id }}</td>
                            <td>{{ user.lastName|default('') }}</td>
                            <td>{{ user.firstName|default('') }}</td>
                            <td>{{ user.email }}</td>
                            <td>{{ user.username }}</td>
                            <td>
                                {% if user.isAdmin() %}
                                    <span class="badge badge-active">Admin</span>
                                {% else %}
                                    <span class="badge badge-inactive">User</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if user.isBlocked %}
                                    <span class="badge badge-inactive">Bloqué</span>
                                {% else %}
                                    <span class="badge badge-active">Actif</span>
                                {% endif %}
                            </td>
                            <td>{{ user.createdAt|date('Y-m-d') }}</td>
                            <td>
                                <div class="action-buttons">
                                    <form method="post" action="{{ path('admin_user_toggle_role', {'id': user.id}) }}">
                                        <button class="btn-edit" type="submit">Changer rôle</button>
                                    </form>
                                    <form method="post" action="{{ path('admin_user_block', {'id': user.id}) }}">
                                        <button class="btn-edit" type="submit">{{ user.isBlocked ? 'Débloquer' : 'Bloquer' }}</button>
                                    </form>
                                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                        <button class="btn-delete" type="submit">Supprimer</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="9" style="text-align:center;">Aucun utilisateur trouvé.</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
