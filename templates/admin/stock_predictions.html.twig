<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prédictions de Stock - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0A0F0E;
            --bg-panel: #0F1615;
            --bg-card: #131B1A;
            --border: #22302E;
            --accent: #20E3B2;
            --text: #E9FFF7;
            --text-secondary: #8EA39E;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: var(--bg-main);
            color: var(--text);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2rem;
        }

        header {
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        h1 {
            font-size: 2rem;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn {
            padding: 0.75rem 1.5rem;
            background: var(--accent);
            color: var(--bg-main);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(32, 227, 178, 0.3);
        }

        .alerts {
            margin-bottom: 2rem;
        }

        .alert {
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        .alert-success {
            background: rgba(32, 227, 178, 0.1);
            border-left: 4px solid var(--accent);
        }

        .section {
            margin-bottom: 2.5rem;
        }

        .section-title {
            font-size: 1.3rem;
            margin-bottom: 1.5rem;
            color: var(--accent);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 1.5rem;
        }

        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s;
        }

        .card:hover {
            border-color: var(--accent);
            box-shadow: 0 8px 20px rgba(32, 227, 178, 0.1);
        }

        .card-header {
            margin-bottom: 1rem;
        }

        .product-name {
            font-weight: 600;
            font-size: 1.1rem;
            color: var(--text);
        }

        .product-info {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin-top: 0.3rem;
        }

        .metrics {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-top: 1rem;
        }

        .metric {
            background: rgba(32, 227, 178, 0.05);
            padding: 0.75rem;
            border-radius: 6px;
        }

        .metric-label {
            font-size: 0.85rem;
            color: var(--text-secondary);
            text-transform: uppercase;
        }

        .metric-value {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--accent);
            margin-top: 0.3rem;
        }

        .confidence-bar {
            background: var(--bg-panel);
            height: 6px;
            border-radius: 3px;
            margin-top: 0.5rem;
            overflow: hidden;
        }

        .confidence-fill {
            height: 100%;
            background: linear-gradient(90deg, #20E3B2, #5CD0FF);
            transition: width 0.3s;
        }

        .danger {
            border-left: 4px solid #FF6B6B;
        }

        .danger .product-name {
            color: #FF6B6B;
        }

        .table-container {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: x-auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background: var(--bg-panel);
            padding: 1rem;
            text-align: left;
            font-weight: 600;
            color: var(--accent);
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            color: var(--text-secondary);
        }

        tr:hover td {
            background: rgba(32, 227, 178, 0.05);
        }

        .status {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .status-critical {
            background: rgba(255, 107, 107, 0.15);
            color: #FF6B6B;
        }

        .status-warning {
            background: rgba(246, 200, 96, 0.15);
            color: #F6C860;
        }

        .status-safe {
            background: rgba(32, 227, 178, 0.15);
            color: var(--accent);
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>
                <i class="fas fa-brain"></i>
                Stock Prediction AI
            </h1>
            <form method="POST" style="display: inline;">
                <button type="submit" class="btn">
                    <i class="fas fa-zap"></i> Calculer Prédictions
                </button>
            </form>
        </header>

        {% if app.flashes %}
        <div class="alerts">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> {{ message }}
                </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- Critical Products Section -->
        {% if critical_predictions|length > 0 %}
        <section class="section">
            <h2 class="section-title">
                <i class="fas fa-exclamation-triangle"></i>
                🚨 Alertes Critiques (Rupture < 30 jours)
            </h2>

            <div class="cards-grid">
                {% for prediction in critical_predictions %}
                <div class="card danger">
                    <div class="card-header">
                        <div class="product-name">{{ prediction.product.nomProduit }}</div>
                        <div class="product-info">ID: {{ prediction.product.id }}</div>
                    </div>

                    <div class="metrics">
                        <div class="metric">
                            <div class="metric-label">Stock Actuel</div>
                            <div class="metric-value">{{ prediction.currentStock }}</div>
                        </div>
                        <div class="metric">
                            <div class="metric-label">Consommation/Jour</div>
                            <div class="metric-value">{{ prediction.dailyConsumption|number_format(2, '.', ' ') }}</div>
                        </div>
                    </div>

                    <div class="metrics">
                        <div class="metric">
                            <div class="metric-label">Rupture dans</div>
                            <div class="metric-value" style="color: #FF6B6B;">
                                {{ prediction.daysUntilStockout }} j
                            </div>
                        </div>
                        <div class="metric">
                            <div class="metric-label">Confiance</div>
                            <div class="metric-value">{{ (prediction.confidence * 100)|number_format(0) }}%</div>
                            <div class="confidence-bar">
                                <div class="confidence-fill" style="width: {{ prediction.confidence * 100 }}%"></div>
                            </div>
                        </div>
                    </div>

                    {% if prediction.predictedStockoutDate %}
                    <div style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--text-secondary);">
                        <i class="fas fa-calendar"></i>
                        Rupture estimée: {{ prediction.predictedStockoutDate|date('d/m/Y') }}
                    </div>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        </section>
        {% endif %}

        <!-- All Predictions Section -->
        <section class="section">
            <h2 class="section-title">
                <i class="fas fa-chart-line"></i>
                Toutes les Prédictions
            </h2>

            {% if predictions|length > 0 %}
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Produit</th>
                            <th>Stock</th>
                            <th>Consommation/Jour</th>
                            <th>Rupture dans</th>
                            <th>Date Estimée</th>
                            <th>Confiance</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for prediction in predictions %}
                        <tr>
                            <td>
                                <strong>{{ prediction.product.nomProduit }}</strong><br>
                                <span style="font-size: 0.85rem; color: var(--text-secondary);">ID: {{ prediction.product.id }}</span>
                            </td>
                            <td>
                                <strong>{{ prediction.currentStock }}</strong>
                            </td>
                            <td>
                                {{ prediction.dailyConsumption|number_format(2, '.', ' ') }} units
                            </td>
                            <td>
                                <strong>{{ prediction.daysUntilStockout }} jours</strong>
                            </td>
                            <td>
                                {% if prediction.predictedStockoutDate %}
                                    {{ prediction.predictedStockoutDate|date('d/m/Y') }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span>{{ (prediction.confidence * 100)|number_format(0) }}%</span>
                                    <div class="confidence-bar" style="flex: 1; width: 40px;">
                                        <div class="confidence-fill" style="width: {{ prediction.confidence * 100 }}%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                {% if prediction.daysUntilStockout <= 10 %}
                                    <span class="status status-critical">CRITIQUE</span>
                                {% elseif prediction.daysUntilStockout <= 20 %}
                                    <span class="status status-warning">ALERTE</span>
                                {% else %}
                                    <span class="status status-safe">OK</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% else %}
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>Aucune prédiction disponible. Cliquez sur "Calculer Prédictions" pour en générer.</p>
            </div>
            {% endif %}
        </section>
    </div>
</body>
</html>
