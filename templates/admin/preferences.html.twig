<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Préférences - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .admin-layout { display: grid; grid-template-columns: 250px 1fr; gap: 0; min-height: 100vh; }
        .admin-sidebar { background-color: #1A1F1E; border-right: 1px solid #2A3139; padding: 2rem 0; position: fixed; left: 0; top: 0; width: 250px; height: 100vh; overflow-y: auto; }
        .admin-sidebar .logo { padding: 1rem 1.5rem; margin-bottom: 2rem; border-bottom: 1px solid #2A3139; }
        .admin-sidebar nav ul { list-style: none; padding: 0; margin: 0; }
        .admin-sidebar nav li { margin: 0; }
        .admin-sidebar nav a { display: block; padding: 12px 1.5rem; color: #B0B9B6; text-decoration: none; border-left: 3px solid transparent; transition: all 0.3s; }
        .admin-sidebar nav a:hover { background-color: #0B0F0E; color: #18E3A4; border-left-color: #18E3A4; }
        .admin-sidebar nav a.active { background-color: #0B0F0E; color: #18E3A4; border-left-color: #18E3A4; font-weight: 600; }
        .admin-content { margin-left: 250px; padding: 2rem; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #2A3139; }
        .admin-header h1 { margin: 0; color: #18E3A4; }
        .preference-card { background-color: #1A1F1E; border-radius: 6px; padding: 1.5rem; margin-bottom: 2rem; }
        .preference-card h3 { color: #18E3A4; margin-top: 0; }
        .table-wrapper { background-color: #1A1F1E; border-radius: 6px; overflow: hidden; }
        .table-wrapper table { width: 100%; border-collapse: collapse; }
        .table-wrapper th { background-color: #0B0F0E; padding: 1rem 1.5rem; text-align: left; color: #18E3A4; font-weight: 600; border-bottom: 1px solid #2A3139; }
        .table-wrapper td { padding: 1rem 1.5rem; border-bottom: 1px solid #2A3139; color: #E6FFF6; }
        .table-wrapper tr:hover { background-color: #252A29; }
        .action-buttons { display: flex; gap: 0.5rem; }
        .action-buttons a { padding: 4px 12px; font-size: 0.85rem; text-decoration: none; border-radius: 3px; }
        .btn-edit { background-color: #18E3A4; color: #0B0F0E; }
        .btn-delete { background-color: #BD3B44; color: #E6FFF6; }
    </style>
</head>
<body style="margin: 0;">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="logo" style="color: #18E3A4; font-weight: 700; font-size: 1.2rem;">⚙️ Admin</div>
            <nav>
                <ul>
                    <li><a href="/admin/dashboard">📊 Tableau de Bord</a></li>
                    <li><a href="/admin/users">👥 Utilisateurs</a></li>
                    <li><a href="/admin/oeuvres">📖 Œuvres</a></li>
                    <li><a href="/admin/artefacts">⚔️ Artefacts</a></li>
                    <li><a href="/admin/univers">🌍 Univers</a></li>
                    <li><a href="/admin/personnages">👹 Personnages</a></li>
                    <li><a href="/admin/produits">🛍️ Produits</a></li>
                    <li><a href="/admin/commandes">📦 Commandes</a></li>
                    <li><a href="/admin/challenges">🎯 Défis</a></li>
                    <li><a href="/admin/submissions">📤 Soumissions</a></li>
                    <li><a href="/admin/quiz-questions">❓ Questions Quiz</a></li>
                    <li><a href="/admin/quiz-reponses">✅ Réponses Quiz</a></li>
                    <li><a href="/admin/preferences" class="active">⚙️ Préférences</a></li>
                </ul>
            </nav>
        </aside>

        <div class="admin-content">
            <div class="admin-header">
                <h1>Gestion des Préférences</h1>
            </div>

            <div class="preference-card">
                <h3>Paramètres Généraux</h3>
                <form style="display: grid; gap: 1rem;">
                    <div>
                        <label style="display: block; color: #18E3A4; margin-bottom: 0.5rem;">Titre du Site</label>
                        <input type="text" value="Midgar Fantasy Platform" style="width: 100%; padding: 8px; background-color: #0B0F0E; border: 1px solid #2A3139; color: #E6FFF6; border-radius: 4px;">
                    </div>
                    <div>
                        <label style="display: block; color: #18E3A4; margin-bottom: 0.5rem;">Description</label>
                        <textarea style="width: 100%; padding: 8px; background-color: #0B0F0E; border: 1px solid #2A3139; color: #E6FFF6; border-radius: 4px; min-height: 100px; resize: vertical;">Créez, partagez et faites vivre vos univers fantasy</textarea>
                    </div>
                    <div>
                        <label style="display: block; color: #18E3A4; margin-bottom: 0.5rem;">Email support</label>
                        <input type="email" value="support@midgar.fr" style="width: 100%; padding: 8px; background-color: #0B0F0E; border: 1px solid #2A3139; color: #E6FFF6; border-radius: 4px;">
                    </div>
                    <button class="btn btn-primary" style="width: auto;">Sauvegarder</button>
                </form>
            </div>

            <div class="preference-card">
                <h3>Genres et Thèmes</h3>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Genre</th>
                                <th>Thèmes Associés</th>
                                <th>Actif</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#G1</td>
                                <td>Fantasy Épique</td>
                                <td>Action, Aventure, Dragons, Magie</td>
                                <td>✓</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                            <tr>
                                <td>#G2</td>
                                <td>Dark Fantasy</td>
                                <td>Mystère, Horreur, Noir, Sombre</td>
                                <td>✓</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                            <tr>
                                <td>#G3</td>
                                <td>Sci-Fi Fantasy</td>
                                <td>Technologie, Futur, Magie Avancée</td>
                                <td>✓</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="preference-card">
                <h3>Types de Contenu</h3>
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#T1</td>
                                <td>Univers</td>
                                <td>Mondes imaginaires complets</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                            <tr>
                                <td>#T2</td>
                                <td>Œuvre</td>
                                <td>Histoires, illustrations, designs</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                            <tr>
                                <td>#T3</td>
                                <td>Personnage</td>
                                <td>Créations de personnages</td>
                                <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a></div></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
