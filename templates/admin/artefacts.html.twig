            align-items: center;
            gap: 0.5rem;
            white-space: nowrap;
        }

        .search-form button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .search-form button::before {
            content: "🔍";
        }

        .btn-link {
            padding: 12px 24px;
            border-radius: var(--radius);
