            text-decoration: none;
            border-left: 3px solid transparent;
            transition: all 0.3s;
            font-weight: 500;
        }
        .admin-sidebar a i { width: 20px; text-align: center; font-size: 1.1rem; }
        .admin-sidebar a::before {
            content: "";
