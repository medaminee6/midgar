<script>
function openCommentsModal(type, id, title) {
    document.getElementById('modalTitle').textContent = title + ' - Commentaires';
    document.getElementById('commentsModalBody').innerHTML = '<p style="text-align: center; color: #9BA6A2;"><i class="fas fa-spinner fa-spin"></i> Chargement...</p>';
    document.getElementById('commentsModal').style.display = 'block';
    
    const url = type === 'oeuvre' ? '/admin/comments/oeuvre/' + id + '/list' : '/admin/comments/artefact/' + id + '/list';
    
    fetch(url)
        .then(response => response.json())
        .then(data => {
            let html = '';
            if (data.comments && data.comments.length > 0) {
                data.comments.forEach(function(comment) {
                    html += `
                        <div style="background: #1A1F1E; border-radius: 8px; padding: 15px; margin-bottom: 15px; border-left: 3px solid #18E3A4;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                                <strong style="color: #18E3A4;">${comment.userName}</strong>
                                <small style="color: #9BA6A2;">${comment.createdAt}</small>
                            </div>
                            <div style="color: #CBD5D1; margin-bottom: 10px; line-height: 1.5;">${comment.contenu}</div>
                            <div style="text-align: right;">
                                <button onclick="deleteComment(${comment.id}, this)" style="background: #EF5350; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: 500;">
                                    <i class="fas fa-trash"></i> Supprimer
                                </button>
                            </div>
                        </div>
                    `;
                });
            } else {
                html = '<p style="text-align: center; color: #9BA6A2;">Aucun commentaire</p>';
            }
            document.getElementById('commentsModalBody').innerHTML = html;
        })
        .catch(error => {
            document.getElementById('commentsModalBody').innerHTML = '<p style="color: #EF5350; text-align: center;">Erreur lors du chargement</p>';
        });
}

function closeCommentsModal() {
    document.getElementById('commentsModal').style.display = 'none';
}

function deleteComment(commentId, btn) {
    if (!confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?')) {
        return;
    }
    
    fetch('/admin/comments/' + commentId + '/delete-ajax', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Commentaire supprimé avec succès');
            // Remove the comment card
            btn.closest('div[style*="border-left"]').remove();
            // Reload to update counts
            location.reload();
        } else {
            alert('Erreur: ' + (data.message || 'Impossible de supprimer'));
        }
    })
    .catch(error => {
        alert('Erreur lors de la suppression');
    });
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('commentsModal');
    if (event.target == modal) {
        modal.style.display = 'none';
    }
}
</script>

