            background: linear-gradient(135deg, var(--bg-main) 0%, #0F1413 100%);
        }
        .admin-content::before {
            content: "";
            position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
        }
        
        /* ===== HEADER ===== */
        .page-header { margin-bottom: 2.5rem; }
        .page-title {
            font-size: 2.5rem; color: var(--accent); margin-bottom: 0.5rem;
            font-weight: 800; letter-spacing: -0.5px; display: flex; align-items: center; gap: 1rem;
        }
        .page-title i { font-size: 2.2rem; filter: drop-shadow(0 0 8px var(--accent-glow)); }
