        .logo-icon { font-size: 1.8rem; color: var(--accent); }
        .logo-text { font-size: 1.4rem; font-weight: 800; color: var(--accent); letter-spacing: -0.5px; }
        .admin-sidebar ul { list-style: none; }
        .admin-sidebar a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
