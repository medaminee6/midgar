            background: linear-gradient(90deg, var(--accent-light), transparent);
            transition: width 0.4s ease;
            z-index: -1;
        }
        .admin-sidebar a:hover::before, .admin-sidebar a.active::before { width: 100%; }
        .admin-sidebar a:hover, .admin-sidebar a.active { color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
        
        /* ===== CONTENT ===== */
        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2.5rem 3rem;
