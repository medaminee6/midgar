            color: #E6FFF6;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-link:hover {
            background: #3A424A;
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        }
        
        /* ===== STATS ===== */
        .dashboard-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2.5rem;
        }
        .stat-card {
            background: #1A1F1E;
            padding: 1.5rem;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            transition: transform 0.3s ease;
        }
        .stat-card:hover { transform: translateY(-4px); }
        .stat-icon {
            width: 48px; height: 48px;
            background: var(--accent-light);
            border-radius: var(--radius);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 1rem;
        }
        .stat-icon i { font-size: 1.5rem; color: var(--accent); }
        .stat-title { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0.25rem; }
        .stat-value { font-size: 2rem; font-weight: 700; color: var(--accent); }
        
        /* ===== ALERT ===== */
        .alert {
            padding: 1.25rem 1.5rem; border-radius: var(--radius); margin-bottom: 2rem;
            border-left: 4px solid; animation: slideIn 0.5s;
            display: flex; align-items: center; gap: 1rem;
        }
        .alert i { font-size: 1.4rem; }
        .alert-success { background: rgba(24,227,164,0.08); border-left-color: var(--accent); color: var(--accent); }
        @keyframes slideIn { from { opacity: 0; transform: translateY(-20px); } to { opacity: 1; transform: translateY(0); } }
        
        /* ===== TABLE ===== */
        .table-container { background: #1A1F1E; border-radius: var(--radius); overflow: hidden; }
        .table-wrapper { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th { background: #0B0F0E; padding: 1rem 1.5rem; text-align: left; color: var(--accent); font-weight: 600; border-bottom: 1px solid var(--border); }
        td { padding: 1rem 1.5rem; border-bottom: 1px solid var(--border); color: #E6FFF6; vertical-align: middle; }
        tr:hover { background: #252A29; }
        
        .description-truncate { max-width: 250px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        
        /* ===== BADGES ===== */
        .badge {
            display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 600;
        }
        .badge-legendary { background: linear-gradient(135deg, #FFD700, #FFA500); color: #1A1F1E; }
        .badge-epic { background: rgba(147, 51, 234, 0.3); color: #A855F7; }
        .badge-rare { background: rgba(24, 227, 164, 0.2); color: #18E3A4; }
        .badge-common { background: rgba(176, 185, 182, 0.2); color: #B0B9B6; }
        
        /* ===== ACTIONS ===== */
        .action-buttons { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .btn {
            display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem;
            border-radius: 4px; text-decoration: none; font-size: 0.85rem; border: none; cursor: pointer;
            transition: all 0.2s;
        }
        .btn-danger { background: #BD3B44; color: #fff; }
        .btn-danger:hover { background: #c9444c; }
        
        /* ===== EMPTY STATE ===== */
        .empty-state { text-align: center; padding: 3rem; color: var(--text-muted); }
        .empty-state i { font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; }
    </style>
</head>
