<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier le statut - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        :root { --sidebar-width: 280px; --accent: #18E3A4; --muted: #B0B9B6; --border: #2A3139; --panel-bg: #0B0F0E; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #080A0A; color: #E6FFF6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar { width: var(--sidebar-width); background: linear-gradient(135deg, #1A1F1E 0%, #0F1312 100%); border-right: 2px solid var(--border); padding: 1.5rem 0; position: fixed; left: 0; top: 0; height: 100vh; }
        .admin-sidebar .logo { padding: 1.5rem; border-bottom: 2px solid var(--border); color: var(--accent); font-weight: 700; }
        .admin-sidebar nav ul { list-style: none; }
        .admin-sidebar nav a { display: block; padding: 0.8rem 1.5rem; color: var(--muted); text-decoration: none; }
        .admin-sidebar nav a:hover, .admin-sidebar nav a.active { color: var(--accent); }
        .admin-content { margin-left: var(--sidebar-width); padding: 2rem; flex: 1; }
        .btn-back { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; color: var(--muted); border: 2px solid var(--border); border-radius: 4px; text-decoration: none; font-weight: 600; margin-bottom: 1.5rem; }
        .btn-back:hover { color: var(--accent); border-color: var(--accent); }
        .form-section { background: linear-gradient(135deg, #1A1F1E 0%, #252A29 100%); border: 1px solid var(--border); border-radius: 8px; padding: 2rem; max-width: 480px; }
        .form-section h2 { color: var(--accent); margin-bottom: 1.5rem; font-size: 1.25rem; }
        .form-group { margin-bottom: 1.25rem; }
        .form-group label { display: block; color: var(--accent); font-weight: 600; margin-bottom: 0.5rem; }
        .form-control { width: 100%; padding: 0.75rem; background: #0F1312; border: 1px solid var(--border); color: #E6FFF6; border-radius: 4px; font-size: 1rem; }
        .form-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
        button[type="submit"] { background: var(--accent); color: var(--panel-bg); padding: 0.75rem 1.5rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 700; }
        button[type="submit"]:hover { opacity: 0.9; }
        .participation-info { color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
    </style>
</head>
<body>
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="logo">⚙️ Admin</div>
        <nav>
            <ul>
                <li><a href="{{ path('admin_challenges') }}">⚔️ Défis</a></li>
                <li><a href="{{ path('admin_participations') }}" class="active">📋 Participations</a></li>
            </ul>
        </nav>
    </aside>

    <main class="admin-content">
        <a href="{{ path('admin_participations') }}" class="btn-back">← Retour aux participations</a>

        <div class="form-section">
            <h2>Modifier le statut — Participation #{{ participation.id }}</h2>
            <p class="participation-info">Défi : {{ participation.defi ? participation.defi.titre : '—' }} · {{ participation.dateSoumission ? participation.dateSoumission|date('d/m/Y') : '' }}</p>

            {{ form_start(form) }}
                <div class="form-group">
                    {{ form_label(form.statut) }}
                    {{ form_widget(form.statut, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.statut) }}
                </div>
                <div class="form-actions">
                    <button type="submit">Enregistrer</button>
                    <a href="{{ path('admin_participations') }}" style="padding: 0.75rem 1.5rem; color: var(--muted); text-decoration: none; border: 2px solid var(--border); border-radius: 4px;">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </main>
</div>
</body>
</html>
