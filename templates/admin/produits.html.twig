        <!-- PAGE HEADER -->
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-shopping-cart"></i> Gestion des Produits</h1>
        </div>

        <!-- STATS DASHBOARD -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-box"></i></div>
                <div class="stat-title">Produits Total</div>
                <div class="stat-value">{{ produits|length }}</div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-cubes"></i></div>
                <div class="stat-title">Stock Total</div>
                <div class="stat-value">
                    {{ produits|reduce((total, p) => total + p.quantiteDisponible, 0) }}
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-euro-sign"></i></div>
                <div class="stat-title">Valeur Stock</div>
                <div class="stat-value">
                    {{ (produits|reduce((total, p) => total + (p.prix * p.quantiteDisponible), 0))|round }}€
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="stat-title">Rupture de stock</div>
                <div class="stat-value">
                    {{ produits|filter(p => p.quantiteDisponible == 0)|length }}
                </div>
            </div>
        </div>

        <!-- ALERTS -->
        {% for message in app.flashes('success') %}
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}
        
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        <!-- CREATE BUTTON -->
        <div class="create-section">
            <button class="create-btn" type="button" onclick="toggleForm()">
                <i class="fas fa-plus"></i>
                Ajouter un produit
            </button>
        </div>

        <!-- CREATE FORM CARD -->
        <div id="createFormCard" class="form-card" style="display: none;">
            <h2><i class="fas fa-plus-circle"></i> Ajouter un produit</h2>
            <form method="POST" action="{{ path('admin_produits_create') }}">
                <div class="form-group">
                    <label class="form-label">Nom du produit</label>
                    <input type="text" name="nom_produit" class="form-control" required placeholder="Ex: Épée de Cristal">
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="3" placeholder="Décrivez le produit..."></textarea>
                </div>
                <div class="form-group">
                    <label class="form-label">Prix (€)</label>
                    <input type="number" name="prix" step="0.01" class="form-control" required placeholder="0.00">
                </div>
                <div class="form-group">
                    <label class="form-label">Type</label>
                    <input type="text" name="type_produit" class="form-control" required placeholder="Ex: Artefact, Livre, Collection...">
                </div>
                <div class="form-group">
                    <label class="form-label">Quantité</label>
                    <input type="number" name="quantite_disponible" class="form-control" required placeholder="0">
                </div>
                <div style="display: flex; gap: 1rem;">
                    <button type="submit" class="btn-submit">
                        <i class="fas fa-plus"></i> Ajouter
                    </button>
                    <button type="button" class="btn-submit" style="background: var(--border); color: var(--text-main);" onclick="hideForm()">
                        <i class="fas fa-times"></i> Annuler
                    </button>
                </div>
            </form>
        </div>

        <!-- TABLE DES PRODUITS -->
        <div class="table-container">
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th><i class="fas fa-hashtag"></i> ID</th>
                            <th><i class="fas fa-tag"></i> Nom</th>
                            <th><i class="fas fa-align-left"></i> Description</th>
                            <th><i class="fas fa-euro-sign"></i> Prix</th>
                            <th><i class="fas fa-layer-group"></i> Type</th>
                            <th><i class="fas fa-cubes"></i> Stock</th>
                            <th><i class="fas fa-calendar"></i> Date</th>
                            <th><i class="fas fa-cogs"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for produit in produits %}
                            <tr>
                                <td><strong>#{{ produit.id }}</strong></td>
                                <td style="font-weight: 600; color: var(--text-main);">{{ produit.nomProduit }}</td>
                                <td>
                                    <div title="{{ produit.description }}">
                                        {{ produit.description[:50] }}{{ produit.description|length > 50 ? '...' : '' }}
                                    </div>
                                </td>
                                <td style="font-weight: 600; color: var(--accent);">{{ produit.prix }}€</td>
                                <td><span class="badge badge-accent">{{ produit.typeProduit }}</span></td>
                                <td>
                                    {% if produit.quantiteDisponible == 0 %}
                                        <span class="badge badge-danger">Rupture</span>
                                    {% elseif produit.quantiteDisponible < 5 %}
                                        <span class="badge badge-warning">Stock faible ({{ produit.quantiteDisponible }})</span>
                                    {% else %}
                                        {{ produit.quantiteDisponible }}
                                    {% endif %}
                                </td>
                                <td>{{ produit.dateAjout ? produit.dateAjout|date('d/m/Y') : 'N/A' }}</td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="{{ path('admin_produits_edit', {id: produit.id}) }}" class="btn-edit">
                                            <i class="fas fa-edit"></i> Éditer
                                        </a>
                                        <form method="POST" action="{{ path('admin_produits_delete', {id: produit.id}) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce produit ? Cette action est irréversible.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_produit_' ~ produit.id) }}">
                                            <button type="submit" class="btn-delete">
                                                <i class="fas fa-trash"></i> Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <i class="fas fa-box-open"></i>
                                        <h3>Aucun produit trouvé</h3>
                                        <p>Commencez par ajouter votre premier produit !</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script>
    // Toggle form
    function toggleForm() {
        const formCard = document.getElementById('createFormCard');
        if (formCard.style.display === 'none') {
            formCard.style.display = 'block';
            formCard.scrollIntoView({ behavior: 'smooth' });
        } else {
            formCard.style.display = 'none';
        }
    }

    function hideForm() {
        document.getElementById('createFormCard').style.display = 'none';
    }

    // Animation des cartes de statistiques
    document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mouseenter', function() {
            this.style.transform = 'translateY(-8px)';
        });
        
        card.addEventListener('mouseleave', function() {
            this.style.transform = 'translateY(0)';
        });
    });

    // Animation progressive des lignes du tableau
    document.querySelectorAll('tbody tr').forEach((row, index) => {
        row.style.animationDelay = `${index * 0.05}s`;
    });

    // Animation du bouton de création
    document.querySelectorAll('.create-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            this.classList.add('active');
            setTimeout(() => this.classList.remove('active'), 300);
        });
    });

    // Focus sur les inputs
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('focus', function() {
            this.style.boxShadow = '0 0 0 3px rgba(24,227,164,0.2)';
        });
        
        input.addEventListener('blur', function() {
            this.style.boxShadow = '';
        });
    });
</script>

</body>
</html>
