<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier Commande #{{ commande.id }} - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0B0F0E;
            --bg-panel: #141A19;
            --bg-card: #1E2423;
            --border: #2A3139;
            --accent: #18E3A4;
            --text-main: #E6FFF6;
            --text-muted: #9BA6A2;
            --danger: #EF5350;
            --sidebar-width: 280px;
            --radius: 12px;
            --shadow: 0 10px 25px rgba(0,0,0,0.3);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", Arial, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            line-height: 1.6;
        }
        .admin-layout { display: flex; min-height: 100vh; }
        .admin-sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0B0F0E 0%, #161C1B 100%);
            border-right: 1px solid var(--border);
            padding: 2.5rem 0;
            position: fixed;
            height: 100vh;
        }
        .sidebar-logo {
            padding: 0 1.5rem 1.5rem;
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .logo-icon { font-size: 1.8rem; color: var(--accent); }
        .logo-text { font-size: 1.4rem; font-weight: 800; color: var(--accent); }
        .admin-sidebar ul { list-style: none; }
        .admin-sidebar a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            text-decoration: none;
            border-left: 3px solid transparent;
        }
        .admin-sidebar a.active,
        .admin-sidebar a:hover {
            color: var(--accent);
            border-left-color: var(--accent);
        }
        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2.5rem 3rem;
            width: calc(100% - var(--sidebar-width));
        }
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
        }
        .page-title { font-size: 2rem; color: var(--accent); font-weight: 800; }
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.5rem;
            box-shadow: var(--shadow);
        }
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 1rem;
        }
        .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
        label { color: var(--text-muted); font-size: 0.9rem; }
        input, select {
            background: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 0.7rem 0.8rem;
            color: var(--text-main);
        }
        .info-row { margin-top: 1rem; color: var(--text-muted); }
        .actions { display: flex; gap: 0.75rem; margin-top: 1.5rem; }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.7rem 1rem;
            border-radius: 10px;
            border: none;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-primary { background: var(--accent); color: #0B0F0E; }
        .btn-secondary { background: transparent; border: 1px solid var(--border); color: var(--text-main); }
        .btn-danger { background: var(--danger); color: #fff; }
        .alert {
            margin-bottom: 1rem;
            padding: 0.8rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-panel);
        }
    </style>
</head>
<body>
<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">Midgar Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('admin_users') }}"><i class="fas fa-users"></i><span>Utilisateurs</span></a></li>
            <li><a href="{{ path('admin_quiz_questions') }}"><i class="fas fa-question-circle"></i><span>Quiz</span></a></li>
            <li><a href="{{ path('admin_produits') }}"><i class="fas fa-shopping-cart"></i><span>Shop</span></a></li>
            <li><a href="{{ path('admin_commandes') }}" class="active"><i class="fas fa-truck"></i><span>Commandes</span></a></li>
            <li><a href="{{ path('admin_shop_analytics') }}"><i class="fas fa-chart-line"></i><span>Analyse IA</span></a></li>
            <li><a href="{{ path('admin_challenges') }}"><i class="fas fa-trophy"></i><span>Defis</span></a></li>
        </ul>
    </aside>

    <main class="admin-content">
        <div class="page-header">
            <div class="page-title">Modifier commande #{{ commande.id }}</div>
            <a class="btn btn-secondary" href="{{ path('admin_commandes') }}">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert">{{ message }}</div>
        {% endfor %}

        <div class="card">
            <form method="POST" action="{{ path('admin_commande_edit', {id: commande.id}) }}">
                <div class="form-grid">
                    <div class="form-group">
                        <label for="acheteur">Client</label>
                        <input id="acheteur" type="text" name="acheteur" value="{{ commande.acheteur }}" required>
                    </div>
                    <div class="form-group">
                        <label for="etat">Statut</label>
                        <select id="etat" name="etat" required>
                            {% for etat in etats %}
                                <option value="{{ etat.value }}" {% if commande.etat.value == etat.value %}selected{% endif %}>
                                    {{ etat.getLabel() }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div class="info-row">
                    Produit: {{ commande.produit.nomProduit }} | Quantite: {{ commande.quantite }} | Montant: {{ commande.prixTotal }} EUR
                </div>

                <div class="actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                    <a href="{{ path('admin_commande_detail', {id: commande.id}) }}" class="btn btn-secondary">
                        <i class="fas fa-eye"></i> Voir details
                    </a>
                </div>
            </form>
        </div>
    </main>
</div>
</body>
</html>
