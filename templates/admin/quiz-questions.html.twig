<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Questions Quiz - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">

    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #1A1F1E;
            --accent: #18E3A4;
            --muted: #B0B9B6;
            --panel-bg: #0B0F0E;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; padding: 0; overflow-x: hidden; }

        .admin-layout { display: flex; min-height: 100vh; }

        .admin-sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            border-right: 1px solid #2A3139;
            padding: 2rem 0;
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .admin-sidebar .logo {
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #2A3139;
            color: var(--accent);
            font-weight: 700;
            font-size: 1.2rem;
        }

        .admin-sidebar nav ul { list-style: none; padding: 0; margin: 0; }

        .admin-sidebar nav a {
            display: block;
            padding: 12px 1.5rem;
            color: var(--muted);
            text-decoration: none;
            border-left: 3px solid transparent;
        }

        .admin-sidebar nav a:hover,
        .admin-sidebar nav a.active {
            background-color: #0B0F0E;
            color: var(--accent);
            border-left-color: var(--accent);
            font-weight: 600;
        }

        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
            overflow-y: auto;
        }

        .admin-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #2A3139;
        }

        .admin-header h1 {
            margin: 0;
            color: var(--accent);
        }

        .table-wrapper {
            background-color: #1A1F1E;
            border-radius: 6px;
            overflow: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: var(--panel-bg);
            padding: 1rem 1.5rem;
            color: var(--accent);
            text-align: left;
            border-bottom: 1px solid #2A3139;
        }

        td {
            padding: 1rem 1.5rem;
            color: #E6FFF6;
            border-bottom: 1px solid #2A3139;
        }

        tr:hover { background-color: #252A29; }

        .action-buttons { display: flex; gap: 0.5rem; }

        .btn-edit {
            background-color: var(--accent);
            color: #0B0F0E;
            padding: 4px 12px;
            border-radius: 3px;
            text-decoration: none;
        }

        .btn-delete {
            background-color: #BD3B44;
            color: #E6FFF6;
            padding: 4px 12px;
            border-radius: 3px;
            text-decoration: none;
        }

        .mt-4 { margin-top: 3rem; }
        .mb-2 { margin-bottom: 1rem; }
    </style>
</head>

<body>
<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="logo">Admin</div>
        <nav>
            <ul>
                <li><a href="/admin/dashboard">Tableau de bord</a></li>
                <li><a href="/admin/users">Utilisateurs</a></li>
                <li><a href="/admin/quiz-questions" class="active">Quiz</a></li>
                <li><a href="/admin/produits">Shop</a></li>
                <li><a href="/admin/challenges">Défis</a></li>
            </ul>
        </nav>
    </aside>

    <!-- CONTENT -->
    <main class="admin-content">

        <div class="admin-header">
            <h1>Gestion des Questions Quiz</h1>
        </div>

        <!-- SEARCH AND SORT -->
        <div style="margin-bottom: 2rem; display: flex; gap: 1rem; align-items: flex-end;">
            <form method="GET" style="display: flex; gap: 1rem; align-items: flex-end; flex: 1;">
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 0.5rem; color: #E6FFF6; font-size: 0.9rem;">Rechercher</label>
                    <input type="text" name="q" value="{{ search | default('') }}" 
                        placeholder="Rechercher une question, option ou tag" 
                        style="width: 100%; padding: 0.5rem; background-color: #0B0F0E; border: 1px solid #2A3139; border-radius: 4px; color: #E6FFF6;">
                </div>
                
                <div>
                    <label style="display: block; margin-bottom: 0.5rem; color: #E6FFF6; font-size: 0.9rem;">Trier par</label>
                    <select name="sort" style="padding: 0.5rem; background-color: #0B0F0E; border: 1px solid #2A3139; border-radius: 4px; color: #E6FFF6;">
                        <option value="createdAt_desc" {% if sort == 'createdAt_desc' %}selected{% endif %}>Plus récent</option>
                        <option value="createdAt_asc" {% if sort == 'createdAt_asc' %}selected{% endif %}>Plus ancien</option>
                    </select>
                </div>
                
                <button type="submit" style="padding: 0.5rem 1rem; background-color: #18E3A4; color: #0B0F0E; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">Rechercher</button>
                {% if search %}
                    <a href="{{ path('admin_quiz_questions') }}" style="padding: 0.5rem 1rem; background-color: #2A3139; color: #E6FFF6; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block;">Réinitialiser</a>
                {% endif %}
            </form>
        </div>

        <!-- QUESTIONS TABLE -->
        <div class="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Question</th>
                    <th>Créée le</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% if questions | length > 0 %}
                    {% for question in questions %}
                    <tr>
                        <td>#{{ question.id }}</td>
                        <td>{{ question.question }}</td>
                        <td>{{ question.createdAt | date('Y-m-d H:i') }}</td>
                        <td class="action-buttons">
                            <a href="{{ path('admin_quiz_questions_edit', {id: question.id}) }}" class="btn-edit">Éditer</a>
                            <form method="POST" action="{{ path('admin_quiz_questions_delete', {id: question.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_question_' ~ question.id) }}">
                                <button type="submit" class="btn-delete" onclick="return confirm('Êtes-vous sûr ?');">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="4" style="text-align:center;color:#B0B9B6;">Aucune question trouvée</td>
                    </tr>
                {% endif %}
                </tbody>
                </tbody>
            </table>
        </div>

        <!-- ANSWERS TABLE -->
        <div class="table-wrapper mt-4">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Option</th>
                    <th>Tag</th>
                    <th>Question ID</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% if reponses | length > 0 %}
                    {% for reponse in reponses %}
                    <tr>
                        <td>#{{ reponse.id }}</td>
                        <td>{{ reponse.option }}</td>
                        <td>{{ reponse.tag }}</td>
                        <td>#{{ reponse.question.id }}</td>
                        <td class="action-buttons">
                            <a href="{{ path('admin_quiz_reponses_edit', {id: reponse.id}) }}" class="btn-edit">Éditer</a>
                            <form method="POST" action="{{ path('admin_quiz_reponses_delete', {id: reponse.id}) }}" style="display:inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_reponse_' ~ reponse.id) }}">
                                <button type="submit" class="btn-delete" onclick="return confirm('Êtes-vous sûr ?');">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="5" style="text-align:center;color:#B0B9B6;">Aucune réponse trouvée</td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
        </div>

        <!-- FORMS -->
        <section class="mt-4">
            {% if errors is defined and errors | length > 0 %}
                <div style="background-color:#BD3B44;color:#E6FFF6;padding:1rem;border-radius:4px;margin-bottom:2rem;">
                    <h4>Erreurs de validation:</h4>
                    <ul>
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                    </ul>
                </div>
            {% endif %}

            <h2>{% if editQuestion | default(false) %}Modifier une question{% else %}Ajouter une question{% endif %}</h2>

            <form method="POST" action="{{ editQuestion | default(false) ? path('admin_quiz_questions_update', {id: editQuestion.id}) : path('admin_quiz_questions_create') }}">
                <div class="mb-2">
                    <label>Question</label>
                    <textarea class="form-control" name="question" rows="3" required>{{ editQuestion.question | default('') }}</textarea>
                </div>
                <button type="submit" class="btn btn-primary">{% if editQuestion | default(false) %}Modifier la question{% else %}Ajouter la question{% endif %}</button>
            </form>

            <hr style="margin:2rem 0; opacity:.1">

            <h2>{% if editReponse | default(false) %}Modifier une réponse{% else %}Ajouter une réponse{% endif %}</h2>

            <form method="POST" action="{{ editReponse | default(false) ? path('admin_quiz_reponses_update', {id: editReponse.id}) : path('admin_quiz_reponses_create') }}">
                <div class="mb-2">
                    <label>Option</label>
                    <input class="form-control" type="text" name="option" value="{{ editReponse.option | default('') }}" required>
                </div>

                <div class="mb-2">
                    <label>Tag</label>
                    <input class="form-control" type="text" name="tag" value="{{ editReponse.tag | default('') }}" required>
                </div>

                <div class="mb-2">
                    <label>Question</label>
                    <select class="form-control" name="question_id" required>
                        <option value="">-- Sélectionner une question --</option>
                        {% for question in questions %}
                            <option value="{{ question.id }}" {% if editReponse | default(false) and editReponse.question.id == question.id %}selected{% endif %}>#{{ question.id }} - {{ question.question }}</option>
                        {% endfor %}
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">{% if editReponse | default(false) %}Modifier la réponse{% else %}Ajouter la réponse{% endif %}</button>
            </form>
        </section>

    </main>
</div>
</body>
</html>
