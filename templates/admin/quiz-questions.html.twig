<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Questions Quiz - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">

    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-bg: #1A1F1E;
            --accent: #18E3A4;
            --muted: #B0B9B6;
            --panel-bg: #0B0F0E;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { height: 100%; margin: 0; padding: 0; overflow-x: hidden; }

        .admin-layout { display: flex; min-height: 100vh; }

        .admin-sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            border-right: 1px solid #2A3139;
            padding: 2rem 0;
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .admin-sidebar .logo {
            padding: 1rem 1.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #2A3139;
            color: var(--accent);
            font-weight: 700;
            font-size: 1.2rem;
        }

        .admin-sidebar nav ul { list-style: none; padding: 0; margin: 0; }

        .admin-sidebar nav a {
            display: block;
            padding: 12px 1.5rem;
            color: var(--muted);
            text-decoration: none;
            border-left: 3px solid transparent;
        }

        .admin-sidebar nav a:hover,
        .admin-sidebar nav a.active {
            background-color: #0B0F0E;
            color: var(--accent);
            border-left-color: var(--accent);
            font-weight: 600;
        }

        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2rem;
            min-height: 100vh;
            overflow-y: auto;
        }

        .admin-header {
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #2A3139;
        }

        .admin-header h1 {
            margin: 0;
            color: var(--accent);
        }

        .table-wrapper {
            background-color: #1A1F1E;
            border-radius: 6px;
            overflow: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: var(--panel-bg);
            padding: 1rem 1.5rem;
            color: var(--accent);
            text-align: left;
            border-bottom: 1px solid #2A3139;
        }

        td {
            padding: 1rem 1.5rem;
            color: #E6FFF6;
            border-bottom: 1px solid #2A3139;
        }

        tr:hover { background-color: #252A29; }

        .action-buttons { display: flex; gap: 0.5rem; }

        .btn-edit {
            background-color: var(--accent);
            color: #0B0F0E;
            padding: 4px 12px;
            border-radius: 3px;
            text-decoration: none;
        }

        .btn-delete {
            background-color: #BD3B44;
            color: #E6FFF6;
            padding: 4px 12px;
            border-radius: 3px;
            text-decoration: none;
        }

        .mt-4 { margin-top: 3rem; }
        .mb-2 { margin-bottom: 1rem; }
    </style>
</head>

<body>
<div class="admin-layout">

    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="logo">Admin</div>
        <nav>
            <ul>
                <li><a href="/admin/dashboard">Tableau de bord</a></li>
                <li><a href="/admin/users">Utilisateurs</a></li>
                <li><a href="/admin/quiz-questions" class="active">Quiz</a></li>
                <li><a href="/admin/produits">Shop</a></li>
                <li><a href="/admin/challenges">Défis</a></li>
            </ul>
        </nav>
    </aside>

    <!-- CONTENT -->
    <main class="admin-content">

        <div class="admin-header">
            <h1>Gestion des Questions Quiz</h1>
        </div>

        <!-- QUESTIONS TABLE -->
        <div class="table-wrapper">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Question</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>#1</td>
                    <td>Quel type d’univers préférez-vous ?</td>
                    <td>2026-01-10</td>
                    <td class="action-buttons">
                        <a href="#" class="btn-edit">Éditer</a>
                        <a href="#" class="btn-delete">Supprimer</a>
                    </td>
                </tr>
                <tr>
                    <td>#2</td>
                    <td>Quel genre de personnage créeriez-vous ?</td>
                    <td>2026-01-12</td>
                    <td class="action-buttons">
                        <a href="#" class="btn-edit">Éditer</a>
                        <a href="#" class="btn-delete">Supprimer</a>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- ANSWERS TABLE -->
        <div class="table-wrapper mt-4">
            <table>
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Option</th>
                    <th>Tag</th>
                    <th>ID Question</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>#A1</td>
                    <td>Fantasy sombre</td>
                    <td>dark-fantasy</td>
                    <td>#1</td>
                    <td class="action-buttons">
                        <a href="#" class="btn-edit">Éditer</a>
                        <a href="#" class="btn-delete">Supprimer</a>
                    </td>
                </tr>
                <tr>
                    <td>#A2</td>
                    <td>Univers lumineux</td>
                    <td>high-fantasy</td>
                    <td>#1</td>
                    <td class="action-buttons">
                        <a href="#" class="btn-edit">Éditer</a>
                        <a href="#" class="btn-delete">Supprimer</a>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>

        <!-- FORMS -->
        <section class="mt-4">
            <h2>Ajouter une question</h2>

            <div class="mb-2">
                <label>Question</label>
                <textarea class="form-control" rows="3"></textarea>
            </div>


            <hr style="margin:2rem 0; opacity:.1">

            <h2>Ajouter une réponse</h2>

            <div class="mb-2">
                <label>Option</label>
                <input class="form-control" type="text">
            </div>

            <div class="mb-2">
                <label>Tag</label>
                <input class="form-control" type="text">
            </div>

            <div class="mb-2">
                <label>ID Question</label>
                <select class="form-control">
                    <option>#1</option>
                    <option>#2</option>
                </select>
            </div>
        </section>

    </main>
</div>
</body>
</html>
