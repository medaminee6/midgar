<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestion des Univers - Admin</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0B0F0E;
            --bg-panel: #141A19;
            --bg-soft: #1A1F1E;
            --bg-card: #1E2423;
            --border: #2A3139;
            --border-light: #3A424A;
            --border-hover: #4A5259;
            --accent: #18E3A4;
            --accent-dark: #13c891;
            --accent-light: rgba(24,227,164,0.12);
            --accent-glow: rgba(24,227,164,0.25);
            --text-main: #E6FFF6;
            --text-light: #CBD5D1;
            --text-muted: #9BA6A2;
            --sidebar-width: 280px;
            --radius: 12px;
        }
        
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Arial, sans-serif; background: var(--bg-main); color: var(--text-main); }
        
        .admin-layout { display: flex; min-height: 100vh; gap: 0; }
        
        .admin-sidebar { 
            width: var(--sidebar-width); 
            background: linear-gradient(180deg, #0B0F0E 0%, #161C1B 100%); 
            border-right: 1px solid var(--border); 
            padding: 2.5rem 0; 
            position: fixed; 
            left: 0; 
            top: 0; 
            height: 100vh; 
            z-index: 100; 
            transition: all 0.3s ease; 
            backdrop-filter: blur(10px);
        }
        
        .sidebar-logo { 
            padding: 0 1.5rem 1.5rem; 
            margin-bottom: 2.5rem; 
            border-bottom: 1px solid var(--border-light); 
            display: flex; 
            align-items: center; 
            gap: 1rem;
        }
        
        .logo-icon { 
            font-size: 1.8rem; 
            color: var(--accent); 
            filter: drop-shadow(0 0 10px var(--accent-glow));
        }
        
        .logo-text { 
            font-size: 1.4rem; 
            font-weight: 800; 
            color: var(--accent); 
            letter-spacing: -0.5px;
        }
        
        .admin-sidebar ul { list-style: none; }
        
        .admin-sidebar a { 
            display: flex; 
            align-items: center; 
            gap: 1rem; 
            padding: 1rem 1.5rem; 
            color: var(--text-muted); 
            text-decoration: none; 
            border-left: 3px solid transparent; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            position: relative; 
            margin: 0.25rem 0; 
            font-weight: 500;
        }
        
        .admin-sidebar a i { 
            width: 20px; 
            text-align: center; 
            font-size: 1.1rem; 
            transition: all 0.3s ease;
        }
        
        .admin-sidebar a::before { 
            content: ""; 
            position: absolute; 
            left: 0; 
            top: 0; 
            height: 100%; 
            width: 0; 
            background: linear-gradient(90deg, var(--accent-light), transparent); 
            transition: width 0.4s ease; 
            z-index: -1;
        }
        
        .admin-sidebar a:hover::before,
        .admin-sidebar a.active::before { 
            width: 100%;
        }
        
        .admin-sidebar a:hover,
        .admin-sidebar a.active { 
            color: var(--accent); 
            border-left-color: var(--accent); 
            font-weight: 600;
        }
        
        .admin-sidebar a:hover i,
        .admin-sidebar a.active i { 
            transform: scale(1.1); 
            filter: drop-shadow(0 0 5px var(--accent-glow));
        }
        
        .admin-content { margin-left: var(--sidebar-width); padding: 2rem; }
        .admin-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #2A3139; }
        .admin-header h1 { margin: 0; color: #18E3A4; }
        .table-wrapper { background-color: #1A1F1E; border-radius: 6px; overflow: hidden; }
        .table-wrapper table { width: 100%; border-collapse: collapse; }
        .table-wrapper th { background-color: #0B0F0E; padding: 1rem 1.5rem; text-align: left; color: #18E3A4; font-weight: 600; border-bottom: 1px solid #2A3139; }
        .table-wrapper td { padding: 1rem 1.5rem; border-bottom: 1px solid #2A3139; color: #E6FFF6; }
        .table-wrapper tr:hover { background-color: #252A29; }
        .badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
        .badge-active { background-color: rgba(24, 227, 164, 0.2); color: #18E3A4; }
        .action-buttons { display: flex; gap: 0.5rem; }
        .action-buttons a { padding: 4px 12px; font-size: 0.85rem; text-decoration: none; border-radius: 3px; }
        .btn-edit { background-color: #18E3A4; color: #0B0F0E; }
        .btn-delete { background-color: #BD3B44; color: #E6FFF6; }
    </style>
</head>
<body style="margin: 0;">
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="sidebar-logo">
                <div class="logo-icon">⚡</div>
                <div class="logo-text">Midgar Admin</div>
            </div>
            <ul>
                <li><a href="/admin/dashboard"><i class="fas fa-chart-line"></i><span>Dashboard</span></a></li>
                <li><a href="/admin/users"><i class="fas fa-users"></i><span>Utilisateurs</span></a></li>
                <li><a href="/admin/quiz-questions"><i class="fas fa-question-circle"></i><span>Quiz</span></a></li>
                <li><a href="/admin/produits"><i class="fas fa-shopping-cart"></i><span>Shop</span></a></li>
                <li><a href="/admin/challenges"><i class="fas fa-trophy"></i><span>Défis</span></a></li>
            </ul>
        </aside>

        <div class="admin-content">
            <div class="admin-header">
                <h1>Gestion des Univers</h1>
                <button class="btn btn-primary btn-sm">+ Ajouter Univers</button>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Créateur</th>
                            <th>Genre</th>
                            <th>Contenus</th>
                            <th>Favoris</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#1</td>
                            <td>Nuit Éternelle</td>
                            <td>Léa Mage</td>
                            <td>Sombre</td>
                            <td>42</td>
                            <td>1,240</td>
                            <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a><a href="#" class="btn-delete">Supprimer</a></div></td>
                        </tr>
                        <tr>
                            <td>#2</td>
                            <td>Châteaux Flottants</td>
                            <td>Léa Mage</td>
                            <td>Épic</td>
                            <td>38</td>
                            <td>892</td>
                            <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a><a href="#" class="btn-delete">Supprimer</a></div></td>
                        </tr>
                        <tr>
                            <td>#3</td>
                            <td>Dragons de Lumière</td>
                            <td>Alexis Shadowborn</td>
                            <td>Aventure</td>
                            <td>28</td>
                            <td>654</td>
                            <td><div class="action-buttons"><a href="#" class="btn-edit">Éditer</a><a href="#" class="btn-delete">Supprimer</a></div></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
