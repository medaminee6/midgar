<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Éditer Produit - Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --bg-main: #0B0F0E;
            --bg-panel: #141A19;
            --bg-soft: #1A1F1E;
            --bg-card: #1E2423;
            --border: #2A3139;
            --border-light: #3A424A;
            --border-hover: #4A5259;

            --accent: #18E3A4;
            --accent-dark: #13c891;
            --accent-light: rgba(24,227,164,0.12);
            --accent-glow: rgba(24,227,164,0.25);
            --danger: #EF5350;
            --danger-light: rgba(239,83,80,0.12);
            --warning: #FFA726;
            --warning-light: rgba(255,167,38,0.12);
            --info: #42A5F5;
            --info-light: rgba(66,165,245,0.12);
            --success: #66BB6A;
            --purple: #AB47BC;

            --text-main: #E6FFF6;
            --text-light: #CBD5D1;
            --text-muted: #9BA6A2;
            --text-placeholder: #7A8580;

            --sidebar-width: 280px;
            --radius: 12px;
            --radius-lg: 16px;
            --radius-xl: 20px;
            --shadow: 0 10px 25px rgba(0,0,0,0.3);
            --shadow-lg: 0 15px 35px rgba(0,0,0,0.4);
            --shadow-xl: 0 20px 50px rgba(0,0,0,0.5);
            --shadow-accent: 0 0 25px rgba(24,227,164,0.3);
            --shadow-hover: 0 10px 30px rgba(0,0,0,0.5);
            
            --transition: 0.25s;
        }

        * { 
            box-sizing: border-box; 
            margin: 0; 
            padding: 0; 
        }

        body {
            font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", Arial, sans-serif;
            background: var(--bg-main);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ===== LAYOUT ===== */
        .admin-layout {
            display: flex;
            min-height: 100vh;
            position: relative;
        }

        /* ===== SIDEBAR ===== */
        .admin-sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, #0B0F0E 0%, #161C1B 100%);
            border-right: 1px solid var(--border);
            padding: 2.5rem 0;
            position: fixed;
            height: 100vh;
            z-index: 100;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .sidebar-logo {
            padding: 0 1.5rem 1.5rem;
            margin-bottom: 2.5rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .logo-icon {
            font-size: 1.8rem;
            color: var(--accent);
            filter: drop-shadow(0 0 10px var(--accent-glow));
        }

        .logo-text {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--accent);
            letter-spacing: -0.5px;
        }

        .admin-sidebar ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .admin-sidebar a {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1rem 1.5rem;
            color: var(--text-muted);
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            margin: 0.25rem 0;
            font-weight: 500;
        }

        .admin-sidebar a i {
            width: 20px;
            text-align: center;
            font-size: 1.1rem;
            transition: all 0.3s ease;
        }

        .admin-sidebar a::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 0;
            background: linear-gradient(90deg, var(--accent-light), transparent);
            transition: width 0.4s ease;
            z-index: -1;
        }

        .admin-sidebar a:hover::before,
        .admin-sidebar a.active::before {
            width: 100%;
        }

        .admin-sidebar a:hover,
        .admin-sidebar a.active {
            color: var(--accent);
            border-left-color: var(--accent);
            font-weight: 600;
        }

        .admin-sidebar a:hover i,
        .admin-sidebar a.active i {
            transform: scale(1.1);
            filter: drop-shadow(0 0 5px var(--accent-glow));
        }

        /* ===== CONTENT ===== */
        .admin-content {
            margin-left: var(--sidebar-width);
            padding: 2.5rem 3rem;
            width: calc(100% - var(--sidebar-width));
            min-height: 100vh;
            background: linear-gradient(135deg, var(--bg-main) 0%, #0F1413 100%);
            position: relative;
        }

        .admin-content::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent), transparent);
            z-index: 1;
        }

        /* ===== HEADER ===== */
        .page-header {
            margin-bottom: 2.5rem;
            position: relative;
        }

        .page-title {
            font-size: 2.2rem;
            color: var(--accent);
            margin-bottom: 0.5rem;
            font-weight: 800;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 1rem;
            text-shadow: 0 2px 10px rgba(0,0,0,0.3);
        }

        .page-title i {
            font-size: 2rem;
            filter: drop-shadow(0 0 8px var(--accent-glow));
        }

        .page-subtitle {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-left: 3.5rem;
        }

        /* ===== FORM CARD ===== */
        .form-card {
            background: linear-gradient(135deg, var(--bg-card), var(--bg-soft));
            border-radius: var(--radius-lg);
            padding: 2.5rem;
            max-width: 700px;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-light);
            transition: all 0.4s ease;
            animation: cardAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            backdrop-filter: blur(10px);
        }

        .form-card:hover {
            box-shadow: var(--shadow-xl);
            border-color: var(--border-hover);
            transform: translateY(-4px);
        }

        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border-light);
        }

        .form-header i {
            font-size: 1.8rem;
            color: var(--accent);
            background: var(--accent-light);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .form-title {
            font-size: 1.8rem;
            color: var(--text-main);
            font-weight: 700;
        }

        .form-subtitle {
            color: var(--accent);
            font-weight: 600;
            font-size: 1.1rem;
        }

        /* ===== FORM ELEMENTS ===== */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            margin-bottom: 0.75rem;
            color: var(--text-light);
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .form-label i {
            color: var(--accent);
            font-size: 0.9rem;
        }

        .form-control {
            width: 100%;
            padding: 0.85rem 1.25rem;
            background-color: var(--bg-panel);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            color: var(--text-main);
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--accent);
            box-shadow: 0 0 0 3px var(--accent-light);
        }

        textarea.form-control {
            min-height: 120px;
            resize: vertical;
        }

        /* ===== BUTTONS ===== */
        .btn-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            margin-top: 2rem;
        }

        .btn {
            padding: 0.85rem 2rem;
            border-radius: var(--radius);
            border: none;
            cursor: pointer;
            font-weight: 700;
            font-size: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            text-decoration: none;
            position: relative;
            overflow: hidden;
            min-width: 140px;
        }

        .btn i {
            font-size: 1.1rem;
            transition: transform 0.3s ease;
        }

        .btn:hover i {
            transform: scale(1.1);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            color: #000;
            box-shadow: 0 4px 15px rgba(24,227,164,0.3);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24,227,164,0.4);
        }

        .btn-secondary {
            background: rgba(42,49,57,0.8);
            color: var(--text-main);
            border: 1px solid var(--border);
        }

        .btn-secondary:hover {
            background: #2A3139;
            transform: translateY(-3px);
        }

        /* ===== BADGE ===== */
        .badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            border: 1px solid transparent;
        }

        .badge-accent {
            background: var(--accent-light);
            color: var(--accent);
            border-color: rgba(24,227,164,0.3);
        }

        .badge-danger {
            background: rgba(239,83,80,0.15);
            color: var(--danger);
            border-color: rgba(239,83,80,0.3);
        }

        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-main);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 10px;
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--border-light);
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 992px) {
            .admin-sidebar {
                width: 80px;
                padding: 1.5rem 0;
            }
            
            .admin-sidebar .logo-text,
            .admin-sidebar a span {
                display: none;
            }
            
            .admin-sidebar a {
                justify-content: center;
                padding: 1rem;
            }
            
            .admin-content {
                margin-left: 80px;
                padding: 2rem;
            }
            
            .page-title {
                font-size: 1.8rem;
            }
        }

        @media (max-width: 768px) {
            .btn-group {
                flex-direction: column;
            }
            
            .btn {
                width: 100%;
            }
            
            .form-card {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>

<div class="admin-layout">
    <!-- SIDEBAR -->
    <aside class="admin-sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">Midgar Admin</div>
        </div>
        <ul>
            <li><a href="{{ path('admin_users') }}"><i class="fas fa-users"></i><span>Utilisateurs</span></a></li>
            <li><a href="{{ path('admin_quiz_questions') }}"><i class="fas fa-question-circle"></i><span>Quiz</span></a></li>
            <li><a href="{{ path('admin_produits') }}" class="active"><i class="fas fa-shopping-cart"></i><span>Shop</span></a></li>
            <li><a href="{{ path('admin_challenges') }}"><i class="fas fa-trophy"></i><span>Défis</span></a></li>
        </ul>
    </aside>

    <!-- CONTENT -->
    <main class="admin-content">
        <!-- PAGE HEADER -->
        <div class="page-header">
            <h1 class="page-title"><i class="fas fa-edit"></i> Éditer Produit</h1>
            <p class="page-subtitle">Modifier les informations du produit #{{ produit.id }}</p>
        </div>

        <!-- FORM CARD -->
        <div class="form-card">
            <div class="form-header">
                <i class="fas fa-box"></i>
                <div>
                    <div class="form-title">{{ produit.nomProduit }}</div>
                    <div class="form-subtitle">Modifiez les détails du produit</div>
                </div>
            </div>
            
            <form method="POST" action="{{ path('admin_produits_edit', {id: produit.id}) }}">
                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-tag"></i> Nom du produit
                    </label>
                    <input type="text" name="nom_produit" value="{{ produit.nomProduit }}" class="form-control" required placeholder="Ex: Épée de Cristal">
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-align-left"></i> Description
                    </label>
                    <textarea name="description" class="form-control" rows="4" required>{{ produit.description }}</textarea>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-euro-sign"></i> Prix
                    </label>
                    <input type="number" name="prix" step="0.01" value="{{ produit.prix }}" class="form-control" required placeholder="0.00">
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-layer-group"></i> Type
                    </label>
                    <input type="text" name="type_produit" value="{{ produit.typeProduit }}" class="form-control" required placeholder="Ex: Artefact, Livre, Collection...">
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="fas fa-cubes"></i> Quantité disponible
                    </label>
                    <input type="number" name="quantite_disponible" value="{{ produit.quantiteDisponible }}" class="form-control" required placeholder="0">
                    {% if produit.quantiteDisponible == 0 %}
                        <span class="badge badge-danger" style="margin-top: 0.5rem;">⚠️ Rupture de stock</span>
                    {% endif %}
                </div>

                <div class="btn-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Enregistrer
                    </button>
                    <a href="{{ path('admin_produits') }}" class="btn btn-secondary">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                </div>
            </form>
        </div>
    </main>
</div>

<script>
    // Animation du formulaire
    document.addEventListener('DOMContentLoaded', function() {
        const formCard = document.querySelector('.form-card');
        if (formCard) {
            formCard.style.animation = 'cardAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
        }
    });

    // Focus sur les inputs
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('focus', function() {
            this.style.boxShadow = '0 0 0 3px rgba(24,227,164,0.2)';
        });
        
        input.addEventListener('blur', function() {
            this.style.boxShadow = '';
        });
    });
</script>

</body>
</html>