<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz de Préférences - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">

    <!-- QUIZ OPTIONS STYLING -->
    <style>
        /* === QUIZ OPTIONS GRID === */
        .quiz-options {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .quiz-options input[type="radio"] {
            display: none;
        }

        .quiz-option {
            position: relative;
            padding: 1.25rem 1.5rem;
            background-color: #0B0F0E;
            border: 2px solid #2A3139;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
            color: #E6FFF6;
            min-height: 90px;
            display: flex;
            align-items: center;
        }

        .quiz-option:hover {
            transform: translateY(-3px);
            border-color: #18E3A4;
            box-shadow: 0 10px 25px rgba(24, 227, 164, 0.15);
        }

        .quiz-options input[type="radio"]:checked + .quiz-option {
            background: linear-gradient(135deg, rgba(24,227,164,0.14), rgba(24,227,164,0.05));
            border-color: #18E3A4;
            box-shadow: 0 0 0 1px rgba(24,227,164,0.6), 0 12px 30px rgba(24,227,164,0.25);
        }

        .quiz-option::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 4px;
            background: #18E3A4;
            opacity: 0;
            border-radius: 10px 0 0 10px;
            transition: opacity 0.25s ease;
        }

        .quiz-options input[type="radio"]:checked + .quiz-option::before {
            opacity: 1;
        }

        /* === PERSONALIZE FEED LINK === */
        .personalize-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.95rem;
            color: #B0B9B6;
        }

        .personalize-link a {
            color: #18E3A4;
            text-decoration: none;
            border-bottom: 1px solid rgba(24,227,164,0.4);
            padding-bottom: 2px;
            transition: color 0.25s ease, border-color 0.25s ease, text-shadow 0.25s ease;
        }

        .personalize-link a:hover {
            color: #E6FFF6;
            border-bottom-color: #18E3A4;
            text-shadow: 0 0 8px rgba(24,227,164,0.6);
        }

        @media (max-width: 640px) {
            .quiz-options {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
<header>
    <div class="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
            <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
            <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
            <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
            <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
            <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
        </svg>
        Midgar
    </div>

    <nav>
        <ul>
            <li><a href="/">Accueil</a></li>
            <li><a href="/discover">Découvrir</a></li>
            <li><a href="/universes">Univers</a></li>
            <li><a href="/oeuvre">Œuvre</a></li>
            <li><a href="/shop">Boutique</a></li>
            <li><a href="/challenges">Défis</a></li>
        </ul>
    </nav>

    <div class="auth-buttons">
        <a href="/login" class="btn btn-secondary btn-sm">Connexion</a>
        <a href="/register" class="btn btn-primary btn-sm">S'inscrire</a>
    </div>
</header>

<main>
<section class="section">
<div class="container">
<div style="max-width: 700px; margin: 0 auto;">

    <h1 class="text-center mb-4">Quiz de Préférences</h1>
    <p class="text-center mb-4" style="color:#B0B9B6;font-size:1.1rem;">
        Découvrez vos préférences en création fantasy
    </p>

    <div id="quiz-container" style="background-color:#1A1F1E;padding:2rem;border-radius:8px;border:1px solid #2A3139;">

        <div class="quiz-question">
            <h3 style="margin-bottom:1.5rem;">
                {{ question.question }}
            </h3>

            <div class="quiz-options">
                {% for reponse in reponses %}
                <input type="radio" id="reponse-{{ reponse.id }}" name="reponse" value="{{ reponse.id }}">
                <label for="reponse-{{ reponse.id }}" class="quiz-option">
                    {{ reponse.option }}
                </label>
                {% endfor %}
            </div>
        </div>

        <div style="margin-top:2rem;">
            <div style="background:#0B0F0E;height:4px;border-radius:2px;overflow:hidden;">
                <div style="background:linear-gradient(90deg,#18E3A4,#0DCF92);height:100%;width:{{ (step / total * 100) | round }}%;"></div>
            </div>
            <p style="text-align:center;font-size:0.9rem;color:#B0B9B6;margin-top:0.5rem;">
                Question {{ step }} de {{ total }}
            </p>
        </div>

        <!-- NAVIGATION -->
        <div style="display:flex;gap:1rem;margin-top:2rem;justify-content:space-between;">
            {% if step > 1 %}
                <a href="{{ path('quiz', {step: step - 1}) }}" class="btn btn-secondary">Précédent</a>
            {% else %}
                <button class="btn btn-secondary" disabled>Précédent</button>
            {% endif %}
            
            {% if step < total %}
                <a href="{{ path('quiz', {step: step + 1}) }}" class="btn btn-primary">Suivant</a>
            {% else %}
                <a href="{{ path('quiz', {step: 1}) }}" class="btn btn-primary">Terminer</a>
            {% endif %}
        </div>

        <!-- PERSONALIZE FEED -->
        <div class="personalize-link">
            ou <a href="/preferences/advanced">personnaliser ton feed</a>
        </div>

    </div>

</div>
</div>
</section>
</main>

<footer>
    <div class="container">
        <div class="footer-bottom">
            <p>&copy; 2026 Midgar Fantasy Platform</p>
        </div>
    </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
