{% extends "base.html.twig" %}

{% block title %}Page non trouvée - Midgar{% endblock %}

{% block content %}
<div class="error-container">
    <div class="error-content">
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Page non trouvée</h2>
        <p class="error-message">
            La page que vous recherchez n'existe pas ou a été déplacée.
        </p>
        {% if requestedPage is defined %}
            <p class="error-detail">
                Page demandée: <code>{{ requestedPage }}</code>
            </p>
        {% endif %}
        <div class="error-actions">
            <a href="/" class="btn btn-primary">Retour à l'accueil</a>
            <a href="/shop" class="btn btn-secondary">Aller à la boutique</a>
        </div>
    </div>
</div>

