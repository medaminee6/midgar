{% extends "base.html.twig" %}

{% block title %}Page non trouvée - Midgar{% endblock %}

{% block content %}
<div class="error-container">
    <div class="error-content">
        <h1 class="error-code">404</h1>
        <h2 class="error-title">Page non trouvée</h2>
        <p class="error-message">
            La page que vous recherchez n'existe pas ou a été déplacée.
        </p>
        {% if requestedPage is defined %}
            <p class="error-detail">
                Page demandée: <code>{{ requestedPage }}</code>
            </p>
        {% endif %}
        <div class="error-actions">
            <a href="/" class="btn btn-primary">Retour à l'accueil</a>
            <a href="/shop" class="btn btn-secondary">Aller à la boutique</a>
        </div>
    </div>
</div>

<style>
    .error-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 2rem;
    }
    
    .error-content {
        text-align: center;
        max-width: 500px;
    }
    
    .error-code {
        font-size: 6rem;
        font-weight: bold;
        color: #18E3A4;
        margin-bottom: 0.5rem;
    }
    
    .error-title {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #333;
    }
    
    .error-message {
        font-size: 1.1rem;
        color: #666;
        margin-bottom: 2rem;
    }
    
    .error-detail {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 5px;
        margin-bottom: 2rem;
        border-left: 4px solid #18E3A4;
    }
    
    .error-detail code {
        color: #d63384;
        font-family: monospace;
    }
    
    .error-actions {
        display: flex;
        gap: 1rem;
        justify-content: center;
        flex-wrap: wrap;
    }
</style>
{% endblock %}
