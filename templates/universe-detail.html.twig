<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détail Univers - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .hero-banner { width: 100%; height: 300px; background: linear-gradient(135deg, #18E3A4, #0DCF92); display: flex; align-items: center; justify-content: center; font-size: 3rem; margin: 0 0 2rem 0; }
        .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
        .universe-header { display: grid; grid-template-columns: 1fr 250px; gap: 2rem; margin-bottom: 2rem; }
        .universe-info h1 { font-size: 2.5rem; margin: 0 0 0.5rem 0; text-transform: uppercase; }
        .genre-badges { display: flex; gap: 0.5rem; margin: 1rem 0; flex-wrap: wrap; }
        .genre-badge { padding: 6px 14px; background-color: #18E3A4; color: #0B0F0E; border-radius: 20px; font-size: 0.85rem; font-weight: 600; }
        .universe-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1rem; }
        .action-btn { padding: 10px 20px; border: 2px solid #18E3A4; background-color: transparent; color: #18E3A4; border-radius: 4px; cursor: pointer; font-weight: 600; transition: all 0.3s; }
        .action-btn:hover, .action-btn.primary:hover { background-color: #0DCF92; border-color: #0DCF92; }
        .action-btn.primary { background-color: #18E3A4; color: #0B0F0E; }
        .content-wrapper { display: grid; grid-template-columns: 1fr 280px; gap: 2rem; }
        .main-content { background-color: #1A1F1E; border: 1px solid #2A3139; border-radius: 8px; padding: 2rem; }
        .tabs { display: flex; gap: 0; border-bottom: 2px solid #2A3139; margin-bottom: 2rem; }
        .tab-btn { padding: 1rem 1.5rem; background: none; border: none; color: #B0B9B6; cursor: pointer; font-weight: 600; border-bottom: 3px solid transparent; transition: all 0.3s; }
        .tab-btn.active { color: #18E3A4; border-bottom-color: #18E3A4; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .content-items { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
        .item-card { background-color: #0B0F0E; padding: 1rem; border-radius: 6px; border: 1px solid #2A3139; text-align: center; }
        .item-emoji { font-size: 2rem; margin-bottom: 0.5rem; }
        .item-name { font-weight: 600; color: #E6FFF6; margin-bottom: 0.25rem; }
        .item-creator { font-size: 0.75rem; color: #B0B9B6; }
        .creator-card { background-color: #0B0F0E; border: 1px solid #2A3139; border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem; }
        .creator-avatar { width: 60px; height: 60px; border-radius: 50%; background-color: #18E3A4; display: flex; align-items: center; justify-content: center; color: #0B0F0E; font-weight: 700; font-size: 1.5rem; margin-bottom: 1rem; }
        .creator-name { font-weight: 600; margin-bottom: 0.25rem; }
        .creator-username { font-size: 0.9rem; color: #B0B9B6; margin-bottom: 1rem; }
        .follow-btn { width: 100%; padding: 0.75rem; background-color: #18E3A4; color: #0B0F0E; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; transition: all 0.3s; }
        .follow-btn:hover { background-color: #0DCF92; }
        .related-card { background-color: #1A1F1E; padding: 1rem; border-radius: 6px; border: 1px solid #2A3139; margin-bottom: 1rem; cursor: pointer; transition: all 0.3s; }
        .related-card:hover { border-color: #18E3A4; }
        .related-emoji { font-size: 1.5rem; margin-bottom: 0.5rem; }
        .related-title { font-weight: 600; color: #E6FFF6; margin-bottom: 0.25rem; }
        .related-genre { font-size: 0.75rem; color: #18E3A4; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin: 2rem 0; }
        .stat { text-align: center; padding: 1rem; background-color: #1A1F1E; border-radius: 6px; border: 1px solid #2A3139; }
        .stat-value { font-size: 1.5rem; font-weight: 700; color: #18E3A4; }
        .stat-label { font-size: 0.85rem; color: #B0B9B6; margin-top: 0.5rem; }
        @media (max-width: 768px) { .universe-header { grid-template-columns: 1fr; } .content-wrapper { grid-template-columns: 1fr; } .content-items { grid-template-columns: 1fr; } .stats { grid-template-columns: repeat(2, 1fr); } }
    </style>
</head>
<body>
    <header style="background-color: #1A1F1E; border-bottom: 2px solid #2A3139; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center;">
        <div style="font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #18E3A4;">◆ Midgar</div>
        <nav style="display: flex; gap: 2rem;">
            <a href="/" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Accueil</a>
            <a href="/discover" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Découvrir</a>
            <a href="/universes" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Univers</a>
            <a href="/oeuvre" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Œuvre</a>
            <a href="/shop" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Boutique</a>
            <a href="/challenges" style="color: #B0B9B6; text-decoration: none; font-weight: 600; transition: all 0.3s;">Défis</a>
        </nav>
        <div>
            <a href="/login" style="padding: 0.6rem 1.2rem; border: 1px solid #18E3A4; color: #18E3A4; text-decoration: none; border-radius: 4px; font-weight: 600; font-size: 0.85rem;">Se connecter</a>
        </div>
    </header>

    <div class="hero-banner" id="heroBanner">🌙</div>

    <div class="container">
        <div class="universe-header">
            <div class="universe-info">
                <h1 id="universeName">Nuit Éternelle</h1>
                <div class="genre-badges" id="genreBadges">
                    <span class="genre-badge">Fantaisie Sombre</span>
                </div>
                <p id="universeDesc">Découvrez un monde où la nuit règne éternelle et les mystères sont plus puissants que la lumière.</p>
                <div class="universe-actions">
                    <button class="action-btn">Favoris</button>
                    <button class="action-btn primary">Suivre</button>
                    <button class="action-btn">Partager</button>
                </div>
            </div>
        </div>

        <div class="stats">
            <div class="stat">
                <div class="stat-value" id="personnagesCount">12</div>
                <div class="stat-label">Personnages</div>
            </div>
            <div class="stat">
                <div class="stat-value" id="oeuvresCount">28</div>
                <div class="stat-label">Œuvres</div>
            </div>
            <div class="stat">
                <div class="stat-value" id="artefactsCount">7</div>
                <div class="stat-label">Artefacts</div>
            </div>
            <div class="stat">
                <div class="stat-value" id="followersCount">1.2K</div>
                <div class="stat-label">Abonnés</div>
            </div>
        </div>

        <div class="content-wrapper">
            <div class="main-content">
                <div class="tabs">
                    <button class="tab-btn active" data-tab="apropos">À propos</button>
                    <button class="tab-btn" data-tab="personnages">Personnages</button>
                    <button class="tab-btn" data-tab="oeuvres">Œuvres</button>
                    <button class="tab-btn" data-tab="artefacts">Artefacts</button>
                    <button class="tab-btn" data-tab="lieux">Lieux</button>
                </div>

                <div id="apropos" class="tab-content active">
                    <h3>À propos de cet univers</h3>
                    <p>Faites l'expérience d'un univers où la nuit éternelle crée une ambiance mystérieuse et sombre. Chaque coin cache des secrets et des créatures fascinantes.</p>
                </div>

                <div id="personnages" class="tab-content">
                    <h3>Personnages Principaux</h3>
                    <div class="content-items">
                        <div class="item-card">
                            <div class="item-emoji">👸</div>
                            <div class="item-name">Reine des Ombres</div>
                            <div class="item-creator">Personnage principal</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">🧙</div>
                            <div class="item-name">Magicien Vétéran</div>
                            <div class="item-creator">Allié</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">🛡️</div>
                            <div class="item-name">Gardien Nocturne</div>
                            <div class="item-creator">Protecteur</div>
                        </div>
                    </div>
                </div>

                <div id="oeuvres" class="tab-content">
                    <h3>Œuvres &amp; Créations</h3>
                    <div class="content-items">
                        <div class="item-card">
                            <div class="item-emoji">📖</div>
                            <div class="item-name">Les Murs de Minuit</div>
                            <div class="item-creator">Histoire courte</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">🎨</div>
                            <div class="item-name">Palais Lunaire</div>
                            <div class="item-creator">Illustration</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">🎵</div>
                            <div class="item-name">Hymne de la Nuit</div>
                            <div class="item-creator">Composition</div>
                        </div>
                    </div>
                </div>

                <div id="artefacts" class="tab-content">
                    <h3>Artefacts Légendaires</h3>
                    <div class="content-items">
                        <div class="item-card">
                            <div class="item-emoji">💎</div>
                            <div class="item-name">Cristal de Lune</div>
                            <div class="item-creator">Artefact rare</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">⚔️</div>
                            <div class="item-name">Épée Nocturne</div>
                            <div class="item-creator">Artefact épique</div>
                        </div>
                    </div>
                </div>

                <div id="lieux" class="tab-content">
                    <h3>Lieux Importants</h3>
                    <div class="content-items">
                        <div class="item-card">
                            <div class="item-emoji">🏰</div>
                            <div class="item-name">Château de Midi</div>
                            <div class="item-creator">Forteresse principale</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">⛏️</div>
                            <div class="item-name">Mines d'Ombre</div>
                            <div class="item-creator">Souterrain magique</div>
                        </div>
                        <div class="item-card">
                            <div class="item-emoji">🌲</div>
                            <div class="item-name">Forêt Mélancolique</div>
                            <div class="item-creator">Sanctuaire antique</div>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <div class="creator-card">
                    <div class="creator-avatar">L</div>
                    <div class="creator-name">Léa Moretti</div>
                    <div class="creator-username">@leamoretti</div>
                    <p style="color: #B0B9B6; font-size: 0.9rem; margin-bottom: 1rem;">Créatrice de mondes avec une passion pour la fantasy sombre.</p>
                    <button class="follow-btn">Suivre</button>
                </div>

                <div style="background-color: #1A1F1E; border-radius: 8px; border: 1px solid #2A3139; padding: 1.5rem;">
                    <h3 style="margin: 0 0 1rem 0;">Univers relatifs</h3>
                    <div class="related-card" onclick="window.location.href='/universe-detail?id=9'">
                        <div class="related-emoji">🌑</div>
                        <div class="related-title">Domaine des Ombres</div>
                        <div class="related-genre">Sombre • 834 aimes</div>
                    </div>
                    <div class="related-card" onclick="window.location.href='/universe-detail?id=8'">
                        <div class="related-emoji">🌊</div>
                        <div class="related-title">Océan Enchanté</div>
                        <div class="related-genre">Haute Fantaisie • 645 aimes</div>
                    </div>
                    <div class="related-card" onclick="window.location.href='/universe-detail?id=5'">
                        <div class="related-emoji">🌲</div>
                        <div class="related-title">Forêt Éternelle</div>
                        <div class="related-genre">Haute Fantaisie • 756 aimes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer style="background-color: #1A1F1E; border-top: 2px solid #2A3139; padding: 2rem; margin-top: 4rem; text-align: center; color: #B0B9B6;">
        <p>&copy; 2025 Midgar. Created with ◆</p>
    </footer>

    <script>
        const universeData = {
            1: {name:"Nuit Éternelle",banner:"🌙",genre:"Fantaisie Sombre",desc:"Un monde où la nuit règne.",personnages:12,oeuvres:28,artefacts:7,followers:"1.2K"},
            2: {name:"Châteaux Flottants",banner:"☁️",genre:"Haute Fantaisie",desc:"Des châteaux volent dans le ciel.",personnages:18,oeuvres:45,artefacts:12,followers:"892"},
            3: {name:"Dragons de Lumière",banner:"🐲",genre:"Haute Fantaisie",desc:"Des créatures majestueuses.",personnages:14,oeuvres:32,artefacts:9,followers:"654"},
            4: {name:"Techno-Mystique",banner:"⚡",genre:"Science-Fantasy",desc:"Magie et technologie fusionnées.",personnages:22,oeuvres:51,artefacts:15,followers:"1.1K"},
            5: {name:"Forêt Éternelle",banner:"🌲",genre:"Haute Fantaisie",desc:"Une forêt de mystères.",personnages:16,oeuvres:37,artefacts:8,followers:"756"}
        };

        function getUrlParam(name){
            const params = new URLSearchParams(window.location.search);
            return params.get(name) || "1";
        }

        document.addEventListener("DOMContentLoaded", function() {
            const universeId = getUrlParam("id");
            const data = universeData[universeId];
            if(data){
                document.getElementById("universeName").textContent = data.name;
                document.getElementById("heroBanner").textContent = data.banner;
                document.getElementById("universeDesc").textContent = data.desc;
                document.getElementById("genreBadges").innerHTML = "<span class=\"genre-badge\">" + data.genre + "</span>";
                document.getElementById("personnagesCount").textContent = data.personnages;
                document.getElementById("oeuvresCount").textContent = data.oeuvres;
                document.getElementById("artefactsCount").textContent = data.artefacts;
                document.getElementById("followersCount").textContent = data.followers;
            }

            document.querySelectorAll(".tab-btn").forEach(function(btn) {
                btn.addEventListener("click", function() {
                    document.querySelectorAll(".tab-btn").forEach(function(b) { b.classList.remove("active"); });
                    document.querySelectorAll(".tab-content").forEach(function(c) { c.classList.remove("active"); });
                    this.classList.add("active");
                    const tab = this.dataset.tab;
                    const element = document.getElementById(tab);
                    if(element) element.classList.add("active");
                });
            });
        });
    </script>
</body>
</html>