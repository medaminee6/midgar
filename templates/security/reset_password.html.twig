        .form-control:focus { outline:none; border-color: var(--primary-color); box-shadow:0 0 0 3px rgba(24,227,164,0.2); }

        button { width:100%; padding:12px; border-radius:12px; border:none; background: linear-gradient(135deg, var(--primary-color), var(--primary-dark)); color:#000; font-weight:bold; cursor:pointer; transition: all 0.3s ease; }

        .success { background:#064e3b; color:#d1fae5; padding:10px; border-radius:8px; margin-bottom:15px; text-align:center; }
    </style>
</head>
<body>
