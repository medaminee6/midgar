<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Configuration Faciale - Midgar</title>
    
    <style>
        /* ===== VARIABLES MIDGAR ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --border-radius: 12px;
            --danger: #EF5350;
            --success: #18E3A4;
            --warning: #FFA726;
            --glass-bg: rgba(26, 31, 30, 0.5);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-color);
            position: relative;
            overflow: hidden;
        }
        
        /* ===== VIDÉO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        /* ===== OVERLAY GRADIENT ===== */
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(26, 31, 30, 0.85), rgba(13, 15, 15, 0.9));
            z-index: -1;
        }
        
        /* ===== OVERLAY DE PARTICULES ===== */
        .particle-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 30%, rgba(24, 227, 164, 0.03) 0%, transparent 30%),
                        radial-gradient(circle at 80% 70%, rgba(24, 227, 164, 0.03) 0%, transparent 30%);
            z-index: -1;
            pointer-events: none;
        }
        
        /* ===== CARTE PRINCIPALE ===== */
        .face-container {
            width: 100%;
            max-width: 600px;
            padding: 2rem;
            z-index: 10;
        }
        
        .face-card {
            background: linear-gradient(135deg, rgba(26, 31, 30, 0.8), rgba(20, 26, 25, 0.9));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            border: 1px solid rgba(24, 227, 164, 0.2);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(24, 227, 164, 0.1);
            overflow: hidden;
            animation: cardAppear 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .face-header {
            padding: 2rem 2rem 1rem 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .face-header h2 {
            color: var(--primary-color);
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }
        
        .face-header h2 i {
            font-size: 2rem;
            filter: drop-shadow(0 0 8px rgba(24, 227, 164, 0.5));
        }
        
        .face-header p {
            color: var(--text-secondary);
            margin-top: 0.5rem;
            font-size: 0.95rem;
        }
        
        .face-body {
            padding: 2rem;
        }
        
        /* ===== VIDÉO TUTORIEL ===== */
        .video-wrapper {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
            border: 1px solid rgba(24, 227, 164, 0.2);
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }
        
        .video-overlay-text {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
            padding: 1.5rem 1rem 1rem 1rem;
            text-align: center;
            color: var(--text-color);
            font-size: 0.9rem;
            backdrop-filter: blur(2px);
        }
        
        .video-overlay-text i {
            color: var(--primary-color);
            margin-right: 0.5rem;
        }
        
        #tutorialVideo {
            width: 100%;
            display: block;
        }
        
        /* ===== CAMÉRA RÉELLE CACHÉE ===== */
        #realVideo {
            display: none;
        }
        
        #canvas {
            display: none;
        }
        
        /* = badge de sécurité ===== */
        .security-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: rgba(24, 227, 164, 0.1);
            border: 1px solid rgba(24, 227, 164, 0.2);
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            margin: 1rem 0 1.5rem 0;
            color: var(--text-secondary);
            font-size: 0.9rem;
            backdrop-filter: blur(5px);
        }
        
        .security-badge i {
            color: var(--primary-color);
            font-size: 1.1rem;
        }
        
        .security-badge strong {
            color: var(--primary-color);
            font-weight: 600;
        }
        
        /* ===== BOUTONS ===== */
        .btn {
            display: inline-block;
            padding: 0.85rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
            font-size: 1rem;
            width: 100%;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            box-shadow: 0 4px 15px rgba(24, 227, 164, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-secondary {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-face {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
        }
        
        .btn-face:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }
        
        .btn-group {
            display: flex;
            gap: 1rem;
            margin: 1.5rem 0;
        }
        
        .btn-group .btn {
            flex: 1;
        }
        
        /* ===== STATUS ===== */
        .status-container {
            margin-top: 1.5rem;
            padding: 1rem;
            border-radius: 12px;
            background: rgba(24, 227, 164, 0.05);
            border: 1px solid rgba(24, 227, 164, 0.1);
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        #status {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        #status i {
            color: var(--primary-color);
            font-size: 1.2rem;
        }
        
        #status.success {
            color: var(--success);
        }
        
        #status.success i {
            color: var(--success);
        }
        
        #status.error {
            color: var(--danger);
        }
        
        #status.error i {
            color: var(--danger);
        }
        
        #status.warning {
            color: var(--warning);
        }
        
        #status.warning i {
            color: var(--warning);
        }
        
        /* ===== ANIMATION DE CHARGEMENT ===== */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            border-radius: 50%;
            border-top-color: var(--primary-color);
            animation: spin 0.8s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* = badge de confirmation ===== */
        .success-badge {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(24, 227, 164, 0.15);
            border: 1px solid var(--primary-color);
            border-radius: 50px;
            padding: 0.5rem 1rem;
            color: var(--primary-color);
            font-weight: 600;
            margin: 1rem 0;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.8; }
        }
        
        .success-badge i {
            font-size: 1.2rem;
        }
        
        /* ===== LIEN RETOUR ===== */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            text-decoration: none;
            margin-top: 1.5rem;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }
        
        .back-link:hover {
            color: var(--primary-color);
            gap: 0.75rem;
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 640px) {
            .face-container {
                padding: 1rem;
            }
            
            .face-header h2 {
                font-size: 1.6rem;
            }
            
            .btn-group {
                flex-direction: column;
            }
            
            .security-badge {
                flex-direction: column;
                text-align: center;
                padding: 1rem;
            }
        }
    </style>
    
    <!-- Font Awesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- ===== VIDÉO BACKGROUND ===== -->
    <video id="bgVideo" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo.
    </video>
    
    <!-- ===== OVERLAYS ===== -->
    <div class="video-overlay"></div>
    <div class="particle-overlay"></div>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <div class="face-container">
        <div class="face-card">
            <div class="face-header">
                <h2>
                    <i class="fas fa-face-smile"></i>
                    Configuration Faciale
                </h2>
                <p>Ajoutez une couche de sécurité supplémentaire à votre compte</p>
            </div>
            
            <div class="face-body">
                <!-- Caméra réelle cachée -->
                <video id="realVideo" autoplay muted playsinline></video>
                <canvas id="canvas"></canvas>
                
                <!-- Vidéo tutoriel visible -->
                <div class="video-wrapper">
                    <video id="tutorialVideo" autoplay loop muted playsinline>
                        <source src="{{ asset('uploads/face-auth.mp4') }}" type="video/mp4">
                        Votre navigateur ne supporte pas la vidéo.
                    </video>
                    <div class="video-overlay-text">
                        <i class="fas fa-shield-alt"></i>
                        Suivez le tutoriel - votre caméra capture en arrière-plan
                    </div>
                </div>
                
                <!-- Badge de sécurité cryptage -->
                <div class="security-badge">
                    <i class="fas fa-lock"></i>
                    <span><strong>Données cryptées</strong> · Votre visage est transformé en empreinte numérique unique et sécurisée</span>
                </div>
                
                <!-- Boutons de contrôle -->
                <button id="startCamera" class="btn btn-face">
                    <i class="fas fa-camera"></i>
                    Activer la configuration faciale
                </button>
                
                <button id="captureFace" class="btn btn-primary" style="display:none;">
                    <i class="fas fa-camera-retro"></i>
                    Enregistrer mon visage
                </button>
                
                <!-- Badge de succès (caché par défaut) -->
                <div id="successBadge" class="success-badge" style="display: none;">
                    <i class="fas fa-check-circle"></i>
                    <span>Visage enregistré avec succès ! Redirection...</span>
                </div>
                
                <!-- Zone de statut -->
                <div class="status-container">
                    <div id="status">
                        <i class="fas fa-info-circle"></i>
                        Cliquez sur "Activer la configuration faciale" pour commencer
                    </div>
                </div>
                
                <!-- Lien retour -->
                <a href="{{ path('home') }}" class="back-link">
                    <i class="fas fa-arrow-left"></i>
                    Retour à l'accueil
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://unpkg.com/face-api.js@0.22.2/dist/face-api.min.js"></script>
    
    <script>
    // ===== CONFIGURATION FACIALE =====
    class FaceRecognition {
        constructor() {
            this.realVideo = document.getElementById('realVideo');
            this.tutorialVideo = document.getElementById('tutorialVideo');
            this.canvas = document.getElementById('canvas');
            this.startBtn = document.getElementById('startCamera');
            this.captureBtn = document.getElementById('captureFace');
            this.statusEl = document.getElementById('status');
            this.successBadge = document.getElementById('successBadge');
            
            this.stream = null;
            this.modelsLoaded = false;
            this.faceDescriptor = null;
            this.detectionInterval = null;
            
            this.init();
        }
        
        async init() {
            // Charger les modèles face-api
            try {
                this.showStatus('Chargement des modèles de reconnaissance...', 'info', 'spinner');
                
                await faceapi.nets.tinyFaceDetector.loadFromUri('/models');
                await faceapi.nets.faceLandmark68Net.loadFromUri('/models');
                await faceapi.nets.faceRecognitionNet.loadFromUri('/models');
                
                this.modelsLoaded = true;
                this.showStatus('Modèles chargés avec succès', 'success', 'check-circle');
                
            } catch (error) {
                console.error('Erreur chargement modèles:', error);
                this.showStatus('Erreur de chargement des modèles', 'error', 'exclamation-circle');
            }
            
            // Événements
            this.startBtn.addEventListener('click', () => this.startCamera());
            this.captureBtn.addEventListener('click', () => this.captureFace());
            
            // Gérer la vidéo de fond
            const bgVideo = document.getElementById('bgVideo');
            if (bgVideo) {
                bgVideo.play().catch(e => console.log('Background video play error:', e));
            }
        }
        
        async startCamera() {
            try {
                this.showStatus('Demande d\'accès à la caméra...', 'info', 'spinner');
                
                // 1. Démarrer la caméra réelle (cachée)
                this.stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { 
                        width: 640, 
                        height: 480,
                        facingMode: 'user'
                    } 
                });
                
                // 2. Connecter la caméra à l'élément vidéo réel
                this.realVideo.srcObject = this.stream;
                await this.realVideo.play();
                
                // 3. S'assurer que la vidéo tutoriel tourne
                if (this.tutorialVideo.paused) {
                    await this.tutorialVideo.play();
                }
                
                // 4. Mettre à jour l'interface
                this.startBtn.style.display = 'none';
                this.captureBtn.style.display = 'block';
                
                this.showStatus('✅ Configuration activée ! La caméra capture votre visage en arrière-plan pendant que vous regardez le tutoriel.', 'success', 'check-circle');
                
                // 5. Démarrer la détection automatique
                this.startFaceDetection();
                
            } catch (error) {
                console.error('Erreur caméra:', error);
                
                if (error.name === 'NotAllowedError') {
                    this.showStatus('❌ Accès à la caméra refusé. Vérifiez vos permissions.', 'error', 'exclamation-triangle');
                } else if (error.name === 'NotFoundError') {
                    this.showStatus('❌ Aucune caméra trouvée sur votre appareil.', 'error', 'exclamation-circle');
                } else {
                    this.showStatus('❌ Erreur d\'accès à la caméra: ' + error.message, 'error', 'exclamation-circle');
                }
            }
        }
        
        startFaceDetection() {
            if (!this.modelsLoaded) return;
            
            // Vérifier les visages toutes les secondes
            this.detectionInterval = setInterval(async () => {
                if (!this.realVideo || this.realVideo.paused || !this.realVideo.videoWidth) return;
                
                try {
                    const detection = await faceapi
                        .detectSingleFace(this.realVideo, new faceapi.TinyFaceDetectorOptions())
                        .withFaceLandmarks()
                        .withFaceDescriptor();
                    
                    if (detection) {
                        // Visage détecté
                        this.captureBtn.classList.add('btn-primary');
                        this.captureBtn.classList.remove('btn-face');
                        
                        // Sauvegarder temporairement
                        this.tempDescriptor = Array.from(detection.descriptor);
                        
                        this.showStatus('✅ Visage détecté ! Vous pouvez maintenant enregistrer', 'success', 'check-circle');
                    } else {
                        this.showStatus('👤 Recherche de visage... Placez-vous face à la caméra', 'warning', 'exclamation-triangle');
                    }
                } catch (error) {
                    console.error('Erreur détection:', error);
                }
            }, 1000);
        }
        
        async captureFace() {
            if (!this.modelsLoaded) {
                this.showStatus('Modèles non chargés', 'error', 'exclamation-circle');
                return;
            }
            
            if (!this.realVideo || !this.realVideo.videoWidth) {
                this.showStatus('Caméra non disponible', 'error', 'exclamation-circle');
                return;
            }
            
            try {
                this.showStatus('Analyse du visage en cours...', 'info', 'spinner');
                
                // Détecter le visage
                const detection = await faceapi
                    .detectSingleFace(this.realVideo, new faceapi.TinyFaceDetectorOptions())
                    .withFaceLandmarks()
                    .withFaceDescriptor();
                
                if (!detection) {
                    this.showStatus('Aucun visage détecté. Réessayez.', 'warning', 'exclamation-triangle');
                    return;
                }
                
                // Sauvegarder le descripteur
                this.faceDescriptor = Array.from(detection.descriptor);
                
                // Afficher un aperçu (optionnel)
                const context = this.canvas.getContext('2d');
                this.canvas.width = this.realVideo.videoWidth;
                this.canvas.height = this.realVideo.videoHeight;
                context.drawImage(this.realVideo, 0, 0, this.canvas.width, this.canvas.height);
                
                // Envoyer au serveur
                await this.saveFaceDescriptor();
                
                // Afficher le succès
                this.showStatus('✅ Visage enregistré avec succès !', 'success', 'check-circle');
                this.successBadge.style.display = 'flex';
                
                // Désactiver le bouton
                this.captureBtn.disabled = true;
                
                // Redirection après 2 secondes
                setTimeout(() => {
                    window.location.href = "{{ path('home') }}?face_success=1";
                }, 2000);
                
            } catch (error) {
                console.error('Erreur capture:', error);
                this.showStatus('Erreur lors de l\'analyse', 'error', 'exclamation-circle');
            }
        }
        
        async saveFaceDescriptor() {
            if (!this.faceDescriptor) return;
            
            try {
                const response = await fetch('/profil/securite/visage/save', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ 
                        descriptor: this.faceDescriptor 
                    })
                });
                
                const data = await response.json();
                
                if (!data.success) {
                    throw new Error(data.message || 'Erreur de sauvegarde');
                }
                
                return true;
                
            } catch (error) {
                console.error('Erreur réseau:', error);
                this.showStatus('Erreur de communication avec le serveur', 'error', 'exclamation-circle');
                throw error;
            }
        }
        
        showStatus(message, type = 'info', icon = 'info-circle') {
            if (!this.statusEl) return;
            
            let iconHtml = '';
            if (type === 'spinner') {
                iconHtml = '<span class="loading-spinner"></span>';
            } else {
                iconHtml = `<i class="fas fa-${icon}"></i>`;
            }
            
            this.statusEl.innerHTML = `${iconHtml} ${message}`;
            this.statusEl.className = type;
        }
        
        stopCamera() {
            if (this.stream) {
                this.stream.getTracks().forEach(track => track.stop());
                this.stream = null;
            }
            
            if (this.detectionInterval) {
                clearInterval(this.detectionInterval);
            }
        }
    }

    // ===== INITIALISATION =====
    document.addEventListener('DOMContentLoaded', () => {
        // Initialiser la configuration faciale
        const faceRecognition = new FaceRecognition();
        
        // Arrêter la caméra si on quitte la page
        window.addEventListener('beforeunload', () => {
            if (faceRecognition) {
                faceRecognition.stopCamera();
            }
        });
        
        // Vérifier le succès dans l'URL
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('face_success') === '1') {
            const statusEl = document.getElementById('status');
            if (statusEl) {
                statusEl.innerHTML = '<i class="fas fa-check-circle"></i> Configuration faciale réussie !';
                statusEl.className = 'success';
            }
        }
    });
    </script>
</body>
</html>