<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion par visage - Midgar</title>
    
    <style>
        /* ===== VARIABLES MIDGAR ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --border-radius: 12px;
            --danger: #EF5350;
            --success: #18E3A4;
            --warning: #FFA726;
            --glass-bg: rgba(26, 31, 30, 0.5);
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-color);
            position: relative;
            overflow-x: hidden;
        }
        
        /* ===== VIDÉO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        /* ===== OVERLAY GRADIENT ===== */
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, rgba(26, 31, 30, 0.85), rgba(13, 15, 15, 0.9));
            z-index: -1;
        }
        
        /* ===== PARTICULES ANIMÉES ===== */
        .particle {
            position: absolute;
            width: 4px;
            height: 4px;
            background: var(--primary-color);
            border-radius: 50%;
            pointer-events: none;
            opacity: 0.3;
            animation: floatParticle 8s infinite;
        }
        
        @keyframes floatParticle {
            0% { transform: translateY(0) translateX(0); opacity: 0; }
            10% { opacity: 0.3; }
            90% { opacity: 0.2; }
            100% { transform: translateY(-100vh) translateX(20px); opacity: 0; }
        }
        
        /* ===== CONTENEUR PRINCIPAL ===== */
        .face-login-container {
            width: 100%;
            max-width: 700px;
            padding: 2rem;
            z-index: 10;
        }
        
        /* ===== CARTE PRINCIPALE ===== */
        .face-card {
            background: linear-gradient(135deg, rgba(26, 31, 30, 0.8), rgba(20, 26, 25, 0.9));
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            border: 1px solid rgba(24, 227, 164, 0.2);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(24, 227, 164, 0.1);
            overflow: hidden;
            animation: cardAppear 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* ===== EN-TÊTE ===== */
        .face-header {
            padding: 2rem 2rem 1rem 2rem;
            text-align: center;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .face-header h1 {
            color: var(--primary-color);
            font-size: 2.2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }
        
        .face-header h1 i {
            font-size: 2.2rem;
            filter: drop-shadow(0 0 8px rgba(24, 227, 164, 0.5));
        }
        
        .face-header p {
            color: var(--text-secondary);
            font-size: 1rem;
        }
        
        /* ===== CORPS ===== */
        .face-body {
            padding: 2rem;
        }
        
        /* ===== VIDÉO TUTORIEL (visible) ===== */
        .video-wrapper {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            background: #000;
            border: 2px solid rgba(24, 227, 164, 0.2);
            margin-bottom: 1.5rem;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }
        
        #tutorialVideo {
            width: 100%;
            display: block;
        }
        
        .video-overlay-text {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
            padding: 1.5rem 1rem 1rem 1rem;
            text-align: center;
            color: var(--text-color);
            font-size: 0.95rem;
            backdrop-filter: blur(2px);
        }
        
        .video-overlay-text i {
            color: var(--primary-color);
            margin-right: 0.5rem;
        }
        
        /* ===== CAMÉRA RÉELLE CACHÉE ===== */
        #realVideo {
            display: none;
        }
        
        /* ===== INSTRUCTIONS ===== */
        .instructions {
            background: rgba(24, 227, 164, 0.05);
            border: 1px solid rgba(24, 227, 164, 0.1);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }
        
        .instructions h3 {
            color: var(--primary-color);
            font-size: 1.2rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .instructions h3 i {
            font-size: 1.2rem;
        }
        
        .instructions ul {
            list-style: none;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }
        
        .instructions ul li {
            color: var(--text-secondary);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .instructions ul li i {
            color: var(--primary-color);
            font-size: 1rem;
        }
        
        @media (max-width: 640px) {
            .instructions ul {
                grid-template-columns: 1fr;
            }
        }
        
        /* ===== BOUTONS ===== */
        .btn-group {
            display: flex;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        
        .btn {
            flex: 1;
            padding: 0.85rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            font-size: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            box-shadow: 0 4px 15px rgba(24, 227, 164, 0.3);
        }
        
        .btn-primary:hover:not(:disabled) {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-secondary {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-face {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
        }
        
        .btn-face:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }
        
        /* ===== STATUS ===== */
        .status-container {
            padding: 1rem;
            border-radius: 12px;
            background: rgba(24, 227, 164, 0.05);
            border: 1px solid rgba(24, 227, 164, 0.1);
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1.5rem;
        }
        
        #status {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        #status i {
            color: var(--primary-color);
            font-size: 1.2rem;
        }
        
        #status.success {
            color: var(--success);
        }
        
        #status.success i {
            color: var(--success);
        }
        
        #status.error {
            color: var(--danger);
        }
        
        #status.error i {
            color: var(--danger);
        }
        
        #status.warning {
            color: var(--warning);
        }
        
        #status.warning i {
            color: var(--warning);
        }
        
        /* ===== BADGE SÉCURITÉ ===== */
        .security-badge {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            background: rgba(24, 227, 164, 0.1);
            border: 1px solid rgba(24, 227, 164, 0.2);
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            margin: 1rem 0;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .security-badge i {
            color: var(--primary-color);
            font-size: 1.1rem;
        }
        
        .security-badge strong {
            color: var(--primary-color);
            font-weight: 600;
        }
        
        /* ===== CHARGEMENT ===== */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            border-radius: 50%;
            border-top-color: var(--primary-color);
            animation: spin 0.8s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* ===== LIEN RETOUR ===== */
        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            padding: 0.5rem 0;
        }
        
        .back-link:hover {
            color: var(--primary-color);
            gap: 0.75rem;
        }
        
        .footer {
            text-align: center;
            margin-top: 1.5rem;
        }
        
        /* ===== CANVAS CACHÉ ===== */
        #snapshot {
            display: none;
        }
        /* ===== OVERLAY CRISTAL MIDGAR (SOLUTION 3) ===== */
.midgar-crystal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        linear-gradient(
            125deg,
            transparent 0%,
            rgba(24, 227, 164, 0.15) 20%,
            transparent 40%,
            transparent 60%,
            rgba(24, 227, 164, 0.15) 80%,
            transparent 100%
        ),
        linear-gradient(
            45deg,
            rgba(24, 227, 164, 0.08) 0%,
            transparent 30%,
            transparent 70%,
            rgba(24, 227, 164, 0.08) 100%
        );
    pointer-events: none;
    z-index: 5;
    animation: crystalShift 8s ease-in-out infinite;
}

.midgar-lens-flare {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
        circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
        rgba(24, 227, 164, 0.2) 0%,
        rgba(24, 227, 164, 0.05) 20%,
        transparent 60%
    );
    pointer-events: none;
    z-index: 6;
    mix-blend-mode: screen;
}

.midgar-glow-pulse {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
        circle at 50% 50%,
        rgba(24, 227, 164, 0.1) 0%,
        transparent 70%
    );
    animation: glowPulse 3s ease-in-out infinite;
    z-index: 4;
}

@keyframes crystalShift {
    0%, 100% {
        opacity: 0.5;
        filter: hue-rotate(0deg) brightness(1);
    }
    33% {
        opacity: 0.8;
        filter: hue-rotate(5deg) brightness(1.1);
    }
    66% {
        opacity: 0.6;
        filter: hue-rotate(-5deg) brightness(0.9);
    }
}

@keyframes glowPulse {
    0%, 100% {
        transform: scale(1);
        opacity: 0.3;
    }
    50% {
        transform: scale(1.2);
        opacity: 0.6;
    }
}

/* Effet de bordure scintillante */
.video-wrapper::after {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    border-radius: 18px;
    background: linear-gradient(
        45deg,
        transparent,
        rgba(24, 227, 164, 0.3),
        transparent,
        rgba(24, 227, 164, 0.3),
        transparent
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 7;
    pointer-events: none;
}

.video-wrapper:hover::after {
    opacity: 0.8;
    animation: borderGlow 2s linear infinite;
}

@keyframes borderGlow {
    0% {
        filter: hue-rotate(0deg);
        opacity: 0.5;
    }
    50% {
        filter: hue-rotate(15deg);
        opacity: 0.8;
    }
    100% {
        filter: hue-rotate(0deg);
        opacity: 0.5;
    }
}

/* Particules supplémentaires sur la vidéo */
.midgar-sparkles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.1) 1px, transparent 1px),
        radial-gradient(circle at 80% 70%, rgba(24, 227, 164, 0.1) 1px, transparent 1px),
        radial-gradient(circle at 40% 60%, rgba(24, 227, 164, 0.1) 1px, transparent 1px),
        radial-gradient(circle at 90% 20%, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 100px 100px;
    pointer-events: none;
    z-index: 3;
    opacity: 0.5;
    animation: sparkleMove 12s linear infinite;
}

@keyframes sparkleMove {
    0% { background-position: 0 0; }
    100% { background-position: 100px 100px; }
}
    </style>
    
