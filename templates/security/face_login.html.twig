    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    
    <script>
        // ===== CRÉATION DES PARTICULES =====
        function createParticles() {
            const particlesContainer = document.getElementById('particles');
            for (let i = 0; i < 30; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                
                // Position aléatoire
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                
                // Délai d'animation aléatoire
                particle.style.animationDelay = Math.random() * 5 + 's';
                
                // Taille aléatoire
                const size = 2 + Math.random() * 4;
                particle.style.width = size + 'px';
                particle.style.height = size + 'px';
                
                particlesContainer.appendChild(particle);
            }
        }

        // ===== RECONNAISSANCE FACIALE POUR LOGIN =====
        class FaceLogin {
            constructor() {
                this.realVideo = document.getElementById('realVideo');
                this.tutorialVideo = document.getElementById('tutorialVideo');
                this.canvas = document.getElementById('snapshot');
                this.startBtn = document.getElementById('startCamera');
                this.loginBtn = document.getElementById('btnLoginFace');
                this.statusEl = document.getElementById('status');
                
                this.stream = null;
                this.modelsLoaded = false;
                this.currentDescriptor = null;
                this.detectionInterval = null;
                
                this.init();
            }
            
            async init() {
                // Créer les particules
                createParticles();
                initLensFlareEffect();

                
                // Gérer la vidéo de fond
                const bgVideo = document.getElementById('bgVideo');
                if (bgVideo) {
                    bgVideo.play().catch(e => console.log('Background video error:', e));
                }
                
                // Précharger la vidéo tutoriel
                this.tutorialVideo.load();
                
                // Charger les modèles
                try {
                    this.showStatus('Chargement des modèles...', 'info', 'spinner');
                    
                    await faceapi.nets.tinyFaceDetector.loadFromUri('/models');
                    await faceapi.nets.faceLandmark68Net.loadFromUri('/models');
                    await faceapi.nets.faceRecognitionNet.loadFromUri('/models');
                    
                    this.modelsLoaded = true;
                    this.showStatus('Modèles chargés avec succès', 'success', 'check-circle');
                    
                } catch (error) {
                    console.error('Erreur chargement modèles:', error);
                    this.showStatus('Erreur de chargement des modèles', 'error', 'exclamation-circle');
                }
                
                // Événements
                this.startBtn.addEventListener('click', () => this.startCamera());
                this.loginBtn.addEventListener('click', () => this.authenticate());
            }
            
            async startCamera() {
                try {
                    this.showStatus('Demande d\'accès à la caméra...', 'info', 'spinner');
                    
                    // 1. Démarrer la caméra réelle (cachée)
                    this.stream = await navigator.mediaDevices.getUserMedia({ 
                        video: { 
                            width: 640, 
                            height: 480,
                            facingMode: 'user'
                        } 
                    });
                    
                    // 2. Connecter la caméra à l'élément réel
                    this.realVideo.srcObject = this.stream;
                    await this.realVideo.play();
                    
                    // 3. Lancer la vidéo tutoriel
                    try {
                        await this.tutorialVideo.play();
                    } catch (e) {
                        console.log('Tutoriel video play error:', e);
                    }
                    
                    // 4. Mise à jour interface
                    this.startBtn.style.display = 'none';
                    this.loginBtn.style.display = 'block';
                    
                    this.showStatus('Reconnaissance activée ! Votre visage est analysé en arrière-plan', 'success', 'check-circle');
                    
                    // 5. Démarrer la détection
                    this.startFaceDetection();
                    
                } catch (error) {
                    console.error('Erreur caméra:', error);
                    
                    if (error.name === 'NotAllowedError') {
                        this.showStatus('Accès à la caméra refusé', 'error', 'exclamation-triangle');
                    } else {
                        this.showStatus('Erreur: ' + error.message, 'error', 'exclamation-circle');
                    }
                }
            }
            
            startFaceDetection() {
                if (!this.modelsLoaded) return;
                
                this.detectionInterval = setInterval(async () => {
                    if (!this.realVideo || this.realVideo.paused || !this.realVideo.videoWidth) return;
                    
                    try {
                        const detection = await faceapi
                            .detectSingleFace(this.realVideo, new faceapi.TinyFaceDetectorOptions())
                            .withFaceLandmarks()
                            .withFaceDescriptor();
                        
                        if (detection) {
                            // Visage détecté
                            this.currentDescriptor = Array.from(detection.descriptor);
                            this.loginBtn.disabled = false;
                            
                            this.showStatus('✅ Visage détecté ! Vous pouvez vous connecter', 'success', 'check-circle');
                        } else {
                            this.currentDescriptor = null;
                            this.loginBtn.disabled = true;
                            this.showStatus('👤 Recherche de visage...', 'warning', 'exclamation-triangle');
                        }
                    } catch (error) {
                        console.error('Erreur détection:', error);
                    }
                }, 1000);
            }
            
            async authenticate() {
                if (!this.currentDescriptor) {
                    this.showStatus('Aucun visage détecté', 'error', 'exclamation-circle');
                    return;
                }
                
                try {
                    this.showStatus('Vérification de votre identité...', 'info', 'spinner');
                    this.loginBtn.disabled = true;
                    
                    // Envoyer le descripteur au serveur
                    const response = await fetch('/login/face', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            descriptor: this.currentDescriptor
                        })
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        this.showStatus('✅ Connexion réussie ! Redirection...', 'success', 'check-circle');
                        
                        // Redirection
                        setTimeout(() => {
                            window.location.href = '/';
                        }, 1500);
                    } else {
                        this.showStatus('❌ ' + (data.message || 'Visage non reconnu'), 'error', 'exclamation-circle');
                        this.loginBtn.disabled = false;
                    }
                    
                } catch (error) {
                    console.error('Erreur authentification:', error);
                    this.showStatus('Erreur de communication', 'error', 'exclamation-circle');
                    this.loginBtn.disabled = false;
                }
            }
            
            showStatus(message, type = 'info', icon = 'info-circle') {
                let iconHtml = '';
                if (type === 'spinner') {
                    iconHtml = '<span class="loading-spinner"></span>';
                } else {
                    iconHtml = `<i class="fas fa-${icon}"></i>`;
                }
                
                this.statusEl.innerHTML = `${iconHtml} ${message}`;
                this.statusEl.className = type;
            }
            
            stopCamera() {
                if (this.stream) {
                    this.stream.getTracks().forEach(track => track.stop());
                }
                if (this.detectionInterval) {
                    clearInterval(this.detectionInterval);
                }
            }
        }

        // ===== INITIALISATION =====
        document.addEventListener('DOMContentLoaded', () => {
            const faceLogin = new FaceLogin();
            
            window.addEventListener('beforeunload', () => {
                faceLogin.stopCamera();
            });
        });
        // ===== EFFET DE LENTILLE QUI SUIT LA SOURIS (SOLUTION 3) =====
function initLensFlareEffect() {
    const videoWrapper = document.getElementById('videoWrapper');
    const lensFlare = document.getElementById('lensFlare');
    
    if (videoWrapper && lensFlare) {
        videoWrapper.addEventListener('mousemove', (e) => {
            const rect = videoWrapper.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            
            // Appliquer la position au style CSS
            lensFlare.style.setProperty('--mouse-x', x + '%');
            lensFlare.style.setProperty('--mouse-y', y + '%');
            
            // Ajouter un effet de brillance supplémentaire
            lensFlare.style.opacity = '1';
        });
        
        videoWrapper.addEventListener('mouseleave', () => {
            // Reset au centre avec opacité réduite
            lensFlare.style.setProperty('--mouse-x', '50%');
            lensFlare.style.setProperty('--mouse-y', '50%');
            lensFlare.style.opacity = '0.5';
        });
        
        // Effet de scintillement aléatoire
        setInterval(() => {
            if (Math.random() > 0.7) {
                lensFlare.style.background = `radial-gradient(
                    circle at ${Math.random() * 100}% ${Math.random() * 100}%,
                    rgba(24, 227, 164, 0.3) 0%,
                    rgba(24, 227, 164, 0.1) 20%,
                    transparent 60%
                )`;
                
                setTimeout(() => {
                    lensFlare.style.background = 'radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(24, 227, 164, 0.2) 0%, rgba(24, 227, 164, 0.05) 20%, transparent 60%)';
                }, 200);
            }
        }, 3000);
    }
}
