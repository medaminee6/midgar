    <script>
        document.getElementById('fileInput')?.addEventListener('change', (e) => {
            const label = document.querySelector('.file-label');
            if(e.target.files.length) {
                label.innerHTML = `<div class="file-icon" style="background-color: rgba(24, 227, 164, 0.2);"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 28px; height: 28px; stroke: var(--accent-primary);">
                    <polyline points="20 6 9 17 4 12"/></svg></div><div class="file-text" style="color: var(--accent-primary);">✓ ${e.target.files[0].name}</div>`;
            }
        });
        document.querySelector('.file-label').addEventListener('click', (e) => {
            if(e.target.closest('.file-label')) document.getElementById('fileInput').click();
        });
        document.getElementById('artifactForm')?.addEventListener('submit', (e) => {
            e.preventDefault();
            alert('Artefact créé! (Fonctionnalité de démonstration)');
        });
    </script>
