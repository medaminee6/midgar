<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Créer un Artefact - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .creation-container { display: grid; grid-template-columns: 250px 1fr; gap: 2rem; min-height: 100vh; }
        .sidebar { position: sticky; top: 0; height: 100vh; background-color: var(--bg-secondary); border-right: 2px solid var(--border-color); overflow-y: auto; padding: 2rem 1.5rem; }
        .sidebar-title { font-size: 0.9rem; font-weight: 700; text-transform: uppercase; color: var(--accent-primary); margin-bottom: 1.5rem; letter-spacing: 1px; }
        .sidebar-nav { display: flex; flex-direction: column; gap: 0.75rem; }
        .sidebar-link { display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem; color: var(--text-secondary); text-decoration: none; border-radius: 4px; transition: all 0.3s; font-size: 0.9rem; }
        .sidebar-link:hover, .sidebar-link.active { background-color: rgba(24, 227, 164, 0.1); color: var(--accent-primary); border-left: 3px solid var(--accent-primary); padding-left: calc(1rem - 3px); }
        .sidebar-icon { width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; }
        .main-content { padding: 3rem; }
        .form-container { background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2.5rem; max-width: 700px; }
        .form-title { font-size: 2.2rem; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 1px; }
        .form-subtitle { color: var(--text-secondary); margin-bottom: 2rem; font-size: 0.95rem; }
        .form-group { margin-bottom: 1.5rem; }
        .form-label { display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.5px; color: var(--text-primary); }
        .form-input, .form-textarea, .form-select { width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; transition: all 0.3s; }
        .form-input:focus, .form-textarea:focus, .form-select:focus { outline: none; border-color: var(--accent-primary); box-shadow: 0 0 12px var(--shadow-color); }
        .form-textarea { resize: vertical; min-height: 120px; }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
        .radio-group { display: flex; gap: 1.5rem; }
        .radio-option { display: flex; align-items: center; gap: 0.5rem; }
        .radio-option input { accent-color: var(--accent-primary); }
        .radio-option label { margin: 0; text-transform: capitalize; font-size: 0.9rem; color: var(--text-primary); cursor: pointer; }
        .file-upload { position: relative; }
        .file-label { display: block; padding: 2rem; border: 2px dashed var(--border-color); border-radius: 8px; text-align: center; cursor: pointer; transition: all 0.3s; background-color: rgba(24, 227, 164, 0.05); }
        .file-label:hover { border-color: var(--accent-primary); background-color: rgba(24, 227, 164, 0.1); }
        .file-icon { width: 48px; height: 48px; margin: 0 auto 0.75rem; display: flex; align-items: center; justify-content: center; background-color: rgba(24, 227, 164, 0.15); border-radius: 8px; }
        .file-text { font-weight: 600; margin-bottom: 0.25rem; color: var(--accent-primary); }
        .file-hint { font-size: 0.85rem; color: var(--text-secondary); }
        #fileInput { display: none; }
        .form-actions { display: flex; gap: 1rem; margin-top: 2rem; }
        .btn { padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; }
        .btn-primary { background-color: var(--accent-primary); color: var(--bg-primary); }
        .btn-primary:hover { background-color: var(--accent-hover); }
        .btn-secondary { background-color: var(--border-color); color: var(--text-primary); border: 1px solid var(--accent-primary); }
        .btn-secondary:hover { background-color: rgba(24, 227, 164, 0.1); }
        @media (max-width: 1024px) { .creation-container { grid-template-columns: 1fr; } .sidebar { position: static; height: auto; border-right: none; border-bottom: 2px solid var(--border-color); } .sidebar-nav { flex-direction: row; gap: 1rem; overflow-x: auto; } .form-row { grid-template-columns: 1fr; } }
    </style>
</head>
