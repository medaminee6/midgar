{% extends "base.html.twig" %}

{% block title %}Commandes - Fantasy Store{% endblock %}

{% block content %}
<div style="background: linear-gradient(135deg, #0d1117 0%, #1a1f1e 100%); min-height: 80vh; padding: 3rem 0;">
    <div class="container">
        <div class="row mb-4">
            <div class="col-md-8">
                <h1 style="color:white;">Commandes</h1>
                <p style="color:#999;">Gestion de toutes les commandes</p>
            </div>
            <div class="col-md-4" style="display:flex; align-items:center; justify-content:flex-end; gap:0.5rem;">
                <a href="{{ path('shop_index') }}" class="btn btn-primary">
                    <i class="fas fa-shopping-bag"></i> Retour à la boutique
                </a>
            </div>
        </div>

        {% if commandes %}
            <div style="background:#0d1117; padding:1rem; border-radius:8px; border:1px solid #222;">
                <div class="table-responsive">
                    <table class="table table-hover" style="color:#ddd;">
                        <thead>
                            <tr>
                                <th>Référence</th>
                                <th>Produit</th>
                                <th>Acheteur</th>
                                <th>Quantité</th>
                                <th>Prix total</th>
                                <th>État</th>
                                <th>Date</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for commande in commandes %}
                                <tr>
                                    <td>
                                        <strong style="color:#fff;">{{ commande.referenceCommande }}</strong>
                                    </td>
                                    <td>{{ commande.produit.nomProduit }}</td>
                                    <td>{{ commande.acheteur }}</td>
                                    <td>{{ commande.quantite }}</td>
                                    <td><strong>{{ commande.prixTotal }}€</strong></td>
                                    <td>
                                        <span class="badge {{ commande.etat.getBadgeClass() }}">
                                            {{ commande.etat.getLabel() }}
                                        </span>
                                    </td>
                                    <td>{{ commande.dateCommande|date('d/m/Y H:i') }}</td>
                                    <td>
                                        <a href="{{ path('shop_commande_detail', {id: commande.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="{{ path('shop_commande_edit', {id: commande.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <form action="{{ path('shop_commande_delete', {id: commande.id}) }}" method="POST" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr?');">
                                            <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% else %}
            <div class="alert alert-info" style="background:#1a1f1e; color:#ccc; border:1px solid #222;">
                Aucune commande pour le moment.
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
