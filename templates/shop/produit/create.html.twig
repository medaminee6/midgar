{% extends "base.html.twig" %}

{% block title %}Ajouter un produit - Fantasy Store{% endblock %}

{% block content %}
<div style="background: linear-gradient(135deg, #0d1117 0%, #1a1f1e 100%); min-height: 80vh; padding: 3rem 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1 class="mb-4" style="color:white;">Ajouter un nouveau produit</h1>

                <div style="background:#0d1117; padding:1.25rem; border-radius:8px; border:1px solid #222;">
                    <form method="POST" class="needs-validation">
                        <div class="mb-3">
                            <label for="nom_produit" class="form-label" style="color:#ddd;">Nom du produit</label>
                            <input type="text" class="form-control" id="nom_produit" name="nom_produit" value="{{ produit is defined ? produit.nomProduit : '' }}">
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label" style="color:#ddd;">Description</label>
                            <textarea class="form-control" id="description" name="description" rows="4">{{ produit is defined ? produit.description : '' }}</textarea>
                        </div>

                        <div class="mb-3">
                            <label for="prix" class="form-label" style="color:#ddd;">Prix (€)</label>
                            <input type="number" class="form-control" id="prix" name="prix" step="0.01" value="{{ produit is defined ? produit.prix : '' }}">
                        </div>

                        <div class="mb-3">
                            <label for="type_produit" class="form-label" style="color:#ddd;">Type de produit</label>
                            <select class="form-control" id="type_produit" name="type_produit">
                                <option value="">Sélectionnez un type</option>
                                <option value="Artefact">Artefact</option>
                                <option value="Oeuvre">Oeuvre</option>
                                <option value="Personnage">Personnage</option>
                                <option value="Livre">Livre</option>
                                <option value="Collection">Collection</option>
                                <option value="Autre">Autre</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="quantite_disponible" class="form-label" style="color:#ddd;">Quantité disponible</label>
                            <input type="number" class="form-control" id="quantite_disponible" name="quantite_disponible" value="{{ produit is defined ? produit.quantiteDisponible : 1 }}">
                        </div>

                        <div style="display:flex; gap:0.5rem; justify-content:flex-end;">
                            <a href="{{ path('shop_index') }}" class="btn btn-secondary">Annuler</a>
                            <button type="submit" class="btn btn-primary">Créer le produit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
