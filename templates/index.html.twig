    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    
    <script>
        // ===== FONCTIONS MODALES =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // ===== BARRE DE RECHERCHE DANS LE HEADER =====
        function toggleSearchBar() {
            const searchBar = document.getElementById('searchBarContainer');
            const normalButtons = document.getElementById('normalButtons');
            const searchToggle = document.getElementById('searchToggleBtn');
            
            searchBar.classList.toggle('active');
            
            if (searchBar.classList.contains('active')) {
                normalButtons.classList.add('hidden');
                searchToggle.innerHTML = '<i class="fas fa-times"></i>';
                setTimeout(() => {
                    document.getElementById('searchBarInput').focus();
                }, 300);
            } else {
                normalButtons.classList.remove('hidden');
                searchToggle.innerHTML = '<i class="fas fa-search"></i>';
                document.getElementById('searchBarResults').innerHTML = '';
                document.getElementById('searchBarInput').value = '';
            }
        }

        // ===== RECHERCHE EN TEMPS RÉEL DANS LA BARRE =====
        const searchBarInput = document.getElementById('searchBarInput');
        const searchBarResults = document.getElementById('searchBarResults');
        let searchBarTimeout;
        let searchBarController;

        if (searchBarInput) {
            searchBarInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                if (searchBarController) searchBarController.abort();
                
                if (query.length < 2) {
                    searchBarResults.innerHTML = '';
                    return;
                }
                
                searchBarResults.innerHTML = `
                    <div style="text-align:center; padding:1rem;">
                        <div class="loading-spinner" style="width:30px; height:30px;"></div>
                        <p style="color: var(--text-secondary); font-size:0.9rem; margin-top:0.5rem;">Recherche...</p>
                    </div>
                `;
                
                clearTimeout(searchBarTimeout);
                searchBarTimeout = setTimeout(() => {
                    searchUsersInBar(query);
                }, 500);
            });
        }

        async function searchUsersInBar(query) {
            searchBarController = new AbortController();
            
            try {
                const response = await fetch(`/api/search/users?q=${encodeURIComponent(query)}`, {
                    signal: searchBarController.signal
                });
                
                if (!response.ok) throw new Error('Erreur réseau');
                
                const users = await response.json();
                displayBarResults(users);
                
            } catch (error) {
                if (error.name === 'AbortError') return;
                console.error('Erreur:', error);
                searchBarResults.innerHTML = `
                    <div style="text-align:center; padding:1rem; color: var(--danger);">
                        <i class="fas fa-exclamation-triangle"></i>
                        <p style="font-size:0.9rem;">Erreur</p>
                    </div>
                `;
            }
        }

        function displayBarResults(users) {
            if (users.length === 0) {
                searchBarResults.innerHTML = `
                    <div style="text-align:center; padding:1rem;">
                        <p style="color: var(--text-secondary); font-size:0.9rem;">Aucun utilisateur trouvé</p>
                    </div>
                `;
                return;
            }

            let html = '';
            users.forEach(user => {
                const avatarUrl = user.avatar ? `/uploads/avatars/${user.avatar}` : '/images/default-avatar.png';
                
                html += `
                    <div class="search-result-item" onclick="window.location.href='/profile/${user.id}'">
                        <img src="${avatarUrl}" class="search-result-avatar">
                        <div>
                            <strong style="color: var(--primary-color);">@${user.username}</strong>
                            <p style="color: var(--text-secondary); font-size:0.9rem;">${user.prenom} ${user.nom}</p>
                        </div>
                    </div>
                `;
            });
            
            searchBarResults.innerHTML = html;
        }

        // Fermer la barre de recherche si on clique ailleurs
        document.addEventListener('click', function(event) {
            const searchBar = document.getElementById('searchBarContainer');
            const searchToggle = document.getElementById('searchToggleBtn');
            
            if (searchBar && searchBar.classList.contains('active')) {
                if (!searchBar.contains(event.target) && !searchToggle.contains(event.target)) {
                    toggleSearchBar();
                }
            }
        });

        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 12; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 120 + 'px';
                    const y = (Math.random() - 0.5) * 120 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    const hue = Math.floor(Math.random() * 60) + 140;
                    particle.style.background = `radial-gradient(circle, hsl(${hue}, 100%, 60%), hsl(${hue}, 100%, 30%))`;
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== FERMETURE DES MODALES AVEC ECHAP =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const searchBar = document.getElementById('searchBarContainer');
                if (searchBar && searchBar.classList.contains('active')) {
                    toggleSearchBar();
                }
                closeModal('defi-modal');
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath) {
                link.classList.add('active');
            }
        });

        // ===== SWIPER INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            // Univers Slider
            new Swiper('.univers-slider', {
                loop: true,
                slidesPerView: 3,
                spaceBetween: 30,
                grabCursor: true,
                centeredSlides: true,
                effect: 'coverflow',
                coverflowEffect: {
                    rotate: 50,
                    stretch: 0,
                    depth: 100,
                    modifier: 1,
                    slideShadows: true,
                },
                navigation: {
                    nextEl: '.univers-next',
                    prevEl: '.univers-prev',
                },
                pagination: {
                    el: '.univers-pagination',
                    clickable: true,
                },
                breakpoints: {
                    320: { slidesPerView: 1 },
                    640: { slidesPerView: 2 },
