    <script>
        // Magic Button Particle Effect (sans son)
        document.querySelectorAll('.magic-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                // Effet de particules
                for(let i = 0; i < 12; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 120 + 'px';
                    const y = (Math.random() - 0.5) * 120 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    // Position relative au bouton
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    // Couleur aléatoire pour effet magique
                    const hue = Math.floor(Math.random() * 60) + 140; // Teintes vert/cyan
                    particle.style.background = `radial-gradient(circle, hsl(${hue}, 100%, 60%), hsl(${hue}, 100%, 30%))`;
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
                
                // Effet visuel : onde concentrique
                const wave = document.createElement('div');
                wave.style.position = 'absolute';
                wave.style.width = '0';
                wave.style.height = '0';
                wave.style.border = '2px solid var(--primary-color)';
                wave.style.borderRadius = '50%';
                wave.style.top = '50%';
                wave.style.left = '50%';
                wave.style.transform = 'translate(-50%, -50%)';
                wave.style.opacity = '0.7';
                wave.style.pointerEvents = 'none';
                wave.style.zIndex = '1';
                
                btn.style.position = 'relative';
                btn.appendChild(wave);
                
                // Animation de l'onde
                let size = 0;
                const waveInterval = setInterval(() => {
                    size += 5;
                    wave.style.width = size + 'px';
                    wave.style.height = size + 'px';
                    wave.style.opacity = (0.7 - (size / 100));
                    
                    if (size > 100) {
                        clearInterval(waveInterval);
                        wave.remove();
                    }
                }, 10);
            });
            
            // Effet au survol
            btn.addEventListener('mouseenter', function() {
                this.style.transition = 'all 0.3s ease';
            });
        });

        // Highlight active nav link
