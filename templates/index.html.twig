    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
            --danger: #EF5350;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            background: var(--bg-primary);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color), 
                        0 0 30px var(--primary-color), 
                        0 0 50px var(--primary-dark);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color), 
                        0 0 30px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color), 
                        0 0 30px var(--primary-color), 
                        0 0 50px var(--primary-dark);
            border-color: var(--primary-color);
            color: var(--primary-color);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== GLOW ANIMATION ===== */
        @keyframes glow {
            0%, 100% {
                box-shadow: 0 0 5px var(--primary-color),
                            0 0 10px var(--primary-color);
            }
            50% {
                box-shadow: 0 0 15px var(--primary-color),
                            0 0 30px var(--primary-color),
                            0 0 45px var(--primary-dark);
            }
        }
        
        .btn-glow {
            animation: glow 2s infinite;
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: -1;
        }
        
        /* ===== HEADER ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            position: relative;
            min-width: 200px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== BARRE DE RECHERCHE DANS LE HEADER ===== */
        .search-bar-container {
            position: absolute;
            top: 0;
            right: 0;
            width: 0;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 200;
        }

        .search-bar-container.active {
            width: 300px;
            opacity: 1;
            visibility: visible;
        }

        .search-bar-wrapper {
            display: flex;
            align-items: center;
            background: rgba(11, 15, 14, 0.9);
            border: 1px solid var(--primary-color);
            border-radius: 30px;
            padding: 0.3rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.3);
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .search-icon {
            color: var(--primary-color);
            margin-left: 1rem;
            font-size: 1rem;
        }

        .search-bar-input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 0.8rem 0.5rem;
            color: var(--text-color);
            font-size: 1rem;
            outline: none;
        }

        .search-bar-input::placeholder {
            color: var(--text-secondary);
            opacity: 0.7;
        }

        .search-close-btn {
            background: transparent;
            border: none;
            color: var(--primary-color);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
        }

        .search-close-btn:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }

        .search-bar-results {
            position: absolute;
            top: 60px;
            right: 0;
            width: 100%;
            max-height: 300px;
            overflow-y: auto;
            background: var(--bg-primary);
            border: 1px solid var(--primary-color);
            border-radius: 10px;
            padding: 0.5rem;
            backdrop-filter: blur(10px);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            animation: fadeIn 0.3s ease;
        }

        .search-bar-results .search-result-item {
            display: flex;
            align-items: center;
            gap: 0.8rem;
            padding: 0.5rem;
            margin-bottom: 0.3rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .search-bar-results .search-result-item:hover {
            background: rgba(24, 227, 164, 0.1);
        }

        .search-bar-results .search-result-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-color);
        }

        .auth-buttons-normal {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: opacity 0.3s ease;
        }

        .auth-buttons-normal.hidden {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        @keyframes searchPulse {
            0% { transform: scale(1); }
            50% { 
                transform: scale(1.1);
                box-shadow: 0 0 20px var(--primary-color);
            }
            100% { transform: scale(1); }
        }

        .search-toggle {
            animation: searchPulse 2s infinite;
            z-index: 150;
        }

        .search-toggle:hover {
            animation: none;
        }
        
        /* ===== HERO SECTION ===== */
        .hero {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 2rem;
        }
        
        .hero h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            margin: 1rem 0;
            text-shadow: 0 0 10px rgba(24, 227, 164, 0.5);
        }
        
        .hero-tagline {
            font-size: clamp(1rem, 3vw, 1.3rem);
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
        }
        
        .hero-buttons {
            margin-top: 1.5rem;
        }
        
        .hero-buttons a {
            margin: 0 0.5rem;
        }
        
        /* ===== SECTIONS ===== */
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 2rem;
            font-size: clamp(1.5rem, 4vw, 2rem);
            position: relative;
        }
        
        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
        }
        
        /* ===== CARDS ===== */
        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            transition: all 0.3s ease;
            height: 100%;
            position: relative;
            border: 1px solid transparent;
        }
        
        .card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6),
                        0 0 20px rgba(24, 227, 164, 0.3);
            border-color: rgba(24, 227, 164, 0.2);
        }
        
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(24, 227, 164, 0.1), transparent);
            transition: left 0.5s;
        }
        
        .card:hover::before {
            left: 100%;
        }
        
        .card-image {
            width: 100%;
            aspect-ratio: 4 / 3;
            overflow: hidden;
            position: relative;
        }
        
        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .card:hover .card-image img {
            transform: scale(1.1);
        }
        
        .card-body {
            padding: 1rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 2;
        }
        
        .card-body h3 {
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
            color: var(--primary-color);
        }
        
        .card-body p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            flex-grow: 1;
        }
        
        .card-tags {
            margin: 0.5rem 0;
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            justify-content: center;
        }
        
        .tag {
            background-color: var(--primary-color);
            color: #000;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .tag:hover {
            transform: scale(1.1);
        }
        
        /* ===== SWIPER ===== */
        .swiper-container {
            padding: 3rem 0;
            position: relative;
        }
        
        .swiper-coverflow {
            padding: 4rem 0;
        }
        
        .swiper-coverflow .swiper-slide {
            transition: all 0.3s ease;
        }
        
        .swiper-coverflow .swiper-slide-active {
            transform: scale(1.05);
            z-index: 10;
        }
        
        .swiper-button-next,
        .swiper-button-prev {
            color: var(--primary-color);
            background: rgba(26, 31, 30, 0.7);
            width: 40px;
            height: 40px;
            border-radius: 50%;
            backdrop-filter: blur(5px);
            border: 1px solid var(--primary-color);
            transition: all 0.3s;
        }
        
        .swiper-button-next:hover,
        .swiper-button-prev:hover {
            background: var(--primary-color);
            color: #000;
            box-shadow: 0 0 15px var(--primary-color);
            transform: scale(1.1);
        }
        
        .swiper-button-next:after,
        .swiper-button-prev:after {
            font-size: 1.2rem;
        }
        
        .swiper-pagination-bullet {
            background: var(--primary-color);
            opacity: 0.7;
            width: 12px;
            height: 12px;
            transition: all 0.3s;
        }
        
        .swiper-pagination-bullet:hover {
            transform: scale(1.3);
        }
        
        .swiper-pagination-bullet-active {
            opacity: 1;
            transform: scale(1.2);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        /* ===== DÉFIS SECTION ===== */
        .defis-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-top: 1rem;
        }
        
        .defi-card {
            cursor: pointer;
            position: relative;
        }
        
        .defi-card:hover .view-defi {
            animation: glow 1.5s infinite;
        }
        
        /* ===== MODAL ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .modal-content {
            background: var(--bg-primary);
            padding: 2rem;
            border-radius: var(--border-radius);
            max-width: 500px;
            width: 90%;
            position: relative;
            border: 1px solid var(--primary-color);
            animation: slideUp 0.4s;
            box-shadow: 0 0 50px rgba(24, 227, 164, 0.3);
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--primary-color);
            background: none;
            border: none;
            padding: 0.5rem;
            transition: all 0.3s;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-title {
            margin-bottom: 1rem;
            color: var(--primary-color);
            text-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
                min-width: auto;
            }
            
            .search-bar-container.active {
                width: 250px;
            }
            
            .hero {
                padding: 1rem;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .defis-grid {
                grid-template-columns: 1fr;
            }
            
            .swiper-coverflow {
                padding: 2rem 0;
            }
            
            .swiper-button-next,
            .swiper-button-prev {
                display: none;
            }
            
            .magic-btn {
                padding: 0.4rem 0.8rem;
                font-size: 0.9rem;
            }
        }
        
        /* ===== PULSE ANIMATION ===== */
        @keyframes pulse {
            0% {
                box-shadow: 0 0 0 0 rgba(24, 227, 164, 0.7);
            }
            70% {
                box-shadow: 0 0 0 10px rgba(24, 227, 164, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(24, 227, 164, 0);
            }
        }
        
        .pulse {
            animation: pulse 2s infinite;
        }

        .loading-spinner {
            width: 30px;
            height: 30px;
            border: 3px solid transparent;
            border-top-color: var(--primary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
