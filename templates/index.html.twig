<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Midgar - Plateforme de Création Fantasy</title>
    <link rel="stylesheet" href="/css/midgar.css">
</head>
<body>
    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/personnages">Personnages</a></li>
                <li><a href="/oeuvre">Œuvre</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            <a href="/login" class="btn btn-secondary btn-sm">Connexion</a>
            <a href="/register" class="btn btn-primary btn-sm">S'inscrire</a>
        </div>
    </header>

    <main>
        <!-- HERO SECTION -->
        <section class="hero">
            <div class="hero-content">
                <svg class="logo-large" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2.5"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="2"/>
                    <circle cx="35" cy="40" r="4" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="5" fill="#18E3A4"/>
                    <circle cx="50" cy="72" r="4" fill="#18E3A4"/>
                </svg>
                <h1>Midgar</h1>
                <p class="hero-tagline">Créez, partagez et faites vivre vos univers fantasy</p>
                <div class="hero-buttons">
                    <a href="/quiz" class="btn btn-primary">Commencer le Quiz</a>
                    <a href="/universes" class="btn btn-secondary">Créer un Univers</a>
                    <a href="/discover" class="btn btn-secondary">Explorer</a>
                </div>
            </div>
        </section>

        <!-- FEATURED UNIVERSES -->
        <section class="section">
            <div class="container">
                <h2 class="section-title">Univers Populaires</h2>
                <div class="grid grid-3">
                    <div class="card">
                        <div class="card-image" style="background: linear-gradient(135deg, #2A3139, #1A1F1E); font-size: 4rem;">🐉</div>
                        <div class="card-body">
                            <h3 class="card-title">Les Royaumes Oubliés</h3>
                            <p class="card-text">Un monde où les dragons règnent sur les montagnes mystérieuses et les châteaux ancestraux gardent des secrets millénaires.</p>
                            <div class="card-tags">
                                <span class="tag">Fantasy</span>
                                <span class="tag">Dragons</span>
                                <span class="tag">Épique</span>
                            </div>
                            <a href="/universe-detail" class="btn btn-primary btn-sm">Découvrir</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 4rem;">🏰</div>
                        <div class="card-body">
                            <h3 class="card-title">Châteaux Enchantés</h3>
                            <p class="card-text">Des forteresses magiques flottant dans le ciel, habitées par des créatures enchanteresses et des magiciens puissants.</p>
                            <div class="card-tags">
                                <span class="tag">Magie</span>
                                <span class="tag">Châteaux</span>
                                <span class="tag">Héroïque</span>
                            </div>
                            <a href="/universe-detail" class="btn btn-primary btn-sm">Découvrir</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 4rem;">🌙</div>
                        <div class="card-body">
                            <h3 class="card-title">Nuit Éternelle</h3>
                            <p class="card-text">Un univers où la lune règne toujours, révélant des mondes cachés et des mystères nocturnes.</p>
                            <div class="card-tags">
                                <span class="tag">Sombre</span>
                                <span class="tag">Mystérieux</span>
                                <span class="tag">Nocturne</span>
                            </div>
                            <a href="/universe-detail" class="btn btn-primary btn-sm">Découvrir</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- RECENT ARTWORKS -->
        <section class="section" style="background-color: rgba(26, 31, 30, 0.3);">
            <div class="container">
                <h2 class="section-title">Créations Récentes</h2>
                <div class="grid grid-4">
                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">📖</div>
                        <div class="card-body">
                            <h3 class="card-title">L'Épée Légendaire</h3>
                            <p class="card-text">Roman - 15 pages</p>
                            <div class="card-tags">
                                <span class="tag">Roman</span>
                                <span class="tag">Aventure</span>
                            </div>
                            <small style="color: #18E3A4;">Par LunaLight</small>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🎨</div>
                        <div class="card-body">
                            <h3 class="card-title">Guerrière Ailes</h3>
                            <p class="card-text">Illustration</p>
                            <div class="card-tags">
                                <span class="tag">Illustration</span>
                                <span class="tag">Personnage</span>
                            </div>
                            <small style="color: #18E3A4;">Par ArtisanMagique</small>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🗡️</div>
                        <div class="card-body">
                            <h3 class="card-title">Artefacts Perdus</h3>
                            <p class="card-text">Nouvelles - 8 pages</p>
                            <div class="card-tags">
                                <span class="tag">Nouvelle</span>
                                <span class="tag">Mystère</span>
                            </div>
                            <small style="color: #18E3A4;">Par SageEcrivain</small>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">✨</div>
                        <div class="card-body">
                            <h3 class="card-title">Cristaux Magiques</h3>
                            <p class="card-text">Illustration</p>
                            <div class="card-tags">
                                <span class="tag">Illustration</span>
                                <span class="tag">Objet</span>
                            </div>
                            <small style="color: #18E3A4;">Par CristalArtist</small>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ACTIVE CHALLENGES -->
        <section class="section">
            <div class="container">
                <h2 class="section-title">Défis Actuels</h2>
                <div class="grid grid-2">
                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">⚔️</div>
                        <div class="card-body">
                            <h3 class="card-title">Héros Légendaire</h3>
                            <p class="card-text">Créez un héros qui marquera l'histoire. Du design au backstory, tout est permis!</p>
                            <p style="color: #18E3A4; font-weight: 600; margin-top: 1rem;">Fin: 15 Février 2026</p>
                            <a href="/challenges" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Participer</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🌍</div>
                        <div class="card-body">
                            <h3 class="card-title">Monde Souterrain</h3>
                            <p class="card-text">Imaginez un univers sous terre avec ses propres règles, créatures et magie.</p>
                            <p style="color: #18E3A4; font-weight: 600; margin-top: 1rem;">Fin: 22 Février 2026</p>
                            <a href="/challenges" class="btn btn-primary btn-sm" style="margin-top: 1rem;">Participer</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SHOP HIGHLIGHTS -->
        <section class="section" style="background-color: rgba(26, 31, 30, 0.3);">
            <div class="container">
                <h2 class="section-title">Boutique en Vedette</h2>
                <div class="grid grid-4">
                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">📜</div>
                        <div class="card-body">
                            <h3 class="card-title">Grimoire Ancestral</h3>
                            <p style="color: #18E3A4; font-weight: 600;">29,99 €</p>
                            <p class="card-text">Guide complet de création de systèmes magiques</p>
                            <a href="/shop" class="btn btn-primary btn-sm">Ajouter au panier</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🎭</div>
                        <div class="card-body">
                            <h3 class="card-title">Kit Personnage Pro</h3>
                            <p style="color: #18E3A4; font-weight: 600;">39,99 €</p>
                            <p class="card-text">Templates et outils pour créer des personnages complexes</p>
                            <a href="/shop" class="btn btn-primary btn-sm">Ajouter au panier</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🗺️</div>
                        <div class="card-body">
                            <h3 class="card-title">Cartographe Atlas</h3>
                            <p style="color: #18E3A4; font-weight: 600;">49,99 €</p>
                            <p class="card-text">Outils avancés pour créer des mondes détaillés</p>
                            <a href="/shop" class="btn btn-primary btn-sm">Ajouter au panier</a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-image" style="font-size: 3rem;">🎨</div>
                        <div class="card-body">
                            <h3 class="card-title">Pack Artiste Complet</h3>
                            <p style="color: #18E3A4; font-weight: 600;">199,99 €</p>
                            <p class="card-text">Suite complète pour créateurs visuels</p>
                            <a href="/shop" class="btn btn-primary btn-sm">Ajouter au panier</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA SECTION -->
        <section class="section" style="background: linear-gradient(135deg, rgba(24, 227, 164, 0.1), rgba(13, 207, 146, 0.05)); border-radius: 8px; margin: 0 2rem;">
            <div class="container text-center">
                <h2>Prêt à créer votre léggende?</h2>
                <p style="font-size: 1.1rem; margin: 1.5rem 0; color: #B0B9B6;">Rejoignez des milliers de créateurs qui façonnent des univers extraordinaires</p>
                <a href="/register" class="btn btn-primary">Commencer Gratuitement</a>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                        <li><a href="#">Équipe</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions d'utilisation</a></li>
                        <li><a href="#">Politique de confidentialité</a></li>
                        <li><a href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script src="/assets/js/main.js"></script>
</body>
</html>


