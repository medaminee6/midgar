<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tous les Personnages - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .universes-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 6px;
            border: 1px solid #2A3139;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #2A3139;
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: #18E3A4;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: #18E3A4;
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: #E6FFF6;
            font-size: 0.9rem;
            margin: 0;
            flex: 1;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background-color: #0B0F0E;
            border: 1px solid #2A3139;
            border-radius: 4px;
            color: #E6FFF6;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .search-box::placeholder { color: #B0B9B6; }
        .search-box:focus {
            outline: none;
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.2);
        }

        .filter-reset {
            width: 100%;
            padding: 10px;
            background-color: #2A3139;
            color: #18E3A4;
            border: 1px solid #18E3A4;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .filter-reset:hover {
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .universes-section { flex: 1; }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title { margin: 0; }

        .create-cta {
            padding: 12px 24px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }

        .create-cta:hover { background-color: #0DCF92; }

        .universes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card {
            background-color: #1A1F1E;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #2A3139;
            transition: all 0.3s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }

        .universe-card:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.15);
            transform: translateY(-2px);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #E6FFF6;
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: #0B0F0E;
            border: 1px solid #18E3A4;
            color: #18E3A4;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .card-description {
            font-size: 0.85rem;
            color: #B0B9B6;
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: #B0B9B6;
            padding-top: 1rem;
            border-top: 1px solid #2A3139;
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .results-count { color: #B0B9B6; font-size: 0.9rem; }

        .load-more { display: flex; justify-content: center; margin-top: 2rem; }

        .load-more-btn {
            padding: 12px 40px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .load-more-btn:hover { background-color: #0DCF92; }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #B0B9B6;
        }

        .empty-state p { font-size: 1.1rem; margin-bottom: 1rem; }

        @media (max-width: 1024px) {
            .universes-container { grid-template-columns: 1fr; }
            .filter-sidebar { position: static; }
        }

        @media (max-width: 768px) {
            .universes-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/oeuvre">Œuvre</a></li>
                <li><a href="/personnages">Personnages</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            <a href="/login" class="btn btn-secondary btn-sm">Connexion</a>
            <a href="/register" class="btn btn-primary btn-sm">S'inscrire</a>
        </div>
    </header>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <div>
                        <h1 style="margin-bottom: 0.5rem;">Tous les Personnages</h1>
                        <p style="color: #B0B9B6; margin: 0;">Parcourez les personnages créés dans les univers</p>
                    </div>
                    <div class="create-ctas">
                            <a href="{{ path('personnage_new') }}" class="create-cta">+ Créer un Personnage</a>
                        </div>
                </div>

                <div class="universes-container">
                    <div class="filter-sidebar">
                        <form method="get" action="{{ path('personnage_index') }}" id="filterForm">
                            <div class="filter-group">
                                <input type="text" name="search" class="search-box" placeholder="Chercher..." value="{{ app.request.query.get('search') }}">
                            </div>

                            <div class="filter-group">
                                <h4>Classe / Rôle</h4>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-guerrier" name="classRole[]" value="guerrier" class="role-filter" {% if selectedClassRoles and 'guerrier' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-guerrier">Guerrier</label>
                                </div>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-mage" name="classRole[]" value="mage" class="role-filter" {% if selectedClassRoles and 'mage' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-mage">Mage</label>
                                </div>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-escroc" name="classRole[]" value="escroc" class="role-filter" {% if selectedClassRoles and 'escroc' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-escroc">Escroc</label>
                                </div>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-clerc" name="classRole[]" value="clerc" class="role-filter" {% if selectedClassRoles and 'clerc' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-clerc">Clerc</label>
                                </div>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-rodeur" name="classRole[]" value="rodeur" class="role-filter" {% if selectedClassRoles and 'rodeur' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-rodeur">Rôdeur</label>
                                </div>
                                <div class="filter-option">
                                    <input type="checkbox" id="role-other" name="classRole[]" value="other" class="role-filter" {% if selectedClassRoles and 'other' in selectedClassRoles %}checked{% endif %}>
                                    <label for="role-other">Autre</label>
                                </div>
                            </div>

                            <div class="filter-group">
                                <h4>Univers</h4>
                                {% if universes is defined and universes|length > 0 %}
                                    {% for u in universes %}
                                        {% set u_id = u.id ~ '' %}
                                        <div class="filter-option">
                                            <input type="checkbox" id="universe-{{ u.id }}" name="universe[]" value="{{ u.id }}" class="universe-filter" {% if selectedUniverses and u_id in selectedUniverses %}checked{% endif %}>
                                            <label for="universe-{{ u.id }}">{{ u.name }}</label>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <div class="filter-option">
                                        <input type="checkbox" id="universe-all" name="universe[]" value="all" class="universe-filter" checked>
                                        <label for="universe-all">Tous</label>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="filter-group">
                                <h4>Tri</h4>
                                <div class="filter-option">
                                    <input type="radio" id="sort-newest" name="sort" value="newest" class="sort-filter" {% if app.request.query.get('sort') == 'newest' or not app.request.query.get('sort') %}checked{% endif %}>
                                    <label for="sort-newest">Plus récent</label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" id="sort-oldest" name="sort" value="oldest" class="sort-filter" {% if app.request.query.get('sort') == 'oldest' %}checked{% endif %}>
                                    <label for="sort-oldest">Plus ancien</label>
                                </div>
                                <div class="filter-option">
                                    <input type="radio" id="sort-name" name="sort" value="name" class="sort-filter" {% if app.request.query.get('sort') == 'name' %}checked{% endif %}>
                                    <label for="sort-name">Nom (A-Z)</label>
                                </div>
                            </div>

                            <button type="submit" class="filter-reset" style="width: 100%; margin-top: 1rem;">Filtrer</button>
                            <a href="{{ path('personnage_index') }}" class="filter-reset" style="width: 100%; margin-top: 0.5rem; display: block; text-align: center;">Réinitialiser</a>
                        </form>
                    </div>

                    <div class="universes-section">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #2A3139;">
                            <div>
                                <h2 style="margin: 0; color: #E6FFF6;">Personnages</h2>
                                <p style="color: #B0B9B6; margin: 0; font-size: 0.9rem;">Affichage: <a href="/personnages" style="color:#18E3A4;">Personnages</a> • <a href="/universes" style="color:#B0B9B6;">Univers</a></p>
                            </div>
                            <div class="results-count">
                                <span>{{ personnages|length }}</span>
                            </div>
                        </div>

                        <div class="universes-grid" id="universesGrid">
                            {% for p in personnages %}
                                <div class="universe-card" onclick="location.href='{{ path('personnage_show', {'id': p.id}) }}'">
                                    <div class="card-banner">{% if p.getPortraitBase64() %}<img src="{{ p.getPortraitBase64() }}" alt="portrait" style="width:100%;height:160px;object-fit:cover;">{% else %}🧍{% endif %}</div>
                                    <div class="card-content">
                                        <h3 class="card-title">{{ p.name }}</h3>
                                        <div class="card-genre-tags">
                                            <span class="genre-tag">{{ {'warrior':'Guerrier','mage':'Mage','rogue':'Escroc','cleric':'Clerc','ranger':'Rôdeur','other':'Autre'}[p.classRole] ?? p.classRole }}</span>
                                        </div>
                                        <p class="card-description">{{ p.historyContext|slice(0,200) ~ '...' }}</p>
                                        <div class="card-footer">
                                            <div class="card-stats"><div class="stat">Univers: {{ p.universe.name }}</div></div>
                                            <div class="creator-info"><div class="creator-avatar">{{ p.name|first|upper }}</div><span>—</span></div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="empty-state">
                                    <p>😔 Aucun personnage trouvé.</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                        <li><a href="#">Équipe</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions d'utilisation</a></li>
                        <li><a href="#">Politique de confidentialité</a></li>
                        <li><a href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script>
        // Note: Script removed as it's for mock data, real data handled by controller
    </script>
</body>
</html>
