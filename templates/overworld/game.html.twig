            function showFinalResultsScreen() {
                endingSequenceActive = true;
                pauseOverworldMusic();
                stopIntroMedia();
                stopFinalResultsAudio();
                playFinalResultsAudio();

                const overlay = document.getElementById('victory-overlay');
                if (!overlay) return;

