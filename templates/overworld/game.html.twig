            function getSessionSummaryPayload() {
                const totalDefeats = (gameState.defeatedEnemies || []).filter(function(id) {
                    return typeof id === 'string' && !id.includes('_C');
                }).length;
                const totalCollectedCoins = (gameState.collectedCoins || []).length;

                return {
                    playerName: playerName,
                    playerClass: playerClass,
                    runId: GAME_RUN_ID,
                    levelReached: gameState.currentLevel,
                    levelsGained: Math.max(0, gameState.currentLevel - gameState.initialLevel),
                    totalKills: totalDefeats,
                    totalCoins: totalCollectedCoins,
                    killsGained: Math.max(0, totalDefeats - gameState.initialKills),
                    coinsGained: Math.max(0, totalCollectedCoins - gameState.initialCoins),
                    health: gameState.health,
                    mp: gameState.mp,
                    battles: gameState.sessionStats.battles,
                    victories: gameState.sessionStats.victories,
                    defeats: gameState.sessionStats.defeats,
                    statGains: gameState.sessionStats.statGains
                };
            }

            function renderStatBars(statGains) {
                const statItems = [
                    { key: 'attack', label: 'Attack +' },
                    { key: 'defense', label: 'Defense +' },
                    { key: 'magic', label: 'Magic +' },
                    { key: 'agility', label: 'Agility +' }
                ];

                const maxGain = Math.max(1, ...statItems.map(function(item) {
                    return statGains[item.key] || 0;
                }));

                return statItems.map(function(item) {
                    const value = statGains[item.key] || 0;
                    const widthPercent = Math.max(4, Math.round((value / maxGain) * 100));
                    return `
                        <div class="final-stat-row">
                            <div class="final-stat-head">
                                <span>${item.label}</span>
                                <span>+${value}</span>
                            </div>
                            <div class="final-stat-track">
                                <div class="final-stat-fill" style="width:${widthPercent}%;"></div>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            function stopFinalResultsAudio() {
                if (finalResultsAudio) {
                    finalResultsAudio.pause();
                    finalResultsAudio.currentTime = 0;
                }
            }

            function playFinalResultsAudio() {
                if (!finalResultsAudio) {
                    finalResultsAudio = new Audio(FINAL_RESULTS_MEDIA.victoryMusic);
                    finalResultsAudio.loop = true;
                    finalResultsAudio.volume = 0.62;
                }

                finalResultsAudio.currentTime = 0;
                finalResultsAudio.play().catch(() => {});
            }

            function renderPerformanceRing(summary) {
                const battles = Math.max(0, Number(summary.battles) || 0);
                const victories = Math.max(0, Number(summary.victories) || 0);
                const winRate = battles > 0 ? Math.round((victories / battles) * 100) : 100;
                const ringStyle = `background: conic-gradient(#18E3A4 ${winRate}%, rgba(255,255,255,0.12) ${winRate}%);`;

                return `
                    <div class="final-ring" style="${ringStyle}">
                        <div class="final-ring-inner">
                            <div class="final-ring-value">${winRate}%</div>
                            <div class="final-ring-note">Win Rate</div>
                        </div>
                    </div>
                `;
            }

            function saveResultsAsPdf(summary) {
                const popup = window.open('', '_blank', 'width=960,height=760');
                if (!popup) {
                    alert('Pop-up blocked. Please allow pop-ups, then click Save Result as PDF again.');
