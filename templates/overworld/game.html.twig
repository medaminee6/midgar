                                    <div class="bar-track"><div class="bar-fill" style="width:${width}%"></div></div>
                                </div>
                            `;
                        }).join('')}

                        <p class="muted" style="margin-top:16px;">Recovery bonuses: HP restores ${statGains['restore-hp'] || 0}, MP restores ${statGains['restore-mp'] || 0}</p>
                    </body>
                    </html>
                `;

                popup.document.open();
                popup.document.write(printableHtml);
                popup.document.close();
                popup.focus();
                setTimeout(function() {
                    popup.print();
                }, 350);
