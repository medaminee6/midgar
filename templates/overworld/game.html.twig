<!DOCTYPE html>
<html>
<head>
    <title>Overworld - {{ personnage.name|default('Hero') }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            background: #0a0a0a;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        button, input, textarea, select {
            font-family: inherit;
        }

        #world-bg-video {
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            opacity: 0.95;
            pointer-events: none;
        }

        #world-bg-overlay {
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.08) 20%, rgba(0, 0, 0, 0.45) 100%);
            z-index: 1;
            pointer-events: none;
        }
        
        #game-container {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
            z-index: 2;
        }
        
        #game-canvas {
            position: relative;
            width: 800px;
            height: 600px;
            background: rgba(0, 0, 0, 0.18);
            border: 4px solid #444;
            box-shadow: 0 0 50px rgba(0, 0, 0, 0.9);
            overflow: hidden;
        }
        
        #map-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        #collision-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0;
            display: none;
            z-index: 10;
        }
        
        #entities-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 20;
        }
        
        .entity {
            position: absolute;
            transform: translate(-50%, -50%);
            transition: left 0.05s linear, top 0.05s linear;
        }
        
        #player {
            width: 64px;
            height: 64px;
            z-index: 100;
            filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.5));
            background-image: url('{{ asset('assets/adventure/playablecharachter/1F.png') }}');
            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;
            image-rendering: pixelated;
        }
        
        #player img {
            display: none;
        }
        
        .enemy {
            width: 44px;
            height: 44px;
            z-index: 50;
            filter: drop-shadow(0 0 6px rgba(255, 0, 0, 0.6));
            animation: enemyBounce 1s infinite ease-in-out;
        }
        
        .enemy img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        
        .enemy.boss {
            width: 192px;
            height: 192px;
            filter: drop-shadow(0 0 15px rgba(255, 100, 0, 0.8));
        }
        
        @keyframes enemyBounce {
            0%, 100% { transform: translate(-50%, -50%) translateY(0); }
            50% { transform: translate(-50%, -50%) translateY(-8px); }
        }
        
        .coin {
            width: 28px;
            height: 28px;
            z-index: 40;
            filter: drop-shadow(0 0 8px rgba(255, 215, 0, 0.8));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            line-height: 1;
            animation: coinSpin 2s infinite linear;
        }
        
        @keyframes coinSpin {
            0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); }
            50% { transform: translate(-50%, -50%) rotate(180deg) scale(1.08); }
            100% { transform: translate(-50%, -50%) rotate(360deg) scale(1); }
        }
        
        .exit-portal {
            width: 60px;
            height: 70px;
            z-index: 30;
            filter: drop-shadow(0 0 20px rgba(0, 255, 100, 0.8));
            animation: portalPulse 1.5s infinite ease-in-out;
        }
        
        .exit-portal::before {
            content: '🌟';
            font-size: 48px;
            display: block;
            text-align: center;
            line-height: 70px;
        }
        
        .door {
            width: 60px;
            height: 80px;
            z-index: 100;
            filter: drop-shadow(0 0 20px rgba(100, 149, 237, 0.8));
            animation: portalPulse 1.5s infinite ease-in-out;
            cursor: pointer;
        }
        
        .door::before {
            content: '🚪';
            font-size: 48px;
            display: block;
            text-align: center;
            line-height: 80px;
        }
        
        .door.hidden {
            display: none;
        }
        
        @keyframes portalPulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.8; }
            50% { transform: translate(-50%, -50%) scale(1.15); opacity: 1; }
        }
        
        .exit-portal.hidden {
            display: none;
        }
        
        /* Collision indicator */
        .wall-indicator {
            display: none;
        }
        
        .wall-indicator.active {
            display: block;
        }
        
        @keyframes wallBump {
            0% { transform: translate(-50%, -50%) scale(1.5); }
            100% { transform: translate(-50%, -50%) scale(1); }
        }
        
        #hud {
            position: fixed;
            top: 20px;
            left: 20px;
            background: linear-gradient(145deg, rgba(24, 24, 24, 0.82), rgba(52, 52, 52, 0.62));
            border: 1px solid rgba(255, 255, 255, 0.24);
            border-radius: 16px;
            padding: 18px 20px;
            color: #fff;
            z-index: 1000;
            min-width: 250px;
            box-shadow: 0 10px 26px rgba(0, 0, 0, 0.32);
            backdrop-filter: blur(6px);
            overflow: hidden;
        }

        #hud::before {
            content: '';
            position: absolute;
            top: -60%;
            left: -20%;
            width: 80%;
            height: 220%;
            background: linear-gradient(120deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0));
            pointer-events: none;
        }

        .menu-theme-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            opacity: 0.45;
            pointer-events: none;
        }

        .menu-theme-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0, 0, 0, 0.28) 0%, rgba(0, 0, 0, 0.68) 100%);
            z-index: -1;
            pointer-events: none;
        }
        
        #hud h3 {
            color: #ffffff;
            margin-bottom: 14px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            padding-bottom: 8px;
            text-shadow: 0 1px 8px rgba(0, 0, 0, 0.65);
        }
        
        .hud-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 10px 0;
            padding: 9px 10px;
            font-size: 15px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 10px;
        }
        
        .hud-label {
            color: #f0f0f0;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .hud-symbol {
            font-size: 14px;
            opacity: 0.95;
        }

        .coin-emoji {
            font-size: 15px;
            line-height: 1;
        }
        
        .hud-value {
            color: #fff;
            font-weight: bold;
            font-size: 16px;
        }
        
        .hud-value.kills {
            color: #ffb1b1;
        }
        
        .hud-value.coins {
            color: #ffdf68;
            text-shadow: 0 0 12px rgba(255, 209, 51, 0.55);
        }

        .hud-new-run {
            background: linear-gradient(135deg, #ff7676, #bc2f2f);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: 0.3px;
            box-shadow: 0 6px 14px rgba(170, 35, 35, 0.32);
        }

        .hud-new-run:hover {
            filter: brightness(1.08);
        }
        
        #level-indicator {
            position: fixed;
            top: 20px;
            right: 20px;
            background: rgba(0, 0, 0, 0.55);
            border: 2px solid rgba(255, 255, 255, 0.28);
            border-radius: 12px;
            padding: 15px 25px;
            color: #fff;
            z-index: 1000;
            box-shadow: 0 0 24px rgba(0, 0, 0, 0.45);
            overflow: hidden;
            backdrop-filter: blur(2px);
        }
        
        #level-indicator h2 {
            color: #f6f6f6;
            font-size: 20px;
            margin: 0;
            text-shadow: 0 0 12px rgba(0, 0, 0, 0.8);
        }
        
        #battle-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0a0a0a;
            z-index: 2000;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        #battle-overlay.hidden {
            display: none;
        }
        
        #battle-container {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        #battle-overlay h1 {
            color: #DDF247;
            font-size: 56px;
            margin-bottom: 30px;
            text-shadow: 0 0 40px rgba(221, 242, 71, 0.6);
            animation: battleTextPulse 1s infinite;
        }
        
        @keyframes battleTextPulse {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.02); }
        }
        
        #battle-iframe {
            width: 90%;
            max-width: 1000px;
            height: 75%;
            border: 3px solid #444;
            border-radius: 12px;
            background: #000;
        }
        
        #battle-close {
            margin-top: 20px;
            padding: 12px 30px;
            background: #444;
            border: none;
            color: #fff;
            font-size: 16px;
            border-radius: 8px;
            cursor: pointer;
            font-family: inherit;
        }
        
        #battle-close:hover {
            background: #555;
        }
        
        #victory-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 3000;
            display: none;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        #victory-overlay.active {
            display: flex;
        }
        
        #victory-overlay h1 {
            color: #ffd700;
            font-size: 72px;
            margin-bottom: 30px;
            text-shadow: 0 0 60px rgba(255, 215, 0, 0.8);
            animation: victoryPulse 1.5s infinite;
        }
        
        @keyframes victoryPulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.08); }
        }
        
        #victory-overlay p {
            color: #fff;
            font-size: 28px;
            margin-bottom: 40px;
        }
        
        #victory-overlay button {
            background: linear-gradient(135deg, #4a4, #6b6);
            border: none;
            color: #fff;
            padding: 18px 50px;
            font-size: 20px;
            border-radius: 12px;
            cursor: pointer;
            font-family: inherit;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 0 30px rgba(0, 255, 0, 0.4);
        }
        
        #victory-overlay button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 50px rgba(0, 255, 0, 0.6);
        }

        .final-results-root {
            position: fixed;
            inset: 0;
            overflow: hidden;
            background: #0b0f10;
        }

        .final-results-bg-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.9;
        }

        .final-results-dim {
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 18% 22%, rgba(24, 227, 164, 0.2) 0%, rgba(11, 15, 16, 0.9) 42%, rgba(8, 11, 12, 0.95) 100%);
        }

        .final-results-shell {
            position: relative;
            z-index: 2;
            width: min(1160px, 95vw);
            max-height: 92vh;
            margin: 4vh auto;
            overflow: auto;
            border-radius: 18px;
            border: 1px solid rgba(24, 227, 164, 0.34);
            background: linear-gradient(150deg, rgba(12, 18, 19, 0.9), rgba(16, 25, 24, 0.76));
            box-shadow: 0 26px 60px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(8px);
            padding: 26px;
        }

        .final-results-title {
            margin: 0;
            color: #18E3A4;
            font-size: clamp(30px, 4vw, 44px);
            font-weight: 800;
            letter-spacing: 0.01em;
            animation: none !important;
            transform: none !important;
        }

        .final-results-subtitle {
            margin: 10px 0 0;
            color: #d8ece6;
            font-size: clamp(16px, 2.1vw, 20px);
            line-height: 1.45;
            max-width: 900px;
        }

        .final-kpi-grid {
            margin-top: 22px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }

        .final-kpi {
            border-radius: 12px;
            padding: 12px 14px;
            background: rgba(26, 31, 30, 0.6);
            border: 1px solid rgba(24, 227, 164, 0.16);
        }

        .final-kpi-label {
            color: #9ac9bb;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 4px;
        }

        .final-kpi-value {
            color: #f1fffa;
            font-size: 22px;
            font-weight: 700;
        }

        .final-charts {
            margin-top: 18px;
            display: grid;
            grid-template-columns: 280px 1fr;
            gap: 16px;
        }

        .final-chart-card {
            border-radius: 14px;
            padding: 16px;
            background: rgba(15, 23, 22, 0.72);
            border: 1px solid rgba(24, 227, 164, 0.2);
        }

        .final-chart-title {
            margin: 0 0 12px;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.09em;
            color: #9fd4c5;
            font-weight: 700;
        }

        .final-ring {
            width: 170px;
            height: 170px;
            border-radius: 999px;
            margin: 4px auto 10px;
            display: grid;
            place-items: center;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08), 0 12px 32px rgba(0, 0, 0, 0.34);
        }

        .final-ring-inner {
            width: 128px;
            height: 128px;
            border-radius: 999px;
            background: rgba(10, 15, 15, 0.95);
            display: grid;
            place-items: center;
            border: 1px solid rgba(24, 227, 164, 0.22);
            color: #f4fffb;
            text-align: center;
            line-height: 1.2;
        }

        .final-ring-value {
            font-size: 34px;
            font-weight: 800;
            color: #18E3A4;
        }

        .final-ring-note {
            font-size: 12px;
            color: #9ac9bb;
        }

        .final-stat-row {
            margin-bottom: 12px;
        }

        .final-stat-head {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            color: #d8ece6;
            margin-bottom: 6px;
            letter-spacing: 0.02em;
        }

        .final-stat-track {
            width: 100%;
            height: 12px;
            border-radius: 999px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .final-stat-fill {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #18E3A4, #8cf7d5);
            box-shadow: 0 0 16px rgba(24, 227, 164, 0.4);
        }

        .final-extra-note {
            margin-top: 10px;
            color: #afd6ca;
            font-size: 13px;
        }

        .final-actions {
            margin-top: 20px;
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            flex-wrap: wrap;
        }

        .final-action-btn {
            border: none;
            border-radius: 10px;
            padding: 11px 16px;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 0.01em;
            cursor: pointer;
            transition: transform 0.16s ease, box-shadow 0.2s ease, filter 0.2s ease;
        }

        .final-action-btn:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
        }

        .final-action-btn.secondary {
            color: #d8ece6;
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.22);
        }

        .final-action-btn.primary {
            color: #081210;
            background: #18E3A4;
            box-shadow: 0 10px 24px rgba(24, 227, 164, 0.3);
        }

        @media (max-width: 880px) {
            .final-charts {
                grid-template-columns: 1fr;
            }

            .final-results-shell {
                padding: 18px;
            }
        }
        
        #loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0a0a0a;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        
        #loading-screen h1 {
            color: #4a4;
            font-size: 42px;
            margin-bottom: 25px;
            text-shadow: 0 0 30px rgba(0, 255, 0, 0.5);
        }
        
        #loading-screen p {
            color: #666;
            margin-bottom: 25px;
            font-size: 16px;
            max-width: 760px;
            line-height: 1.5;
            text-align: center;
        }

        #intro-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.92);
            z-index: 3000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 30px;
            overflow: hidden;
        }

        #intro-overlay.active {
            display: flex;
        }

        .intro-video {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
            opacity: 0.45;
        }

        .intro-backdrop {
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0.25) 0%, rgba(0,0,0,0.72) 100%);
            z-index: 1;
        }

        .intro-card {
            width: min(900px, 92vw);
            background: rgba(14, 14, 14, 0.95);
            border: 3px solid #DDF247;
            border-radius: 14px;
            box-shadow: 0 0 35px rgba(221, 242, 71, 0.2);
            padding: 24px;
            color: #fff;
            position: relative;
            z-index: 2;
        }

        .intro-title {
            font-size: 28px;
            color: #DDF247;
            margin-bottom: 14px;
            letter-spacing: 1px;
        }

        .intro-story {
            font-size: 18px;
            line-height: 1.7;
            min-height: 220px;
            max-height: 50vh;
            overflow-y: auto;
            white-space: pre-line;
            color: #f4f4f4;
            text-shadow: 0 0 8px rgba(0,0,0,0.45);
        }

        .intro-controls {
            margin-top: 18px;
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }

        .intro-btn {
            border: none;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 14px;
            cursor: pointer;
            font-family: inherit;
        }

        .intro-btn.skip {
            background: #3a3a3a;
            color: #fff;
        }

        .intro-btn.next {
            background: #2a3f66;
            color: #fff;
        }

        .intro-btn.start {
            background: #DDF247;
            color: #141414;
            font-weight: bold;
        }
        
        .loading-bar {
            width: 350px;
            height: 12px;
            background: #222;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #333;
        }
        
        .loading-bar-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #4a4, #8f8);
            transition: width 0.3s;
        }
        
        #controls-hint {
            position: fixed;
            bottom: 25px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.78);
            color: #f1f1f1;
            padding: 12px 25px;
            border-radius: 25px;
            font-size: 14px;
            z-index: 1000;
            border: 1px solid rgba(255, 255, 255, 0.24);
            box-shadow: 0 0 16px rgba(0, 0, 0, 0.4);
        }
        
        /* Enemy tooltip */
        .enemy-tooltip {
            position: absolute;
            background: rgba(0, 0, 0, 0.9);
            color: #f55;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            white-space: nowrap;
            pointer-events: none;
            z-index: 60;
            display: none;
            border: 1px solid #f55;
        }
        
        .enemy:hover .enemy-tooltip {
            display: block;
        }
    </style>
</head>
<body>
    <video id="world-bg-video" autoplay muted loop playsinline preload="metadata"></video>
    <div id="world-bg-overlay"></div>

    <!-- Loading Screen -->
    <div id="loading-screen">
        <h1>🌍 OVERWORLD</h1>
        <p id="loading-story-text">Loading adventure...</p>
        <div class="loading-bar">
            <div class="loading-bar-fill" id="loading-progress"></div>
        </div>
    </div>

    <div id="intro-overlay">
        <video id="intro-cinematic" class="intro-video" autoplay loop muted playsinline preload="auto"></video>
        <div class="intro-backdrop"></div>
        <div class="intro-card">
            <div class="intro-title">Quest Briefing</div>
            <div class="intro-story" id="intro-story-text">Preparing your story...</div>
            <div class="intro-controls">
                <button class="intro-btn next" id="intro-next-btn">Next Story</button>
                <button class="intro-btn skip" id="intro-skip-btn">Skip & Start Gameplay</button>
            </div>
        </div>
    </div>
    
    <!-- Wall Collision Indicator -->
    <div class="wall-indicator" id="wall-indicator">🚫 WALL</div>
    
    <!-- HUD -->
    <div id="hud">
        <h3>Adventure Status</h3>
