            async function ensureFreshStartVitals() {
                const isFreshLevelOneRun = gameState.currentLevel === 1
                    && gameState.defeatedEnemies.length === 0
                    && gameState.collectedCoins.length === 0
                    && gameState.kills === 0
                    && gameState.coins === 0;

                if (!isFreshLevelOneRun) return;

                try {
                    const response = await fetch('/api/game/personnage/' + personnageId);
                    if (!response.ok) return;
                    const data = await response.json();
                    const defense = Math.max(0, Number(data?.stats?.defense) || 0);
                    const magic = Math.max(0, Number(data?.stats?.magic) || 0);
                    const maxHp = Math.min(999, 120 + (defense * 8));
                    const maxMp = Math.min(999, 80 + (magic * 8));
                    gameState.health = maxHp;
                    gameState.mp = maxMp;
                    console.log('[VITALS] Fresh start at Level 1, set HP/MP to max:', maxHp, maxMp);
                } catch (e) {
                    console.warn('[VITALS] Could not set fresh start vitals:', e);
                }
            }

            async function beginGameplayAfterIntro() {
                if (introDismissed) return;
                introDismissed = true;
                introState = 'GAMEPLAY';
                gameState.battleActive = false;
                try { localStorage.setItem(introStorageKey, '1'); } catch (e) {}
                const introOverlay = document.getElementById('intro-overlay');
                if (introOverlay) {
                    introOverlay.classList.remove('active');
                }
                stopIntroMedia();
                await ensureFreshStartVitals();
                bootstrapGameplay();
            }

            function generateNextIntroStory() {
                if (introState !== 'STORY') return;

                const nextBtn = document.getElementById('intro-next-btn');
                const introTextEl = document.getElementById('intro-story-text');
                if (nextBtn) {
                    nextBtn.disabled = true;
                    nextBtn.textContent = 'Generating...';
                }
                if (introTextEl) {
                    introTextEl.textContent = 'Forging a new legend...';
                }

                loadGeneratedUniverseStory(true)
                    .then(function(story) {
                        if (introTextEl) {
                            introTextEl.textContent = story || generatedLaunchStory;
                        }
                        playIntroMedia();
                    })
                    .finally(function() {
                        if (nextBtn) {
                            nextBtn.disabled = false;
                            nextBtn.textContent = 'Next Story';
                        }
                    });
            }

            function bootstrapGameplay() {
                if (gameplayBootstrapped) return;
                gameplayBootstrapped = true;

                // Set canvas size - will be updated when collision map loads
                collisionCanvas.width = 1;
                collisionCanvas.height = 1;

                // Load the saved level (or default to level 1)
                loadLevel({{ savedLevel|default(1) }});

                // Setup overworld music and unlock handler
                initOverworldMusic();

                // Check if we should show door based on saved progress
                setTimeout(function() {
                    checkLevelComplete();
                }, 1000);

                // Setup input handlers
                setupInputHandlers();

                // Start game loop
                requestAnimationFrame(gameLoop);
            }

            function bindIntroControls() {
                const skipBtn = document.getElementById('intro-skip-btn');
                const nextBtn = document.getElementById('intro-next-btn');

                if (skipBtn) skipBtn.addEventListener('click', beginGameplayAfterIntro);
                if (nextBtn) nextBtn.addEventListener('click', generateNextIntroStory);

                document.addEventListener('keydown', function(e) {
                    if (!introDismissed && (e.key === ' ' || e.key === 'Enter' || e.key === 'Escape')) {
                        e.preventDefault();
                        beginGameplayAfterIntro();
                    }
                });
            }

            function showIntroOverlay(storyText) {
                if (introShownOnce || introState === 'GAMEPLAY') {
                    return;
                }
                introShownOnce = true;
                introState = 'STORY';

                const loadingScreen = document.getElementById('loading-screen');
                if (loadingScreen) {
                    loadingScreen.style.display = 'none';
                }

                const overlay = document.getElementById('intro-overlay');
                const introTextEl = document.getElementById('intro-story-text');
                if (!overlay || !introTextEl) {
                    beginGameplayAfterIntro();
                    return;
                }

                const finalStory = storyText || generatedLaunchStory || (playerName + ' the ' + playerClass + ', your quest begins now.');
                introTextEl.textContent = finalStory;
                overlay.classList.add('active');
                pauseOverworldMusic();
                playIntroMedia();
            }
            
            // DOM Elements
            let gameCanvas, collisionCanvas, collisionCtx, entitiesLayer, playerEl;
            let loadingProgress, killsDisplay, coinsDisplay, levelName;
            let battleOverlay, battleIframe, victoryOverlay, levelCompleteOverlay, wallIndicator;
            
            // Initialize game
            function init() {
                console.log('=== OVERWORLD GAME INITIALIZING ===');
                console.log('Loading from database - Level:', {{ savedLevel|default(1)|default(1) }}, 'Health:', {{ savedHealth|default(100)|default(100) }}, 'MP:', {{ savedMp|default(50)|default(50) }});
                console.log('Defeated enemies:', {{ defeatedEnemies|json_encode|default('[]')|raw }});
                console.log('Loading game assets and setting up...');
                
                // Get DOM elements
                gameCanvas = document.getElementById('game-canvas');
                collisionCanvas = document.getElementById('collision-layer');
                collisionCtx = collisionCanvas.getContext('2d');
                entitiesLayer = document.getElementById('entities-layer');
                playerEl = document.getElementById('player');
                
                // Set default player sprite (facing down)
                playerEl.style.backgroundImage = "url('{{ asset('assets/adventure/playablecharachter/1F.png') }}')";
                playerEl.style.backgroundSize = "contain";
                playerEl.style.backgroundPosition = "center";
                
                loadingProgress = document.getElementById('loading-progress');
                killsDisplay = document.getElementById('kills-display');
                coinsDisplay = document.getElementById('coins-display');
                levelName = document.getElementById('level-name');
                
                battleOverlay = document.getElementById('battle-overlay');
                battleIframe = document.getElementById('battle-iframe');
                victoryOverlay = document.getElementById('victory-overlay');
                levelCompleteOverlay = document.getElementById('level-complete-overlay');
                wallIndicator = document.getElementById('wall-indicator');

                if (IS_FRESH_RUN) {
                    try { localStorage.removeItem(introStorageKey); } catch (e) {}
                }

                const introAlreadySeen = (() => {
                    try {
                        return localStorage.getItem(introStorageKey) === '1';
                    } catch (e) {
                        return false;
                    }
                })();

                if (introAlreadySeen && !IS_FRESH_RUN) {
                    introDismissed = true;
                    introState = 'GAMEPLAY';
                    gameState.battleActive = false;
                    const loadingScreen = document.getElementById('loading-screen');
                    if (loadingScreen) {
                        loadingScreen.style.display = 'none';
                    }
                    bootstrapGameplay();
                    return;
                }

                generatedStoryPromise = loadGeneratedUniverseStory();
                bindIntroControls();

                // Keep gameplay paused and unloaded until the player skips intro
                gameState.battleActive = true;

                Promise.resolve(generatedStoryPromise)
                    .then(function(story) {
                        showIntroOverlay(story);
                    })
                    .catch(function() {
                        showIntroOverlay(generatedLaunchStory);
                    });
            }
            
            // Load a level
            function loadLevel(levelNum) {
                console.log('Loading level:', levelNum);
                
                const level = LEVELS[levelNum];
                if (!level) {
                    console.error('Level not found:', levelNum);
                    return;
                }
                
                // Update current level
                gameState.currentLevel = levelNum;
                
                // Reset kills and coins for this level (per-level tracking)
                // These are "current level" stats that reset when changing levels
                // But we need to count defeated enemies for THIS level from the database
                const levelPrefix = 'L' + levelNum + '_';
                const levelKills = gameState.defeatedEnemies.filter(function(id) {
                    return id.startsWith('L' + levelNum + '_') && !id.includes('_C');
                }).length;
                
                // Count collected coins for this level
                const levelCoins = gameState.collectedCoins.filter(function(id) {
                    return id.startsWith('L' + levelNum + '_C');
                }).length;
                
                gameState.kills = levelKills;
                gameState.coins = levelCoins;
                
                console.log('Level ' + levelNum + ' loaded - Kills: ' + levelKills + ', Coins: ' + levelCoins);
                console.log('Defeated enemies:', gameState.defeatedEnemies);
                console.log('Collected coins:', gameState.collectedCoins);
                // collectedCoins persists - we keep ALL collected coins from all levels
                // so they don't respawn when changing levels
                
                gameState.exitVisible = false;
                gameState.doorVisible = false;
                gameState.levelTransitioning = false;
                if (gameState.doorElement) {
                    gameState.doorElement.remove();
                    gameState.doorElement = null;
                }
                gameState.playerX = 100;
                gameState.playerY = 300;
                
                // Update HUD
                updateHUD();
                levelName.textContent = 'Level ' + levelNum + ': ' + level.name;
                applyMenuTheme(levelNum);
                playLevelMusic(levelNum);
                
                // Auto-save progress (save level change)
                saveProgress(0, 0, null, gameState.kills, gameState.coins, gameState.collectedCoins);
                
                // Load map image
                const mapImg = document.getElementById('map-layer');
                mapImg.src = level.mapImage;
                
                // Also load collision map overlay
                const collisionOverlay = document.getElementById('collision-overlay');
                collisionOverlay.src = level.collisionImage;
                
                // No offset needed - map and collision are same size
                collisionOverlay.style.left = '0px';
                
                // Wait for map to load then load collision
                mapImg.onload = function() {
                    gameState.mapDimensions = {
                        width: mapImg.naturalWidth || CONFIG.CANVAS_WIDTH,
                        height: mapImg.naturalHeight || CONFIG.CANVAS_HEIGHT
                    };
                    updateLoadingProgress(30);
                    loadCollisionMap(level.collisionImage);
                };
            }
            
            // Load collision map and scale it the same way the map is drawn (object-fit: cover)
            function loadCollisionMap(collisionUrl) {
                console.log('Loading collision map:', collisionUrl);

                const collisionImg = new Image();
                collisionImg.onload = function() {
                    const canvasW = CONFIG.CANVAS_WIDTH;
                    const canvasH = CONFIG.CANVAS_HEIGHT;

                    // Match how the map is rendered with object-fit: cover
                    const refWidth = (gameState.mapDimensions && gameState.mapDimensions.width) || collisionImg.width;
                    const refHeight = (gameState.mapDimensions && gameState.mapDimensions.height) || collisionImg.height;
                    const scale = Math.max(canvasW / refWidth, canvasH / refHeight);
                    const drawW = refWidth * scale;
                    const drawH = refHeight * scale;
                    const offsetX = (canvasW - drawW) / 2;
                    const offsetY = (canvasH - drawH) / 2;

                    collisionCanvas.width = canvasW;
                    collisionCanvas.height = canvasH;
                    collisionCtx.clearRect(0, 0, canvasW, canvasH);
                    collisionCtx.drawImage(collisionImg, offsetX, offsetY, drawW, drawH);

                    gameState.collisionData = collisionCtx.getImageData(0, 0, canvasW, canvasH);
                    gameState.collisionTransform = {
                        scale: scale,
                        offsetX: offsetX,
                        offsetY: offsetY,
                        sourceWidth: collisionImg.width,
                        sourceHeight: collisionImg.height
                    };

                    console.log('Collision loaded with cover scaling', gameState.collisionTransform);

                    // Build reachability and ensure player spawn is on a walkable area
                    const spawnPoint = buildReachabilityFromPoint(gameState.playerX, gameState.playerY);
                    if (spawnPoint) {
                        gameState.playerX = spawnPoint.x;
                        gameState.playerY = spawnPoint.y;
                    }

                    updateLoadingProgress(60);
                    spawnEntities();
                };
                collisionImg.src = collisionUrl;
            }
            
            // Spawn enemies and coins
            function spawnEntities() {
                const level = LEVELS[gameState.currentLevel];
                
                console.log('Spawning entities for level:', gameState.currentLevel);
                console.log('Defeated enemies list:', gameState.defeatedEnemies);
                console.log('Level enemies:', level.enemies);
                console.log('Collected coins list:', gameState.collectedCoins);
                
                // Clear existing entities (keep player)
                entitiesLayer.querySelectorAll('.enemy, .coin, .exit-portal').forEach(el => el.remove());
                
                // Spawn enemies with real sprites - filter out defeated enemies and wall positions
                const allEnemies = level.enemies;
                const defeatedList = gameState.defeatedEnemies;
                gameState.enemies = allEnemies
                    .filter(e => {
                        const isDefeated = defeatedList.includes(e.id);
                        if (isDefeated) {
                            console.log('Filtering out defeated enemy:', e.id);
                        }
                        return !isDefeated;
                    })
                    .map(e => ({
                        ...e,
                        alive: true,
                        element: null
                    }));
                
                console.log('Spawning enemies:', gameState.enemies);
                
                gameState.enemies.forEach(enemy => {
                    const enemySize = enemy.isBoss ? CONFIG.BOSS_SIZE : CONFIG.ENEMY_SIZE;
                    const spawnPoint = findNearestReachablePoint(enemy.x, enemy.y, enemySize);
                    enemy.x = spawnPoint.x;
                    enemy.y = spawnPoint.y;
                    const el = document.createElement('div');
                    el.className = 'entity enemy' + (enemy.isBoss ? ' boss' : '');
                    el.id = 'enemy-' + enemy.id;
                    el.style.left = enemy.x + 'px';
                    el.style.top = enemy.y + 'px';
                    
                    // Use real enemy sprite
                    const spritePath = ENEMY_SPRITES[enemy.sprite];
                    el.innerHTML = '<img src="' + spritePath + '" alt="Enemy" /><div class="enemy-tooltip">' + (enemy.isBoss ? 'BOSS!' : 'Enemy') + '</div>';
                    
                    entitiesLayer.appendChild(el);
                    enemy.element = el;
                });
                
                // Spawn coins with sprite - filter out collected coins and wall positions
                gameState.coinsOnMap = level.coins
                    .filter(c => {
                        const isCollected = gameState.collectedCoins.includes(c.id);
                        return !isCollected;
                    })
                    .map(c => ({
                        ...c,
                        collected: false,
                        element: null
                    }));
                
                console.log('Spawning coins:', gameState.coinsOnMap);
                
                gameState.coinsOnMap.forEach(coin => {
                    const spawnPoint = findNearestReachablePoint(coin.x, coin.y, CONFIG.COIN_SIZE);
                    coin.x = spawnPoint.x;
                    coin.y = spawnPoint.y;
                    const el = document.createElement('div');
                    el.className = 'entity coin';
                    el.id = 'coin-' + coin.id;
                    el.style.left = coin.x + 'px';
                    el.style.top = coin.y + 'px';
                    el.textContent = '🪙';
                    entitiesLayer.appendChild(el);
                    coin.element = el;
                });
                
                // Spawn door (appears when all enemies and coins are collected)
                const doorEl = document.createElement('div');
                doorEl.className = 'entity door hidden';
                doorEl.id = 'door';
                const doorPoint = findNearestReachablePoint(650, 300, CONFIG.EXIT_SIZE);
                doorEl.style.left = doorPoint.x + 'px';
                doorEl.style.top = doorPoint.y + 'px';
                entitiesLayer.appendChild(doorEl);
                gameState.doorElement = doorEl;
                
                // Spawn exit portal (hidden, for compatibility)
                if (level.exit) {
                    const exitEl = document.createElement('div');
                    exitEl.className = 'entity exit-portal hidden';
                    exitEl.id = 'exit-portal';
                    const exitPoint = findNearestReachablePoint(level.exit.x, level.exit.y, CONFIG.EXIT_SIZE);
                    exitEl.style.left = exitPoint.x + 'px';
                    exitEl.style.top = exitPoint.y + 'px';
                    entitiesLayer.appendChild(exitEl);
                    gameState.exitElement = exitEl;
                }
                
                updateLoadingProgress(100);
            }
            
            // Update loading progress bar
            function updateLoadingProgress(percent) {
                loadingProgress.style.width = percent + '%';
            }

            function isWallPixel(x, y) {
                if (!gameState.collisionData) return false;

                const collisionWidth = collisionCanvas.width || CONFIG.CANVAS_WIDTH;
                const collisionHeight = collisionCanvas.height || CONFIG.CANVAS_HEIGHT;

                const canvasX = Math.floor(Math.max(0, Math.min(collisionWidth - 1, x)));
                const canvasY = Math.floor(Math.max(0, Math.min(collisionHeight - 1, y)));
                const index = (canvasY * collisionWidth + canvasX) * 4;
                const r = gameState.collisionData.data[index];
                const g = gameState.collisionData.data[index + 1];
                const b = gameState.collisionData.data[index + 2];

                // Wall color #ED1C24 = RGB(237, 28, 36)
                const WALL_R = 237;
                const WALL_G = 28;
                const WALL_B = 36;
                const TOLERANCE = 30;

                return (
                    Math.abs(r - WALL_R) <= TOLERANCE &&
                    Math.abs(g - WALL_G) <= TOLERANCE &&
                    Math.abs(b - WALL_B) <= TOLERANCE
                );
            }

            function clampToCanvas(point) {
                return {
                    x: Math.max(10, Math.min(CONFIG.CANVAS_WIDTH - 10, point.x)),
                    y: Math.max(10, Math.min(CONFIG.CANVAS_HEIGHT - 10, point.y))
                };
            }

            function getCellForPoint(x, y, cellSize) {
                return {
                    x: Math.floor(x / cellSize),
                    y: Math.floor(y / cellSize)
                };
            }

            function getCellCenter(cellX, cellY, cellSize) {
                return {
                    x: cellX * cellSize + cellSize / 2,
                    y: cellY * cellSize + cellSize / 2
                };
            }

            function findNearestWalkableCell(startCell, walkable, width, height) {
                const maxRadius = Math.max(width, height);
                for (let radius = 0; radius <= maxRadius; radius++) {
                    for (let dy = -radius; dy <= radius; dy++) {
                        for (let dx = -radius; dx <= radius; dx++) {
                            if (Math.abs(dx) !== radius && Math.abs(dy) !== radius) {
                                continue;
                            }
                            const cellX = startCell.x + dx;
                            const cellY = startCell.y + dy;
                            if (cellX < 0 || cellX >= width || cellY < 0 || cellY >= height) {
                                continue;
                            }
                            const idx = cellY * width + cellX;
                            if (walkable[idx] === 1) {
                                return { x: cellX, y: cellY };
                            }
                        }
                    }
                }

                return null;
            }

            function buildReachabilityFromPoint(startX, startY) {
                if (!gameState.collisionData) return null;

                const cellSize = 8;
                const width = Math.ceil(CONFIG.CANVAS_WIDTH / cellSize);
                const height = Math.ceil(CONFIG.CANVAS_HEIGHT / cellSize);
                const walkable = new Uint8Array(width * height);

                for (let y = 0; y < height; y++) {
                    for (let x = 0; x < width; x++) {
                        const center = getCellCenter(x, y, cellSize);
                        if (!isWallPixel(center.x, center.y)) {
                            walkable[y * width + x] = 1;
                        }
                    }
                }

                const startCell = getCellForPoint(startX, startY, cellSize);
                const safeStart = findNearestWalkableCell(startCell, walkable, width, height);

                const reachable = new Uint8Array(width * height);
                if (safeStart) {
                    const queue = [safeStart];
                    reachable[safeStart.y * width + safeStart.x] = 1;
                    for (let i = 0; i < queue.length; i++) {
                        const cell = queue[i];
                        const neighbors = [
                            { x: cell.x + 1, y: cell.y },
                            { x: cell.x - 1, y: cell.y },
                            { x: cell.x, y: cell.y + 1 },
                            { x: cell.x, y: cell.y - 1 }
                        ];
                        for (const neighbor of neighbors) {
                            if (neighbor.x < 0 || neighbor.x >= width || neighbor.y < 0 || neighbor.y >= height) {
                                continue;
                            }
                            const idx = neighbor.y * width + neighbor.x;
                            if (reachable[idx] === 1 || walkable[idx] === 0) {
                                continue;
                            }
                            reachable[idx] = 1;
                            queue.push(neighbor);
                        }
                    }
                }

                gameState.reachability = {
                    cellSize: cellSize,
                    width: width,
                    height: height,
                    walkable: walkable,
                    reachable: reachable,
                    startCell: safeStart
                };

                if (!safeStart) {
                    return null;
                }

                const startPoint = getCellCenter(safeStart.x, safeStart.y, cellSize);
                return clampToCanvas(startPoint);
            }

            function isBlockedForEntity(x, y, size) {
                const probeSize = Math.max(8, size - 6);
                return isColliding(x, y, probeSize);
            }

            function findNearestReachablePoint(x, y, size) {
                const reachability = gameState.reachability;
                if (!reachability) {
                    return { x: x, y: y };
                }

                const cellSize = reachability.cellSize;
                const width = reachability.width;
                const height = reachability.height;
                const startCell = getCellForPoint(x, y, cellSize);

                const isCellReachable = function(cellX, cellY) {
                    if (cellX < 0 || cellX >= width || cellY < 0 || cellY >= height) {
                        return false;
                    }
                    return reachability.reachable[cellY * width + cellX] === 1;
                };

                if (isCellReachable(startCell.x, startCell.y) && !isBlockedForEntity(x, y, size)) {
                    return { x: x, y: y };
                }

                const maxRadius = Math.max(width, height);
                for (let radius = 1; radius <= maxRadius; radius++) {
                    for (let dy = -radius; dy <= radius; dy++) {
                        for (let dx = -radius; dx <= radius; dx++) {
                            if (Math.abs(dx) !== radius && Math.abs(dy) !== radius) {
                                continue;
                            }
                            const cellX = startCell.x + dx;
                            const cellY = startCell.y + dy;
                            if (!isCellReachable(cellX, cellY)) {
                                continue;
                            }
                            const center = clampToCanvas(getCellCenter(cellX, cellY, cellSize));
                            if (!isBlockedForEntity(center.x, center.y, size)) {
                                return center;
                            }
                        }
                    }
                }

                return { x: x, y: y };
            }

            // Toggle collision debug overlay
            window.toggleCollision = function() {
                const overlay = document.getElementById('collision-overlay');
                const canvas = document.getElementById('collision-layer');
                const shouldShow = overlay.style.display === 'none' || !overlay.style.display;

                overlay.style.display = shouldShow ? 'block' : 'none';
                canvas.style.display = shouldShow ? 'block' : 'none';
            };
            
            // Setup keyboard input
            function setupInputHandlers() {
                document.addEventListener('keydown', function(e) {
                    gameState.keysPressed[e.key] = true;
                    gameState.keysPressed[e.code] = true;
                });
                
                document.addEventListener('keyup', function(e) {
                    gameState.keysPressed[e.key] = false;
                    gameState.keysPressed[e.code] = false;
                });
            }
            
            // Main game loop
            function gameLoop() {
                if (!gameState.battleActive) {
                    update();
                }
                requestAnimationFrame(gameLoop);
            }
            
            // Update game state
            function update() {
                // Handle player movement
                let dx = 0;
                let dy = 0;
                let isMoving = false;
                
                if (gameState.keysPressed['ArrowUp'] || gameState.keysPressed['w'] || gameState.keysPressed['W']) {
                    dy = -CONFIG.PLAYER_SPEED;
                    gameState.playerDirection = 3; // up
                    isMoving = true;
                }
                if (gameState.keysPressed['ArrowDown'] || gameState.keysPressed['s'] || gameState.keysPressed['S']) {
                    dy = CONFIG.PLAYER_SPEED;
                    gameState.playerDirection = 0; // down
                    isMoving = true;
                }
                if (gameState.keysPressed['ArrowLeft'] || gameState.keysPressed['a'] || gameState.keysPressed['A']) {
                    dx = -CONFIG.PLAYER_SPEED;
                    gameState.playerDirection = 1; // left
                    isMoving = true;
                }
                if (gameState.keysPressed['ArrowRight'] || gameState.keysPressed['d'] || gameState.keysPressed['D']) {
                    dx = CONFIG.PLAYER_SPEED;
                    gameState.playerDirection = 2; // right
                    isMoving = true;
                }
                
                updatePlayerAnimation(isMoving);
                
                // Check collision with walls before moving
                const playerSize = 12; // Smaller to not bother movement
                const newX = gameState.playerX + dx;
                const newY = gameState.playerY + dy;
                
                // Only move if no collision
                if (!isColliding(newX, newY, playerSize)) {
                    gameState.playerX = newX;
                    gameState.playerY = newY;
                }
                
                // Keep in bounds
                gameState.playerX = Math.max(30, Math.min(CONFIG.CANVAS_WIDTH - 30, gameState.playerX));
                gameState.playerY = Math.max(30, Math.min(CONFIG.CANVAS_HEIGHT - 30, gameState.playerY));
                
                // Update player position
                playerEl.style.left = gameState.playerX + 'px';
                playerEl.style.top = gameState.playerY + 'px';
                
                // Check enemy collisions
                checkEnemyCollisions();
                
                // Check coin collisions
                checkCoinCollisions();
                
                // Check exit collision
                checkExitCollision();
                
                // Check door collision
                checkDoorCollision();
            }

            function updatePlayerAnimation(isMoving) {
                // Down: 1F-4F, Left: 5left-6l, Right: 7r-8r, Up: 10U-13u
                const frameMap = {
                    0: ['1F.png', '2F.png', '3F.png', '4F.png'],  // down
                    1: ['5 left.png', '6 l.png'],                // left
                    2: ['7r.png', '8r.png'],                     // right
                    3: ['10 U.png', '11 U.png', '12 U.png', '13 u.png'] // up
                };

                const dir = gameState.playerDirection || 0;
                const frames = frameMap[dir];
                if (!frames || frames.length === 0) {
                    return;
                }

                const now = performance.now();
                const frameDuration = 120;

                if (gameState.playerLastDirection !== dir) {
                    gameState.playerFrameIndex = 0;
                    gameState.playerLastDirection = dir;
                    gameState.playerLastFrameTime = now;
                }

                if (isMoving) {
                    if (now - gameState.playerLastFrameTime >= frameDuration) {
                        gameState.playerFrameIndex = (gameState.playerFrameIndex + 1) % frames.length;
                        gameState.playerLastFrameTime = now;
                    }
                } else {
                    gameState.playerFrameIndex = 0;
                    gameState.playerLastFrameTime = now;
                }

                const frameFile = frames[gameState.playerFrameIndex];
                const newSprite = "url('{{ asset('assets/adventure/playablecharachter/') }}" + frameFile + "')";
                if (playerEl.style.backgroundImage !== newSprite) {
                    playerEl.style.backgroundImage = newSprite;
                    playerEl.style.backgroundSize = "contain";
                    playerEl.style.backgroundPosition = "center";
                }
            }
            
            // Show wall collision indicator
            function showWallIndicator() {
                const now = Date.now();
                if (now - gameState.lastWallCollision > 500) {
                    gameState.lastWallCollision = now;
                    wallIndicator.classList.add('active');
                    setTimeout(function() {
                        wallIndicator.classList.remove('active');
                    }, 300);
                }
            }
            
            // Check if position collides with wall - #ED1C24 is wall color
            function isColliding(x, y, size) {
                if (!gameState.collisionData) return false;

                const collisionWidth = collisionCanvas.width || CONFIG.CANVAS_WIDTH;
                const collisionHeight = collisionCanvas.height || CONFIG.CANVAS_HEIGHT;

                // Wall color #ED1C24 = RGB(237, 28, 36)
                const WALL_R = 237;
                const WALL_G = 28;
                const WALL_B = 36;
                const TOLERANCE = 30;

                const halfSize = size / 2;
                const margin = 10;

                // Check multiple points around the player
                const points = [
                    { x: x - halfSize + margin, y: y - halfSize + margin },
                    { x: x + halfSize - margin, y: y - halfSize + margin },
                    { x: x - halfSize + margin, y: y + halfSize - margin },
                    { x: x + halfSize - margin, y: y + halfSize - margin },
                    { x: x, y: y - halfSize + margin },
                    { x: x, y: y + halfSize - margin },
                    { x: x - halfSize + margin, y: y },
                    { x: x + halfSize - margin, y: y }
                ];

                for (let point of points) {
                    const canvasX = Math.floor(Math.max(0, Math.min(collisionWidth - 1, point.x)));
                    const canvasY = Math.floor(Math.max(0, Math.min(collisionHeight - 1, point.y)));

                    const index = (canvasY * collisionWidth + canvasX) * 4;
                    const r = gameState.collisionData.data[index];
                    const g = gameState.collisionData.data[index + 1];
                    const b = gameState.collisionData.data[index + 2];

                    // Check if pixel matches #ED1C24
                    if (Math.abs(r - WALL_R) <= TOLERANCE && 
                        Math.abs(g - WALL_G) <= TOLERANCE && 
                        Math.abs(b - WALL_B) <= TOLERANCE) {
                        return true;
                    }
                }

                return false;
            }
            
            // Check collision with enemies using sprite-sized bounds
            function checkEnemyCollisions() {
                if (endingSequenceActive) return;
                if (Date.now() < battleCooldownUntil) return;

                gameState.enemies.forEach(enemy => {
                    if (!enemy.alive) return;
                    if (gameState.battleActive) return;
                    
                    const enemySize = enemy.isBoss ? CONFIG.BOSS_SIZE : CONFIG.ENEMY_SIZE;
                    const playerHalf = CONFIG.PLAYER_SIZE / 2;
                    const enemyHalf = enemySize / 2;
                    const dx = Math.abs(gameState.playerX - enemy.x);
                    const dy = Math.abs(gameState.playerY - enemy.y);

                    // AABB overlap using sprite-sized bounds
                    if (dx < playerHalf + enemyHalf && dy < playerHalf + enemyHalf) {
                        triggerBattle(enemy);
                    }
                });
            }
            
            // Check collision with coins
            function checkCoinCollisions() {
                const playerRadius = CONFIG.PLAYER_SIZE / 2;
                const coinRadius = CONFIG.COIN_SIZE / 2;
                
                gameState.coinsOnMap.forEach(coin => {
                    if (coin.collected) return;
                    
                    const dx = gameState.playerX - coin.x;
                    const dy = gameState.playerY - coin.y;
                    const distance = Math.sqrt(dx * dx + dy * dy);
                    
                    if (distance < playerRadius + coinRadius) {
                        // Collect coin
                        coin.collected = true;
                        gameState.collectedCoins.push(coin.id); // Track collected coin ID (string format)
                        gameState.coins++;
                        playCoinCollectionSound();
                        console.log('Coin collected! ID:', coin.id, 'Total coins:', gameState.coins);
                        coin.element.remove();
                        updateHUD();
                        console.log('HUD updated. Current display:', coinsDisplay.textContent);
                        
                        // Check if level is complete after collecting coin
                        checkLevelComplete();
                        
                        // Auto-save progress with current kills, coins AND collectedCoins
                        saveProgress(0, 1, null, gameState.kills, gameState.coins, gameState.collectedCoins);
                    }
                });
            }
            
            // Check collision with exit
            function checkExitCollision() {
                if (!gameState.exitVisible) return;
                
                const level = LEVELS[gameState.currentLevel];
                if (!level.exit) return;
                
                const playerRadius = CONFIG.PLAYER_SIZE / 2;
                const exitRadius = CONFIG.EXIT_SIZE / 2;
                
                const dx = gameState.playerX - level.exit.x;
                const dy = gameState.playerY - level.exit.y;
                const distance = Math.sqrt(dx * dx + dy * dy);
                
                if (distance < playerRadius + exitRadius) {
                    // Go to next level
                    nextLevel();
                }
            }
            
            // Check collision with door
            function checkDoorCollision() {
                if (!gameState.doorVisible || !gameState.doorElement || gameState.levelTransitioning) return;
                
                // Door position (hardcoded in spawnEntities)
                const doorX = parseFloat(gameState.doorElement.style.left) || 650;
                const doorY = parseFloat(gameState.doorElement.style.top) || 300;
                const doorRadius = 40;
                
                const playerRadius = CONFIG.PLAYER_SIZE / 2;
                
                const dx = gameState.playerX - doorX;
                const dy = gameState.playerY - doorY;
                const distance = Math.sqrt(dx * dx + dy * dy);
                
                if (distance < playerRadius + doorRadius) {
                    console.log('Door collision! Going to next level...');
                    gameState.doorVisible = false;
                    gameState.doorElement.classList.add('hidden');
                    gameState.doorElement.style.display = 'none';
                    gameState.doorElement.remove();
                    gameState.doorElement = null;
                    goToNextLevelViaDoor();
                }
            }
            
            // Trigger battle - integrate battle system directly
            let battleController = null;
            let battleResultHandled = false;
            let battleCooldownUntil = 0;

            function triggerBattle(enemy, options = {}) {
                const forceStart = !!options.force;
                const now = Date.now();

                if (!enemy || !enemy.alive) {
                    console.log('[BATTLE DEBUG] triggerBattle blocked: invalid/dead enemy', enemy?.id);
                    return;
                }

                if (!forceStart && endingSequenceActive) {
                    console.log('[BATTLE DEBUG] triggerBattle blocked: endingSequenceActive', enemy.id);
                    return;
                }

                if (!forceStart && gameState.battleActive) {
                    console.log('[BATTLE DEBUG] triggerBattle blocked: battle already active', enemy.id);
                    return;
                }

                if (!forceStart && now < battleCooldownUntil) {
                    console.log('[BATTLE DEBUG] triggerBattle blocked: cooldown', enemy.id, 'remaining', battleCooldownUntil - now, 'ms');
                    return;
                }

                console.log('Starting battle with enemy:', enemy.id);
                
                // Store current enemy for completion handler
                currentEnemy = enemy;
                
                // Pause game loop
                gameState.battleActive = true;
                battleResultHandled = false;
                endingSequenceActive = false;
                battleCooldownUntil = 0;
                pauseOverworldMusic();
                
                // Show battle overlay
                const battleOverlay = document.getElementById('battle-overlay');
                battleOverlay.classList.remove('hidden');
                battleOverlay.style.display = 'flex';
                
                // Initialize battle controller
                const battleEnemyData = {
                    id: enemy.id,
                    sprite: enemy.sprite,
                    isBoss: enemy.isBoss || false,
                    level: gameState.currentLevel // Pass current level for background
                };
                battleController = new BattleController();
                
                // Initialize battle in the container
                battleController.init(personnageId, universeId, gameState.health, gameState.mp, battleEnemyData)
                    .then(function(success) {
                        if (success) {
                            console.log('Battle initialized successfully');
                        } else {
                            console.error('Battle initialization failed');
                            // Fallback to redirect
                            window.location.href = '/adventure/play/' + personnageId + '/' + universeId;
                        }
                    })
                    .catch(function(error) {
                        console.error('Battle error:', error);
                        // Fallback to redirect
                        window.location.href = '/adventure/play/' + personnageId + '/' + universeId;
                    });
            }
            
            // Handle battle completion via postMessage
            window.addEventListener('message', function(event) {
                console.log('=== POST MESSAGE RECEIVED ===', event.data);
                if (event.data && event.data.type === 'battle-complete') {
                    console.log('Battle complete via postMessage!');
                    handleBattleComplete(null, event.data);
                }
            });
            
            // Handle battle completion via jQuery event
            $(document).on('battleComplete', function(event, result) {
                console.log('=== BATTLE COMPLETE EVENT FIRED ===');
                console.log('Battle result:', result);
                handleBattleComplete(null, result);
            });
            
            // Handle battle completion
            let currentEnemy = null;
            function handleBattleComplete(enemy, result) {
                if (battleResultHandled) {
                    console.log('Battle result already handled, ignoring duplicate event.');
                    return;
                }
                battleResultHandled = true;

                console.log('=== BATTLE COMPLETE ===');
                console.log('Full result:', result);
                console.log('[BATTLE DEBUG] completion payload flags', {
                    retry: !!result.retry,
                    giveUp: !!result.giveUp,
                    badEnding: !!result.badEnding,
                    victory: !!result.victory
                });
                console.log('Victory flag:', result.victory);
                console.log('Current enemy stored:', currentEnemy);
                console.log('Game state enemies:', gameState.enemies);
                
                // Use the enemy from result or currentEnemy
                let targetEnemy = enemy || currentEnemy;
                
                // If enemyId is provided in result, find the enemy by id (could be string or number)
                if (result.enemyId && !targetEnemy) {
                    targetEnemy = gameState.enemies.find(e => e.id === result.enemyId || e.id === String(result.enemyId));
                    console.log('Found enemy by ID:', result.enemyId, targetEnemy);
                }
                
                console.log('Target enemy for save:', targetEnemy);
                
                // Show results overlay with stats
                const battleOverlay = document.getElementById('battle-overlay');
                
                // Update game state with new health/MP from battle result
                if (result.health !== undefined) {
                    gameState.health = result.health;
                }
                if (result.mp !== undefined) {
                    gameState.mp = result.mp;
                }

                gameState.sessionStats.battles += 1;
                
                if (result.victory) {
                    gameState.sessionStats.victories += 1;
                    console.log('Victory! Saving enemy defeat...');
                    // Mark enemy as defeated
                    if (targetEnemy) {
                        targetEnemy.alive = false;
                        if (targetEnemy.element) targetEnemy.element.remove();
                        gameState.defeatedEnemies.push(targetEnemy.id);
                        console.log('Enemy marked as defeated:', targetEnemy.id);
                    }
                    gameState.kills++;
                    console.log('Kills incremented to:', gameState.kills);
                    
                    // Check if level is complete after killing enemy
                    checkLevelComplete();
                    
                    // Save progress with defeated enemy, kills, coins AND collectedCoins
                    saveProgress(
                        0, 
                        0, 
                        targetEnemy ? targetEnemy.id : null,
                        gameState.kills,
                        gameState.coins,
                        gameState.collectedCoins
                    );
                } else {
                    gameState.sessionStats.defeats += 1;
                    // Even if defeated, save current health/mp and collectedCoins
                    saveProgress(0, 0, null, gameState.kills, gameState.coins, gameState.collectedCoins);
                }

                const isBossBattle = !!(targetEnemy && targetEnemy.isBoss);
                if (result.giveUp || result.badEnding) {
                    closeBattle(false, 1200, targetEnemy);
                    playEndingCinematic(
                        STORY_MEDIA.badEndingVideo,
                        true,
                        null,
                        showBadEndingState,
                        {
                            fullBackground: true,
                            fateText: 'Your fate was sealed in fear. The world remembers your surrender... and falls into darkness.'
                        }
                    );
                    return;
                }
                if (!result.victory && isBossBattle) {
                    closeBattle(false, 1200, targetEnemy);
                    playEndingCinematic(
                        STORY_MEDIA.badEndingVideo,
                        true,
                        null,
                        showBadEndingState,
                        {
                            fullBackground: true,
                            fateText: 'Defeated at the final hour, your legend fades and the realm sinks into endless night.'
                        }
                    );
                    return;
                }

                if (result.retry) {
                    console.log('[BATTLE DEBUG] Retry selected: returning to overworld with half HP/MP');
                    closeBattle(true, 1400, targetEnemy);
                    return;
                }
                
                // Update game state with new health/MP from battle result
                if (result.health !== undefined) {
                    gameState.health = result.health;
                }
                if (result.mp !== undefined) {
                    gameState.mp = result.mp;
                }
                
                // Update HUD
                updateHUD();
                
                // Show stats overlay
                let rewardText = 'Reward applied!';
                if (!result.victory) {
                    rewardText = 'No reward this time.';
                } else if (result.statUpgrade === 'restore-hp') {
                    rewardText = 'HP restored!';
                } else if (result.statUpgrade === 'restore-mp') {
                    rewardText = 'MP restored!';
                } else if (result.statUpgrade) {
                    rewardText = result.statUpgrade.toUpperCase() + ' increased!';
                }

                if (result.victory && result.statUpgrade && gameState.sessionStats.statGains[result.statUpgrade] !== undefined) {
                    gameState.sessionStats.statGains[result.statUpgrade] += 1;
                }

                battleOverlay.innerHTML = `
                    <div style="text-align: center; padding: 40px; background: #1a1a1a; border-radius: 16px; max-width: 500px;">
                        <h2 style="color: ${result.victory ? '#4f4' : '#f44'}; font-size: 32px; margin-bottom: 20px;">
                            ${result.victory ? '🎉 VICTORY!' : '💀 DEFEATED'}
                        </h2>
                        <div style="color: #fff; margin-bottom: 10px;">${rewardText}</div>
                        <div style="color: #888; margin: 20px 0; font-size: 14px;">Your character stats carry forward.</div>
                    </div>
                `;
                
                // Auto-close battle instantly; on victory, force refresh to reflect latest state
                closeBattle(true, 1000, targetEnemy);
            }
            
            // Close battle overlay and return to overworld
            function closeBattle(shouldResumeMusic = true, cooldownMs = 800, enemyToDisengage = null) {
                // Destroy battle controller
                if (battleController) {
                    try {
                        battleController.destroy();
                    } catch (e) {
                        console.warn('Battle destroy error:', e);
                    }
                    battleController = null;
                }
                
                // Just hide the battle overlay, don't navigate away
                const battleOverlay = document.getElementById('battle-overlay');
                battleOverlay.style.display = 'none';
                battleOverlay.innerHTML = '';
                gameState.battleActive = false;
                battleCooldownUntil = Date.now() + Math.max(0, cooldownMs);

                if (enemyToDisengage && enemyToDisengage.alive) {
                    const dx = gameState.playerX - enemyToDisengage.x;
                    const dy = gameState.playerY - enemyToDisengage.y;
                    const dist = Math.max(1, Math.sqrt(dx * dx + dy * dy));
                    const pushDist = (enemyToDisengage.isBoss ? CONFIG.BOSS_SIZE : CONFIG.ENEMY_SIZE) * 0.8;
                    gameState.playerX = Math.max(30, Math.min(CONFIG.CANVAS_WIDTH - 30, gameState.playerX + (dx / dist) * pushDist));
                    gameState.playerY = Math.max(30, Math.min(CONFIG.CANVAS_HEIGHT - 30, gameState.playerY + (dy / dist) * pushDist));
                    playerEl.style.left = gameState.playerX + 'px';
                    playerEl.style.top = gameState.playerY + 'px';
                    console.log('[BATTLE DEBUG] player disengaged from enemy', enemyToDisengage.id, 'pos=', gameState.playerX, gameState.playerY);
                }

                console.log('[BATTLE DEBUG] closeBattle state', {
                    shouldResumeMusic,
                    endingSequenceActive,
                    cooldownMs,
                    battleCooldownUntil,
                    battleActive: gameState.battleActive
                });

                if (shouldResumeMusic && !endingSequenceActive) {
                    resumeOverworldMusic();
                }
                
                // Check if level is complete
                checkLevelComplete();
            }
            
            // Make closeBattle available globally for button onclick
            window.closeBattle = closeBattle;
            
            // Save progress to server
            function saveProgress(xp, coins, defeatedEnemyId = null, killsOverride = null, coinsOverride = null, collectedCoinsOverride = null) {
                // Use overrides if provided, otherwise use game state
                const killsToSave = killsOverride !== null ? killsOverride : gameState.kills;
                const coinsToSave = coinsOverride !== null ? coinsOverride : gameState.coins;
                const collectedCoinsToSave = collectedCoinsOverride !== null ? collectedCoinsOverride : gameState.collectedCoins;
                
                console.log('SAVING - Health:', gameState.health, 'MP:', gameState.mp, 'Level:', gameState.currentLevel, 'Kills:', killsToSave, 'Coins:', coinsToSave, 'CollectedCoins:', collectedCoinsToSave);
                fetch('/overworld/save-progress', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        personnageId: personnageId,
                        gameRunId: GAME_RUN_ID,
                        xp: xp,
                        coins: coins,
                        health: gameState.health,
                        mp: gameState.mp,
                        currentLevel: gameState.currentLevel,
                        kills: killsToSave,
                        coinsCollected: coinsToSave,
                        defeatedEnemyId: defeatedEnemyId,
                        collectedCoins: collectedCoinsToSave
                    })
                }).then(response => {
                    console.log('Save response status:', response.status);
                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }
                    return response.json();
                })
                  .then(data => {
                      console.log('Progress saved:', data);
                      if (!data.success) {
                          console.error('Save failed:', data.message);
                      }
                  })
                  .catch(error => console.error('Error saving progress:', error));
            }
            
            // Update HUD display
            function updateHUD() {
                const level = LEVELS[gameState.currentLevel];
                killsDisplay.textContent = gameState.kills + ' / ' + level.requiredKills;
                coinsDisplay.textContent = gameState.coins + ' / ' + level.requiredCoins;
            }
            
            // Check if level is complete
            function checkLevelComplete() {
                const level = LEVELS[gameState.currentLevel];
                console.log('=== CHECKING LEVEL COMPLETE ===');
                console.log('Current level:', gameState.currentLevel);
                console.log('Kills:', gameState.kills, 'Required:', level.requiredKills);
                console.log('Coins:', gameState.coins, 'Required:', level.requiredCoins);
                
                // Check if requirements met
                if (gameState.kills >= level.requiredKills && gameState.coins >= level.requiredCoins) {
                    console.log('Level complete! Showing door...');
                    
                    // Show the door!
                    if (gameState.doorElement) {
                        gameState.doorElement.classList.remove('hidden');
                        gameState.doorVisible = true;
                        console.log('Door is now visible!');
                    }
                    
                    // Hide any overlays
                    if (levelCompleteOverlay) {
                        levelCompleteOverlay.style.display = 'none';
                    }
                }
            }
            
            // Go to next level when door is clicked
            function goToNextLevelViaDoor() {
                if (gameState.levelTransitioning) {
                    console.log('[LEVEL] Transition already in progress, ignoring duplicate door trigger.');
                    return;
                }
                gameState.levelTransitioning = true;
                const nextLevelNum = gameState.currentLevel + 1;
                
                if (nextLevelNum > 3) {
                    showVictory();
                } else {
                    loadLevel(nextLevelNum);
                }
            }
            
            // Go to next level (called from button)
            window.goToNextLevel = function() {
                const nextLevelNum = gameState.currentLevel + 1;
                
                if (nextLevelNum > 3) {
                    // Victory!
                    if (levelCompleteOverlay) {
                        levelCompleteOverlay.style.display = 'none';
                    }
                    showVictory();
                } else {
                    if (levelCompleteOverlay) {
                        levelCompleteOverlay.style.display = 'none';
                    }
                    loadLevel(nextLevelNum);
                }
            };
            
            // Go to next level
            function nextLevel() {
                const nextLevelNum = gameState.currentLevel + 1;
                
                if (nextLevelNum > 3) {
                    // Victory!
                    showVictory();
                } else {
                    loadLevel(nextLevelNum);
                }
            }
            
            // Show victory screen
            function showVictory() {
                if (goodEndingSequenceStarted) {
                    console.log('[ENDING] Good ending already running, ignoring duplicate trigger.');
                    return;
                }
                goodEndingSequenceStarted = true;

                loadGeneratedVictoryMessage(true)
                    .then(function(endingStory) {
                        const finalText = endingStory
                            || (playerName + ' the ' + playerClass + ' fulfilled the quest, and peace returned to the realm.');

                        playEndingCinematic(
                            STORY_MEDIA.goodEndingVideo,
                            false,
                            STORY_MEDIA.goodEndingTheme,
                            showFinalResultsScreen,
                            {
                                fullBackground: true,
                                fateText: finalText
                            }
                        );
                    })
                    .catch(function() {
                        const fallbackText = playerName + ' the ' + playerClass + ' fulfilled the quest, and peace returned to the realm.';
                        playEndingCinematic(
                            STORY_MEDIA.goodEndingVideo,
                            false,
                            STORY_MEDIA.goodEndingTheme,
                            showFinalResultsScreen,
                            {
                                fullBackground: true,
                                fateText: fallbackText
                            }
                        );
                    });
            }
            
            // Start game when DOM is ready
            document.addEventListener('DOMContentLoaded', init);
            
        })();
    </script>
</body>
</html>
