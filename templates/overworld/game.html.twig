                        <div class="grid">
                            <div class="card"><div class="label">Level Reached</div><div class="value">${summary.levelReached}</div></div>
                            <div class="card"><div class="label">Levels Gained</div><div class="value">+${summary.levelsGained}</div></div>
                            <div class="card"><div class="label">Total Kills</div><div class="value">${summary.totalKills}</div></div>
                            <div class="card"><div class="label">Total Coins</div><div class="value">${summary.totalCoins}</div></div>
                            <div class="card"><div class="label">Battles (W/L)</div><div class="value">${summary.battles} (${summary.victories}/${summary.defeats})</div></div>
