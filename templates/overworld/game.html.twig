            function loadGeneratedUniverseStory(forceRegenerate = false) {
                const storyText = document.getElementById('loading-story-text');
                if (introState === 'GAMEPLAY' && !forceRegenerate) {
                    return Promise.resolve(generatedLaunchStory || '');
                }

                currentLaunchSeed = Date.now() + Math.floor(Math.random() * 10000);

                return fetch('/api/game/universe/' + universeId + '/generated-story?seed=' + currentLaunchSeed + '&personnageId=' + personnageId)
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('Story generation failed');
                        }
                        return response.json();
                    })
                    .then(function(data) {
                        if (!data || !data.story) {
                            return '';
                        }

                        generatedLaunchStory = data.story;
                        if (storyText) {
                            storyText.textContent = generatedLaunchStory;
                        }
                        console.log('Generated launch story source:', data.source, 'seed:', data.seed);
                        return generatedLaunchStory;
                    })
                    .catch(function(error) {
                        console.warn('Could not load generated story:', error);
                        generatedLaunchStory = playerName + ' the ' + playerClass + ', your quest begins now. Survive this world, gather strength, and uncover what threatens this universe.';
                        if (storyText) {
                            storyText.textContent = generatedLaunchStory;
                        }
                        return generatedLaunchStory;
                    });
            }

            function loadGeneratedVictoryMessage(forceRegenerate = false) {
                if (generatedVictoryMessage && !forceRegenerate) {
                    return Promise.resolve(generatedVictoryMessage);
                }

                const accomplishmentNote = 'Completed the final adventure and saved the realm.';

                return fetch('/api/game/universe/' + universeId + '/generated-story?mode=victory&personnageId=' + personnageId + '&previous=' + encodeURIComponent(accomplishmentNote))
                    .then(function(response) {
                        if (!response.ok) {
                            throw new Error('Victory message generation failed');
                        }
                        return response.json();
                    })
                    .then(function(data) {
                        if (data && data.story) {
                            generatedVictoryMessage = data.story;
                            return generatedVictoryMessage;
                        }

                        generatedVictoryMessage = 'Congratulations, ' + playerName + '! You completed the adventure and proved your strength from start to finish.';
                        return generatedVictoryMessage;
