                `;

                const playAgainBtn = document.getElementById('final-play-again-btn');
                if (playAgainBtn) {
                    playAgainBtn.addEventListener('click', function() {
                        stopFinalResultsAudio();
                        window.location.href = '/adventure';
                    });
