<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Détail Univers - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .hero-banner {
            width: 100%;
            height: 300px;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 5rem;
            margin: -2rem -2rem 2rem -2rem;
            margin-bottom: 2rem;
        }

        .universe-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 2rem;
            gap: 2rem;
        }

        .universe-info h1 { margin: 0 0 0.5rem 0; }

        .genre-badges {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }

        .genre-badge {
            padding: 6px 14px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .universe-actions {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }

        .action-btn {
            padding: 10px 20px;
            border: 2px solid #18E3A4;
            background-color: transparent;
            color: #18E3A4;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .action-btn:hover {
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .action-btn.primary {
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .action-btn.primary:hover {
            background-color: #0DCF92;
        }

        .tabs {
            display: flex;
            gap: 0;
            border-bottom: 2px solid #2A3139;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .tab-btn {
            padding: 1rem 1.5rem;
            background-color: transparent;
            color: #B0B9B6;
            border: none;
            cursor: pointer;
            font-weight: 600;
            border-bottom: 3px solid transparent;
            transition: all 0.3s;
        }

        .tab-btn.active {
            color: #18E3A4;
            border-bottom-color: #18E3A4;
        }

        .tab-btn:hover { color: #18E3A4; }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .creator-card {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #2A3139;
            margin-bottom: 2rem;
        }

        .creator-header {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1rem;
        }

        .creator-avatar-large {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            color: #0B0F0E;
            font-weight: bold;
        }

        .creator-details h3 { margin: 0; }
        .creator-details p { margin: 0; color: #B0B9B6; font-size: 0.9rem; }

        .creator-bio {
            color: #B0B9B6;
            margin: 1rem 0;
            line-height: 1.6;
        }

        .follow-btn {
            padding: 10px 20px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            width: 100%;
        }

        .follow-btn:hover { background-color: #0DCF92; }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .stat-card {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #2A3139;
            text-align: center;
        }

        .stat-number {
            font-size: 2rem;
            font-weight: 700;
            color: #18E3A4;
        }

        .stat-label {
            font-size: 0.9rem;
            color: #B0B9B6;
            margin-top: 0.5rem;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 280px;
            gap: 2rem;
        }

        .related-universes {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #2A3139;
        }

        .related-universes h3 { margin: 0 0 1rem 0; }

        .related-card {
            background-color: #0B0F0E;
            padding: 1rem;
            border-radius: 6px;
            margin-bottom: 1rem;
            cursor: pointer;
            transition: all 0.3s;
            border: 1px solid #2A3139;
        }

        .related-card:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.1);
        }

        .related-card:last-child { margin-bottom: 0; }

        .related-card-emoji {
            font-size: 1.5rem;
            margin-bottom: 0.5rem;
        }

        .related-card-title {
            font-weight: 600;
            color: #E6FFF6;
            margin-bottom: 0.25rem;
        }

        .related-card-genre {
            font-size: 0.75rem;
            color: #18E3A4;
        }

        .lore-section {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 8px;
            border: 1px solid #2A3139;
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        .lore-section h3 { margin: 0 0 1rem 0; }

        .content-items {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .item-card {
            background-color: #1A1F1E;
            padding: 1rem;
            border-radius: 8px;
            border: 1px solid #2A3139;
            text-align: center;
            transition: all 0.3s;
        }

        .item-card:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 15px rgba(24, 227, 164, 0.1);
        }

        .item-emoji {
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .item-name {
            font-weight: 600;
            color: #E6FFF6;
            margin-bottom: 0.25rem;
        }

        .item-creator {
            font-size: 0.8rem;
            color: #B0B9B6;
        }

        @media (max-width: 1024px) {
            .content-grid { grid-template-columns: 1fr; }
            .universe-header { flex-direction: column; }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            <a href="/login" class="btn btn-secondary btn-sm">Connexion</a>
            <a href="/register" class="btn btn-primary btn-sm">S'inscrire</a>
        </div>
    </header>

    <main>
        <section class="section">
            <div class="hero-banner" id="heroBanner">🌙</div>

            <div class="container">
                <div class="universe-header">
                    <div class="universe-info">
                        <h1 id="universeName">Nuit Éternelle</h1>
                        <div class="genre-badges" id="genreBadges">
                            <span class="genre-badge">Sombre</span>
                        </div>
                        <p style="color: #B0B9B6; margin-top: 1rem; max-width: 600px;">
                            Un monde plongé dans une nuit perpétuelle, où la lune règne toujours. Explorez les mystères cachés et les créatures nocturnes.
                        </p>
                    </div>
                    <div class="universe-actions">
                        <button class="action-btn primary">❤️ Favoris</button>
                        <button class="action-btn">👁️ Suivre</button>
                        <button class="action-btn">💬 Partager</button>
                    </div>
                </div>

                <div class="tabs">
                    <button class="tab-btn active" data-tab="about">À propos</button>
                    <button class="tab-btn" data-tab="personnages">Personnages</button>
                    <button class="tab-btn" data-tab="oeuvres">Œuvres</button>
                    <button class="tab-btn" data-tab="artefacts">Artefacts</button>
                    <button class="tab-btn" data-tab="lieux">Lieux</button>
                </div>

                <div class="content-grid">
                    <div>
                        <div id="about" class="tab-content active">
                            <div class="lore-section">
                                <h3>Lore & Histoire</h3>
                                <p>
                                    Il y a mille ans, un cataclysme cosmique a figé la world dans une nuit perpétuelle. Les humains, les elfes et les races antiques ont dû s'adapter à ce nouvel ordre. 
                                    Certains ont construit des cités souterraines illuminées par la magie cristalline, tandis que d'autres se sont élevés pour devenir les enfants de la lune.
                                </p>
                                <p>
                                    Légendes disent que celui qui unifiera les trois cristaux lunaires pourra restaurer le jour. Mais à quel prix ?
                                </p>
                            </div>

                            <div class="stats-grid">
                                <div class="stat-card">
                                    <div class="stat-number" id="personnagesCount">12</div>
                                    <div class="stat-label">Personnages</div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-number" id="oeuvresCount">28</div>
                                    <div class="stat-label">Œuvres</div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-number" id="artefactsCount">7</div>
                                    <div class="stat-label">Artefacts</div>
                                </div>
                                <div class="stat-card">
                                    <div class="stat-number" id="followersCount">1.2K</div>
                                    <div class="stat-label">Followers</div>
                                </div>
                            </div>
                        </div>

                        <div id="personnages" class="tab-content">
                            <h3>Personnages de cet Univers</h3>
                            <div class="content-items">
                                <div class="item-card">
                                    <div class="item-emoji">👤</div>
                                    <div class="item-name">Nyxis le Sage</div>
                                    <div class="item-creator">Par Léa M.</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">🧙</div>
                                    <div class="item-name">Morrigan</div>
                                    <div class="item-creator">Par Léa M.</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">⚔️</div>
                                    <div class="item-name">Kaelen Noir</div>
                                    <div class="item-creator">Par Victor D.</div>
                                </div>
                            </div>
                        </div>

                        <div id="oeuvres" class="tab-content">
                            <h3>Œuvres & Créations</h3>
                            <div class="content-items">
                                <div class="item-card">
                                    <div class="item-emoji">📖</div>
                                    <div class="item-name">Les Murs de Minuit</div>
                                    <div class="item-creator">Histoire courte</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">🎨</div>
                                    <div class="item-name">Palais Lunaire</div>
                                    <div class="item-creator">Illustration</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">🎵</div>
                                    <div class="item-name">Hymne de la Nuit</div>
                                    <div class="item-creator">Composition</div>
                                </div>
                            </div>
                        </div>

                        <div id="artefacts" class="tab-content">
                            <h3>Artefacts Légendaires</h3>
                            <div class="content-items">
                                <div class="item-card">
                                    <div class="item-emoji">💎</div>
                                    <div class="item-name">Cristal de Lune</div>
                                    <div class="item-creator">Artefact rare</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">⚔️</div>
                                    <div class="item-name">Épée Nocturne</div>
                                    <div class="item-creator">Artefact épique</div>
                                </div>
                            </div>
                        </div>

                        <div id="lieux" class="tab-content">
                            <h3>Lieux Importants</h3>
                            <div class="content-items">
                                <div class="item-card">
                                    <div class="item-emoji">🏰</div>
                                    <div class="item-name">Château de Midi</div>
                                    <div class="item-creator">Forteresse principale</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">⛏️</div>
                                    <div class="item-name">Mines d'Ombre</div>
                                    <div class="item-creator">Souterrain magique</div>
                                </div>
                                <div class="item-card">
                                    <div class="item-emoji">🌲</div>
                                    <div class="item-name">Forêt Mélancolique</div>
                                    <div class="item-creator">Sanctuaire antique</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="creator-card">
                            <div class="creator-header">
                                <div class="creator-avatar-large">L</div>
                                <div class="creator-details">
                                    <h3>Léa Moretti</h3>
                                    <p>@leamoretti</p>
                                </div>
                            </div>
                            <div class="creator-bio">
                                Créatrice de mondes avec une passion pour la fantasy sombre et les mystères nocturnes. Passionnée par l'écriture collaborative.
                            </div>
                            <button class="follow-btn">👁️ Suivre</button>
                        </div>

                        <div class="related-universes">
                            <h3>Univers relatifs</h3>
                            <div class="related-card" onclick="window.location.href='/universe-detail?id=9'">
                                <div class="related-card-emoji">🌑</div>
                                <div class="related-card-title">Domaine des Ombres</div>
                                <div class="related-card-genre">Sombre • 834 aimes</div>
                            </div>
                            <div class="related-card" onclick="window.location.href='/universe-detail?id=8'">
                                <div class="related-card-emoji">🌊</div>
                                <div class="related-card-title">Océan Enchanté</div>
                                <div class="related-card-genre">Haute Fantaisie • 645 aimes</div>
                            </div>
                            <div class="related-card" onclick="window.location.href='/universe-detail?id=5'">
                                <div class="related-card-emoji">🌲</div>
                                <div class="related-card-title">Forêt Éternelle</div>
                                <div class="related-card-genre">Haute Fantaisie • 756 aimes</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions</a></li>
                        <li><a href="#">Confidentialité</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script>
        const universeData = {
            1: {name:"Nuit Éternelle",banner:"🌙",genre:["dark-fantasy"],creator:"Léa Moretti",personnages:12,oeuvres:28,artefacts:7,followers:"1.2K"},
            2: {name:"Châteaux Flottants",banner:"☁️",genre:["high-fantasy"],creator:"Léa M.",personnages:18,oeuvres:45,artefacts:12,followers:"892"},
            3: {name:"Dragons de Lumière",banner:"🐲",genre:["high-fantasy"],creator:"Alexis S.",personnages:14,oeuvres:32,artefacts:9,followers:"654"},
            4: {name:"Techno-Mystique",banner:"⚡",genre:["scifi-fantasy"],creator:"Marcus T.",personnages:22,oeuvres:51,artefacts:15,followers:"1.1K"},
            5: {name:"Forêt Éternelle",banner:"🌲",genre:["high-fantasy"],creator:"Elena R.",personnages:16,oeuvres:37,artefacts:8,followers:"756"}
        };

        function getUrlParam(name){
            const params = new URLSearchParams(window.location.search);
            return params.get(name) || '1';
        }

        document.addEventListener('DOMContentLoaded', () => {
            const universeId = getUrlParam('id');
            const data = universeData[universeId];
            if(data){
                document.getElementById('universeName').textContent = data.name;
                document.getElementById('heroBanner').textContent = data.banner;
                document.getElementById('genreBadges').innerHTML = data.genre.map(g => `<span class="genre-badge">${{'high-fantasy':'Haute Fantaisie','dark-fantasy':'Sombre','scifi-fantasy':'Sci-Fi'}[g]}</span>`).join('');
                document.getElementById('personnagesCount').textContent = data.personnages;
                document.getElementById('oeuvresCount').textContent = data.oeuvres;
                document.getElementById('artefactsCount').textContent = data.artefacts;
                document.getElementById('followersCount').textContent = data.followers;
            }

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
                    btn.classList.add('active');
                    const tab = btn.dataset.tab;
                    document.getElementById(tab).classList.add('active');
                });
            });
        });
    </script>
</body>
</html>