<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toutes les Œuvres - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        .universes-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: #1A1F1E;
            padding: 1.5rem;
            border-radius: 6px;
            border: 1px solid #2A3139;
            height: fit-content;
            position: sticky;
            top: 100px;
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #2A3139;
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: #18E3A4;
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: #18E3A4;
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: #E6FFF6;
            font-size: 0.9rem;
            margin: 0;
            flex: 1;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background-color: #0B0F0E;
            border: 1px solid #2A3139;
            border-radius: 4px;
            color: #E6FFF6;
            font-size: 0.9rem;
            margin-bottom: 1rem;
        }

        .search-box::placeholder { color: #B0B9B6; }
        .search-box:focus {
            outline: none;
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.2);
        }

        .filter-reset {
            width: 100%;
            padding: 10px;
            background-color: #2A3139;
            color: #18E3A4;
            border: 1px solid #18E3A4;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
        }

        .filter-reset:hover {
            background-color: #18E3A4;
            color: #0B0F0E;
        }

        .universes-section { flex: 1; }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title { margin: 0; }

        .create-cta {
            padding: 12px 24px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }

        .create-cta:hover { background-color: #0DCF92; }

        .universes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card {
            background-color: #1A1F1E;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #2A3139;
            transition: all 0.3s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }

        .universe-card:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.15);
            transform: translateY(-2px);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: #E6FFF6;
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: #0B0F0E;
            border: 1px solid #18E3A4;
            color: #18E3A4;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .card-description {
            font-size: 0.85rem;
            color: #B0B9B6;
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: #B0B9B6;
            padding-top: 1rem;
            border-top: 1px solid #2A3139;
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, #18E3A4, #0DCF92);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
        }

        .results-count { color: #B0B9B6; font-size: 0.9rem; }

        .load-more { display: flex; justify-content: center; margin-top: 2rem; }

        .load-more-btn {
            padding: 12px 40px;
            background-color: #18E3A4;
            color: #0B0F0E;
            border: none;
            border-radius: 4px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
        }

        .load-more-btn:hover { background-color: #0DCF92; }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: #B0B9B6;
        }

        .empty-state p { font-size: 1.1rem; margin-bottom: 1rem; }

        @media (max-width: 1024px) {
            .universes-container { grid-template-columns: 1fr; }
            .filter-sidebar { position: static; }
        }

        @media (max-width: 768px) {
            .universes-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/oeuvre">Œuvre</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
        <div class="auth-buttons">
            <a href="/login" class="btn btn-secondary btn-sm">Connexion</a>
            <a href="/register" class="btn btn-primary btn-sm">S'inscrire</a>
        </div>
    </header>

    <main>
        <section class="section">
            <div class="container">
                <div class="section-header">
                    <div>
                        <h1 style="margin-bottom: 0.5rem;">Toutes les Œuvres</h1>
                        <p style="color: #B0B9B6; margin: 0;">Explorez les mondes créés par notre communauté</p>
                    </div>
                    <div class="create-ctas">
                        <a href="/create-oeuvre" class="create-cta">+ Créer une Œuvre</a>
                        <a href="/create-artifact" class="create-cta" style="background-color: transparent; border: 1px solid #18E3A4; color: #18E3A4;">+ Créer un Artefact</a>
                    </div>
                </div>

                <div class="universes-container">
                    <div class="filter-sidebar">
                        <div class="filter-group">
                            <input type="text" class="search-box" id="searchInput" placeholder="Chercher...">
                        </div>

                        <div class="filter-group">
                            <h4>Genre</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-high-fantasy" value="high-fantasy" class="genre-filter">
                                <label for="genre-high-fantasy">Haute Fantaisie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-dark-fantasy" value="dark-fantasy" class="genre-filter">
                                <label for="genre-dark-fantasy">Sombre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-scifi-fantasy" value="scifi-fantasy" class="genre-filter">
                                <label for="genre-scifi-fantasy">Sci-Fi</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="genre-urban-fantasy" value="urban-fantasy" class="genre-filter">
                                <label for="genre-urban-fantasy">Urban</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Thèmes</h4>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-magie" value="magie" class="theme-filter">
                                <label for="theme-magie">Magie</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-guerre" value="guerre" class="theme-filter">
                                <label for="theme-guerre">Guerre</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-politique" value="politique" class="theme-filter">
                                <label for="theme-politique">Politique</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-nature" value="nature" class="theme-filter">
                                <label for="theme-nature">Nature</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-mystere" value="mystere" class="theme-filter">
                                <label for="theme-mystere">Mystère</label>
                            </div>
                            <div class="filter-option">
                                <input type="checkbox" id="theme-aventure" value="aventure" class="theme-filter">
                                <label for="theme-aventure">Aventure</label>
                            </div>
                        </div>

                        <div class="filter-group">
                            <h4>Tri</h4>
                            <div class="filter-option">
                                <input type="radio" id="sort-newest" name="sort" value="newest" class="sort-filter" checked>
                                <label for="sort-newest">Récent</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-popular" name="sort" value="popular" class="sort-filter">
                                <label for="sort-popular">Populaire</label>
                            </div>
                            <div class="filter-option">
                                <input type="radio" id="sort-trending" name="sort" value="trending" class="sort-filter">
                                <label for="sort-trending">Tendance</label>
                            </div>
                        </div>

                        <button class="filter-reset" id="resetFilters">Réinitialiser</button>
                    </div>

                    <div class="universes-section">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid #2A3139;">
                            <h2 style="margin: 0; color: #E6FFF6;">Œuvres</h2>
                            <div class="results-count">
                                <span id="displayedCount">0</span> / <span id="totalCount">0</span>
                            </div>
                        </div>

                        <div class="universes-grid" id="universesGrid"></div>

                        <div class="load-more" id="loadMoreContainer" style="display: none;">
                            <button class="load-more-btn" id="loadMoreBtn">Charger Plus</button>
                        </div>

                        <div class="empty-state" id="emptyState" style="display: none;">
                            <p>😔 Aucune œuvre ne correspond à vos critères</p>
                        </div>
                    </div>
                </div>

            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                        <li><a href="#">Équipe</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions d'utilisation</a></li>
                        <li><a href="#">Politique de confidentialité</a></li>
                        <li><a href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script>
        const mockUniverses = [
            {id:1,name:"Nuit Éternelle",genre:["dark-fantasy"],themes:["mystere","magie"],desc:"Monde plongé dans une nuit perpétuelle",banner:"🌙",creator:"Léa M.",avatar:"L",personnages:12,oeuvres:28,artefacts:7,likes:1240,date:new Date(2026,0,20)},
            {id:2,name:"Châteaux Flottants",genre:["high-fantasy"],themes:["aventure","magie"],desc:"Forteresses majestueuses flottent dans les nuages",banner:"☁️",creator:"Léa M.",avatar:"L",personnages:18,oeuvres:45,artefacts:12,likes:892,date:new Date(2026,0,18)},
            {id:3,name:"Dragons de Lumière",genre:["high-fantasy"],themes:["aventure","nature"],desc:"Univers dominé par les dragons",banner:"🐲",creator:"Alexis S.",avatar:"A",personnages:14,oeuvres:32,artefacts:9,likes:654,date:new Date(2026,0,15)},
            {id:4,name:"Techno-Mystique",genre:["scifi-fantasy"],themes:["magie","guerre"],desc:"Technologie avancée rencontre magie ancienne",banner:"⚡",creator:"Marcus T.",avatar:"M",personnages:22,oeuvres:51,artefacts:15,likes:1120,date:new Date(2026,0,25)},
            {id:5,name:"Forêt Éternelle",genre:["high-fantasy"],themes:["nature","magie"],desc:"Forêt ancienne où les arbres parlent",banner:"🌲",creator:"Elena R.",avatar:"E",personnages:16,oeuvres:37,artefacts:8,likes:756,date:new Date(2026,0,22)},
            {id:6,name:"Royaumes Souterrains",genre:["dark-fantasy","high-fantasy"],themes:["guerre","politique"],desc:"Empires dwarves et gnomes sous les montagnes",banner:"⛏️",creator:"Thor N.",avatar:"T",personnages:20,oeuvres:48,artefacts:14,likes:892,date:new Date(2026,0,19)},
            {id:7,name:"Cités Flottantes",genre:["scifi-fantasy"],themes:["aventure","politique"],desc:"Villes futuristes flottant au-dessus d'un monde post-apocalyptique",banner:"🏙️",creator:"Luna K.",avatar:"L",personnages:19,oeuvres:42,artefacts:11,likes:978,date:new Date(2026,0,17)},
            {id:8,name:"Océan Enchanté",genre:["high-fantasy","urban-fantasy"],themes:["magie","mystere"],desc:"Royaumes sous-marins remplis de créatures magiques",banner:"🌊",creator:"Nerida M.",avatar:"N",personnages:13,oeuvres:29,artefacts:10,likes:645,date:new Date(2026,0,16)},
            {id:9,name:"Domaine des Ombres",genre:["dark-fantasy"],themes:["guerre","mystere"],desc:"Où les ombres ont pris vie",banner:"🌑",creator:"Victor D.",avatar:"V",personnages:17,oeuvres:40,artefacts:13,likes:834,date:new Date(2026,0,14)},
            {id:10,name:"Empire Cristallin",genre:["high-fantasy"],themes:["magie","aventure"],desc:"Empire construit entièrement de cristaux magiques",banner:"💎",creator:"Sylvia P.",avatar:"S",personnages:15,oeuvres:35,artefacts:9,likes:723,date:new Date(2026,0,21)},
            {id:11,name:"Steppes Sauvages",genre:["high-fantasy"],themes:["nature","aventure"],desc:"Prairies infinies peuplées de tribus guerrières",banner:"🏜️",creator:"Khan B.",avatar:"K",personnages:21,oeuvres:44,artefacts:8,likes:567,date:new Date(2026,0,13)},
            {id:12,name:"Métropole Gothique",genre:["urban-fantasy"],themes:["mystere","politique"],desc:"Grande ville moderne cachant secrets magiques",banner:"🏛️",creator:"Isabelle V.",avatar:"I",personnages:18,oeuvres:39,artefacts:7,likes:891,date:new Date(2026,0,12)}
        ];

        let filtered = [...mockUniverses];
        let displayedItems = 12;

        document.addEventListener('DOMContentLoaded', () => {
            renderUniverses();
            attachListeners();
        });

        function attachListeners(){
            document.querySelectorAll('.genre-filter').forEach(cb => cb.addEventListener('change', filterUniverses));
            document.querySelectorAll('.theme-filter').forEach(cb => cb.addEventListener('change', filterUniverses));
            document.querySelectorAll('.sort-filter').forEach(r => r.addEventListener('change', filterUniverses));
            document.getElementById('searchInput').addEventListener('input', filterUniverses);
            document.getElementById('resetFilters').addEventListener('click', () => {
                document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
                document.getElementById('sort-newest').checked = true;
                document.getElementById('searchInput').value = '';
                filtered = [...mockUniverses];
                displayedItems = 12;
                renderUniverses();
            });
            document.getElementById('loadMoreBtn')?.addEventListener('click', () => { displayedItems += 12; renderUniverses(); });
        }

        function filterUniverses(){
            const genres = Array.from(document.querySelectorAll('.genre-filter:checked')).map(cb => cb.value);
            const themes = Array.from(document.querySelectorAll('.theme-filter:checked')).map(cb => cb.value);
            const search = document.getElementById('searchInput').value.toLowerCase();
            const sort = document.querySelector('.sort-filter:checked').value;

            filtered = mockUniverses.filter(item => {
                if(genres.length > 0 && !genres.some(g => item.genre.includes(g))) return false;
                if(themes.length > 0 && !themes.some(t => item.themes.includes(t))) return false;
                if(search && !item.name.toLowerCase().includes(search)) return false;
                return true;
            });

            if(sort === 'newest') filtered.sort((a,b) => b.date - a.date);
            else if(sort === 'popular') filtered.sort((a,b) => (b.likes || b.personnages) - (a.likes || a.personnages));
            else filtered.sort((a,b) => (b.likes || 0) - (a.likes || 0));

            displayedItems = 12;
            renderUniverses();
        }

        function renderUniverses(){
            const grid = document.getElementById('universesGrid');
            const empty = document.getElementById('emptyState');
            const more = document.getElementById('loadMoreContainer');

            grid.innerHTML = '';
            if(filtered.length === 0) { empty.style.display = 'block'; more.style.display = 'none'; }
            else {
                empty.style.display = 'none';
                filtered.slice(0, displayedItems).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'universe-card';
                    const genreMap = {'high-fantasy':'Haute Fantaisie','dark-fantasy':'Sombre','scifi-fantasy':'Sci-Fi','urban-fantasy':'Urban'};
                    const genreTags = item.genre.map(g => `<span class="genre-tag">${genreMap[g] || g}</span>`).join('');
                    card.innerHTML = `
                        <div class="card-banner">${item.banner}</div>
                        <div class="card-content">
                            <h3 class="card-title">${item.name}</h3>
                            <div class="card-genre-tags">${genreTags}</div>
                            <p class="card-description">${item.desc}</p>
                            <div class="card-footer">
                                <div class="card-stats"><div class="stat">Characters ${item.personnages}</div><div class="stat">Works ${item.oeuvres}</div><div class="stat">Artifacts ${item.artefacts}</div></div>
                                <div class="creator-info"><div class="creator-avatar">${item.avatar}</div><span>${item.creator}</span></div>
                            </div>
                        </div>
                    `;
                    card.addEventListener('click', () => window.location.href = `/universe-detail?id=${item.id}`);
                    grid.appendChild(card);
                });
                more.style.display = filtered.length > displayedItems ? 'flex' : 'none';
            }
            document.getElementById('displayedCount').textContent = Math.min(displayedItems, filtered.length);
            document.getElementById('totalCount').textContent = filtered.length;
        }
    </script>
</body>
</html>