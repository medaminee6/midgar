                'Peignez quelque chose qui vous inspire personally',
                'Créez une composition harmonyuse aux couleurs vibrantes'
            ]
        };
        
        function generateAISuggestion() {
            const btn = document.getElementById('aiSuggestBtn');
            const resultDiv = document.getElementById('aiSuggestionResult');
            const suggestionText = document.getElementById('aiSuggestionText');
            
            // Show loading
            btn.innerHTML = '⏳ Chargement...';
            btn.disabled = true;
            
            // Simulate AI thinking delay
            setTimeout(() => {
                // Get challenge theme
                const theme = '{{ defi.theme|default("") }}';
                
                // Get suggestions based on theme
                let suggestions = paintingSuggestions[theme] || paintingSuggestions['default'];
                currentSuggestion = suggestions[Math.floor(Math.random() * suggestions.length)];
                
                suggestionText.textContent = currentSuggestion;
                resultDiv.style.display = 'block';
                
                btn.innerHTML = '💡 Suggestion IA';
                btn.disabled = false;
            }, 800);
        }
        
        function useSuggestion() {
            const descField = document.getElementById('description');
            descField.value = currentSuggestion;
            document.getElementById('aiSuggestionResult').style.display = 'none';
        }
    </script>
