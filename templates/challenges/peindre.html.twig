<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peindre - {{ defi.titre }} | Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        /* ===== FLOATING EMOJIS BACKGROUND ===== */
        .floating-emojis {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        
        .floating-emoji {
            position: absolute;
            font-size: 2rem;
            opacity: 0.12;
            animation: floatEmoji 20s infinite ease-in-out;
            filter: blur(1px);
        }
        
        .floating-emoji:nth-child(1) { top: 10%; left: 5%; animation-delay: 0s; font-size: 2.5rem; }
        .floating-emoji:nth-child(2) { top: 20%; left: 85%; animation-delay: -2s; font-size: 1.8rem; }
        .floating-emoji:nth-child(3) { top: 50%; left: 15%; animation-delay: -4s; font-size: 3rem; }
        .floating-emoji:nth-child(4) { top: 70%; left: 75%; animation-delay: -6s; font-size: 2.2rem; }
        .floating-emoji:nth-child(5) { top: 85%; left: 25%; animation-delay: -8s; font-size: 1.5rem; }
        .floating-emoji:nth-child(6) { top: 35%; left: 90%; animation-delay: -10s; font-size: 2.8rem; }
        .floating-emoji:nth-child(7) { top: 60%; left: 5%; animation-delay: -12s; font-size: 2rem; }
        .floating-emoji:nth-child(8) { top: 15%; left: 45%; animation-delay: -14s; font-size: 1.7rem; }
        .floating-emoji:nth-child(9) { top: 80%; left: 60%; animation-delay: -16s; font-size: 2.3rem; }
        .floating-emoji:nth-child(10) { top: 45%; left: 70%; animation-delay: -18s; font-size: 1.9rem; }
        
        @keyframes floatEmoji {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            25% { transform: translate(20px, -30px) rotate(10deg); }
            50% { transform: translate(-10px, 20px) rotate(-5deg); }
            75% { transform: translate(15px, 10px) rotate(15deg); }
        }
        
        /* ===== ABSTRACT SHAPES BACKGROUND ===== */
        .abstract-shapes {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        
        .shape {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.06;
        }
        
        .shape-1 {
            width: 500px;
            height: 500px;
            background: linear-gradient(135deg, #FF6B6B, #4ECDC4);
            top: -150px;
            left: -150px;
            animation: morphShape 15s infinite ease-in-out;
        }
        
        .shape-2 {
            width: 400px;
            height: 400px;
            background: linear-gradient(45deg, #18E3A4, #AA96DA);
            top: 50%;
            right: -100px;
            animation: morphShape 12s infinite ease-in-out reverse;
        }
        
        .shape-3 {
            width: 450px;
            height: 450px;
            background: linear-gradient(180deg, #FFE66D, #FF6B6B);
            bottom: -150px;
            left: 20%;
            animation: morphShape 18s infinite ease-in-out;
        }
        
        .shape-4 {
            width: 300px;
            height: 300px;
            background: linear-gradient(90deg, #AA96DA, #18E3A4);
            top: 30%;
            left: 50%;
            animation: morphShape 20s infinite ease-in-out;
        }
        
        @keyframes morphShape {
            0%, 100% { border-radius: 50%; transform: scale(1); }
            33% { border-radius: 40% 60% 60% 40%; transform: scale(1.1); }
            66% { border-radius: 60% 40% 30% 70%; transform: scale(0.95); }
        }
        
        /* ===== LAYERED TEXTURE ===== */
        .layered-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            background: 
                radial-gradient(ellipse at 20% 80%, rgba(24, 227, 164, 0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 20%, rgba(78, 205, 196, 0.04) 0%, transparent 50%),
                radial-gradient(ellipse at 40% 40%, rgba(170, 150, 218, 0.03) 0%, transparent 40%);
        }
        
        /* ===== GLOWING BORDER EFFECT ===== */
        .glow-border {
            position: relative;
            background: linear-gradient(135deg, rgba(24, 227, 164, 0.1), rgba(78, 205, 196, 0.1));
            border-radius: 16px;
            padding: 2px;
        }
        
        .glow-border::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 16px;
            padding: 1px;
            background: linear-gradient(135deg, #18E3A4, #4ECDC4, #AA96DA, #FF6B6B);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: borderGlow 4s linear infinite;
        }
        
        @keyframes borderGlow {
            0% { filter: hue-rotate(0deg); }
            100% { filter: hue-rotate(360deg); }
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }

        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES PEINDRE ===== */
        h2 {
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        
        .text-muted {
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
        }
        
        .toolbar {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        
        .controls {
            display: flex;
            gap: 0.5rem;
            align-items: flex-start;
            flex-wrap: wrap;
        }
        
        .tool-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }
        
        .tool-group label {
            color: var(--text-secondary);
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        .tool-btn, .color-btn {
            transition: all 0.2s ease;
        }
        
        .tool-btn:hover, .color-btn:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        input[type="color"] {
            width: 48px;
            height: 36px;
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            background: rgba(0, 0, 0, 0.3);
            cursor: pointer;
        }
        
        input[type="range"] {
            width: 100px;
            height: 6px;
            background: rgba(24, 227, 164, 0.2);
            border-radius: 3px;
            -webkit-appearance: none;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: var(--primary-color);
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .canvas-wrap {
            background: rgba(0, 0, 0, 0.3);
            border-radius: 16px;
            padding: 8px;
            box-shadow: 
                0 0 30px rgba(24, 227, 164, 0.15),
                0 0 60px rgba(78, 205, 196, 0.1),
                inset 0 0 30px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.2);
            transition: all 0.3s ease;
        }
        
        .canvas-wrap:hover {
            box-shadow: 
                0 0 40px rgba(24, 227, 164, 0.25),
                0 0 80px rgba(78, 205, 196, 0.15),
                inset 0 0 30px rgba(0, 0, 0, 0.3);
            border-color: rgba(24, 227, 164, 0.4);
        }
            border-radius: 8px;
            padding: 8px;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(24, 227, 164, 0.2);
            transition: all 0.3s ease;
        }

            box-shadow: 0 0 20px rgba(24, 227, 164, 0.1);
        }
        
        canvas {
            background: #ffffff;
        }
            display: block;
            width: 100%;
            height: 600px;
            touch-action: none;
            border-radius: 6px;
            cursor: crosshair;
        }
        
        textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            background-color: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            font-family: inherit;
            font-size: 0.95rem;
            transition: all 0.3s;
            margin-top: 0.5rem;
            resize: vertical;
        }
        
        textarea:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        .ms-2 {
            margin-left: 0.5rem;
        }
        
        .mb-3, .mb-4 {
            margin-bottom: 1.5rem;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--primary-color);
            background: rgba(0, 0, 0, 0.3);
            border: none;
            padding: 0.25rem;
            transition: all 0.3s;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1001;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-content {
            max-width: 300px;
            width: 65%;
            background: rgba(26, 31, 30, 0.98);
            padding: 0.8rem;
            border: 1px solid var(--primary-color);
            border-radius: var(--border-radius);
            position: relative;
            animation: slideUp 0.4s;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.2);
            margin: auto;
        }
        
        .modal-image-container {
            width: 100%;
            border-radius: calc(var(--border-radius) - 4px);
            overflow: hidden;
            margin-bottom: 0.4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 40vh;
            background: transparent;
            padding: 0;
        }
        
        .modal-image-container img {
            max-width: 95%;
            max-height: 35vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 4px;
            filter: brightness(1.1);
        }
        
        .modal-title {
            color: var(--primary-color);
            margin-bottom: 0;
            font-size: 0.9rem;
            text-align: center;
            font-weight: 500;
            margin-top: 0.1rem;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .toolbar {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .controls {
                width: 100%;
                justify-content: flex-start;
            }
            
            .tool-group {
                margin-bottom: 8px;
            }
            
            canvas {
                height: 400px;
            }
            
            .modal-content {
                max-width: 280px;
                width: 70%;
                padding: 0.8rem;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="{{ path('challenges_index') }}" class="magic-btn active">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <a href="{{ path('challenges_participate', {'id': defi.id}) }}" class="btn btn-secondary magic-btn mb-3">← Retour</a>
                    
                    <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Peindre — {{ defi.titre }}</h2>
                    <p class="text-muted mb-3">Utilisez l'éditeur ci-dessous pour créer votre œuvre. Cliquez sur <strong>Enregistrer et envoyer</strong> pour soumettre votre peinture.</p>

                    <div class="toolbar mb-3">
