    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== PAINTING FUNCTIONS =====
        
        // Check for AI image in URL
        document.addEventListener('DOMContentLoaded', function() {
            const canvas = document.getElementById('paintCanvas');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            let drawing = false;
            
            // Check for AI generated image in URL or localStorage
            const urlParams = new URLSearchParams(window.location.search);
            const aiImageUrl = urlParams.get('aiImage');
            const localStorageAiImage = localStorage.getItem('aiGeneratedImage');
            
            if (aiImageUrl || localStorageAiImage) {
                const img = new Image();
                img.onload = function() {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    saveToHistory();
                };
                img.src = aiImageUrl || localStorageAiImage;
                localStorage.removeItem('aiGeneratedImage');
            }
            let lastX = 0, lastY = 0;
            let currentTool = 'brush';
            let currentGradient = 'none';
            let currentOpacity = 1;
            let sprayInterval = null;
            let shapeStartX = 0, shapeStartY = 0;
            let tempCanvas = null;
            let lastPressure = 0;
            let points = [];
            
            // Gradient definitions
            const gradients = {
                'linear': (ctx, x1, y1, x2, y2, color) => {
                    const gradient = ctx.createLinearGradient(x1, y1, x2, y2);
                    gradient.addColorStop(0, color);
                    gradient.addColorStop(1, adjustBrightness(color, 40));
                    return gradient;
                },
                'radial': (ctx, x1, y1, x2, y2, color) => {
                    const gradient = ctx.createRadialGradient(x1, y1, 0, x1, y1, Math.hypot(x2-x1, y2-y1));
                    gradient.addColorStop(0, color);
                    gradient.addColorStop(1, adjustBrightness(color, -30));
                    return gradient;
                },
                'sunset': (ctx, x1, y1, x2, y2, color) => {
                    const gradient = ctx.createLinearGradient(x1, y1, x1, y2);
                    gradient.addColorStop(0, '#FF6B6B');
                    gradient.addColorStop(0.5, '#FFE66D');
                    gradient.addColorStop(1, '#4ECDC4');
                    return gradient;
                },
                'ocean': (ctx, x1, y1, x2, y2, color) => {
                    const gradient = ctx.createLinearGradient(x1, y1, x1, y2);
                    gradient.addColorStop(0, '#4ECDC4');
                    gradient.addColorStop(0.5, '#18E3A4');
                    gradient.addColorStop(1, '#AA96DA');
                    return gradient;
                }
            };
            
            function adjustBrightness(hex, percent) {
                const num = parseInt(hex.replace('#', ''), 16);
                const amt = Math.round(2.55 * percent);
                const R = (num >> 16) + amt;
                const G = (num >> 8 & 0x00FF) + amt;
                const B = (num & 0x0000FF) + amt;
                return '#' + (0x1000000 + (R<255?R<1?0:R:255)*0x10000 + (G<255?G<1?0:G:255)*0x100 + (B<255?B<1?0:B:255)).toString(16).slice(1);
            }
            
            // Tool selection
            document.querySelectorAll('.tool-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.tool-btn').forEach(b => {
                        b.classList.remove('active');
                        b.style.background = 'transparent';
                        b.style.borderColor = 'rgba(24,227,164,0.3)';
                        b.style.color = 'var(--text-secondary)';
                    });
                    this.classList.add('active');
                    this.style.background = 'rgba(24,227,164,0.2)';
                    this.style.borderColor = 'var(--primary-color)';
                    this.style.color = 'var(--primary-color)';
                    currentTool = this.dataset.tool;
                });
            });
            
            // Gradient selection
            document.querySelectorAll('.gradient-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.gradient-btn').forEach(b => b.classList.remove('active'));
                    this.classList.add('active');
                    currentGradient = this.dataset.gradient;
                });
            });
            
            // History for undo/redo
            let history = [];
            let historyStep = -1;
            const maxHistory = 30;
            
            // Save canvas state to history
            function saveToHistory() {
                // Remove future history if we're not at the end
                if (historyStep < history.length - 1) {
                    history = history.slice(0, historyStep + 1);
                }
                
                // Add current state
                history.push(canvas.toDataURL());
                historyStep++;
                
                // Limit history size
                if (history.length > maxHistory) {
                    history.shift();
                    historyStep--;
                }
            }
            
            // Initialize with white background
            ctx.fillStyle = '#FFFFFF';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            saveToHistory();

            function resizeCanvasToDisplaySize(canvas) {
                const ratio = window.devicePixelRatio || 1;
                const w = canvas.clientWidth * ratio;
                const h = canvas.clientHeight * ratio;
                if (canvas.width !== w || canvas.height !== h) {
                    const imgData = ctx.getImageData(0,0,canvas.width,canvas.height);
                    canvas.width = w;
                    canvas.height = h;
                    ctx.putImageData(imgData,0,0);
                }
            }

            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length) {
                    return { 
                        x: (e.touches[0].clientX - rect.left) * (canvas.width / rect.width), 
                        y: (e.touches[0].clientY - rect.top) * (canvas.height / rect.height) 
                    };
                }
                return { 
                    x: (e.clientX - rect.left) * (canvas.width / rect.width), 
                    y: (e.clientY - rect.top) * (canvas.height / rect.height) 
                };
            }
            
            // Get current color with opacity
            function getColor(x = 0, y = 0) {
                let color = document.getElementById('color').value;
                if (currentTool === 'eraser') {
                    return 'rgba(255,255,255,' + currentOpacity + ')';
                }
                // Apply gradient if selected
                if (currentGradient !== 'none' && gradients[currentGradient]) {
                    return gradients[currentGradient](ctx, x, y, x + 200, y + 200, color);
                }
                // Convert hex to rgba
                const r = parseInt(color.slice(1,3), 16);
                const g = parseInt(color.slice(3,5), 16);
                const b = parseInt(color.slice(5,7), 16);
                return `rgba(${r},${g},${b},${currentOpacity})`;
            }
            
            // Watercolor brush effect
            function watercolorBrush(x, y, size) {
                ctx.globalCompositeOperation = 'multiply';
                for (let i = 0; i < 3; i++) {
                    const offsetX = (Math.random() - 0.5) * size * 0.5;
                    const offsetY = (Math.random() - 0.5) * size * 0.5;
                    const blobSize = size * (0.3 + Math.random() * 0.4);
                    ctx.beginPath();
                    ctx.arc(x + offsetX, y + offsetY, blobSize, 0, Math.PI * 2);
                    ctx.fillStyle = getColor(x, y);
                    ctx.globalAlpha = currentOpacity * 0.3;
                    ctx.fill();
                }
                ctx.globalAlpha = 1;
                ctx.globalCompositeOperation = 'source-over';
            }
            
            // Airbrush effect
            function airbrush(x, y, size) {
                const density = size * 2;
                for (let i = 0; i < density; i++) {
                    const angle = Math.random() * Math.PI * 2;
                    const radius = Math.random() * size;
                    const px = x + Math.cos(angle) * radius;
                    const py = y + Math.sin(angle) * radius;
                    ctx.fillStyle = getColor(x, y);
                    ctx.globalAlpha = Math.random() * currentOpacity * 0.5;
                    ctx.fillRect(px, py, 1 + Math.random() * 2, 1 + Math.random() * 2);
                }
                ctx.globalAlpha = 1;
            }
            
            // Fill bucket (flood fill)
            function floodFill(startX, startY, fillColor) {
                const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
                const data = imageData.data;
                const width = canvas.width;
                const height = canvas.height;
                
                const startPos = (startY * width + startX) * 4;
                const startR = data[startPos];
                const startG = data[startPos + 1];
                const startB = data[startPos + 2];
                
                const targetColor = hexToRgb(fillColor);
                if (Math.abs(startR - targetColor.r) < 10 && Math.abs(startG - targetColor.g) < 10 && Math.abs(startB - targetColor.b) < 10) {
                    return;
                }
                
                const tolerance = 32;
                const stack = [[startX, startY]];
                const visited = new Set();
                
                while (stack.length > 0) {
                    const [x, y] = stack.pop();
                    const key = y * width + x;
                    
                    if (visited.has(key) || x < 0 || x >= width || y < 0 || y >= height) continue;
                    
                    const pos = key * 4;
                    if (Math.abs(data[pos] - startR) > tolerance || Math.abs(data[pos + 1] - startG) > tolerance || 
                        Math.abs(data[pos + 2] - startB) > tolerance) continue;
                    
                    visited.add(key);
                    data[pos] = targetColor.r;
                    data[pos + 1] = targetColor.g;
                    data[pos + 2] = targetColor.b;
                    data[pos + 3] = 255;
                    
                    stack.push([x + 1, y], [x - 1, y], [x, y + 1], [x, y - 1]);
                }
                
                ctx.putImageData(imageData, 0, 0);
            }
            
            function hexToRgb(hex) {
                const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
                return result ? {
                    r: parseInt(result[1], 16),
                    g: parseInt(result[2], 16),
                    b: parseInt(result[3], 16)
                } : { r: 0, g: 0, b: 0 };
            }
            
            // Eyedropper
            function eyedropper(x, y) {
                const pixel = ctx.getImageData(Math.floor(x), Math.floor(y), 1, 1).data;
                const hex = '#' + [pixel[0], pixel[1], pixel[2]].map(x => x.toString(16).padStart(2, '0')).join('');
                document.getElementById('color').value = hex;
            }
            
            // Get brush size
            function getSize() {
                const baseSize = parseInt(document.getElementById('size').value);
                const ratio = canvas.width / canvas.clientWidth;
                return baseSize * ratio;
            }
            
            // Draw with different tools
            function drawWithTool(x, y, lastX = x, lastY = y) {
                const size = getSize();
                const color = getColor(x, y);
                
                switch(currentTool) {
                    case 'brush':
                        ctx.strokeStyle = color;
                        ctx.lineWidth = size;
                        ctx.lineCap = 'round';
                        ctx.lineJoin = 'round';
                        break;
                    
                    case 'watercolor':
                        watercolorBrush(x, y, size);
                        return;
                    
                    case 'airbrush':
                        airbrush(x, y, size);
                        return;
                        
                    case 'marker':
                        ctx.strokeStyle = color;
                        ctx.lineWidth = size * 2;
                        ctx.lineCap = 'square';
                        ctx.globalAlpha = currentOpacity * 0.6;
                        break;
                        
                    case 'spray':
                        // Spray effect handled separately
                        break;
                        
                    case 'eraser':
                        ctx.strokeStyle = color;
                        ctx.lineWidth = size * 1.5;
                        ctx.lineCap = 'round';
                        ctx.lineJoin = 'round';
                        break;
                }
            }
            
            // Spray tool effect
            function spray(x, y) {
                const size = getSize();
                const color = document.getElementById('color').value;
                const density = size * 2;
                
                for (let i = 0; i < density; i++) {
                    const offsetX = (Math.random() - 0.5) * size * 3;
                    const offsetY = (Math.random() - 0.5) * size * 3;
                    const radius = Math.random() * 2;
                    
                    ctx.beginPath();
                    ctx.arc(x + offsetX, y + offsetY, radius, 0, Math.PI * 2);
                    ctx.fillStyle = color;
                    ctx.globalAlpha = Math.random() * 0.5 * currentOpacity;
                    ctx.fill();
                }
                ctx.globalAlpha = currentOpacity;
            }

            canvas.addEventListener('pointerdown', (e) => { 
                const p = getPos(e);
                lastX = p.x;
                lastY = p.y;
                
                // Handle special tools that don't need dragging
                if (currentTool === 'fill') {
                    floodFill(Math.floor(p.x), Math.floor(p.y), document.getElementById('color').value);
                    saveToHistory();
                    return;
                }
                
                if (currentTool === 'eyedropper') {
                    eyedropper(p.x, p.y);
                    return;
                }
                
                // For shape tools, save start position
                if (currentTool === 'line' || currentTool === 'rectangle' || currentTool === 'circle') {
                    shapeStartX = p.x;
                    shapeStartY = p.y;
                    // Create temporary canvas for shape preview
                    tempCanvas = document.createElement('canvas');
                    tempCanvas.width = canvas.width;
                    tempCanvas.height = canvas.height;
                    tempCanvas.getContext('2d').drawImage(canvas, 0, 0);
                }
                
                drawing = true;
                canvas.setPointerCapture(e.pointerId);
                
                // For spray tool, start continuous spray
                if (currentTool === 'spray') {
                    sprayInterval = setInterval(() => {
                        if (drawing) {
                            spray(lastX, lastY);
                            lastX += (Math.random() - 0.5) * 10;
                            lastY += (Math.random() - 0.5) * 10;
                        }
                    }, 50);
                }
            });
            
            canvas.addEventListener('pointerup', (e) => { 
                const p = getPos(e);
                
                // Handle shape tools
                if (currentTool === 'line') {
                    ctx.putImageData(tempCanvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height), 0, 0);
                    ctx.strokeStyle = getColor(shapeStartX, shapeStartY);
                    ctx.lineWidth = getSize();
                    ctx.lineCap = 'round';
                    ctx.beginPath();
                    ctx.moveTo(shapeStartX, shapeStartY);
                    ctx.lineTo(p.x, p.y);
                    ctx.stroke();
                } else if (currentTool === 'rectangle') {
                    ctx.putImageData(tempCanvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height), 0, 0);
                    ctx.strokeStyle = getColor(shapeStartX, shapeStartY);
                    ctx.lineWidth = getSize();
                    ctx.strokeRect(shapeStartX, shapeStartY, p.x - shapeStartX, p.y - shapeStartY);
                } else if (currentTool === 'circle') {
                    ctx.putImageData(tempCanvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height), 0, 0);
                    ctx.strokeStyle = getColor(shapeStartX, shapeStartY);
                    ctx.lineWidth = getSize();
                    const radius = Math.hypot(p.x - shapeStartX, p.y - shapeStartY);
                    ctx.beginPath();
                    ctx.arc(shapeStartX, shapeStartY, radius, 0, Math.PI * 2);
                    ctx.stroke();
                }
                
                tempCanvas = null;
                drawing = false; 
                if (sprayInterval) {
                    clearInterval(sprayInterval);
                    sprayInterval = null;
                }
                saveToHistory();
            });
            
            canvas.addEventListener('pointercancel', () => { 
                drawing = false; 
                tempCanvas = null;
                if (sprayInterval) {
                    clearInterval(sprayInterval);
                    sprayInterval = null;
                }
            });
            
            // Preview shapes while dragging
            canvas.addEventListener('pointermove', (e) => {
                const p = getPos(e);
                
                // Show shape preview
                if (drawing && tempCanvas && (currentTool === 'line' || currentTool === 'rectangle' || currentTool === 'circle')) {
                    ctx.putImageData(tempCanvas.getContext('2d').getImageData(0, 0, canvas.width, canvas.height), 0, 0);
                    ctx.strokeStyle = getColor(shapeStartX, shapeStartY);
                    ctx.lineWidth = getSize();
                    ctx.setLineDash([5, 5]);
                    
                    if (currentTool === 'line') {
                        ctx.beginPath();
                        ctx.moveTo(shapeStartX, shapeStartY);
                        ctx.lineTo(p.x, p.y);
                        ctx.stroke();
                    } else if (currentTool === 'rectangle') {
                        ctx.strokeRect(shapeStartX, shapeStartY, p.x - shapeStartX, p.y - shapeStartY);
                    } else if (currentTool === 'circle') {
                        const radius = Math.hypot(p.x - shapeStartX, p.y - shapeStartY);
                        ctx.beginPath();
                        ctx.arc(shapeStartX, shapeStartY, radius, 0, Math.PI * 2);
                        ctx.stroke();
                    }
                    ctx.setLineDash([]);
                    return;
                }
                
                if (!drawing) return;
                
                if (currentTool === 'spray') {
                    spray(p.x, p.y);
                } else {
                    drawWithTool(p.x, p.y, lastX, lastY);
                    ctx.beginPath();
                    ctx.moveTo(lastX, lastY);
                    ctx.lineTo(p.x, p.y);
                    ctx.stroke();
                    
                    // Reset alpha after marker
                    if (currentTool === 'marker') {
                        ctx.globalAlpha = 1;
                    }
                }
                lastX = p.x; 
                lastY = p.y;
            });

            // Clear canvas
            document.getElementById('clear').addEventListener('click', () => {
                ctx.fillStyle = '#FFFFFF';
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                saveToHistory();
            });

            // Undo
            document.getElementById('undo').addEventListener('click', () => {
                if (historyStep > 0) {
                    historyStep--;
                    const img = new Image();
                    img.onload = () => {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        ctx.drawImage(img, 0, 0);
                    };
                    img.src = history[historyStep];
                }
            });

            // Redo
            document.getElementById('redo').addEventListener('click', () => {
                if (historyStep < history.length - 1) {
                    historyStep++;
                    const img = new Image();
                    img.onload = () => {
                        ctx.clearRect(0, 0, canvas.width, canvas.height);
                        ctx.drawImage(img, 0, 0);
                    };
                    img.src = history[historyStep];
                }
            });

            // Tool selection
            document.querySelectorAll('.tool-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.tool-btn').forEach(b => {
                        b.style.background = 'transparent';
                        b.style.borderColor = 'rgba(24,227,164,0.3)';
                        b.style.color = 'var(--text-secondary)';
                    });
                    btn.style.background = 'rgba(24,227,164,0.2)';
                    btn.style.borderColor = 'var(--primary-color)';
                    btn.style.color = 'var(--primary-color)';
                    currentTool = btn.dataset.tool;
                });
            });

            // Color palette
            document.querySelectorAll('.color-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.color-btn').forEach(b => {
                        b.style.borderColor = 'transparent';
                    });
                    btn.style.borderColor = 'rgba(24,227,164,0.8)';
                    document.getElementById('color').value = btn.dataset.color;
                });
            });

            // Size slider display
            document.getElementById('size').addEventListener('input', (e) => {
                document.getElementById('sizeValue').textContent = e.target.value;
            });

            // Opacity slider
            document.getElementById('opacity').addEventListener('input', (e) => {
                currentOpacity = e.target.value / 100;
                document.getElementById('opacityValue').textContent = e.target.value;
            });

            // Save
            document.getElementById('save').addEventListener('click', () => {
                const description = document.getElementById('description').value || 'Peinture digitale';
                const dataUrl = canvas.toDataURL('image/png');
                
                fetch('{{ path('challenges_peindre_save', {'id': defi.id}) }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'imageData=' + encodeURIComponent(dataUrl) + '&description=' + encodeURIComponent(description)
                }).then(r => {
                    if (r.redirected) {
                        window.location = r.url;
                    } else {
                        return r.text().then(t => alert('Réponse: ' + t));
                    }
                }).catch(e => alert('Erreur lors de l\'envoi: ' + e.message));
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            if (!imageSrc) return;
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || '{{ defi.titre }}';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('challenges_index') }}' && currentPath.includes('/challenges'))) {
                link.classList.add('active');
            }
        });
    </script>
    
