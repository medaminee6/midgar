<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peindre - {{ defi.titre }} | Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES PEINDRE ===== */
        h2 {
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        
        .text-muted {
            color: var(--text-secondary);
            margin-bottom: 1.5rem;
        }
        
        .toolbar {
            display: flex;
            gap: 1rem;
            align-items: center;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
        }
        
        .controls {
            display: flex;
            gap: 0.5rem;
            align-items: center;
            flex-wrap: wrap;
        }
        
        label {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        input[type="color"] {
            width: 48px;
            height: 36px;
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            background: rgba(0, 0, 0, 0.3);
            cursor: pointer;
        }
        
        input[type="range"] {
            width: 100px;
            height: 6px;
            background: rgba(24, 227, 164, 0.2);
            border-radius: 3px;
            -webkit-appearance: none;
        }
        
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: var(--primary-color);
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .canvas-wrap {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 8px;
            padding: 8px;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(24, 227, 164, 0.2);
            transition: all 0.3s ease;
        }
        
        .canvas-wrap:hover {
            border-color: rgba(24, 227, 164, 0.4);
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.1);
        }
        
        canvas {
            background: #ffffff;
            display: block;
            width: 100%;
            height: 600px;
            touch-action: none;
            border-radius: 6px;
            cursor: crosshair;
        }
        
        textarea {
            width: 100%;
            min-height: 100px;
            padding: 0.75rem;
            background-color: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            font-family: inherit;
            font-size: 0.95rem;
            transition: all 0.3s;
            margin-top: 0.5rem;
            resize: vertical;
        }
        
        textarea:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        .ms-2 {
            margin-left: 0.5rem;
        }
        
        .mb-3, .mb-4 {
            margin-bottom: 1.5rem;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--primary-color);
            background: rgba(0, 0, 0, 0.3);
            border: none;
            padding: 0.25rem;
            transition: all 0.3s;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1001;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-content {
            max-width: 300px;
            width: 65%;
            background: rgba(26, 31, 30, 0.98);
            padding: 0.8rem;
            border: 1px solid var(--primary-color);
            border-radius: var(--border-radius);
            position: relative;
            animation: slideUp 0.4s;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.2);
            margin: auto;
        }
        
        .modal-image-container {
            width: 100%;
            border-radius: calc(var(--border-radius) - 4px);
            overflow: hidden;
            margin-bottom: 0.4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 40vh;
            background: transparent;
            padding: 0;
        }
        
        .modal-image-container img {
            max-width: 95%;
            max-height: 35vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 4px;
            filter: brightness(1.1);
        }
        
        .modal-title {
            color: var(--primary-color);
            margin-bottom: 0;
            font-size: 0.9rem;
            text-align: center;
            font-weight: 500;
            margin-top: 0.1rem;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .toolbar {
                flex-direction: column;
                align-items: flex-start;
            }
            
            .controls {
                width: 100%;
            }
            
            canvas {
                height: 400px;
            }
            
            .modal-content {
                max-width: 280px;
                width: 70%;
                padding: 0.8rem;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="{{ path('challenges_index') }}" class="magic-btn active">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <a href="{{ path('challenges_participate', {'id': defi.id}) }}" class="btn btn-secondary magic-btn mb-3">← Retour</a>
                    
                    <h2 style="color: var(--primary-color); margin-bottom: 1rem;">Peindre — {{ defi.titre }}</h2>
                    <p class="text-muted mb-3">Utilisez l'éditeur ci-dessous pour créer votre œuvre. Cliquez sur <strong>Enregistrer et envoyer</strong> pour soumettre votre peinture.</p>

                    <div class="toolbar mb-3">
                        <div class="controls">
                            <label for="color">Couleur</label>
                            <input id="color" type="color" value="#18E3A4" style="width:48px; height:36px;">
                            <label for="size" class="ms-2">Taille</label>
                            <input id="size" type="range" min="1" max="50" value="4" style="width:100px;">
                            <button id="clear" class="btn btn-secondary magic-btn ms-2">Effacer</button>
                        </div>
                        <div style="margin-left:auto;">
                            <button id="save" class="btn btn-primary magic-btn">Enregistrer et envoyer</button>
                        </div>
                    </div>

                    <div class="canvas-wrap mb-3">
                        <canvas id="paintCanvas" width="1200" height="800"></canvas>
                    </div>

                    <div class="mb-3">
                        <label for="description" style="color: var(--text-color); font-weight: 600;">Description (optionnel)</label>
                        <textarea id="description" class="form-control" placeholder="Décrivez votre œuvre..."></textarea>
                    </div>
                </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALE IMAGE (PRÊTE À L'EMPLOI) ===== -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('imageModal')">×</button>
            <div class="modal-image-container">
                <img id="modalImage" src="" alt="Image agrandie">
            </div>
            <h3 class="modal-title" id="modalImageTitle">{{ defi.titre }}</h3>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== PAINTING FUNCTIONS =====
        document.addEventListener('DOMContentLoaded', function() {
            const canvas = document.getElementById('paintCanvas');
            if (!canvas) return;
            
            const ctx = canvas.getContext('2d');
            let drawing = false;
            let lastX = 0, lastY = 0;

            function resizeCanvasToDisplaySize(canvas) {
                const ratio = window.devicePixelRatio || 1;
                const w = canvas.clientWidth * ratio;
                const h = canvas.clientHeight * ratio;
                if (canvas.width !== w || canvas.height !== h) {
                    const imgData = ctx.getImageData(0,0,canvas.width,canvas.height);
                    canvas.width = w;
                    canvas.height = h;
                    ctx.putImageData(imgData,0,0);
                }
            }

            function getPos(e) {
                const rect = canvas.getBoundingClientRect();
                if (e.touches && e.touches.length) {
                    return { 
                        x: (e.touches[0].clientX - rect.left) * (canvas.width / rect.width), 
                        y: (e.touches[0].clientY - rect.top) * (canvas.height / rect.height) 
                    };
                }
                return { 
                    x: (e.clientX - rect.left) * (canvas.width / rect.width), 
                    y: (e.clientY - rect.top) * (canvas.height / rect.height) 
                };
            }

            canvas.addEventListener('pointerdown', (e) => { 
                drawing = true; 
                const p = getPos(e); 
                lastX = p.x; 
                lastY = p.y; 
                canvas.setPointerCapture(e.pointerId);
            });
            
            canvas.addEventListener('pointerup', () => drawing = false);
            canvas.addEventListener('pointercancel', () => drawing = false);
            
            canvas.addEventListener('pointermove', (e) => {
                if (!drawing) return;
                const p = getPos(e);
                ctx.strokeStyle = document.getElementById('color').value;
                ctx.lineWidth = document.getElementById('size').value * (canvas.width / canvas.clientWidth);
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                lastX = p.x; 
                lastY = p.y;
            });

            document.getElementById('clear').addEventListener('click', () => {
                ctx.clearRect(0,0,canvas.width,canvas.height);
            });

            document.getElementById('save').addEventListener('click', () => {
                const description = document.getElementById('description').value || 'Peinture digitale';
                const dataUrl = canvas.toDataURL('image/png');
                
                fetch('{{ path('challenges_peindre_save', {'id': defi.id}) }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'imageData=' + encodeURIComponent(dataUrl) + '&description=' + encodeURIComponent(description)
                }).then(r => {
                    if (r.redirected) {
                        window.location = r.url;
                    } else {
                        return r.text().then(t => alert('Réponse: ' + t));
                    }
                }).catch(e => alert('Erreur lors de l\'envoi: ' + e.message));
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            if (!imageSrc) return;
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || '{{ defi.titre }}';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('challenges_index') }}' && currentPath.includes('/challenges'))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>