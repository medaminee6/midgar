                            <!-- Size & Opacity -->
                            <div class="tool-group ms-3">
                                <label style="display: block; margin-bottom: 4px;">Taille: <span id="sizeValue">4</span>px</label>
                                <input id="size" type="range" min="1" max="100" value="4" style="width:100px;">
                            </div>
                            
                            <div class="tool-group ms-3">
                                <label style="display: block; margin-bottom: 4px;">Opacité: <span id="opacityValue">100</span>%</label>
                                <input id="opacity" type="range" min="10" max="100" value="100" style="width:80px;">
                            </div>
                            
                            <!-- Gradient -->
                            <div class="tool-group ms-3">
                                <label style="display: block; margin-bottom: 4px;">Dégradé</label>
                                <div style="display: flex; gap: 4px;">
                                    <button class="gradient-btn active" data-gradient="none" title="Aucune" style="padding:4px 8px;background:linear-gradient(90deg,#fff,#eee);border:1px solid #ccc;border-radius:4px;cursor:pointer;font-size:10px;">✖</button>
                                    <button class="gradient-btn" data-gradient="linear" title="Lineaire" style="padding:4px 8px;background:linear-gradient(90deg,#FF6B6B,#4ECDC4);border:1px solid #ccc;border-radius:4px;cursor:pointer;font-size:10px;">↗</button>
                                    <button class="gradient-btn" data-gradient="radial" title="Radial" style="padding:4px 8px;background:radial-gradient(circle,#FF6B6B,#4ECDC4);border:1px solid #ccc;border-radius:4px;cursor:pointer;font-size:10px;">◉</button>
                                    <button class="gradient-btn" data-gradient="sunset" title="Coucher soleil" style="padding:4px 8px;background:linear-gradient(180deg,#FF6B6B,#FFE66D,#4ECDC4);border:1px solid #ccc;border-radius:4px;cursor:pointer;font-size:10px;">🌅</button>
                                    <button class="gradient-btn" data-gradient="ocean" title="Ocean" style="padding:4px 8px;background:linear-gradient(180deg,#4ECDC4,#18E3A4,#AA96DA);border:1px solid #ccc;border-radius:4px;cursor:pointer;font-size:10px;">🌊</button>
