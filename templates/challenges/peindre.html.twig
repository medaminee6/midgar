                    <div class="mb-3">
                        <label for="description" style="color: var(--text-color); font-weight: 600;">Description (optionnel)</label>
                        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 8px;">
                            <textarea id="description" class="form-control" placeholder="Décrivez votre œuvre..."></textarea>
