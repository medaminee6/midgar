                                    <button class="tool-btn" data-tool="eyedropper" title="Pipette" style="padding:6px 10px;background:transparent;border:1px solid rgba(24,227,164,0.3);border-radius:6px;cursor:pointer;color:var(--text-secondary);">💧</button>
                                    <button class="tool-btn" data-tool="line" title="Ligne" style="padding:6px 10px;background:transparent;border:1px solid rgba(24,227,164,0.3);border-radius:6px;cursor:pointer;color:var(--text-secondary);">📏</button>
                                    <button class="tool-btn" data-tool="rectangle" title="Rectangle" style="padding:6px 10px;background:transparent;border:1px solid rgba(24,227,164,0.3);border-radius:6px;cursor:pointer;color:var(--text-secondary);">⬜</button>
                                    <button class="tool-btn" data-tool="circle" title="Cercle" style="padding:6px 10px;background:transparent;border:1px solid rgba(24,227,164,0.3);border-radius:6px;cursor:pointer;color:var(--text-secondary);">⭕</button>
                                </div>
