                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                                <strong style="color: var(--primary-color);">💡 Suggestion IA</strong>
                                <button type="button" id="aiSuggestionBtn" class="btn btn-secondary btn-sm magic-btn" onclick="generateAISuggestion()">
