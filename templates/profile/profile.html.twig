                    </div>
                </div>
                <div class="modal-actions" id="oeuvreModalActions">
                    <button class="btn btn-secondary magic-btn" onclick="closeModal('oeuvreModal')">Fermer</button>
                    <!-- Les boutons d'édition/suppression seront ajoutés dynamiquement si c'est le propriétaire -->
                </div>
            </div>
        </div>

