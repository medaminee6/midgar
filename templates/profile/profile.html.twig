    <script>
        // Magic Button Particle Effect
        document.querySelectorAll('.magic-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    const hue = Math.floor(Math.random() * 60) + 140;
                    particle.style.background = `radial-gradient(circle, hsl(${hue}, 100%, 60%), hsl(${hue}, 100%, 30%))`;
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // Highlight active nav link
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            const homePath = '{{ path('home') }}';
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === homePath && currentPath === '/')) {
                link.classList.add('active');
            }
        });

        // Background initialization
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) {
                        gradientBg.style.display = 'block';
                    }
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) {
                        gradientBg.style.display = 'block';
                    }
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // Fonctions modales
        function openModal(id) {
            document.getElementById(id).style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Fermer si clic en dehors de la modal
        window.onclick = function(event) {
            const modals = ['editProfileModal', 'settingsModal', 'oeuvreModal', 'artefactModal', 'universeModal'];
            modals.forEach(id => {
                const modal = document.getElementById(id);
                if (event.target == modal) {
                    closeModal(id);
                }
            });
        }

        // Fermer modales avec Escape
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal('editProfileModal');
                closeModal('settingsModal');
                closeModal('oeuvreModal');
                closeModal('artefactModal');
                closeModal('universeModal');
            }
        });

        // Fonction pour ouvrir la modale d'œuvre
        function openOeuvreModal(id) {
            window.currentOeuvreId = id;
            const editBtn = document.getElementById('oeuvreEditBtn');
            editBtn.href = '/oeuvre/' + id + '/edit';
            {% if oeuvres is defined and oeuvres|length > 0 %}
                {% set oeuvre = oeuvres[0] %}
                const oeuvreData = {
                    title: "{{ oeuvre.title|default('Titre de l\'œuvre')|e('js') }}",
                    author: "{{ app.user.username|e('js') }}",
                    image: "{{ oeuvre.imageUrl|default('')|e('js') }}",
                    type: "{{ oeuvre.type|default('Roman')|e('js') }}",
                    date: "{{ oeuvre.createdAt ? oeuvre.createdAt|date('d/m/Y') : '01/01/2024' }}",
                    status: "{{ oeuvre.status|default('Publié')|e('js') }}",
                    tags: {{ oeuvre.tags|default(['Fantasy', 'Aventure'])|json_encode|raw }},
                    description: "{{ oeuvre.description|default('Description de l\'œuvre...')|e('js') }}"
                };
            {% else %}
                const oeuvreData = {
                    title: "Aucune œuvre",
                    author: "{{ app.user.username|e('js') }}",
                    image: "",
                    type: "-",
                    date: "-",
                    status: "-",
                    tags: [],
                    description: "Vous n'avez pas encore créé d'œuvre. Commencez dès maintenant !"
                };
            {% endif %}
            
            document.getElementById('oeuvreTitle').textContent = oeuvreData.title;
            document.getElementById('oeuvreAuthor').textContent = "Par " + oeuvreData.author;
            document.getElementById('oeuvreImage').src = oeuvreData.image;
            document.getElementById('oeuvreType').textContent = oeuvreData.type;
            document.getElementById('oeuvreDate').textContent = oeuvreData.date;
            document.getElementById('oeuvreStatus').textContent = oeuvreData.status;
            document.getElementById('oeuvreDescription').textContent = oeuvreData.description;
            
            const tagsContainer = document.getElementById('oeuvreTags');
            tagsContainer.innerHTML = '';
            if (oeuvreData.tags && oeuvreData.tags.length > 0) {
                oeuvreData.tags.forEach(tag => {
                    const tagElement = document.createElement('span');
                    tagElement.className = 'tag';
                    tagElement.textContent = tag;
                    tagsContainer.appendChild(tagElement);
                });
            } else {
                const tagElement = document.createElement('span');
                tagElement.className = 'tag';
                tagElement.textContent = 'Non catégorisé';
                tagsContainer.appendChild(tagElement);
            }
            
            openModal('oeuvreModal');
        }

        // Fonction pour supprimer une œuvre
        function deleteOeuvre() {
            if (!window.currentOeuvreId) return;
            
            if (confirm('Êtes-vous sûr de vouloir supprimer cette œuvre ? Cette action est irréversible.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/oeuvre/' + window.currentOeuvreId + '/delete';
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Fonction pour ouvrir la modale d'artefact
        function openArtefactModal(id) {
            window.currentArtefactId = id;
            const editBtn = document.getElementById('artefactEditBtn');
            editBtn.href = '/artefact/' + id + '/edit';
            {% if artefacts is defined and artefacts|length > 0 %}
                {% set artefact = artefacts[0] %}
                const artefactData = {
                    name: "{{ artefact.name|default('Nom de l\'artefact')|e('js') }}",
                    type: "{{ artefact.type|default('Artefact mystérieux')|e('js') }}",
                    image: "{{ artefact.imageUrl|default('')|e('js') }}",
                    rarity: "{{ artefact.rarity|default('Légendaire')|e('js') }}",
                    powers: "{{ artefact.powers|default('Pouvoirs inconnus')|e('js') }}",
                    date: "{{ artefact.createdAt ? artefact.createdAt|date('d/m/Y') : '01/01/2024' }}",
                    origin: "{{ artefact.origins|default('Origine inconnue')|e('js') }}",
                    description: "{{ artefact.description|default(artefact.origins)|default('Description de l\'artefact...')|e('js') }}"
                };
            {% else %}
                const artefactData = {
                    name: "Aucun artefact",
                    type: "-",
                    image: "",
                    rarity: "-",
                    powers: "-",
                    date: "-",
                    origin: "-",
                    description: "Vous n'avez pas encore créé d'artefact. Commencez dès maintenant !"
                };
            {% endif %}
            
            document.getElementById('artefactName').textContent = artefactData.name;
            document.getElementById('artefactType').textContent = artefactData.type;
            document.getElementById('artefactImage').src = artefactData.image;
            document.getElementById('artefactRarity').textContent = artefactData.rarity;
            document.getElementById('artefactPowers').textContent = artefactData.powers;
            document.getElementById('artefactDate').textContent = artefactData.date;
            document.getElementById('artefactOrigin').textContent = artefactData.origin;
            document.getElementById('artefactDescription').textContent = artefactData.description;
            
            openModal('artefactModal');
        }

        // Fonction pour supprimer un artefact
        function deleteArtefact() {
            if (confirm('Êtes-vous sûr de vouloir supprimer cet artefact ? Cette action est irréversible.')) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/artefact/' + window.currentArtefactId + '/delete';
                document.body.appendChild(form);
                form.submit();
            }
        }

        // Fonction pour ouvrir la modale d'univers
        function openUniverseModal(universeId) {
            let universeData;
            
            if (universeId === 'universe-1') {
                universeData = {
                    name: 'Nuit Éternelle',
                    creator: "{{ app.user.username|e('js') }}",
                    image: "",
                    themes: ['Sombre', 'Mystère'],
                    favorites: '1,240',
                    date: '01/01/2024',
                    status: 'Public',
                    description: 'Un monde plongé dans une nuit perpétuelle, où la lune ne se couche jamais et les créatures nocturnes règnent en maître.'
                };
            } else if (universeId === 'universe-2') {
                universeData = {
                    name: 'Châteaux Flottants',
                    creator: "{{ app.user.username|e('js') }}",
                    image: "",
                    themes: ['Épic', 'Magie'],
                    favorites: '892',
                    date: '01/01/2024',
                    status: 'Public',
                    description: 'Des forteresses majestueuses flottant dans les nuages, où la magie est omniprésente et les chevaliers combattent à dos de griffons.'
                };
            } else {
                universeData = {
                    name: 'Univers inconnu',
                    creator: "{{ app.user.username|e('js') }}",
                    image: "",
                    themes: [],
                    favorites: '0',
                    date: '01/01/2024',
                    status: 'Privé',
                    description: 'Description non disponible.'
                };
            }
            
            document.getElementById('universeName').textContent = universeData.name;
            document.getElementById('universeCreator').textContent = "Créé par " + universeData.creator;
            document.getElementById('universeImage').src = universeData.image;
            document.getElementById('universeFavorites').textContent = universeData.favorites;
            document.getElementById('universeDate').textContent = universeData.date;
            document.getElementById('universeStatus').textContent = universeData.status;
            document.getElementById('universeDescription').textContent = universeData.description;
            
            const themesContainer = document.getElementById('universeThemes');
            themesContainer.innerHTML = '';
            if (universeData.themes && universeData.themes.length > 0) {
                universeData.themes.forEach(theme => {
                    const themeElement = document.createElement('span');
                    themeElement.className = 'tag';
                    themeElement.textContent = theme;
                    themesContainer.appendChild(themeElement);
                });
            } else {
                const themeElement = document.createElement('span');
                themeElement.className = 'tag';
                themeElement.textContent = 'Non catégorisé';
                themesContainer.appendChild(themeElement);
            }
            
            openModal('universeModal');
        }

        // Form submission feedback
        document.querySelectorAll('.profile-form, .password-form').forEach(form => {
            if (form) {
                form.addEventListener('submit', function(e) {
                    const submitBtn = this.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        const originalText = submitBtn.textContent;
                        submitBtn.textContent = 'Enregistrement...';
                        submitBtn.disabled = true;
                        
                        setTimeout(() => {
                            submitBtn.textContent = originalText;
                            submitBtn.disabled = false;
                        }, 1500);
                    }
                });
            }
        });

        // Fonction pour supprimer un favori
        async function removeFavorite(type, id, button) {
            if (!confirm('Voulez-vous vraiment retirer cet élément de vos favoris ?')) {
                return;
            }
            
            try {
                const url = `/favoris/${type}/${id}/toggle`;
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                const data = await response.json();
                
                if (data.success) {
                    // Remove the card from the DOM
                    const card = button.closest('.card');
                    card.style.transition = 'opacity 0.3s, transform 0.3s';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.8)';
                    
                    setTimeout(() => {
                        card.remove();
                        // Check if no more favorites
                        const grid = card.parentElement;
                        if (grid.querySelectorAll('.card').length === 0) {
                            grid.innerHTML = `
                                <div class="card">
                                    <div class="card-image" style="display: flex; align-items: center; justify-content: center; font-size: 3rem;">
                                        ❤️
                                    </div>
                                    <div class="card-body">
                                        <h3 class="card-title">Aucun favori</h3>
                                        <p class="card-text">Vous n'avez pas encore ajouté de ${type === 'oeuvre' ? 'œuvres' : 'artefacts'} aux favoris</p>
                                        <a href="${type === 'oeuvre' ? '/oeuvre' : '/artefact'}" class="btn btn-primary btn-sm magic-btn" style="width: 100%; margin-top: 1rem;">Découvrir des ${type === 'oeuvre' ? 'œuvres' : 'artefacts'}</a>
                                    </div>
                                </div>
                            `;
                        }
                    }, 300);
                    
                    // Update the heart button on the item page if user navigates there
                    const heartBtn = document.querySelector(`.favorite-btn[data-${type}-id="${id}"]`);
                    if (heartBtn) {
                        heartBtn.classList.remove('favorited');
                        heartBtn.innerHTML = '🤍';
                    }
                } else {
                    alert('Erreur lors de la suppression des favoris');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Une erreur est survenue');
            }
        }
    </script>
</body>
</html>
