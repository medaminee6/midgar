                            <span class="info-label">Pouvoirs</span>
                            <div class="info-value" id="artefactPowers">Magie élémentaire</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Date de création</span>
                            <div class="info-value" id="artefactDate">01/01/2024</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Origine</span>
                            <div class="info-value" id="artefactOrigin">Ancienne civilisation</div>
                        </div>
