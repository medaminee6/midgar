        <!-- MODALE GÉNÉRATION AVATAR IA -->
        <div id="generateAvatarModal" class="modal">
            <div class="modal-content" style="max-width: 600px;">
                <span class="close" onclick="closeModal('generateAvatarModal')">&times;</span>
                <h2><i class="fas fa-magic me-2"></i> Générer un avatar IA</h2>
                
                <form id="avatarGenerateForm" method="POST" action="{{ path('generate_image') }}" enctype="multipart/form-data">
                    <div class="form-group">
                        <label class="form-label">Photo de base</label>
                        <input type="file" name="image" accept="image/*" required class="form-control" style="padding: 0.5rem; background: rgba(0,0,0,0.3);">
                        <small style="color: var(--text-secondary); display: block; margin-top: 0.25rem;">
                            <i class="fas fa-info-circle"></i> Choisissez une photo pour la transformer en avatar stylisé
                        </small>
                    </div>
                    
                    <div class="form-group">
                        <label class="form-label">Thème</label>
                        <select name="theme" class="form-control" style="background: rgba(0,0,0,0.3);">
                            <option value="fantasy">Fantasy</option>
                            <option value="anime">Anime</option>
                            <option value="cyberpunk">Cyberpunk</option>
                            <option value="steampunk">Steampunk</option>
                            <option value="dark_fantasy">Dark Fantasy</option>
                        </select>
                    </div>
                    
                    <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 1.5rem;">
                        <button type="button" class="btn btn-secondary magic-btn" onclick="closeModal('generateAvatarModal')">
                            <i class="fas fa-times me-2"></i> Annuler
                        </button>
                        <button type="submit" class="btn btn-success magic-btn" id="generateAvatarBtn">
                            <i class="fas fa-magic me-2"></i> Générer
                        </button>
                    </div>
                </form>

                <!-- Zone d'affichage du résultat (cachée par défaut) -->
