        // ===== FONCTIONS POUR LA GÉNÉRATION D'AVATAR =====
        function resetGenerationForm() {
            document.getElementById('avatarGenerateForm').reset();
            document.getElementById('avatarGenerateForm').style.display = 'block';
            document.getElementById('generationResult').style.display = 'none';
            document.getElementById('generateAvatarBtn').disabled = false;
            document.getElementById('generateAvatarBtn').innerHTML = '<i class="fas fa-magic me-2"></i> Générer';
        }

        function useGeneratedAvatar() {
            const avatarUrl = document.getElementById('generatedAvatar').src;
            
            // Extraire le nom du fichier
            const filename = avatarUrl.split('/').pop();
            
            // Envoyer une requête pour mettre à jour l'avatar de l'utilisateur
            fetch('{{ path('update_avatar') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ avatar: filename })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Mettre à jour l'avatar dans la page
                    const avatarImages = document.querySelectorAll('.avatar img, .profile-avatar img');
                    avatarImages.forEach(img => {
                        img.src = avatarUrl + '?t=' + new Date().getTime();
                    });
                    
                    // Fermer la modale
                    closeModal('generateAvatarModal');
                    
                    // Afficher un message de succès
                    alert('Avatar mis à jour avec succès !');
                } else {
                    alert('Erreur lors de la mise à jour de l\'avatar : ' + (data.error || 'Erreur inconnue'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Une erreur est survenue');
            });
        }

        // Gestionnaire de soumission du formulaire
        if (document.getElementById('avatarGenerateForm')) {
            document.getElementById('avatarGenerateForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const formData = new FormData(this);
                const submitBtn = document.getElementById('generateAvatarBtn');
                
                // Désactiver le bouton
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i> Génération...';
                
                try {
                    const response = await fetch(this.action, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });
                    
                    const data = await response.json();
                    
                    if (data.success) {
                        // Cacher le formulaire
                        this.style.display = 'none';
                        
                        // Afficher le résultat
                        document.getElementById('generatedAvatar').src = data.image;
                        document.getElementById('generationResult').style.display = 'block';
                    } else {
                        alert('Erreur lors de la génération : ' + (data.error || 'Erreur inconnue'));
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fas fa-magic me-2"></i> Générer';
                    }
                } catch (error) {
                    console.error('Error:', error);
                    alert('Une erreur est survenue lors de la génération');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-magic me-2"></i> Générer';
                }
            });
        }

