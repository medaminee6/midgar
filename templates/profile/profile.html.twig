<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if isOwner %}Mon Profil{% else %}Profil de {{ user.username }}{% endif %} - Midgar</title>
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color), 
                        0 0 30px var(--primary-color), 
                        0 0 50px var(--primary-dark);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color), 
                        0 0 30px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        .btn-warning {
            background-color: #ffc107;
            color: #000;
        }
        
        .btn-danger {
            background-color: #dc3545;
            color: white;
        }
        
        .btn-success {
            background-color: #28a745;
            color: white;
        }
        
        /* ===== BOUTONS MAGIQUES ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== MAIN CONTENT ===== */
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .site-content {
            position: relative;
            z-index: 1;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 2rem;
            font-size: clamp(1.5rem, 4vw, 2rem);
            position: relative;
            color: var(--primary-color);
        }
        
        .section-title::after {
            content: '';
            position: absolute;
            bottom: -10px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
        }
        
        /* ===== CARDS ===== */
        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
            transition: all 0.3s ease;
            height: 100%;
            position: relative;
            border: 1px solid transparent;
        }
        
        .card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6),
                        0 0 20px rgba(24, 227, 164, 0.3);
            border-color: rgba(24, 227, 164, 0.2);
        }
        
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(24, 227, 164, 0.1), transparent);
            transition: left 0.5s;
        }
        
        .card:hover::before {
            left: 100%;
        }
        
        .card-image {
            width: 100%;
            aspect-ratio: 4 / 3;
            overflow: hidden;
            position: relative;
        }
        
        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .card:hover .card-image img {
            transform: scale(1.1);
        }
        
        .card-body {
            padding: 1rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 2;
        }
        
        .card-body h3 {
            margin-bottom: 0.5rem;
            font-size: 1.1rem;
            color: var(--primary-color);
        }
        
        .card-body p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
            flex-grow: 1;
        }
        
        .card-tags {
            margin: 0.5rem 0;
            display: flex;
            flex-wrap: wrap;
            gap: 0.3rem;
            justify-content: center;
        }
        
        .tag {
            background-color: var(--primary-color);
            color: #000;
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            transition: transform 0.2s;
        }
        
        .tag:hover {
            transform: scale(1.1);
        }
        
        /* ===== PROFILE SPECIFIC ===== */
        .profile-layout {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 2rem;
            margin-bottom: 3rem;
        }
        
        .profile-avatar {
            width: 120px;
            height: 120px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            overflow: hidden;
            border: 3px solid var(--primary-color);
        }
        
        .profile-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .profile-avatar-placeholder {
            width: 120px;
            height: 120px;
            margin: 0 auto 1rem;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 2.5rem;
            border: 3px solid var(--primary-color);
        }
        
        .content-grid {
            display: grid;
            gap: 3rem;
        }
        
        .content-section {
            background: var(--card-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .content-section h2 {
            color: var(--primary-color);
            margin-bottom: 1.5rem;
            font-size: 1.5rem;
        }
        
        .items-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 1.5rem;
        }
        
        .bio-container {
            background: rgba(24, 227, 164, 0.05);
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.2);
            padding: 1rem;
            margin-top: 1rem;
        }
        
        .badge {
            display: inline-block;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        
        .badge.bg-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
        }
        
        .badge.bg-secondary {
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-secondary);
        }
        
        /* ===== MODAL STYLES ===== */
        .modal {
            display: none; 
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%; 
            height: 100%; 
            overflow: auto; 
            background-color: rgba(0,0,0,0.8);
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .modal-content {
            background-color: #0B0F0E;
            margin: 10% auto; 
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 500px;
            color: #fff;
            border: 1px solid var(--primary-color);
            box-shadow: 0 0 30px rgba(24, 227, 164, 0.3);
            position: relative;
            animation: slideIn 0.4s ease;
        }
        
        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .close {
            color: var(--primary-color);
            float: right;
            font-size: 1.8rem;
            font-weight: bold;
            cursor: pointer;
            position: absolute;
            top: 1rem;
            right: 1.5rem;
            transition: all 0.3s ease;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        
        .close:hover {
            color: #000;
            background-color: var(--primary-color);
            transform: rotate(90deg);
        }
        
        .modal h2 {
            color: var(--primary-color);
            margin-bottom: 1.5rem;
            padding-right: 2rem;
        }
        
        /* ===== FORM STYLES ===== */
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-secondary);
        }
        
        .form-control {
            width: 100%;
            padding: 0.75rem;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            transition: all 0.3s;
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        /* ===== EMPTY STATE ===== */
        .empty-state {
            text-align: center;
            padding: 2rem;
            background: rgba(24, 227, 164, 0.05);
            border-radius: var(--border-radius);
            border: 1px dashed rgba(24, 227, 164, 0.3);
        }
        
        .empty-icon {
            font-size: 3rem;
            display: block;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .profile-layout {
                grid-template-columns: 1fr;
            }
            
            .items-grid {
                grid-template-columns: 1fr;
            }
            
            .modal-content {
                margin: 20% auto;
                padding: 1.5rem;
            }
        }
        
        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-primary);
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(24, 227, 164, 0.3);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--primary-color);
        }
    </style>
</head>
<body>
    <!-- VIDEO BACKGROUND -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- SITE CONTENT -->
    <div class="site-content">
        <!-- HEADER -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="/universes" class="magic-btn">Univers</a></li>
                    <li><a href="/personnages" class="magic-btn">Personnages</a></li>
                    <li><a href="/oeuvre" class="magic-btn">Œuvre</a></li>
                    <li><a href="/artefact" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="/challenges" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <button class="magic-btn" onclick="openModal('searchUserModal')" title="Rechercher un utilisateur">
                        <i class="fas fa-search"></i>
                    </button>

                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_users') }}" class="btn btn-warning btn-sm magic-btn">Admin</a>
                    {% endif %}
                    
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <main>
            <section class="section">
                <div class="container">
                    <h1 class="section-title">
                        {% if isOwner %}
                            Mon Profil
                        {% else %}
                            Profil de {{ user.username }}
                        {% endif %}
                    </h1>
                    
                    <div class="profile-layout">
                        <!-- SIDEBAR - INFOS UTILISATEUR -->
                        <div>
                            <div class="card">
                                <div class="card-body">
                                    <!-- Avatar -->
                                    {% if user.avatar %}
                                        <div class="profile-avatar">
                                            <img src="{{ asset('uploads/avatars/' ~ user.avatar) }}" alt="Avatar de {{ user.username }}">
                                        </div>
                                    {% else %}
                                        <div class="profile-avatar-placeholder">
                                            {{ user.prenom|first|upper }}{{ user.nom|first|upper }}
                                        </div>
                                    {% endif %}
                                    
                                    <!-- Infos de base -->
                                    <h2 class="text-primary mb-1">{{ user.username }}</h2>
                                    <p class="text-secondary mb-2">{{ user.prenom }} {{ user.nom }}</p>
                                    <p class="text-secondary small mb-3">
                                        <i class="fas fa-envelope"></i> {{ user.email }}
                                    </p>
                                    
                                    {% if user.phoneNumber %}
                                        <p class="text-secondary small mb-3">
                                            <i class="fas fa-phone"></i> {{ user.phoneNumber }}
                                        </p>
                                    {% endif %}
                                    
                                    <div class="d-flex justify-content-center gap-2 mb-3">
                                        <span class="badge bg-primary">
                                            {% if isOwner %}Mon compte{% else %}Membre{% endif %}
                                        </span>
                                        <span class="badge bg-secondary">
                                            <i class="fas fa-calendar-alt"></i>
                                            {{ user.createdAt|date('d/m/Y') }}
                                        </span>
                                    </div>
                                    
                                    <!-- Bio -->
                                    {% if user.bio %}
                                        <div class="bio-container">
                                            <h4 class="text-primary mb-2">À propos</h4>
                                            <p class="text-secondary mb-0">{{ user.bio|nl2br }}</p>
                                        </div>
                                    {% endif %}
                                    
                                    <!-- Boutons d'action (uniquement si c'est le propriétaire) -->
                                    {% if isOwner %}
                                        <div class="mt-4">
                                            <button class="btn btn-primary w-100 mb-2" onclick="openModal('editProfileModal')">
                                                <i class="fas fa-edit me-2"></i> Éditer le profil
                                            </button>
                                            <button class="btn btn-secondary w-100" onclick="openModal('settingsModal')">
                                                <i class="fas fa-cog me-2"></i> Paramètres
                                            </button>
                                        </div>
                                    {% else %}
                                        <div class="mt-4">
                                            <a href="{{ path('profile') }}" class="btn btn-secondary w-100">
                                                <i class="fas fa-arrow-left me-2"></i> Retour à mon profil
                                            </a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <!-- MAIN CONTENT - CRÉATIONS -->
                        <div class="content-grid">
                                            <!-- ARTEFACTS -->
                            <div class="content-section">
                                <h2><i class="fas fa-gem me-2"></i> Artefacts</h2>
                                <div class="items-grid">
                                    {% if artefacts|length > 0 %}
                                        {% for artefact in artefacts %}
                                            <div class="card">
                                                <div class="card-image">
                                                    {% if artefact.imageUrl %}
                                                        <img src="{{ asset(artefact.imageUrl) }}" alt="{{ artefact.name }}">
                                                    {% else %}
                                                        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size: 2rem;">
                                                            ⚔️
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                <div class="card-body">
                                                    <h3>{{ artefact.name }}</h3>
                                                    <p>{{ artefact.origins|slice(0, 80) ~ '...' }}</p>
                                                    <small class="text-secondary">{{ artefact.createdAt|date('d/m/Y') }}</small>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="empty-state">
                                            <span class="empty-icon">⚔️</span>
                                            <p>Aucun artefact créé</p>
                                            {% if isOwner %}
                                                <a href="/artefact/create" class="btn btn-primary btn-sm mt-3">Créer un artefact</a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>

                            <!-- ŒUVRES -->
                            <div class="content-section">
                                <h2><i class="fas fa-pen-fancy me-2"></i> Œuvres</h2>
                                <div class="items-grid">
                                    {% if oeuvres|length > 0 %}
                                        {% for oeuvre in oeuvres %}
                                            <div class="card">
                                                <div class="card-image">
                                                    {% if oeuvre.imageUrl %}
                                                        <img src="{{ asset(oeuvre.imageUrl) }}" alt="{{ oeuvre.title }}">
                                                    {% else %}
                                                        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size: 2rem;">
                                                            📚
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                <div class="card-body">
                                                    <h3>{{ oeuvre.title }}</h3>
                                                    <p>{{ oeuvre.description|slice(0, 80) ~ '...' }}</p>
                                                    <small class="text-secondary">{{ oeuvre.createdAt|date('d/m/Y') }}</small>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    {% else %}
                                        <div class="empty-state">
                                            <span class="empty-icon">📚</span>
                                            <p>Aucune œuvre créée</p>
                                            {% if isOwner %}
                                                <a href="/oeuvre/create" class="btn btn-primary btn-sm mt-3">Créer une œuvre</a>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- MODAL ÉDITER PROFIL (uniquement pour le propriétaire) -->
        {% if isOwner and profileForm %}
        <div id="editProfileModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal('editProfileModal')">&times;</span>
                <h2>Éditer votre profil</h2>
                {{ form_start(profileForm, {'attr': {'class': 'profile-form'}}) }}
                    <div class="form-group">
                        <label class="form-label">Nom d'utilisateur</label>
                        {{ form_widget(profileForm.username, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email</label>
                        {{ form_widget(profileForm.email, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <div class="form-group">
                        <label class="form-label">Avatar</label>
                        {{ form_widget(profileForm.avatar, {'attr': {'class': 'form-control'}}) }}
                    </div>
                    <button class="btn btn-primary" type="submit" style="width: 100%;">Enregistrer</button>
                {{ form_end(profileForm) }}
            </div>
        </div>
        {% endif %}

        <!-- MODAL PARAMÈTRES (uniquement pour le propriétaire) -->
        {% if isOwner and passwordForm %}
        <div id="settingsModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal('settingsModal')">&times;</span>
                <h2>Paramètres</h2>

                <button class="btn btn-primary w-100 mb-3" onclick="document.getElementById('passwordForm').style.display='block'">
                    Changer le mot de passe
                </button>

                <div id="passwordForm" style="display:none; margin-bottom: 2rem; padding: 1.5rem; background: rgba(0,0,0,0.2); border-radius: 8px;">
                    <h3 class="text-primary mb-3">Changement de mot de passe</h3>
                    {{ form_start(passwordForm, {'attr': {'class': 'password-form'}}) }}
                        <div class="form-group">
                            <label class="form-label">Mot de passe actuel</label>
                            {{ form_widget(passwordForm.oldPassword, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group">
                            <label class="form-label">Nouveau mot de passe</label>
                            {{ form_widget(passwordForm.newPassword, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <div class="form-group">
                            <label class="form-label">Confirmer</label>
                            {{ form_widget(passwordForm.confirmPassword, {'attr': {'class': 'form-control'}}) }}
                        </div>
                        <button class="btn btn-success w-100" type="submit">Modifier</button>
                    {{ form_end(passwordForm) }}
                </div>

                <button class="btn btn-danger w-100" onclick="document.getElementById('deleteForm').style.display='block'">
                    Supprimer mon compte
                </button>

                <div id="deleteForm" style="display:none; margin-top: 1.5rem; padding: 1.5rem; background: rgba(220,53,69,0.1); border-radius: 8px;">
                    <h3 class="text-danger mb-2">Suppression du compte</h3>
                    <p class="text-secondary small mb-3">Cette action est irréversible.</p>
                    <form action="{{ path('profile_delete') }}" method="POST" onsubmit="return confirm('Confirmer la suppression ?');">
                        <div class="form-group">
                            <input type="password" name="password" placeholder="Votre mot de passe" required class="form-control">
                        </div>
                        <button class="btn btn-danger w-100" type="submit">Supprimer définitivement</button>
                    </form>
                </div>
            </div>
        </div>
        {% endif %}

        <!-- MODALE RECHERCHE UTILISATEURS (pour tout le monde) -->
        <div id="searchUserModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal('searchUserModal')">&times;</span>
                <h2><i class="fas fa-search me-2"></i> Rechercher un membre</h2>
                
                <div class="form-group">
                    <input type="text" 
                           id="userSearchInput" 
                           class="form-control" 
                           placeholder="Nom d'utilisateur, prénom ou nom..."
                           autocomplete="off">
                </div>
                
                <div id="userSearchResults" class="search-results" style="max-height: 300px; overflow-y: auto;">
                    <!-- Les résultats apparaîtront ici -->
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <footer>
            <div class="container">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </footer>
    </div>

    <script>
        // ===== FONCTIONS MODALES =====
        function openModal(id) {
            document.getElementById(id).style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Fermer avec Echap
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal('editProfileModal');
                closeModal('settingsModal');
                closeModal('searchUserModal');
            }
        });

        // Fermer en cliquant dehors
        window.onclick = function(event) {
            const modals = ['editProfileModal', 'settingsModal', 'searchUserModal'];
            modals.forEach(id => {
                const modal = document.getElementById(id);
                if (event.target == modal) {
                    closeModal(id);
                }
            });
        }

        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== RECHERCHE UTILISATEURS =====
        const searchInput = document.getElementById('userSearchInput');
        const resultsContainer = document.getElementById('userSearchResults');
        let searchTimeout;
        let controller;

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                const query = this.value.trim();
                
                if (controller) controller.abort();
                
                if (query.length < 2) {
                    resultsContainer.innerHTML = '';
                    return;
                }
                
                resultsContainer.innerHTML = '<div style="text-align:center; padding:1rem;"><div class="loading-spinner"></div><p>Recherche...</p></div>';
                
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    searchUsers(query);
                }, 500);
            });
        }

        async function searchUsers(query) {
            controller = new AbortController();
            
            try {
                const response = await fetch(`/api/search/users?q=${encodeURIComponent(query)}`, {
                    signal: controller.signal
                });
                
                const users = await response.json();
                displayResults(users);
                
            } catch (error) {
                if (error.name === 'AbortError') return;
                resultsContainer.innerHTML = '<p class="text-danger">Erreur</p>';
            }
        }

        function displayResults(users) {
            if (users.length === 0) {
                resultsContainer.innerHTML = '<p class="text-secondary text-center">Aucun utilisateur trouvé</p>';
                return;
            }

            let html = '';
            users.forEach(user => {
                const avatarUrl = user.avatar ? `/uploads/avatars/${user.avatar}` : '/images/default-avatar.png';
                html += `
                    <div class="search-result-item" onclick="window.location.href='/profile/${user.id}'">
                        <img src="${avatarUrl}" class="search-result-avatar">
                        <div>
                            <strong>@${user.username}</strong>
                            <p>${user.prenom} ${user.nom}</p>
                        </div>
                    </div>
                `;
            });
            
            resultsContainer.innerHTML = html;
        }

        // ===== BACKGROUND VIDEO =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(() => {
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
        });
    </script>

    <style>
        /* Styles supplémentaires pour la recherche */
        .search-result-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
            background: rgba(24, 227, 164, 0.05);
            border-radius: var(--border-radius);
            border: 1px solid transparent;
            cursor: pointer;
            transition: all 0.3s;
        }
        
        .search-result-item:hover {
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .search-result-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--primary-color);
        }
        
        .loading-spinner {
            width: 30px;
            height: 30px;
            border: 3px solid transparent;
            border-top-color: var(--primary-color);
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        .text-danger { color: #dc3545; }
        .text-center { text-align: center; }
        .mb-3 { margin-bottom: 1rem; }
        .mt-3 { margin-top: 1rem; }
        .w-100 { width: 100%; }
    </style>
</body>
</html>