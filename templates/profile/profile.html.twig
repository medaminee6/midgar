        <!-- MODALE POUR UNIVERS -->
        <div id="universeModal" class="modal">
            <div class="modal-content modal-detail">
                <span class="close" onclick="closeModal('universeModal')">&times;</span>
                <div class="modal-header">
                    <h2 id="universeName">Nom de l'Univers</h2>
                    <div class="modal-subtitle" id="universeCreator">Créé par Utilisateur</div>
                </div>
                <div class="modal-body">
                    <div class="modal-image">
                        <img id="universeImage" src="" alt="Image de l'univers">
                    </div>
                    <div class="modal-info">
