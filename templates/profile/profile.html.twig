<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Profil - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        /* MODAL STYLES */
        .modal {
            display: none; 
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%; 
            height: 100%; 
            overflow: auto; 
            background-color: rgba(0,0,0,0.5);
        }

        .modal-content {
            background-color: #0B0F0E;
            margin: 10% auto; 
            padding: 2rem;
            border-radius: 10px;
            width: 90%;
            max-width: 500px;
            color: #fff;
        }

        .close {
            color: #18E3A4;
            float: right;
            font-size: 1.5rem;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body>
