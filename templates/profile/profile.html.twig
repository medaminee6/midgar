                        <img id="oeuvreImage" src="" alt="Image de l'œuvre">
                    </div>
                    <div class="modal-info">
                        <div class="info-group">
                            <span class="info-label">Type</span>
                            <div class="info-value" id="oeuvreType">Roman</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Date de création</span>
                            <div class="info-value" id="oeuvreDate">01/01/2024</div>
                        </div>
                        <div class="info-group">
                            <span class="info-label">Statut</span>
                            <div class="info-value" id="oeuvreStatus">Publié</div>
                        </div>
