<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
            --danger: #EF5350;
            --success: #18E3A4;
            --warning: #FFA726;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
            font-size: 1rem;
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            box-shadow: 0 4px 15px rgba(24, 227, 164, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }
        
        .btn-secondary {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(24, 227, 164, 0.4);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
            filter: drop-shadow(0 0 5px rgba(24, 227, 164, 0.3));
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        nav ul li a {
            display: inline-block;
            padding: 0.5rem 1rem;
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }
        
        nav ul li a:hover {
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        nav ul li a.magic-btn {
            color: var(--text-secondary);
        }
        
        nav ul li a.magic-btn:hover {
            color: var(--primary-color);
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        
        main {
            padding-top: 80px;
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* ===== REGISTER CARD ===== */
        .register-container {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 2rem;
        }
        
        .card {
            background: linear-gradient(135deg, rgba(26, 31, 30, 0.8), rgba(20, 26, 25, 0.9));
            backdrop-filter: blur(10px);
            border-radius: 20px;
            border: 1px solid rgba(24, 227, 164, 0.2);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(24, 227, 164, 0.1);
            width: 100%;
            max-width: 500px;
            margin: 2rem;
            transition: all 0.3s ease;
            animation: cardAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card:hover {
            border-color: rgba(24, 227, 164, 0.4);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(24, 227, 164, 0.2);
            transform: translateY(-5px);
        }
        
        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .card-body {
            padding: 2.5rem;
        }
        
        .card-title {
            color: var(--primary-color);
            text-align: center;
            margin-bottom: 2rem;
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }
        
        .card-title::before {
            content: "📝";
            font-size: 1.8rem;
            filter: drop-shadow(0 0 8px rgba(24, 227, 164, 0.5));
        }
        
        /* ===== FORM ELEMENTS ===== */
        .form-group {
            margin-bottom: 1.5rem;
            position: relative;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--text-color);
            font-weight: 600;
            font-size: 0.95rem;
        }
        
        .form-control {
            width: 100%;
            padding: 0.85rem 1.25rem;
            background: rgba(11, 15, 14, 0.8);
            border: 1px solid rgba(42, 49, 57, 0.8);
            border-radius: 12px;
            color: var(--text-color);
            font-size: 0.95rem;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(24, 227, 164, 0.2);
            background: rgba(11, 15, 14, 0.95);
        }
        
        .form-control::placeholder {
            color: var(--text-secondary);
            opacity: 0.7;
        }
        
        /* ===== VALIDATION STYLES ===== */
        .form-control.valid {
            border-color: var(--success);
            box-shadow: 0 0 0 3px rgba(24, 227, 164, 0.1);
        }
        
        .form-control.invalid {
            border-color: var(--danger);
            box-shadow: 0 0 0 3px rgba(239, 83, 80, 0.1);
        }
        
        .validation-message {
            font-size: 0.85rem;
            margin-top: 0.5rem;
            padding-left: 0.5rem;
            animation: slideDown 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .validation-message i {
            font-size: 0.9rem;
        }
        
        .validation-message.error {
            color: var(--danger);
        }
        
        .validation-message.success {
            color: var(--success);
        }
        
        .validation-message.info {
            color: var(--text-secondary);
        }
        
        .validation-message.warning {
            color: var(--warning);
        }
        
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* ===== SUGGESTIONS ===== */
        .suggestions-container {
            margin-top: 1rem;
            padding: 1rem;
            background: rgba(24, 227, 164, 0.05);
            border-radius: 8px;
            border: 1px solid rgba(24, 227, 164, 0.2);
            animation: fadeIn 0.3s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .suggestions-container p {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 0.75rem;
        }
        
        .suggestions-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .suggestion-item {
            padding: 0.5rem 1rem;
            background: rgba(24, 227, 164, 0.1);
            border: 1px solid var(--primary-color);
            border-radius: 20px;
            color: var(--primary-color);
            font-size: 0.85rem;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        
        .suggestion-item:hover {
            background: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(24, 227, 164, 0.3);
        }
        
        /* ===== PASSWORD STRENGTH ===== */
        .password-strength {
            margin-top: 0.5rem;
        }
        
        .strength-bar {
            height: 4px;
            background: rgba(42, 49, 57, 0.5);
            border-radius: 2px;
            overflow: hidden;
        }
        
        .strength-progress {
            height: 100%;
            width: 0;
            transition: width 0.3s ease, background 0.3s ease;
        }
        
        .strength-progress.weak {
            background: var(--danger);
        }
        
        .strength-progress.medium {
            background: var(--warning);
        }
        
        .strength-progress.strong {
            background: var(--success);
        }
        
        .strength-text {
            font-size: 0.8rem;
            margin-top: 0.25rem;
            color: var(--text-secondary);
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }
        
        /* ===== ALERT ===== */
        .alert {
            padding: 1rem 1.25rem;
            border-radius: 12px;
            margin-bottom: 1.5rem;
            border-left: 4px solid;
            animation: slideIn 0.5s ease;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(239, 83, 80, 0.1);
            border-left-color: var(--danger);
            color: var(--danger);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(239, 83, 80, 0.2);
        }
        
        .alert i {
            font-size: 1.2rem;
        }
        
        .alert-danger {
            color: var(--danger);
        }
        
        @keyframes slideIn {
            from { opacity: 0; transform: translateY(-10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* ===== CHECKBOX ===== */
        .checkbox-group {
            margin-bottom: 1.5rem;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
        }
        
        input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--primary-color);
            border-radius: 4px;
            cursor: pointer;
        }
        
        .terms-link {
            color: var(--primary-color);
            text-decoration: none;
            transition: all 0.3s ease;
            position: relative;
        }
        
        .terms-link::after {
            content: "";
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 0;
            height: 1px;
            background: var(--primary-color);
            transition: width 0.3s ease;
        }
        
        .terms-link:hover::after {
            width: 100%;
        }
        
        .terms-link:hover {
            color: var(--primary-color);
            text-shadow: 0 0 8px rgba(24, 227, 164, 0.5);
        }
        
        /* ===== DIVIDER ===== */
        .divider {
            border: none;
            border-top: 1px solid rgba(42, 49, 57, 0.5);
            margin: 2rem 0;
            position: relative;
        }
        
        .divider::before {
            content: "ou";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: var(--bg-primary);
            padding: 0 1rem;
            color: var(--text-secondary);
            font-size: 0.85rem;
        }
        
        /* ===== FILE INPUT ===== */
        input[type="file"] {
            padding: 0.5rem;
            border: 1px dashed var(--primary-color);
            background: rgba(11, 15, 14, 0.6);
            cursor: pointer;
        }
        
        input[type="file"]::file-selector-button {
            background: var(--primary-color);
            border: none;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            color: #000;
            font-weight: 600;
            margin-right: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        input[type="file"]::file-selector-button:hover {
            background: var(--primary-dark);
            transform: scale(1.05);
        }
        
        small {
            display: block;
            margin-top: 0.25rem;
            color: var(--text-secondary);
            font-size: 0.8rem;
        }
        
        /* ===== LOADING SPINNER ===== */
        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid rgba(24, 227, 164, 0.3);
            border-radius: 50%;
            border-top-color: var(--primary-color);
            animation: spin 0.6s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 2rem 0;
            margin-top: auto;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
            width: 100%;
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 0.75rem;
            }
            
            nav ul {
                justify-content: center;
                width: 100%;
            }
            
            .auth-buttons {
                margin-top: 0.5rem;
            }
            
            main {
                padding-top: 140px;
            }
            
            .card-body {
                padding: 2rem 1.5rem;
            }
            
            .card-title {
                font-size: 1.8rem;
            }
            
            .card-title::before {
                font-size: 1.6rem;
            }
            
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
        
        @media (max-width: 480px) {
            .card-body {
                padding: 1.5rem 1rem;
            }
        }
        
        /* ===== SCROLLBAR ===== */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: var(--bg-primary);
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(42, 49, 57, 0.8);
            border-radius: 10px;
            transition: background 0.3s ease;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(24, 227, 164, 0.3);
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('shop_index') }}" class="magic-btn">Boutique</a></li>
                    <li><a href="{{ path('challenges_index') }}" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn active">S'inscrire</a>
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <div class="register-container">
                <div class="card">
                    <div class="card-body">
                        <h2 class="card-title">Rejoindre Midgar</h2>

                        {% if registrationForm.vars.errors|length > 0 %}
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-circle"></i>
                                <div>
                                    {% for error in registrationForm.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        {{ form_start(registrationForm, {'attr': {'enctype':'multipart/form-data', 'id': 'registration-form', 'novalidate': 'novalidate'}}) }}

                        <div class="form-row">
                            <div class="form-group">
                                {{ form_label(registrationForm.prenom, "Prénom") }}
                                {{ form_widget(registrationForm.prenom, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Léa',
                                        'data-validate': 'prenom'
                                    }
                                }) }}
                                <div class="validation-message prenom-message" style="display: none;"></div>
                            </div>
                            <div class="form-group">
                                {{ form_label(registrationForm.nom, "Nom") }}
                                {{ form_widget(registrationForm.nom, {
                                    'attr': {
                                        'class': 'form-control',
                                        'placeholder': 'Mage',
                                        'data-validate': 'nom'
                                    }
                                }) }}
                                <div class="validation-message nom-message" style="display: none;"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(registrationForm.username, "Nom d'utilisateur") }}
                            {{ form_widget(registrationForm.username, {
                                'attr': {
                                    'class': 'form-control username-field',
                                    'placeholder': 'leamage_legends',
                                    'data-validate': 'username',
                                    'autocomplete': 'off'
                                }
                            }) }}
                            <small>3-20 caractères, lettres et chiffres uniquement</small>
                            <div class="validation-message username-message" style="display: none;"></div>
                            <div class="suggestions-container" style="display: none;">
                                <p>Suggestions disponibles :</p>
                                <div class="suggestions-list"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(registrationForm.email, "Email") }}
                            {{ form_widget(registrationForm.email, {
                                'attr': {
                                    'class': 'form-control email-field',
                                    'placeholder': 'votre.email@exemple.com',
                                    'data-validate': 'email'
                                }
                            }) }}
                            <div class="validation-message email-message" style="display: none;"></div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                {{ form_label(registrationForm.plainPassword, "Mot de passe") }}
                                {{ form_widget(registrationForm.plainPassword, {
                                    'attr': {
                                        'class': 'form-control password-field',
                                        'placeholder': '••••••••',
                                        'data-validate': 'password'
                                    }
                                }) }}
                                <div class="password-strength">
                                    <div class="strength-bar">
                                        <div class="strength-progress"></div>
                                    </div>
                                    <div class="strength-text"></div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="password_confirm">Confirmer</label>
                                <input 
                                    type="password" 
                                    id="password_confirm" 
                                    name="password_confirm" 
                                    class="form-control confirm-field"
                                    placeholder="••••••••"
                                    data-validate="confirm"
                                    required>
                                <div class="validation-message confirm-message" style="display: none;"></div>
                            </div>
                        </div>

                        <div class="form-group">
                            {{ form_label(registrationForm.photoProfil, "Photo de profil (optionnel)") }}
                            {{ form_widget(registrationForm.photoProfil, {
                                'attr': {
                                    'class': 'form-control',
                                    'accept': 'image/*'
                                }
                            }) }}
                        </div>

                        <div class="checkbox-group">
                            <label class="checkbox-label">
                                <input type="checkbox" name="terms" id="terms" required>
                                <span>
                                    J'accepte les 
                                    <a href="#" class="terms-link">conditions d'utilisation</a> 
                                    et la 
                                    <a href="#" class="terms-link">politique de confidentialité</a>
                                </span>
                            </label>
                        </div>

                        <button type="submit" id="submit-btn" class="btn btn-primary" style="width: 100%; margin-bottom: 1rem;" disabled>
                            Créer mon Compte
                        </button>

                        {{ form_end(registrationForm) }}

                        <hr class="divider">

                        <p style="text-align: center; color: var(--text-secondary); margin-bottom: 1rem;">
                            Vous avez déjà un compte?
                        </p>
                        <a href="{{ path('app_login') }}" class="btn btn-secondary" style="width: 100%; text-align: center; display: block;">
                            Se Connecter
                        </a>
                        
                        <a href="{{ path('connect_google_start') }}"
                           class="btn btn-secondary"
                           style="width:100%; margin-top:1rem; display:flex; align-items:center; justify-content:center; gap:10px;">
                            <img src="https://developers.google.com/identity/images/g-logo.png" width="18">
                            Continuer avec Google
                        </a>
                    </div>
                </div>
            </div>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>

  <script>
    // ===== VALIDATION COMPLÈTE =====
    class FormValidator {
        constructor() {
            this.form = document.getElementById('registration-form');
            this.submitBtn = document.getElementById('submit-btn');
            
            // Champs
            this.prenomField = document.querySelector('[data-validate="prenom"]');
            this.nomField = document.querySelector('[data-validate="nom"]');
            this.usernameField = document.querySelector('.username-field');
            this.emailField = document.querySelector('.email-field');
            this.passwordField = document.querySelector('.password-field');
            this.confirmField = document.querySelector('.confirm-field');
            this.termsCheckbox = document.getElementById('terms');
            
            // Éléments de message
            this.prenomMessage = document.querySelector('.prenom-message');
            this.nomMessage = document.querySelector('.nom-message');
            this.usernameMessage = document.querySelector('.username-message');
            this.emailMessage = document.querySelector('.email-message');
            this.confirmMessage = document.querySelector('.confirm-message');
            this.suggestionsContainer = document.querySelector('.suggestions-container');
            this.suggestionsList = document.querySelector('.suggestions-list');
            
            // États de validation
            this.validationState = {
                prenom: false,
                nom: false,
                username: false,
                email: false,
                password: false,
                confirm: false,
                terms: false
            };
            
            // Timeouts pour debouncing
            this.usernameTimeout = null;
            this.emailTimeout = null;
            
            // Dernières valeurs vérifiées
            this.lastUsernameCheck = '';
            this.lastEmailCheck = '';
            
            this.init();
        }
        
        init() {
            // Validation prénom
            if (this.prenomField) {
                this.prenomField.addEventListener('input', () => this.validatePrenom());
                this.prenomField.addEventListener('blur', () => this.validatePrenom());
            }
            
            // Validation nom
            if (this.nomField) {
                this.nomField.addEventListener('input', () => this.validateNom());
                this.nomField.addEventListener('blur', () => this.validateNom());
            }
            
            // Validation username avec debounce
            if (this.usernameField) {
                this.usernameField.addEventListener('input', () => {
                    clearTimeout(this.usernameTimeout);
                    
                    // Cacher les suggestions pendant la saisie
                    if (this.suggestionsContainer) {
                        this.suggestionsContainer.style.display = 'none';
                    }
                    
                    // Réinitialiser le message sauf si c'est un message de vérification
                    const username = this.usernameField.value.trim();
                    if (username.length >= 3) {
                        this.showMessage(this.usernameMessage, 'Vérification en cours...', 'info');
                    } else {
                        this.usernameMessage.style.display = 'none';
                    }
                    
                    this.usernameTimeout = setTimeout(() => this.validateUsername(), 800);
                });
                
                // Aussi valider au blur pour être sûr
                this.usernameField.addEventListener('blur', () => {
                    if (this.usernameField.value.trim().length >= 3) {
                        clearTimeout(this.usernameTimeout);
                        this.validateUsername();
                    }
                });
            }
            
            // Validation email avec debounce
            if (this.emailField) {
                this.emailField.addEventListener('input', () => {
                    clearTimeout(this.emailTimeout);
                    
                    // Réinitialiser le message
                    const email = this.emailField.value.trim();
                    if (email.length > 0 && email.includes('@')) {
                        this.showMessage(this.emailMessage, 'Vérification en cours...', 'info');
                    } else {
                        this.emailMessage.style.display = 'none';
                    }
                    
                    this.emailTimeout = setTimeout(() => this.validateEmail(), 800);
                });
                
                this.emailField.addEventListener('blur', () => {
                    if (this.emailField.value.trim().length > 0) {
                        clearTimeout(this.emailTimeout);
                        this.validateEmail();
                    }
                });
            }
            
            // Validation mot de passe
            if (this.passwordField) {
                this.passwordField.addEventListener('input', () => {
                    this.validatePassword();
                    if (this.confirmField && this.confirmField.value) {
                        this.validateConfirm();
                    }
                });
            }
            
            // Validation confirmation
            if (this.confirmField) {
                this.confirmField.addEventListener('input', () => this.validateConfirm());
                this.confirmField.addEventListener('blur', () => this.validateConfirm());
            }
            
            // Checkbox termes
            if (this.termsCheckbox) {
                this.termsCheckbox.addEventListener('change', () => this.validateTerms());
            }
            
            // Empêcher la soumission si pas valide
            if (this.form) {
                this.form.addEventListener('submit', (e) => {
                    if (!this.isFormValid()) {
                        e.preventDefault();
                        this.showGlobalError('Veuillez corriger les erreurs avant de soumettre');
                    }
                });
            }
            
            // Validation initiale si des valeurs existent
            this.validatePrenom();
            this.validateNom();
            if (this.usernameField.value) this.validateUsername();
            if (this.emailField.value) this.validateEmail();
            if (this.passwordField.value) this.validatePassword();
            if (this.confirmField.value) this.validateConfirm();
        }
        
        // ===== VALIDATION PRÉNOM =====
        validatePrenom() {
            const prenom = this.prenomField.value.trim();
            
            this.prenomField.classList.remove('valid', 'invalid');
            
            if (!prenom) {
                this.showMessage(this.prenomMessage, 'Le prénom est requis', 'error');
                this.prenomField.classList.add('invalid');
                this.validationState.prenom = false;
            } else if (prenom.length < 2) {
                this.showMessage(this.prenomMessage, 'Minimum 2 caractères', 'error');
                this.prenomField.classList.add('invalid');
                this.validationState.prenom = false;
            } else if (prenom.length > 50) {
                this.showMessage(this.prenomMessage, 'Maximum 50 caractères', 'error');
                this.prenomField.classList.add('invalid');
                this.validationState.prenom = false;
            } else if (!/^[a-zA-ZÀ-ÿ\s-]+$/.test(prenom)) {
                this.showMessage(this.prenomMessage, 'Lettres uniquement', 'error');
                this.prenomField.classList.add('invalid');
                this.validationState.prenom = false;
            } else {
                this.showMessage(this.prenomMessage, '✓ Valide', 'success');
                this.prenomField.classList.add('valid');
                this.validationState.prenom = true;
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION NOM =====
        validateNom() {
            const nom = this.nomField.value.trim();
            
            this.nomField.classList.remove('valid', 'invalid');
            
            if (!nom) {
                this.showMessage(this.nomMessage, 'Le nom est requis', 'error');
                this.nomField.classList.add('invalid');
                this.validationState.nom = false;
            } else if (nom.length < 2) {
                this.showMessage(this.nomMessage, 'Minimum 2 caractères', 'error');
                this.nomField.classList.add('invalid');
                this.validationState.nom = false;
            } else if (nom.length > 50) {
                this.showMessage(this.nomMessage, 'Maximum 50 caractères', 'error');
                this.nomField.classList.add('invalid');
                this.validationState.nom = false;
            } else if (!/^[a-zA-ZÀ-ÿ\s-]+$/.test(nom)) {
                this.showMessage(this.nomMessage, 'Lettres uniquement', 'error');
                this.nomField.classList.add('invalid');
                this.validationState.nom = false;
            } else {
                this.showMessage(this.nomMessage, '✓ Valide', 'success');
                this.nomField.classList.add('valid');
                this.validationState.nom = true;
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION USERNAME =====
        async validateUsername() {
            const username = this.usernameField.value.trim();
            
            // Éviter les vérifications inutiles
            if (this.lastUsernameCheck === username && this.validationState.username) {
                return;
            }
            
            this.usernameField.classList.remove('valid', 'invalid');
            
            // Validation de base
            if (!username) {
                this.showMessage(this.usernameMessage, 'Nom d\'utilisateur requis', 'error');
                this.usernameField.classList.add('invalid');
                if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
                this.validationState.username = false;
                this.lastUsernameCheck = username;
                this.checkFormValidity();
                return;
            }
            
            if (username.length < 3) {
                this.showMessage(this.usernameMessage, 'Minimum 3 caractères', 'error');
                this.usernameField.classList.add('invalid');
                if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
                this.validationState.username = false;
                this.lastUsernameCheck = username;
                this.checkFormValidity();
                return;
            }
            
            if (username.length > 20) {
                this.showMessage(this.usernameMessage, 'Maximum 20 caractères', 'error');
                this.usernameField.classList.add('invalid');
                if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
                this.validationState.username = false;
                this.lastUsernameCheck = username;
                this.checkFormValidity();
                return;
            }
            
            if (!/^[a-zA-Z0-9]+$/.test(username)) {
                this.showMessage(this.usernameMessage, 'Lettres et chiffres uniquement', 'error');
                this.usernameField.classList.add('invalid');
                if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
                this.validationState.username = false;
                this.lastUsernameCheck = username;
                this.checkFormValidity();
                return;
            }
            
            // Vérification serveur
            try {
                const response = await fetch('/api/check-username', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ username: username })
                });
                
                const data = await response.json();
                this.lastUsernameCheck = username;
                
                if (data.available) {
                    this.showMessage(this.usernameMessage, '✓ Disponible', 'success');
                    this.usernameField.classList.add('valid');
                    if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
                    this.validationState.username = true;
                } else {
                    this.showMessage(this.usernameMessage, '✗ ' + data.message, 'error');
                    this.usernameField.classList.add('invalid');
                    this.validationState.username = false;
                    
                    if (data.suggestions && data.suggestions.length > 0 && this.suggestionsContainer && this.suggestionsList) {
                        this.displaySuggestions(data.suggestions);
                    } else if (this.suggestionsContainer) {
                        this.suggestionsContainer.style.display = 'none';
                    }
                }
            } catch (error) {
                console.error('Erreur:', error);
                this.showMessage(this.usernameMessage, 'Erreur de vérification', 'error');
                this.validationState.username = false;
                if (this.suggestionsContainer) this.suggestionsContainer.style.display = 'none';
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION EMAIL =====
        async validateEmail() {
            const email = this.emailField.value.trim();
            
            // Éviter les vérifications inutiles
            if (this.lastEmailCheck === email && this.validationState.email) {
                return;
            }
            
            this.emailField.classList.remove('valid', 'invalid');
            
            if (!email) {
                this.showMessage(this.emailMessage, 'Email requis', 'error');
                this.emailField.classList.add('invalid');
                this.validationState.email = false;
                this.lastEmailCheck = email;
                this.checkFormValidity();
                return;
            }
            
            // Validation format email
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                this.showMessage(this.emailMessage, 'Format invalide', 'error');
                this.emailField.classList.add('invalid');
                this.validationState.email = false;
                this.lastEmailCheck = email;
                this.checkFormValidity();
                return;
            }
            
            // Vérification serveur
            try {
                const response = await fetch('/api/check-email', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ email: email })
                });
                
                const data = await response.json();
                this.lastEmailCheck = email;
                
                if (data.available) {
                    this.showMessage(this.emailMessage, '✓ Email disponible', 'success');
                    this.emailField.classList.add('valid');
                    this.validationState.email = true;
                } else {
                    this.showMessage(this.emailMessage, '✗ ' + data.message, 'error');
                    this.emailField.classList.add('invalid');
                    this.validationState.email = false;
                }
            } catch (error) {
                console.error('Erreur:', error);
                this.showMessage(this.emailMessage, 'Erreur de vérification', 'error');
                this.validationState.email = false;
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION MOT DE PASSE =====
        validatePassword() {
            const password = this.passwordField.value;
            const strengthBar = document.querySelector('.strength-progress');
            const strengthText = document.querySelector('.strength-text');
            
            if (!password) {
                strengthBar.style.width = '0';
                strengthText.textContent = '';
                this.validationState.password = false;
                this.checkFormValidity();
                return;
            }
            
            let strength = 0;
            let missing = [];
            
            // Longueur
            if (password.length >= 8) {
                strength += 25;
            } else {
                missing.push('8 caractères');
            }
            
            // Majuscule
            if (/[A-Z]/.test(password)) {
                strength += 25;
            } else {
                missing.push('majuscule');
            }
            
            // Minuscule
            if (/[a-z]/.test(password)) {
                strength += 25;
            } else {
                missing.push('minuscule');
            }
            
            // Chiffre ou spécial
            if (/[0-9]/.test(password) || /[^A-Za-z0-9]/.test(password)) {
                strength += 25;
            } else {
                missing.push('chiffre ou caractère spécial');
            }
            
            // Mise à jour barre
            strengthBar.style.width = strength + '%';
            
            // Couleur et texte
            if (strength < 50) {
                strengthBar.className = 'strength-progress weak';
                strengthText.textContent = 'Faible';
                this.validationState.password = false;
            } else if (strength < 75) {
                strengthBar.className = 'strength-progress medium';
                strengthText.textContent = 'Moyen';
                this.validationState.password = true;
            } else {
                strengthBar.className = 'strength-progress strong';
                strengthText.textContent = 'Fort ✓';
                this.validationState.password = true;
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION CONFIRMATION =====
        validateConfirm() {
            const password = this.passwordField.value;
            const confirm = this.confirmField.value;
            
            this.confirmField.classList.remove('valid', 'invalid');
            
            if (!confirm) {
                this.showMessage(this.confirmMessage, 'Confirmation requise', 'error');
                this.confirmField.classList.add('invalid');
                this.validationState.confirm = false;
            } else if (password !== confirm) {
                this.showMessage(this.confirmMessage, 'Les mots de passe ne correspondent pas', 'error');
                this.confirmField.classList.add('invalid');
                this.validationState.confirm = false;
            } else {
                this.showMessage(this.confirmMessage, '✓ Mots de passe identiques', 'success');
                this.confirmField.classList.add('valid');
                this.validationState.confirm = true;
            }
            
            this.checkFormValidity();
        }
        
        // ===== VALIDATION TERMES =====
        validateTerms() {
            this.validationState.terms = this.termsCheckbox.checked;
            this.checkFormValidity();
        }
        
        // ===== AFFICHER SUGGESTIONS =====
        displaySuggestions(suggestions) {
            if (!this.suggestionsList || !this.suggestionsContainer) return;
            
            this.suggestionsList.innerHTML = '';
            
            suggestions.forEach(suggestion => {
                const item = document.createElement('span');
                item.className = 'suggestion-item';
                item.textContent = suggestion;
                item.addEventListener('click', () => {
                    this.usernameField.value = suggestion;
                    this.suggestionsContainer.style.display = 'none';
                    // Valider immédiatement le nouveau username
                    setTimeout(() => this.validateUsername(), 100);
                });
                this.suggestionsList.appendChild(item);
            });
            
            this.suggestionsContainer.style.display = 'block';
        }
        
        // ===== AFFICHER MESSAGE =====
        showMessage(element, content, type) {
            if (!element) return;
            
            element.innerHTML = content;
            element.style.display = 'flex';
            
            // Retirer toutes les classes de type
            element.classList.remove('error', 'success', 'info', 'warning');
            element.classList.add(type);
        }
        
        // ===== VÉRIFIER VALIDITÉ FORMULAIRE =====
        isFormValid() {
            // Vérifier que tous les champs obligatoires sont valides
            return this.validationState.prenom && 
                   this.validationState.nom && 
                   this.validationState.username && 
                   this.validationState.email && 
                   this.validationState.password && 
                   this.validationState.confirm && 
                   this.validationState.terms;
        }
        
        // ===== METTRE À JOUR BOUTON SUBMIT =====
        checkFormValidity() {
            if (this.submitBtn) {
                const isValid = this.isFormValid();
                this.submitBtn.disabled = !isValid;
                
                // Debug - à retirer en production
                console.log('État validation:', this.validationState, 'Formulaire valide:', isValid);
            }
        }
        
        // ===== MESSAGE GLOBAL =====
        showGlobalError(message) {
            // Créer une alerte temporaire
            const alert = document.createElement('div');
            alert.className = 'alert alert-danger';
            alert.innerHTML = '<i class="fas fa-exclamation-circle"></i><div>' + message + '</div>';
            
            const cardBody = document.querySelector('.card-body');
            cardBody.insertBefore(alert, cardBody.firstChild);
            
            setTimeout(() => alert.remove(), 5000);
        }
    }

    // ===== INITIALISATION =====
    document.addEventListener('DOMContentLoaded', function() {
        // Initialiser la validation
        const validator = new FormValidator();
        
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        const bgVideo = document.getElementById('bg-video');
        const gradientBg = document.getElementById('gradient-bg');
        
        if (bgVideo) {
            bgVideo.addEventListener('error', function() {
                console.log('Background video failed to load, using gradient fallback');
                if (gradientBg) gradientBg.style.display = 'block';
            });
            
            bgVideo.play().catch(function(error) {
                console.log('Video autoplay prevented:', error);
                if (gradientBg) gradientBg.style.display = 'block';
            });
        }
        
        document.addEventListener('visibilitychange', function() {
            if (bgVideo) {
                if (document.hidden) {
                    bgVideo.pause();
                } else {
                    bgVideo.play().catch(e => console.log('Video play error:', e));
                }
            }
        });
        
        // ACTIVE NAV LINK HIGHLIGHT
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('app_register') }}' && currentPath.includes('/register'))) {
                link.classList.add('active');
            }
        });
    });

    // ===== FORM ANIMATION =====
    document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('focus', function() {
            this.style.boxShadow = '0 0 0 3px rgba(24,227,164,0.2)';
        });
        
        input.addEventListener('blur', function() {
            this.style.boxShadow = '';
        });
    });
</script>
