<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
</head>
<body style="background-color: #0B0F0E; display: flex; align-items: center; justify-content: center; min-height: 100vh; flex-direction: column;">
    <header style="width: 100%; position: static;">
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        <nav>
            <ul>
                <li><a href="/">Accueil</a></li>
                <li><a href="/discover">Découvrir</a></li>
                <li><a href="/universes">Univers</a></li>
                <li><a href="/oeuvre">Œuvre</a></li>
                <li><a href="/shop">Boutique</a></li>
                <li><a href="/challenges">Défis</a></li>
            </ul>
        </nav>
    </header>

    <div style="flex: 1; display: flex; align-items: center; justify-content: center; width: 100%; padding: 2rem 0;">
        <div class="card" style="width: 100%; max-width: 500px; margin: 2rem;">
            <div class="card-body">
                <h2 class="card-title" style="text-align: center; margin-bottom: 2rem;">Rejoindre Midgar</h2>

                {% if registrationForm.vars.errors|length > 0 %}
                    <div class="alert alert-danger" style="color:#FF6B6B; text-align:center; margin-bottom:1rem;">
                        {% for error in registrationForm.vars.errors %}
                            <p>{{ error.message }}</p>
                        {% endfor %}
                    </div>
                {% endif %}

                {{ form_start(registrationForm, {'attr': {'enctype':'multipart/form-data'}}) }}

                <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div>
                        {{ form_label(registrationForm.prenom, "Prénom", {'label_attr': {'style':'color:#E6FFF6; font-weight:600; font-size:0.9rem;'}}) }}
                        {{ form_widget(registrationForm.prenom, {'attr': {'placeholder':'Léa','style':'width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.9rem;'}}) }}
                    </div>
                    <div>
                        {{ form_label(registrationForm.nom, "Nom", {'label_attr': {'style':'color:#E6FFF6; font-weight:600; font-size:0.9rem;'}}) }}
                        {{ form_widget(registrationForm.nom, {'attr': {'placeholder':'Mage','style':'width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.9rem;'}}) }}
                    </div>
                </div>

                <div class="form-group" style="margin:1rem 0;">
                    {{ form_label(registrationForm.username, "Nom d'utilisateur", {'label_attr': {'style':'color:#E6FFF6; font-weight:600;'}}) }}
                    {{ form_widget(registrationForm.username, {'attr': {'placeholder':'leamage_legends','style':'width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.95rem;'}}) }}
                    <small style="color:#B0B9B6;">3-20 caractères, lettres et chiffres uniquement</small>
                </div>

                <div class="form-group" style="margin:1rem 0;">
                    {{ form_label(registrationForm.email, "Email", {'label_attr': {'style':'color:#E6FFF6; font-weight:600;'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'placeholder':'votre.email@exemple.com','style':'width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.95rem;'}}) }}
                </div>

                <div class="form-group" style="display: grid; grid-template-columns: 1fr 1fr; gap:1rem; margin:1rem 0;">
                    <div>
                        {{ form_label(registrationForm.plainPassword, "Mot de passe", {'label_attr': {'style':'color:#E6FFF6; font-weight:600; font-size:0.9rem;'}}) }}
                        {{ form_widget(registrationForm.plainPassword, {'attr': {'placeholder':'••••••••','style':'width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.9rem;'}}) }}
                    </div>
                    <div>
                        <label for="password_confirm" style="color:#E6FFF6; font-weight:600; font-size:0.9rem;">Confirmer</label>
                        <input type="password" id="password_confirm" name="password_confirm" placeholder="••••••••" style="width:100%; padding:10px; background-color:#1A1F1E; border:1px solid #2A3139; border-radius:4px; color:#E6FFF6; font-size:0.9rem;" required>
                    </div>
                </div>

                <div class="form-group" style="margin:1rem 0;">
                    {{ form_label(registrationForm.photoProfil, "Photo de profil (optionnel)", {'label_attr': {'style':'color:#E6FFF6; font-weight:600;'}}) }}
                    {{ form_widget(registrationForm.photoProfil, {'attr': {'accept':'image/*','style':'width:100%; padding:8px; background-color:#1A1F1E; border:1px dashed #18E3A4; border-radius:4px; color:#E6FFF6; font-size:0.9rem;'}}) }}
                </div>

                <div style="margin:1.5rem 0;">
                    <label style="color:#B0B9B6; font-size:0.9rem;">
                        <input type="checkbox" name="terms" required style="margin-right:8px;">
                        J'accepte les <a href="#" style="color:#18E3A4;">conditions d'utilisation</a> et la <a href="#" style="color:#18E3A4;">politique de confidentialité</a>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary" style="width:100%; margin-bottom:1rem;">Créer mon Compte</button>

                {{ form_end(registrationForm) }}

                <hr style="border:none; border-top:1px solid #2A3139; margin:2rem 0;">

                <p style="text-align:center; color:#B0B9B6; margin-bottom:1rem;">Vous avez déjà un compte?</p>
                <a href="{{ path('app_login') }}" class="btn btn-secondary" style="width:100%; text-align:center; display:block;">Se Connecter</a>
            </div>
        </div>
    </div>

    <footer style="width:100%; margin-top:auto;">
        <div class="container">
            <div style="text-align:center; padding:2rem 0; border-top:1px solid #2A3139;">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
</body>
</html>
