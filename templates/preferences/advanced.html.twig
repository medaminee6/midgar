<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Personnaliser ton feed - Midgar</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/midgar.css">

    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
        }
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== PREFERENCE FORM STYLES ===== */
        .preference-form {
            background-color: rgba(26, 31, 30, 0.9);
            padding: 2.5rem;
            border-radius: 12px;
            border: 1px solid #2A3139;
            backdrop-filter: blur(10px);
        }

        .form-section {
            margin-bottom: 2.5rem;
        }

        .form-section h3 {
            color: #18E3A4;
            margin-bottom: 0.4rem;
        }

        .form-section p {
            color: #B0B9B6;
            font-size: 0.95rem;
            margin-bottom: 1.2rem;
        }

        /* === GENRE RADIO CARDS === */
        .radio-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .radio-grid input {
            display: none;
        }

        .radio-card {
            background-color: rgba(11, 15, 14, 0.8);
            border: 2px solid #2A3139;
            border-radius: 10px;
            padding: 1.2rem;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .radio-card:hover {
            transform: translateY(-3px);
            border-color: #18E3A4;
            box-shadow: 0 10px 25px rgba(24,227,164,0.15);
        }

        .radio-grid input:checked + .radio-card {
            border-color: #18E3A4;
            background: linear-gradient(135deg, rgba(24,227,164,0.15), rgba(24,227,164,0.05));
            box-shadow: 0 0 0 1px rgba(24,227,164,0.6);
        }

        /* === THEMES CHECKBOX === */
        .checkbox-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .checkbox-item {
            background-color: rgba(11, 15, 14, 0.8);
            border: 1px solid #2A3139;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .checkbox-item:hover {
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24,227,164,0.15);
        }

        .checkbox-item input {
            margin-right: 0.5rem;
            accent-color: #18E3A4;
        }

        /* === NUMBER INPUT === */
        .affinity-input {
            width: 100%;
            background-color: rgba(11, 15, 14, 0.8);
            border: 1px solid #2A3139;
            border-radius: 8px;
            padding: 0.8rem 1rem;
            color: #E6FFF6;
        }

        .affinity-input:focus {
            outline: none;
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24,227,164,0.2);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
            background-color: rgba(11, 15, 14, 0.8);
            border: 1px solid #2A3139;
            border-radius: 8px;
            padding: 0.8rem 1rem;
            color: #E6FFF6;
            width: 100%;
        }

        textarea.form-control:focus {
            outline: none;
            border-color: #18E3A4;
            box-shadow: 0 0 10px rgba(24,227,164,0.2);
        }

        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }

        @media (max-width: 640px) {
            .radio-grid,
            .checkbox-grid {
                grid-template-columns: 1fr;
            }
            
            header {
                flex-direction: column;
                gap: 1rem;
                padding: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
        }
    </style>
</head>
<body>

    <!-- VIDEO BACKGROUND -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
    </video>

    <header>
        <div class="logo">
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
            </svg>
            Midgar
        </div>
        
        <nav>
            <ul>
                <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                <li><a href="/shop" class="magic-btn">Boutique</a></li>
                <li><a href="/challenges" class="magic-btn">Défis</a></li>
            </ul>
        </nav>
        
        <div class="auth-buttons">
            {% if app.user %}
                <a href="{{ path('profile') }}" class="profile-link magic-btn">
                    <div class="avatar">
                        {% if app.user.avatar %}
                            <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                        {% else %}
                            <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                        {% endif %}
                    </div>
                    <span>{{ app.user.username }}</span>
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
            {% endif %}
        </div>
    </header>

    <main>
        <section class="section">
            <div class="container">
                <div style="max-width: 800px; margin: 0 auto;">

                    <h1 class="text-center mb-4" style="color: var(--primary-color);">Personnaliser ton feed</h1>
                    <p class="text-center mb-5" style="color: var(--text-secondary);">
                        Dis-nous ce que tu aimes, on s'occupe du reste ✨
                    </p>

                    <form class="preference-form" method="POST" action="{{ path('advanced_preferences') }}" novalidate>
                        
                        {% if errors is defined and errors | length > 0 %}
                            <div style="background-color:#BD3B44;color:#E6FFF6;padding:1rem;border-radius:4px;margin-bottom:2rem;">
                                <h4>Erreurs de validation:</h4>
                                <ul>
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <!-- FREE DESCRIPTION -->
                        <div class="form-section">
                            <h3>Description libre</h3>
                            <p>Décris les univers, styles ou ambiances que tu préfères</p>
                            <textarea class="form-control" name="free_description"
                                placeholder="Ex : mondes sombres, magie ancienne, royaumes oubliés...">{{ preference.freeDescription | default('') }}</textarea>
                        </div>

                        <!-- FAVORITE GENRE -->
                        <div class="form-section">
                            <h3>Genre favori</h3>
                            <p>Choisis celui qui te représente le plus</p>

                            <div class="radio-grid">
                                <input type="radio" id="genre-epic" name="favorite_genre" value="Epic Fantasy" {% if preference.favoriteGenre == 'Epic Fantasy' %}checked{% endif %}>
                                <label for="genre-epic" class="radio-card">Epic Fantasy</label>

                                <input type="radio" id="genre-dark" name="favorite_genre" value="Dark Fantasy" {% if preference.favoriteGenre == 'Dark Fantasy' %}checked{% endif %}>
                                <label for="genre-dark" class="radio-card">Dark Fantasy</label>

                                <input type="radio" id="genre-heroic" name="favorite_genre" value="Heroic Fantasy" {% if preference.favoriteGenre == 'Heroic Fantasy' %}checked{% endif %}>
                                <label for="genre-heroic" class="radio-card">Heroic Fantasy</label>

                                <input type="radio" id="genre-medieval" name="favorite_genre" value="Medieval Fantasy" {% if preference.favoriteGenre == 'Medieval Fantasy' %}checked{% endif %}>
                                <label for="genre-medieval" class="radio-card">Medieval Fantasy</label>

                                <input type="radio" id="genre-scifi" name="favorite_genre" value="Sci-Fi Fantasy" {% if preference.favoriteGenre == 'Sci-Fi Fantasy' %}checked{% endif %}>
                                <label for="genre-scifi" class="radio-card">Sci-Fi Fantasy</label>
                            </div>
                        </div>

                        <!-- GENRE AFFINITY -->
                        <div class="form-section">
                            <h3>Affinité avec ce genre</h3>
                            <p>Sur une échelle de 1 à 10</p>

                            <input type="number"
                                   name="genre_affinity"
                                   min="1"
                                   max="10"
                                   class="affinity-input"
                                   value="{{ preference.affinityLevel | default('') }}"
                                   placeholder="Ex : 8">
                        </div>

                        <!-- FAVORITE THEMES -->
                        <div class="form-section">
                            <h3>Thèmes favoris</h3>

                            <div class="checkbox-grid">
                                <label class="checkbox-item">
                                    <input type="checkbox" name="favorite_themes[]" value="Magie" {% if 'Magie' in preference.favoriteThemes %}checked{% endif %}> Magie
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="favorite_themes[]" value="Guerre" {% if 'Guerre' in preference.favoriteThemes %}checked{% endif %}> Guerre
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="favorite_themes[]" value="Politique" {% if 'Politique' in preference.favoriteThemes %}checked{% endif %}> Politique
                                </label>
                                <label class="checkbox-item">
                                    <input type="checkbox" name="favorite_themes[]" value="Nature" {% if 'Nature' in preference.favoriteThemes %}checked{% endif %}> Nature
                                </label>
                            </div>
                        </div>

                        <!-- CUSTOM TAGS -->
                        <div class="form-section">
                            <h3>Tags personnalisés</h3>
                            <p>Mots-clés séparés par des virgules</p>

                            <input type="text"
                                   name="custom_tags"
                                   class="affinity-input"
                                   value="{{ preference.customTags | default('') }}"
                                   placeholder="Ex : dragons, magie noire, civilisations anciennes">
                        </div>

                        <!-- SUBMIT -->
                        <div style="text-align:center; margin-top:3rem;">
                            <button type="submit" class="btn btn-primary btn-lg magic-btn">
                                {% if isCreating %}
                                    Enregistrer mes préférences
                                {% else %}
                                    Mettre à jour mes préférences
                                {% endif %}
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <p style="color: var(--text-secondary);">
                &copy; 2026 Midgar Fantasy Platform
            </p>
        </div>
    </footer>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .create-cta, .filter-reset').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/')) {
                link.classList.add('active');
            }
        });
    </script>

</body>
</html>
