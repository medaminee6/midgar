{% extends 'base.html.twig' %}

{% block title %}Modifier un Artefact - Midgar{% endblock %}

{% block body %}
<main>
    <section class="section">
        <div class="container">
            <div style="max-width: 700px; margin: 0 auto;">
                <h1 style="margin-bottom: 0.5rem;">Modifier un Artefact</h1>
                <p style="color: #B0B9B6; margin-bottom: 2rem;">{{ artefact.name }}</p>

                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2.5rem;">
                    <form method="POST" enctype="multipart/form-data">
                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Nom de l'Artefact *</label>
                            <input type="text" name="name" value="{{ artefact.name }}" class="form-input" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Type d'Artefact *</label>
                            <select name="type" class="form-select" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                                <option value="">Sélectionner un type</option>
                                <option value="Arme" {% if artefact.type == 'Arme' %}selected{% endif %}>Arme</option>
                                <option value="Armure" {% if artefact.type == 'Armure' %}selected{% endif %}>Armure</option>
                                <option value="Bijoux" {% if artefact.type == 'Bijoux' %}selected{% endif %}>Bijoux</option>
                                <option value="Relique" {% if artefact.type == 'Relique' %}selected{% endif %}>Relique</option>
                                <option value="Outil Magique" {% if artefact.type == 'Outil Magique' %}selected{% endif %}>Outil Magique</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Univers *</label>
                            <input type="text" name="universe" value="{{ artefact.universe }}" class="form-input" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Origines & Histoire *</label>
                            <textarea name="origins" class="form-textarea" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 120px;">{{ artefact.origins }}</textarea>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Pouvoirs & Propriétés *</label>
                            <textarea name="powers" class="form-textarea" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 120px;">{{ artefact.powers }}</textarea>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Rareté *</label>
                            <select name="rarity" class="form-select" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                                <option value="">Sélectionner une rareté</option>
                                <option value="Commune" {% if artefact.rarity == 'Commune' %}selected{% endif %}>Commune</option>
                                <option value="Rare" {% if artefact.rarity == 'Rare' %}selected{% endif %}>Rare</option>
                                <option value="Épique" {% if artefact.rarity == 'Épique' %}selected{% endif %}>Épique</option>
                                <option value="Légendaire" {% if artefact.rarity == 'Légendaire' %}selected{% endif %}>Légendaire</option>
                                <option value="Mythique" {% if artefact.rarity == 'Mythique' %}selected{% endif %}>Mythique</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Image</label>
                            {% if artefact.imageUrl %}
                                <p style="margin-bottom: 1rem;">
                                    <img src="{{ artefact.imageUrl }}" alt="{{ artefact.name }}" style="max-width: 200px; border-radius: 4px;">
                                </p>
                                <p style="color: #B0B9B6; font-size: 0.9rem;">Laissez vide pour conserver l'image actuelle</p>
                            {% endif %}
                            <input type="file" name="image" class="form-input" accept="image/*" style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="display: flex; gap: 1rem;">
                            <a href="{{ path('artefact_show', {id: artefact.id}) }}" class="btn btn-secondary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--border-color); color: var(--text-primary); text-decoration: none; display: inline-block;">Annuler</a>
                            <button type="submit" class="btn btn-primary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--accent-primary); color: var(--bg-primary);">Mettre à jour</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
