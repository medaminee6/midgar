{% extends 'base.html.twig' %}

{% block title %}Créer un Artefact - Midgar{% endblock %}

{% block body %}
<main>
    <section class="section">
        <div class="container">
            {% for message in app.flashes('error') %}
                <div style="background-color: #5c2d2d; border: 1px solid #8f4a4a; color: #ee9090; padding: 1rem; border-radius: 4px; margin-bottom: 2rem; max-width: 700px; margin-left: auto; margin-right: auto;">
                    {{ message }}
                </div>
            {% endfor %}
            <div style="max-width: 700px; margin: 0 auto;">
                <h1 style="margin-bottom: 0.5rem;">Créer un Artefact</h1>
                <p style="color: #B0B9B6; margin-bottom: 2rem;">Ajoutez un nouveau artefact à votre univers</p>

                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2.5rem;">
                    <form method="POST" enctype="multipart/form-data">
                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Nom de l'Artefact *</label>
                            <input type="text" name="name" class="form-input" placeholder="Ex: L'Épée de Cristal" minlength="3" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 3 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Type d'Artefact *</label>
                            <select name="type" class="form-select" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                                <option value="">Sélectionner un type</option>
                                <option value="Arme">Arme</option>
                                <option value="Armure">Armure</option>
                                <option value="Bijoux">Bijoux</option>
                                <option value="Relique">Relique</option>
                                <option value="Outil Magique">Outil Magique</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Univers *</label>
                            <input type="text" name="universe" class="form-input" placeholder="Ex: Midgard, Asgard..." minlength="2" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 2 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Origines & Histoire *</label>
                            <textarea name="origins" class="form-textarea" placeholder="Racontez l'histoire et les origines de cet artefact..." minlength="10" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 120px;"></textarea>
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 10 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Pouvoirs & Propriétés *</label>
                            <textarea name="powers" class="form-textarea" placeholder="Décrivez les pouvoirs et propriétés magiques..." minlength="10" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 120px;"></textarea>
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 10 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Rareté *</label>
                            <select name="rarity" class="form-select" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                                <option value="">Sélectionner une rareté</option>
                                <option value="Commune">Commune</option>
                                <option value="Rare">Rare</option>
                                <option value="Épique">Épique</option>
                                <option value="Légendaire">Légendaire</option>
                                <option value="Mythique">Mythique</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 2rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Image *</label>
                            <input type="file" name="image" class="form-input" accept="image/*" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="display: flex; gap: 1rem;">
                            <a href="{{ path('artefact_index') }}" class="btn btn-secondary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--border-color); color: var(--text-primary); text-decoration: none; display: inline-block;">Annuler</a>
                            <button type="submit" class="btn btn-primary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--accent-primary); color: var(--bg-primary);">Créer l'Artefact</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
