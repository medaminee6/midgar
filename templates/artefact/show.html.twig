<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ artefact.name }} - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
            --artefact-color: #FF6B6B;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        .btn-danger {
            background-color: #d32f2f;
            color: white;
            border: 2px solid #d32f2f;
        }
        
        .btn-danger:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(211, 47, 47, 0.5);
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== SHOW PAGE STYLES ===== */
        .artefact-container {
            background-color: var(--card-bg);
            border: 1px solid rgba(24, 227, 164, 0.1);
            border-radius: var(--border-radius);
            padding: 2.5rem;
            backdrop-filter: blur(10px);
        }
        
        .artefact-title {
            color: var(--primary-color);
            margin-bottom: 0.5rem;
            font-size: 2.2rem;
        }
        
        .artefact-meta {
            color: var(--text-secondary);
            margin: 0;
        }
        
        .artefact-image {
            margin-bottom: 2rem;
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid rgba(255, 107, 107, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            transition: all 0.3s ease;
            cursor: pointer;
        }
        
        .artefact-image:hover {
            border-color: var(--artefact-color);
            box-shadow: 0 0 30px rgba(255, 107, 107, 0.3);
            transform: translateY(-5px);
        }
        
        .artefact-image img {
            width: 100%;
            height: auto;
            max-height: 400px;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .artefact-image:hover img {
            transform: scale(1.05);
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
            padding-bottom: 2rem;
            border-bottom: 1px solid rgba(255, 107, 107, 0.2);
        }
        
        .info-item h3 {
            color: var(--primary-color);
            margin-top: 0;
            margin-bottom: 0.5rem;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .info-item p {
            margin: 0;
            color: var(--text-color);
        }
        
        .description-section {
            padding-top: 1rem;
        }
        
        .description-section h2 {
            color: var(--primary-color);
            margin-top: 0;
            margin-bottom: 1rem;
            font-size: 1.5rem;
        }
        
        .description-section p {
            color: var(--text-secondary);
            line-height: 1.8;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .modal-content {
            background: var(--bg-primary);
            padding: 2rem;
            border-radius: var(--border-radius);
            max-width: 800px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            position: relative;
            border: 1px solid var(--primary-color);
            animation: slideUp 0.4s;
            box-shadow: 0 0 50px rgba(24, 227, 164, 0.3);
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--primary-color);
            background: none;
            border: none;
            padding: 0.5rem;
            transition: all 0.3s;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-image-container {
            width: 100%;
            border-radius: var(--border-radius);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        
        .modal-image-container img {
            width: 100%;
            height: auto;
            max-height: 500px;
            object-fit: contain;
            display: block;
        }
        
        .modal-title {
            color: var(--primary-color);
            margin-bottom: 1rem;
            font-size: 1.8rem;
        }
        
        .modal-body {
            color: var(--text-secondary);
            line-height: 1.8;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .artefact-container {
                padding: 1.5rem;
            }
            
            .artefact-title {
                font-size: 1.8rem;
            }
            
            .info-grid {
                grid-template-columns: 1fr;
                gap: 1rem;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="/universes" class="magic-btn">Univers</a></li>
                    <li><a href="/personnages" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn active">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="/challenges" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <div style="max-width: 900px; margin: 0 auto;">
                        <div class="artefact-container">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
                                <div>
                                    <h1 class="artefact-title">{{ artefact.name }}</h1>
                                    <p class="artefact-meta">{{ artefact.type }} • {{ artefact.rarity }}</p>
                                </div>
                                <div style="display: flex; gap: 1rem;">
                                    <a href="{{ path('artefact_edit', {id: artefact.id}) }}" class="btn btn-primary magic-btn">Modifier</a>
                                    <form method="POST" action="{{ path('artefact_delete', {id: artefact.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet artefact ?');">
                                        <button type="submit" class="btn btn-danger magic-btn">Supprimer</button>
                                    </form>
                                </div>
                            </div>

                            {% if artefact.imageUrl %}
                                <div class="artefact-image">
                                    <img src="{{ artefact.imageUrl }}" alt="{{ artefact.name }}">
                                </div>
                            {% endif %}

                            <div class="info-grid">
                                <div class="info-item">
                                    <h3>Univers</h3>
                                    <p>{{ artefact.universe }}</p>
                                </div>
                                <div class="info-item">
                                    <h3>Type</h3>
                                    <p>{{ artefact.type }}</p>
                                </div>
                                <div class="info-item">
                                    <h3>Rareté</h3>
                                    <p>{{ artefact.rarity }}</p>
                                </div>
                            </div>

                            <div class="description-section" style="margin-bottom: 2rem;">
                                <h2>Origines & Histoire</h2>
                                <p>{{ artefact.origins|nl2br }}</p>
                            </div>

                            <div class="description-section" style="margin-bottom: 2rem;">
                                <h2>Pouvoirs & Propriétés</h2>
                                <p>{{ artefact.powers|nl2br }}</p>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid rgba(255, 107, 107, 0.2);">
                                <p style="color: var(--text-secondary); font-size: 0.9rem; margin: 0;">Créé le {{ artefact.createdAt|date('d/m/Y H:i') }}</p>
                                <a href="{{ path('artefact_index') }}" class="btn btn-secondary magic-btn">← Retour à la liste</a>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALE IMAGE STANDARD ===== -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('imageModal')">&times;</button>
            <div class="modal-image-container">
                <img id="modalImage" src="" alt="Image agrandie">
            </div>
            <h3 class="modal-title" id="modalImageTitle">{{ artefact.name }}</h3>
            <div class="modal-body">
                <p><strong>Type:</strong> {{ artefact.type }}</p>
                <p><strong>Rareté:</strong> {{ artefact.rarity }}</p>
                <p><strong>Univers:</strong> {{ artefact.universe }}</p>
            </div>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .btn-danger').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            // Pause/play video on visibility change
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
            
            // Make artefact image clickable
            const artefactImage = document.querySelector('.artefact-image');
            if (artefactImage) {
                artefactImage.addEventListener('click', function() {
                    const img = this.querySelector('img');
                    if (img) {
                        openImageModal(img.src, '{{ artefact.name }}');
                    }
                });
            }
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || '{{ artefact.name }}';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('artefact_index') }}' && currentPath.includes('/artefact'))) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>