<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Génération d’avatar</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: #e5e7eb;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .container {
            background: #020617;
            padding: 25px;
            border-radius: 10px;
            width: 360px;
            box-shadow: 0 0 25px rgba(0,0,0,0.6);
        }

        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #38bdf8;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        input[type="file"],
        select,
        button {
            padding: 8px;
            border-radius: 5px;
            border: none;
        }

        button {
            background: #38bdf8;
            color: #020617;
            font-weight: bold;
            cursor: pointer;
        }

        button:hover {
            background: #0ea5e9;
        }

        .result {
            margin-top: 20px;
            text-align: center;
        }

        img {
            border-radius: 50%;
            border: 3px solid #38bdf8;
            margin-top: 10px;
            width: 180px;
            height: 180px;
            object-fit: cover;
        }
    </style>
</head>
<body>

<div class="container">
    <h2>Génération d’avatar</h2>

    <form method="post" enctype="multipart/form-data">
        <input type="file" name="image" accept="image/*" required>

        <select name="theme">
            <option value="anime">Anime</option>
            <option value="fantasy">Fantasy</option>
            <option value="cyberpunk">Cyberpunk</option>
            <option value="dark">Dark</option>
        </select>

        <button type="submit">Générer</button>
    </form>

    {% if avatar is defined %}
        <div class="result">
            <p>Avatar généré :</p>
            <img src="{{ avatar }}" alt="Avatar généré">
        </div>
    {% endif %}
</div>

</body>
</html>
