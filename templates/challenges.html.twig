<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Défis Artistiques - Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
</head>
<body>
    {% include '_navbar.html.twig' %}

                <!-- ACTIVE CHALLENGES -->
                <h2 style="color: #18E3A4; margin-bottom: 2rem;">🔥 Défis Actifs</h2>
                {% set active_defis = defis|filter(defi => defi.statut.value == 'OUVERT') %}
                {% if active_defis|length > 0 %}
                    <div class="grid grid-2 mb-4">
                        {% for defi in active_defis %}
                            <div class="card">
                                <div class="card-image" style="font-size: 3rem; height: 140px; display: flex; align-items: center; justify-content: center;">
                                    {% if defi.imageCover %}
                                        <img src="{{ vich_uploader_asset(defi, 'imageCoverFile') }}" alt="{{ defi.titre }}" style="width: 100%; height: 100%; object-fit: cover;">
                                    {% else %}
                                        🎨
                                    {% endif %}
                                    </div>
                                <div class="card-body">
                                    <h3 class="card-title">{{ defi.titre }}</h3>
                                    <p class="card-text">{{ defi.description[:150] }}{{ defi.description|length > 150 ? '...' : '' }}</p>
                                    <div class="card-tags mb-2">
                                        <span class="tag">{{ defi.theme }}</span>
                                        <span class="tag">Actif</span>
                                    </div>
                                    <div style="margin: 1rem 0; color: #18E3A4; font-weight: 600;">📅 {{ defi.dateDebut|date('d/m/Y') }} → {{ defi.dateFin|date('d/m/Y') }}</div>
                                    <a href="{{ path('challenges_participate', { id: defi.id }) }}" class="btn btn-primary btn-sm" style="width: 100%;">Participer</a>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 3rem 2rem; color: #B0B9B6; font-style: italic;">
                        <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">🌟</div>
                        <h3>Aucun défi actif pour le moment</h3>
                        <p>Revenez plus tard pour découvrir de nouveaux défis passionnants!</p>
                    </div>
                {% endif %}

                <!-- PAST CHALLENGES -->
                <h2 style="color: #18E3A4; margin-bottom: 2rem; margin-top: 3rem;">✨ Défis Passés</h2>
                {% set closed_defis = defis|filter(defi => defi.statut.value == 'FERME') %}
                {% if closed_defis|length > 0 %}
                    <div class="grid grid-2">
                        {% for defi in closed_defis %}
                            <div class="card" style="opacity: 0.8;">
                                <div class="card-image" style="font-size: 3rem; height: 140px; display: flex; align-items: center; justify-content: center;">
                                        {% if defi.imageCover %}
                                            <img src="{{ vich_uploader_asset(defi, 'imageCoverFile') }}" alt="{{ defi.titre }}" style="width: 100%; height: 100%; object-fit: cover;">
                                        {% else %}
                                            🏆
                                        {% endif %}
                                    </div>
                                <div class="card-body">
                                    <h3 class="card-title">{{ defi.titre }}</h3>
                                    <p class="card-text">{{ defi.description[:150] }}{{ defi.description|length > 150 ? '...' : '' }}</p>
                                    <div class="card-tags mb-2">
                                        <span class="tag">{{ defi.theme }}</span>
                                        <span class="tag">Terminé</span>
                                    </div>
                                    <div style="margin: 1rem 0; color: #B0B9B6; font-weight: 600;">👁️ Voir les résultats</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div style="text-align: center; padding: 3rem 2rem; color: #B0B9B6; font-style: italic;">
                        <div style="font-size: 3rem; margin-bottom: 1rem; opacity: 0.5;">🎭</div>
                        <h3>Aucun défi terminé</h3>
                        <p>Les défis passés apparaîtront ici après leur conclusion.</p>
                    </div>
                {% endif %}
            </div>
        </section>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-section">
                    <h4>À propos</h4>
                    <ul class="footer-links">
                        <li><a href="#">À propos de Midgar</a></li>
                        <li><a href="#">Notre mission</a></li>
                        <li><a href="#">Équipe</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Ressources</h4>
                    <ul class="footer-links">
                        <li><a href="#">Aide & Support</a></li>
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">Blog</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h4>Légal</h4>
                    <ul class="footer-links">
                        <li><a href="#">Conditions d'utilisation</a></li>
                        <li><a href="#">Politique de confidentialité</a></li>
                        <li><a href="#">Cookies</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
            </div>
        </div>
    </footer>

    <script src="/assets/js/main.js"></script>
</body>
</html>
