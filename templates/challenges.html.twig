<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Défis Artistiques - Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES DÉFIS ===== */
        .grid {
            display: grid;
            gap: 1.5rem;
        }
        
        .grid-2 {
            grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        }
        
        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid transparent;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(5px);
            height: 100%;
        }
        
        .card:hover {
            border-color: rgba(24, 227, 164, 0.2);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(24, 227, 164, 0.3);
            transform: translateY(-5px);
        }
        
        .card-image {
            width: 100%;
            height: 140px;
            overflow: hidden;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        }
        
        .card-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .card:hover .card-image img {
            transform: scale(1.1);
        }
        
        .card-body {
            padding: 1.5rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        
        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }
        
        .card-text {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 1rem;
            line-height: 1.5;
            flex-grow: 1;
        }
        
        .card-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
            flex-wrap: wrap;
        }
        
        .tag {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            background-color: rgba(24, 227, 164, 0.1);
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            transition: transform 0.2s;
        }
        
        .tag:hover {
            transform: scale(1.05);
        }
        
        h2 {
            color: var(--primary-color);
            margin-bottom: 2rem;
            margin-top: 1rem;
            font-size: 1.8rem;
        }
        
        h2:first-of-type {
            margin-top: 0;
        }
        
        h3 {
            color: var(--text-secondary);
            margin-bottom: 0.5rem;
        }
        
        .mb-2, .mb-4 {
            margin-bottom: 1.5rem;
        }
        
        .empty-state {
            text-align: center;
            padding: 3rem 2rem;
            color: var(--text-secondary);
            font-style: italic;
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .empty-state div {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--primary-color);
            background: rgba(0, 0, 0, 0.3);
            border: none;
            padding: 0.25rem;
            transition: all 0.3s;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1001;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-content {
            max-width: 300px;
            width: 65%;
            background: rgba(26, 31, 30, 0.98);
            padding: 0.8rem;
            border: 1px solid var(--primary-color);
            border-radius: var(--border-radius);
            position: relative;
            animation: slideUp 0.4s;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.2);
            margin: auto;
        }
        
        .modal-image-container {
            width: 100%;
            border-radius: calc(var(--border-radius) - 4px);
            overflow: hidden;
            margin-bottom: 0.4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 40vh;
            background: transparent;
            padding: 0;
        }
        
        .modal-image-container img {
            max-width: 95%;
            max-height: 35vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 4px;
            filter: brightness(1.1);
        }
        
        .modal-title {
            color: var(--primary-color);
            margin-bottom: 0;
            font-size: 0.9rem;
            text-align: center;
            font-weight: 500;
            margin-top: 0.1rem;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .grid-2 {
                grid-template-columns: 1fr;
            }
            
            h2 {
                font-size: 1.5rem;
            }
            
            .modal-content {
                max-width: 280px;
                width: 70%;
                padding: 0.8rem;
            }
            
            .filter-sidebar {
                position: static;
            }
        }
        
        /* ===== UNIVERSES CONTAINER (Like artefact page) ===== */
        .universes-container {
            display: flex;
            gap: 2rem;
        }
        
        .filter-sidebar {
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            min-width: 250px;
            max-width: 280px;
            height: fit-content;
            position: sticky;
            top: 100px;
            backdrop-filter: blur(5px);
            border: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        .filter-sidebar:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        .filter-group {
            margin-bottom: 2rem;
        }
        
        .filter-group:last-child {
            border-bottom: none;
        }
        
        .filter-group h4 {
            color: var(--primary-color);
            margin-bottom: 1rem;
            font-size: 1rem;
        }
        
        .filter-option {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.5rem;
        }
        
        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: var(--primary-color);
        }
        
        .filter-option label {
            cursor: pointer;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .search-box {
            width: 100%;
            padding: 0.75rem 1rem;
            border-radius: 8px;
            border: 1px solid rgba(24, 227, 164, 0.3);
            background: rgba(26, 31, 30, 0.8);
            color: var(--text-color);
            font-size: 0.95rem;
        }
        
        .search-box::placeholder {
            color: var(--text-secondary);
        }
        
        .search-box:focus {
            outline: none;
            border-color: var(--primary-color);
        }
        
        .filter-reset {
            width: 100%;
            margin-bottom: 0.5rem;
            padding: 0.75rem;
            text-align: center;
        }
        
        .filter-reset:hover {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .universes-section {
            flex: 1;
        }
        
        .results-count {
            color: var(--text-secondary);
            font-size: 0.9rem;
        }
        
        .universes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="{{ path('challenges_index') }}" class="magic-btn active">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <div class="universes-container">
                        <div class="filter-sidebar">
                            <form method="get" action="{{ path('challenges_index') }}">
                                <div class="filter-group">
                                    <input type="text" name="search" class="search-box" placeholder="Chercher un défi..." value="{{ search|default('') }}">
                                </div>

                                <div class="filter-group">
                                    <h4>Statut</h4>
                                    <div class="filter-option">
                                        <input type="radio" name="statut" value="OUVERT" id="statut-ouvert" {% if statut == 'OUVERT' %}checked{% endif %}>
                                        <label for="statut-ouvert">Ouvert</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="statut" value="FERME" id="statut-ferme" {% if statut == 'FERME' %}checked{% endif %}>
                                        <label for="statut-ferme">Fermé</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="statut" value="" id="statut-all" {% if not statut %}checked{% endif %}>
                                        <label for="statut-all">Tous les statuts</label>
                                    </div>
                                </div>

                                <div class="filter-group">
                                    <h4>Trier par</h4>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="recent" id="sort-recent" {% if sortBy|default('recent') == 'recent' %}checked{% endif %}>
                                        <label for="sort-recent">Plus récents</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="ancien" id="sort-ancien" {% if sortBy|default('recent') == 'ancien' %}checked{% endif %}>
                                        <label for="sort-ancien">Plus anciens</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="date" id="sort-date" {% if sortBy|default('recent') == 'date' %}checked{% endif %}>
                                        <label for="sort-date">Par date</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="theme" id="sort-theme" {% if sortBy|default('recent') == 'theme' %}checked{% endif %}>
                                        <label for="sort-theme">Par thème</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="statut" id="sort-statut" {% if sortBy|default('recent') == 'statut' %}checked{% endif %}>
                                        <label for="sort-statut">Par statut</label>
                                    </div>
                                    <div class="filter-option">
                                        <input type="radio" name="sort" value="titre" id="sort-titre" {% if sortBy|default('recent') == 'titre' %}checked{% endif %}>
                                        <label for="sort-titre">A-Z</label>
                                    </div>
                                </div>

                                <button type="submit" class="filter-reset magic-btn">Filtrer</button>
                                <a href="{{ path('challenges_index') }}" class="filter-reset magic-btn">Réinitialiser</a>
                            </form>
                        </div>

                        <div class="universes-section">
                            
                            <!-- Loading indicator -->
                            <div id="loadingIndicator" style="display: none; text-align: center; padding: 2rem;">
                                <div style="color: var(--primary-color); font-size: 1.2rem;">Chargement...</div>
                            </div>
                            
                            <!-- Results count -->
                            <div id="resultsCount" style="margin-bottom: 1rem; color: var(--text-secondary); font-size: 0.9rem;"></div>
                            
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255, 107, 107, 0.2);">
                                <div>
                                    <h2 style="margin: 0; color: var(--primary-color);">Défis</h2>
                                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">
                                        Affichage: <a href="{{ path('challenges_index') }}" style="color: var(--primary-color);">Défis</a>
                                    </p>
                                </div>
                                <div class="results-count">
                                    <span>{{ defis|length }}</span> défi(s)
                                </div>
                            </div>

                            <!-- ACTIVE CHALLENGES (when not filtering by status) -->
                            {% if not statut %}
                                <h2 style="color: var(--primary-color); margin-bottom: 2rem;">🔥 Défis Actifs</h2>
                                {% set active_defis = defis|filter(defi => defi.statut.value == 'OUVERT') %}
                                {% if active_defis|length > 0 %}
                                    <div id="activeChallengesContainer" class="universes-grid mb-4">
                                        {% for defi in active_defis %}
                                            <div class="card" onclick="location.href='{{ path('challenges_participate', { id: defi.id }) }}'" style="cursor: pointer;">
                                                <div class="card-image">
                                                    {% if defi.imageCover %}
                                                        <img src="{{ vich_uploader_asset(defi, 'imageCoverFile') }}" alt="{{ defi.titre }}" onclick="event.stopPropagation(); openImageModal('{{ vich_uploader_asset(defi, 'imageCoverFile') }}', '{{ defi.titre }}')">
                                                    {% else %}
                                                        🎨
                                                    {% endif %}
                                                </div>
                                                <div class="card-body">
                                                    <h3 class="card-title">{{ defi.titre }}</h3>
                                                    <p class="card-text">{{ defi.description[:100] }}{{ defi.description|length > 100 ? '...' : '' }}</p>
                                                    <div class="card-tags mb-2">
                                                        <span class="tag">{{ defi.theme }}</span>
                                                        <span class="tag" style="background: rgba(24, 227, 164, 0.2); border-color: var(--primary-color);">Actif</span>
                                                    </div>
                                                    <div style="margin: 1rem 0; color: var(--primary-color); font-weight: 600; font-size: 0.85rem;">📅 {{ defi.dateDebut|date('d/m/Y') }} → {{ defi.dateFin|date('d/m/Y') }}</div>
                                                    <div style="color: var(--text-secondary); font-size: 0.85rem; margin-top: auto;">Cliquez pour participer</div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="empty-state">
                                        <div>🌟</div>
                                        <h3>Aucun défi actif pour le moment</h3>
                                        <p>Revenez plus tard pour découvrir de nouveaux défis passionnants!</p>
                                    </div>
                                {% endif %}

                                <!-- PAST CHALLENGES -->
                                <h2 style="color: var(--primary-color); margin-bottom: 2rem; margin-top: 3rem;">✨ Défis Passés</h2>
                                {% set closed_defis = defis|filter(defi => defi.statut.value == 'FERME') %}
                                {% if closed_defis|length > 0 %}
                                    <div id="closedChallengesContainer" class="universes-grid">
                                        {% for defi in closed_defis %}
                                            <div class="card" onclick="location.href='#'" style="cursor: pointer; opacity: 0.8;">
                                                <div class="card-image">
                                                    {% if defi.imageCover %}
                                                        <img src="{{ vich_uploader_asset(defi, 'imageCoverFile') }}" alt="{{ defi.titre }}" onclick="event.stopPropagation(); openImageModal('{{ vich_uploader_asset(defi, 'imageCoverFile') }}', '{{ defi.titre }}')">
                                                    {% else %}
                                                        🏆
                                                    {% endif %}
                                                </div>
                                                <div class="card-body">
                                                    <h3 class="card-title">{{ defi.titre }}</h3>
                                                    <p class="card-text">{{ defi.description[:100] }}{{ defi.description|length > 100 ? '...' : '' }}</p>
                                                    <div class="card-tags mb-2">
                                                        <span class="tag">{{ defi.theme }}</span>
                                                        <span class="tag" style="background: rgba(255, 107, 107, 0.2); border-color: #ff6b6b;">Terminé</span>
                                                    </div>
                                                    <div style="margin: 1rem 0; color: var(--text-secondary); font-weight: 600; font-size: 0.85rem;">👁️ Voir les résultats</div>
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="empty-state">
                                        <div>🎭</div>
                                        <h3>Aucun défi terminé</h3>
                                        <p>Les défis passés apparaîtront ici après leur conclusion.</p>
                                    </div>
                                {% endif %}
                            {% else %}
                                {# When filtering by status, show all results in one grid #}
                                <div class="universes-grid">
                                    {% for defi in defis %}
                                        <div class="card" onclick="location.href='{% if defi.statut.value == 'OUVERT' %}{{ path('challenges_participate', { id: defi.id }) }}{% else %}#{% endif %}'" style="cursor: pointer;">
                                            <div class="card-image">
                                                {% if defi.imageCover %}
                                                    <img src="{{ vich_uploader_asset(defi, 'imageCoverFile') }}" alt="{{ defi.titre }}" onclick="event.stopPropagation(); openImageModal('{{ vich_uploader_asset(defi, 'imageCoverFile') }}', '{{ defi.titre }}')">
                                                {% else %}
                                                    {{ defi.statut.value == 'OUVERT' ? '🎨' : '🏆' }}
                                                {% endif %}
                                            </div>
                                            <div class="card-body">
                                                <h3 class="card-title">{{ defi.titre }}</h3>
                                                <p class="card-text">{{ defi.description[:100] }}{{ defi.description|length > 100 ? '...' : '' }}</p>
                                                <div class="card-tags mb-2">
                                                    <span class="tag">{{ defi.theme }}</span>
                                                    <span class="tag" style="{{ defi.statut.value == 'OUVERT' ? 'background: rgba(24, 227, 164, 0.2); border-color: var(--primary-color);' : 'background: rgba(255, 107, 107, 0.2); border-color: #ff6b6b;' }}">{{ defi.statut.value }}</span>
                                                </div>
                                                <div style="margin: 1rem 0; color: var(--text-secondary); font-weight: 600; font-size: 0.85rem;">📅 {{ defi.dateDebut|date('d/m/Y') }} → {{ defi.dateFin|date('d/m/Y') }}</div>
                                                {% if defi.statut.value == 'OUVERT' %}
                                                    <div style="color: var(--primary-color); font-size: 0.85rem; margin-top: auto;">Cliquez pour participer</div>
                                                {% else %}
                                                    <div style="color: var(--text-secondary); font-size: 0.85rem; margin-top: auto;">Défi terminé</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% else %}
                                        <div class="empty-state">
                                            <div>🔍</div>
                                            <h3>Aucun défi trouvé</h3>
                                            <p>Essayez avec d'autres critères de recherche.</p>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALE IMAGE ULTRA COMPACTE ===== -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('imageModal')">×</button>
            <div class="modal-image-container">
                <img id="modalImage" src="" alt="Image agrandie">
            </div>
            <h3 class="modal-title" id="modalImageTitle">Défi</h3>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== FILTER SIDEBAR FUNCTIONALITY (AJAX) =====
        const filterForm = document.querySelector('.filter-sidebar form');
        
        if (filterForm) {
            // Listen for radio button changes
            filterForm.querySelectorAll('input[type="radio"]').forEach(radio => {
                radio.addEventListener('change', function() {
                    performFilterSearch();
                });
            });
            
            // Listen for search input with debounce
            const searchInput = filterForm.querySelector('input[name="search"]');
            if (searchInput) {
                let debounceTimer;
                searchInput.addEventListener('input', function() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(performFilterSearch, 300);
                });
            }
        }
        
        function performFilterSearch() {
            const formData = new FormData(filterForm);
            const search = formData.get('search') || '';
            const sort = formData.get('sort') || 'recent';
            const statut = formData.get('statut') || '';
            
            // Show loading
            const loadingIndicator = document.getElementById('loadingIndicator');
            if (loadingIndicator) loadingIndicator.style.display = 'block';
            
            // Update URL without reload
            const url = new URL(window.location.href);
            if (search) {
                url.searchParams.set('search', search);
            } else {
                url.searchParams.delete('search');
            }
            url.searchParams.set('sort', sort);
            if (statut) {
                url.searchParams.set('statut', statut);
            } else {
                url.searchParams.delete('statut');
            }
            window.history.pushState({}, '', url);
            
            // Fetch results via AJAX
            fetch(`{{ path('challenges_search') }}?search=${encodeURIComponent(search)}&sort=${encodeURIComponent(sort)}&statut=${encodeURIComponent(statut)}`)
                .then(response => response.json())
                .then(data => {
                    updateChallengesDisplay(data, statut);
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                })
                .catch(error => {
                    console.error('Error fetching challenges:', error);
                    if (loadingIndicator) loadingIndicator.style.display = 'none';
                });
        }
        
        function updateChallengesDisplay(data, currentStatut) {
            const resultsCount = document.getElementById('resultsCount');
            const mainSection = document.querySelector('.universes-section');
            
            if (!mainSection) return;
            
            // Update results count
            if (resultsCount) {
                resultsCount.textContent = `${data.count} défi(s) trouvé(s)`;
            }
            
            let html = '';
            
            if (!currentStatut) {
                // Show both active and closed sections
                html += `<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255, 107, 107, 0.2);">
                    <div>
                        <h2 style="margin: 0; color: var(--primary-color);">Défis</h2>
                        <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">
                            Affichage: <a href="{{ path('challenges_index') }}" style="color: var(--primary-color);">Défis</a>
                        </p>
                    </div>
                    <div class="results-count">
                        <span>${data.count}</span> défi(s)
                    </div>
                </div>`;
                
                // Active challenges
                html += `<h2 style="color: var(--primary-color); margin-bottom: 2rem;">🔥 Défis Actifs</h2>`;
                if (data.active.length > 0) {
                    html += `<div class="universes-grid mb-4">`;
                    data.active.forEach(defi => {
                        html += renderChallengeCard(defi, 'active');
                    });
                    html += `</div>`;
                } else {
                    html += `<div class="empty-state"><div>🌟</div><h3>Aucun défi actif trouvé</h3><p>Essayez avec d'autres critères de recherche!</p></div>`;
                }
                
                // Closed challenges
                html += `<h2 style="color: var(--primary-color); margin-bottom: 2rem; margin-top: 3rem;">✨ Défis Passés</h2>`;
                if (data.closed.length > 0) {
                    html += `<div class="universes-grid">`;
                    data.closed.forEach(defi => {
                        html += renderChallengeCard(defi, 'closed');
                    });
                    html += `</div>`;
                } else {
                    html += `<div class="empty-state"><div>🎭</div><h3>Aucun défi terminé</h3><p>Les défis passés apparaîtront ici après leur conclusion.</p></div>`;
                }
            } else {
                // Show single grid when filtering by status
                html += `<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255, 107, 107, 0.2);">
                    <div>
                        <h2 style="margin: 0; color: var(--primary-color);">Défis</h2>
                        <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">
                            Affichage: <a href="{{ path('challenges_index') }}" style="color: var(--primary-color);">Défis</a>
                        </p>
                    </div>
                    <div class="results-count">
                        <span>${data.count}</span> défi(s)
                    </div>
                </div>`;
                
                if (data.count > 0) {
                    html += `<div class="universes-grid">`;
                    [...data.active, ...data.closed].forEach(defi => {
                        html += renderChallengeCard(defi, defi.statut === 'OUVERT' ? 'active' : 'closed');
                    });
                    html += `</div>`;
                } else {
                    html += `<div class="empty-state"><div>🔍</div><h3>Aucun défi trouvé</h3><p>Essayez avec d'autres critères de recherche.</p></div>`;
                }
            }
            
            mainSection.innerHTML = html;
        }
        
        function renderChallengeCard(defi, type) {
            const imageHtml = defi.imageCover 
                ? `<img src="/uploads/defis/${defi.imageCover}" alt="${defi.titre}" onclick="event.stopPropagation(); openImageModal('/uploads/defis/${defi.imageCover}', '${defi.titre}')">`
                : (type === 'active' ? '🎨' : '🏆');
            
            const link = type === 'active' ? `/challenges/${defi.id}/participer` : '#';
            const actionText = type === 'active' ? 'Cliquez pour participer' : 'Défi terminé';
            const statusBadge = type === 'active' 
                ? '<span class="tag" style="background: rgba(24, 227, 164, 0.2); border-color: var(--primary-color);">Actif</span>'
                : '<span class="tag" style="background: rgba(255, 107, 107, 0.2); border-color: #ff6b6b;">Terminé</span>';
            const dateColor = type === 'active' ? 'var(--primary-color)' : 'var(--text-secondary)';
            
            return `<div class="card" onclick="location.href='${link}'" style="cursor: pointer; opacity: ${type === 'closed' ? '0.8' : '1'};">
                <div class="card-image">${imageHtml}</div>
                <div class="card-body">
                    <h3 class="card-title">${defi.titre}</h3>
                    <p class="card-text">${defi.description.substring(0, 100)}${defi.description.length > 100 ? '...' : ''}</p>
                    <div class="card-tags mb-2">
                        <span class="tag">${defi.theme}</span>
                        ${statusBadge}
                    </div>
                    <div style="margin: 1rem 0; color: ${dateColor}; font-weight: 600; font-size: 0.85rem;">📅 ${defi.dateDebut} → ${defi.dateFin}</div>
                    <div style="color: ${type === 'active' ? 'var(--primary-color)' : 'var(--text-secondary)'}; font-size: 0.85rem; margin-top: auto;">${actionText}</div>
                </div>
            </div>`;
        }

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
            
            // ACTIVE NAV LINK HIGHLIGHT
            const currentPath = window.location.pathname;
            document.querySelectorAll('nav .magic-btn').forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') === currentPath || 
                    (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                    (link.getAttribute('href') === '{{ path('challenges_index') }}' && currentPath.includes('/challenges'))) {
                    link.classList.add('active');
                }
            });
            
            // MAKE IMAGES CLICKABLE
            document.querySelectorAll('.card-image img').forEach(img => {
                img.style.cursor = 'pointer';
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            if (!imageSrc) return;
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || 'Défi';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });
    </script>
</body>
</html>