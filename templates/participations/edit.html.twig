<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier la participation | Midgar</title>
    <link rel="stylesheet" href="/css/midgar.css">
    <style>
        :root { --accent: #18E3A4; --muted: #B0B9B6; --bg-dark: #0B0F0E; --bg-darker: #080A0A; --border: #2A3139; }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: linear-gradient(135deg, #0B0F0E 0%, #1A1F1E 100%); color: #E6FFF6; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; min-height: 100vh; }
        header { background: rgba(26, 31, 30, 0.95); border-bottom: 2px solid var(--border); padding: 1.5rem 0; position: sticky; top: 0; z-index: 100; backdrop-filter: blur(10px); }
        .header-container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; display: flex; align-items: center; justify-content: center; }
        .logo { font-size: 1.5rem; font-weight: 700; color: var(--accent); text-decoration: none; order: 2; margin-left: 1rem; }
        nav { order: 1; display:flex; justify-content:center; gap: 1rem; }
        nav a { color: var(--muted); text-decoration: none; margin: 0 1rem; transition: color 0.3s ease; }
        nav a:hover { color: var(--accent); }
        .btn { padding: 0.6rem 1.25rem; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-weight: 600; transition: all 0.3s ease; display: inline-block; }
        .btn-primary { background: var(--accent); color: var(--bg-dark); }
        .btn-primary:hover { background: #16D49A; }
        .btn-secondary { background: transparent; color: var(--muted); border: 2px solid var(--muted); }
        .btn-secondary:hover { color: var(--accent); border-color: var(--accent); }
        main { max-width: 640px; margin: 0 auto; padding: 2rem; }
        .back-link { color: var(--muted); text-decoration: none; margin-bottom: 1.5rem; display: inline-block; }
        .back-link:hover { color: var(--accent); }
        .card { background: linear-gradient(135deg, #1A1F1E 0%, #252A29 100%); border: 1px solid var(--border); border-radius: 8px; padding: 2rem; }
        .card h2 { color: var(--accent); margin-bottom: 1.5rem; font-size: 1.25rem; }
        .muted { color: var(--muted); font-size: 0.9rem; }
        .form-group { margin-bottom: 1.25rem; }
        .form-group label { display: block; color: var(--muted); margin-bottom: 0.5rem; font-weight: 500; }
        .form-control { width: 100%; padding: 0.75rem 1rem; background: var(--bg-darker); border: 1px solid var(--border); border-radius: 4px; color: #E6FFF6; font-size: 1rem; }
        .form-control:focus { outline: none; border-color: var(--accent); }
        textarea.form-control { min-height: 120px; resize: vertical; }
        select.form-control { cursor: pointer; }
        .form-errors { color: #e57373; font-size: 0.85rem; margin-top: 0.35rem; }
        .form-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
        .flash-success { background: rgba(24, 227, 164, 0.15); color: var(--accent); border: 1px solid var(--accent); padding: 1rem; border-radius: 4px; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <header>
        <div class="header-container">
            <a href="/" class="logo">Midgar</a>
            <nav>
                <a href="/challenges">Défis</a>
                <a href="/participations">Participations</a>
            </nav>
        </div>
    </header>

    <main>
        <a href="{{ path('participation_index') }}" class="back-link">← Liste des participations</a>

        {% for message in app.flashes('success') %}
            <div class="flash-success">{{ message }}</div>
        {% endfor %}

        <div class="card">
            <h2>Modifier la participation #{{ participation.id }}</h2>
            <p class="muted" style="margin-bottom: 1rem;">Défi : {{ participation.defi ? participation.defi.titre : '—' }}</p>
            {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}
                <div class="form-group">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.imageFile) }}
                    {{ form_widget(form.imageFile) }}
                    {{ form_errors(form.imageFile) }}
                    {% if participation.imageFileName %}
                        <p class="muted" style="margin-top: 0.5rem;">Image actuelle :</p>
                        <img src="{{ vich_uploader_asset(participation, 'imageFile') }}" alt="Participation" style="max-width: 200px; max-height: 150px; object-fit: cover; border-radius: 6px;">
                    {% endif %}
                </div>
                <div class="form-group">
                    {{ form_label(form.artworkId) }}
                    {{ form_widget(form.artworkId) }}
                    {{ form_errors(form.artworkId) }}
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('participation_index') }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </main>
</body>
</html>
