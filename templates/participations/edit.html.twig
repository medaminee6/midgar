{% extends 'base.html.twig' %}

{% block title %}Modifier la participation | Midgar{% endblock %}

{% block content %}
<div class="container">
    <a href="{{ path('participation_index') }}" class="btn btn-secondary mb-4" style="display: inline-flex; align-items: center; gap: 0.5rem;">← Liste des participations</a>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="card">
        <div class="card-body">
            <h2 style="color: #18E3A4; margin-bottom: 1.5rem;">Modifier la participation #{{ participation.id }}</h2>
            <p class="text-muted mb-3">Défi : {{ participation.defi ? participation.defi.titre : '—' }}</p>
            {{ form_start(form, { 'attr': { 'enctype': 'multipart/form-data' } }) }}
                <div class="mb-3">
                    {{ form_label(form.description) }}
                    {{ form_widget(form.description, { 'attr': { 'class': 'form-control', 'rows': 5 } }) }}
                    {{ form_errors(form.description) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.imageFile) }}
                    {{ form_widget(form.imageFile, { 'attr': { 'class': 'form-control', 'accept': 'image/*' } }) }}
                    {{ form_errors(form.imageFile) }}
                    {% if participation.imageFileName %}
                        <p class="text-muted mt-2">Image actuelle :</p>
                        <img src="{{ vich_uploader_asset(participation, 'imageFile') }}" alt="Participation" style="max-width: 200px; max-height: 150px; object-fit: cover; border-radius: 6px;">
                    {% endif %}
                </div>
                <div class="mb-3">
                    {{ form_label(form.artworkId) }}
                    {{ form_widget(form.artworkId, { 'attr': { 'class': 'form-control', 'min': 1 } }) }}
                    {{ form_errors(form.artworkId) }}
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Enregistrer</button>
                    <a href="{{ path('participation_index') }}" class="btn btn-secondary">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
