<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Participation #{{ participation.id }} | Midgar</title>
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        .btn-danger {
            background-color: #d32f2f;
            color: white;
            border: 2px solid #d32f2f;
        }
        
        .btn-danger:hover {
            background-color: #b71c1c;
            transform: scale(1.05);
            box-shadow: 0 0 15px rgba(211, 47, 47, 0.5);
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
            box-shadow: 0 0 10px var(--primary-color);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES PARTICIPATION SHOW ===== */
        .card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 2.5rem;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: all 0.3s ease;
        }
        
        .card:hover {
            border-color: rgba(24, 227, 164, 0.3);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }
        
        .card h2 {
            color: var(--primary-color);
            margin-bottom: 1.5rem;
        }
        
        .text-muted {
            color: var(--text-secondary);
            margin-top: 1rem;
            margin-bottom: 0.25rem;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .badge {
            display: inline-block;
            padding: 0.35rem 0.75rem;
            background-color: rgba(24, 227, 164, 0.2);
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }
        
        .bg-warning {
            background-color: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border-color: #ffc107;
        }
        
        .bg-success {
            background-color: rgba(40, 167, 69, 0.2);
            color: #28a745;
            border-color: #28a745;
        }
        
        .participation-image {
            margin-bottom: 1.5rem;
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid rgba(24, 227, 164, 0.2);
            max-width: 100%;
            display: inline-block;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .participation-image:hover {
            border-color: var(--primary-color);
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.3);
            transform: scale(1.02);
        }
        
        .participation-image img {
            max-width: 100%;
            max-height: 300px;
            object-fit: contain;
            display: block;
        }
        
        .mb-3, .mb-4 {
            margin-bottom: 1.5rem;
        }
        
        .mt-3, .mt-4 {
            margin-top: 1.5rem;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            font-size: 1.2rem;
            cursor: pointer;
            color: var(--primary-color);
            background: rgba(0, 0, 0, 0.3);
            border: none;
            padding: 0.25rem;
            transition: all 0.3s;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1001;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-content {
            max-width: 300px;
            width: 65%;
            background: rgba(26, 31, 30, 0.98);
            padding: 0.8rem;
            border: 1px solid var(--primary-color);
            border-radius: var(--border-radius);
            position: relative;
            animation: slideUp 0.4s;
            box-shadow: 0 0 20px rgba(24, 227, 164, 0.2);
            margin: auto;
        }
        
        .modal-image-container {
            width: 100%;
            border-radius: calc(var(--border-radius) - 4px);
            overflow: hidden;
            margin-bottom: 0.4rem;
            display: flex;
            justify-content: center;
            align-items: center;
            max-height: 40vh;
            background: transparent;
            padding: 0;
        }
        
        .modal-image-container img {
            max-width: 95%;
            max-height: 35vh;
            width: auto;
            height: auto;
            object-fit: contain;
            display: block;
            margin: 0 auto;
            border-radius: 4px;
            filter: brightness(1.1);
        }
        
        .modal-title {
            color: var(--primary-color);
            margin-bottom: 0;
            font-size: 0.9rem;
            text-align: center;
            font-weight: 500;
            margin-top: 0.1rem;
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .card {
                padding: 1.5rem;
            }
            
            .modal-content {
                max-width: 280px;
                width: 70%;
                padding: 0.8rem;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>

    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="{{ path('universe_index') }}" class="magic-btn">Univers</a></li>
                    <li><a href="{{ path('personnage_index') }}" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn">Œuvre</a></li>
                    <li><a href="{{ path('artefact_index') }}" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="{{ path('challenges_index') }}" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    <a href="{{ path('participation_index') }}" class="btn btn-secondary magic-btn mb-4" style="display: inline-flex; align-items: center; gap: 0.5rem;">← Liste des participations</a>

                    <div class="card">
                        <div class="card-body">
                            <h2 style="color: var(--primary-color); margin-bottom: 1.5rem;">Participation #{{ participation.id }}</h2>
                            
                            {% if participation.imageFileName %}
                                <div class="participation-image" onclick="openImageModal('{{ vich_uploader_asset(participation, 'imageFile') }}', 'Participation #{{ participation.id }}')">
                                    <img src="{{ vich_uploader_asset(participation, 'imageFile') }}" alt="Participation">
                                </div>
                            {% endif %}
                            
                            <p class="text-muted">Défi</p>
                            <p style="color: var(--text-color);">{{ participation.defi ? participation.defi.titre : '—' }}</p>
                            
                            <p class="text-muted">Description</p>
                            <p style="color: var(--text-secondary); line-height: 1.8;">{{ participation.description }}</p>
                            
                            <p class="text-muted">Utilisateur ID / Artwork ID</p>
                            <p style="color: var(--text-color);">{{ participation.userId }} / {{ participation.artworkId ?? '—' }}</p>
                            
                            <p class="text-muted">Statut</p>
                            <p>
                                <span class="badge {% if participation.statut.value == 'EN_ATTENTE' %}bg-warning{% else %}bg-success{% endif %}">
                                    {{ participation.statut.value }}
                                </span>
                            </p>
                            
                            <p class="text-muted">Date de soumission</p>
                            <p style="color: var(--text-color);">{{ participation.dateSoumission ? participation.dateSoumission|date('d/m/Y H:i') : '—' }}</p>

                            <div class="mt-4" style="display: flex; gap: 1rem;">
                                <a href="{{ path('participation_edit', { id: participation.id }) }}" class="btn btn-primary magic-btn">Modifier</a>
                                <form method="post" action="{{ path('participation_delete', { id: participation.id }) }}" style="display: inline;" onsubmit="return confirm('Supprimer cette participation ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ participation.id) }}">
                                    <button type="submit" class="btn btn-danger magic-btn">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALE IMAGE ULTRA COMPACTE ===== -->
    <div id="imageModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('imageModal')">×</button>
            <div class="modal-image-container">
                <img id="modalImage" src="" alt="Image agrandie">
            </div>
            <h3 class="modal-title" id="modalImageTitle">Participation #{{ participation.id }}</h3>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn, .btn-primary, .btn-secondary, .btn-danger').forEach(btn => {
            btn.addEventListener('click', function(e) {
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) gradientBg.style.display = 'block';
                });
                
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) gradientBg.style.display = 'block';
                });
            }
            
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }
        
        function openImageModal(imageSrc, title) {
            if (!imageSrc) return;
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('modalImageTitle').textContent = title || 'Participation #{{ participation.id }}';
            openModal('imageModal');
        }

        // ===== CLOSE MODAL WHEN CLICKING OUTSIDE =====
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // ===== CLOSE MODAL WITH ESCAPE KEY =====
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/')) {
                link.classList.add('active');
            }
        });
    </script>
</body>
</html>