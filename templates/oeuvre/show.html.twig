{% extends 'base.html.twig' %}

{% block title %}{{ oeuvre.title }} - Midgar{% endblock %}

{% block body %}
<main>
    <section class="section">
        <div class="container">
            <div style="max-width: 900px; margin: 0 auto;">
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem;">
                    <div>
                        <h1 style="margin-bottom: 0.5rem;">{{ oeuvre.title }}</h1>
                        <p style="color: #B0B9B6; margin: 0;">par {{ oeuvre.author }}</p>
                    </div>
                    <div style="display: flex; gap: 1rem;">
                        <a href="{{ path('oeuvre_edit', {id: oeuvre.id}) }}" class="btn" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--accent-primary); color: var(--bg-primary); text-decoration: none; display: inline-block;">Modifier</a>
                        <form method="POST" action="{{ path('oeuvre_delete', {id: oeuvre.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr?');">
                            <button type="submit" class="btn" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: #d32f2f; color: white;">Supprimer</button>
                        </form>
                    </div>
                </div>

                {% if oeuvre.imageUrl %}
                    <div style="margin-bottom: 2rem; border-radius: 8px; overflow: hidden;">
                        <img src="{{ oeuvre.imageUrl }}" alt="{{ oeuvre.title }}" style="width: 100%; height: auto; max-height: 400px; object-fit: cover;">
                    </div>
                {% endif %}

                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2rem; margin-bottom: 2rem;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
                        <div>
                            <h3 style="color: var(--accent-primary); margin-top: 0;">Type</h3>
                            <p style="margin: 0;">{{ oeuvre.type }}</p>
                        </div>
                        <div>
                            <h3 style="color: var(--accent-primary); margin-top: 0;">Date de Publication</h3>
                            <p style="margin: 0;">{{ oeuvre.datePublication ? oeuvre.datePublication|date('d/m/Y') : 'N/A' }}</p>
                        </div>
                        <div>
                            <h3 style="color: var(--accent-primary); margin-top: 0;">Créée le</h3>
                            <p style="margin: 0;">{{ oeuvre.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                    </div>

                    <div style="border-top: 1px solid var(--border-color); padding-top: 2rem;">
                        <h2 style="color: var(--accent-primary); margin-top: 0;">Description</h2>
                        <p>{{ oeuvre.description }}</p>
                    </div>
                </div>

                <div style="display: flex; gap: 1rem;">
                    <a href="{{ path('oeuvre_index') }}" class="btn" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--border-color); color: var(--text-primary); text-decoration: none; display: inline-block;">Retour à la liste</a>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
