{% extends 'base.html.twig' %}

{% block title %}Créer une Œuvre - Midgar{% endblock %}

{% block body %}
<main>
    <section class="section">
        <div class="container">
            {% for message in app.flashes('error') %}
                <div style="background-color: #5c2d2d; border: 1px solid #8f4a4a; color: #ee9090; padding: 1rem; border-radius: 4px; margin-bottom: 2rem; max-width: 700px; margin-left: auto; margin-right: auto;">
                    {{ message }}
                </div>
            {% endfor %}
            <div style="max-width: 700px; margin: 0 auto;">
                <h1 style="margin-bottom: 0.5rem;">Créer une Œuvre</h1>
                <p style="color: #B0B9B6; margin-bottom: 2rem;">Partagez votre création littéraire ou artistique</p>

                <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 2.5rem;">
                    <form method="POST" enctype="multipart/form-data">
                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Titre de l'Œuvre *</label>
                            <input type="text" name="title" class="form-input" placeholder="Ex: La Chute de la Tour Céleste" minlength="3" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 3 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Type d'Œuvre *</label>
                            <select name="type" class="form-select" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                                <option value="">Sélectionner un type</option>
                                <option value="roman">Roman</option>
                                <option value="nouvelle">Nouvelle</option>
                                <option value="poesie">Poésie</option>
                                <option value="artwork">Illustration</option>
                                <option value="musique">Musique</option>
                                <option value="autre">Autre</option>
                            </select>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Description *</label>
                            <textarea name="description" class="form-textarea" placeholder="Décrivez votre œuvre, son contexte, ses inspirations..." minlength="10" required style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem; resize: vertical; min-height: 120px;"></textarea>
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Minimum 10 caractères</small>
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Date de Publication</label>
                            <input type="date" name="datePublication" class="form-input" style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="margin-bottom: 1.5rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Image *</label>
                            <input type="file" id="imageFileInput" name="image" class="form-input" accept="image/*" style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                            <small style="color: #B0B9B6; font-size: 0.8rem;">Vous pouvez télécharger une image ou la dessiner ci-dessous</small>
                        </div>

                        <input type="hidden" id="drawnImageInput" name="drawnImage" value="">

                        <div style="margin-bottom: 1.5rem;">
                            <button type="button" id="toggleDrawBtn" class="btn btn-secondary" style="margin-bottom:0.75rem;">Dessiner votre image</button>
                            <div id="drawArea" style="display:none; background: var(--bg-primary); border:1px solid var(--border-color); padding:1rem; border-radius:6px;">
                                <div style="display:flex; gap:0.5rem; align-items:center; margin-bottom:0.5rem;">
                                    <label style="font-weight:600; font-size:0.85rem;">Couleur</label>
                                    <input type="color" id="brushColor" value="#000000">
                                    <label style="font-weight:600; font-size:0.85rem;">Taille</label>
                                    <input type="range" id="brushSize" min="1" max="50" value="4">
                                    <button type="button" id="clearCanvas" class="btn btn-secondary">Effacer</button>
                                    <button type="button" id="saveCanvas" class="btn btn-primary">Utiliser ce dessin</button>
                                </div>
                                <canvas id="drawCanvas" width="600" height="360" style="width:100%; max-width:100%; background:#fff; border:1px solid #ddd; touch-action: none; border-radius:4px;"></canvas>
                                <p id="drawHint" style="color:#B0B9B6; font-size:0.85rem; margin-top:0.5rem;">Utilisez la souris ou le doigt pour dessiner. Cliquez sur "Utiliser ce dessin" pour l'attacher au formulaire.</p>
                            </div>
                        </div>

                        <div style="margin-bottom: 2rem;">
                            <label style="display: block; font-weight: 600; margin-bottom: 0.5rem; text-transform: uppercase; font-size: 0.85rem;">Auteur/Artiste</label>
                            <input type="text" name="author" class="form-input" placeholder="Votre nom ou pseudonyme" style="width: 100%; padding: 0.875rem; background-color: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-family: inherit; font-size: 0.95rem;">
                        </div>

                        <div style="display: flex; gap: 1rem;">
                            <a href="{{ path('oeuvre_index') }}" class="btn btn-secondary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--border-color); color: var(--text-primary); text-decoration: none; display: inline-block;">Annuler</a>
                            <button type="submit" class="btn btn-primary" style="padding: 0.875rem 2rem; border: none; border-radius: 4px; cursor: pointer; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; transition: all 0.3s; font-size: 0.9rem; background-color: var(--accent-primary); color: var(--bg-primary);">Créer l'Œuvre</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
</main>
    <script>
        (function(){
            const toggleBtn = document.getElementById('toggleDrawBtn');
            const drawArea = document.getElementById('drawArea');
            const canvas = document.getElementById('drawCanvas');
            const ctx = canvas.getContext('2d');
            const brushColor = document.getElementById('brushColor');
            const brushSize = document.getElementById('brushSize');
            const clearBtn = document.getElementById('clearCanvas');
            const saveBtn = document.getElementById('saveCanvas');
            const drawnInput = document.getElementById('drawnImageInput');
            const fileInput = document.getElementById('imageFileInput');
            const form = document.querySelector('form[method="POST"]');

            let drawing = false;
            let lastX = 0, lastY = 0;

            toggleBtn?.addEventListener('click', () => {
                if (drawArea.style.display === 'none') {
                    drawArea.style.display = 'block';
                    toggleBtn.textContent = 'Cacher le dessin';
                } else {
                    drawArea.style.display = 'none';
                    toggleBtn.textContent = 'Dessiner votre image';
                }
            });

            function resizeCanvasForDisplay() {
                // keep internal resolution, but scale to container width
                const ratio = canvas.width / canvas.clientWidth;
                // optional: leave as-is; canvas has fixed internal size
            }

            function pointerPos(e) {
                const rect = canvas.getBoundingClientRect();
                return { x: (e.clientX - rect.left) * (canvas.width / rect.width), y: (e.clientY - rect.top) * (canvas.height / rect.height) };
            }

            canvas.addEventListener('pointerdown', (e) => {
                drawing = true;
                const p = pointerPos(e);
                lastX = p.x; lastY = p.y;
                canvas.setPointerCapture(e.pointerId);
            });
            canvas.addEventListener('pointermove', (e) => {
                if (!drawing) return;
                const p = pointerPos(e);
                ctx.strokeStyle = brushColor.value;
                ctx.lineWidth = brushSize.value;
                ctx.lineCap = 'round';
                ctx.beginPath();
                ctx.moveTo(lastX, lastY);
                ctx.lineTo(p.x, p.y);
                ctx.stroke();
                lastX = p.x; lastY = p.y;
            });
            function stopDraw(e) { drawing = false; try { canvas.releasePointerCapture(e.pointerId); } catch(e){}}
            canvas.addEventListener('pointerup', stopDraw);
            canvas.addEventListener('pointercancel', stopDraw);

            clearBtn?.addEventListener('click', () => {
                ctx.clearRect(0,0,canvas.width, canvas.height);
                drawnInput.value = '';
            });

            saveBtn?.addEventListener('click', () => {
                // export as PNG data URL
                const dataUrl = canvas.toDataURL('image/png');
                drawnInput.value = dataUrl;
                // clear file input to prefer drawn image
                if (fileInput) fileInput.value = '';
                alert('Dessin prêt. Il sera utilisé comme image de l\'œuvre.');
            });

            // If user chooses a file, clear any drawn image
            fileInput?.addEventListener('change', () => {
                if (fileInput.files && fileInput.files.length > 0) {
                    drawnInput.value = '';
                }
            });

            // Validate on submit: require either a file or a drawn image
            form?.addEventListener('submit', (e) => {
                const hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
                const hasDraw = drawnInput && drawnInput.value && drawnInput.value.length > 10;
                if (!hasFile && !hasDraw) {
                    e.preventDefault();
                    alert('Veuillez télécharger une image ou dessiner une image avant de soumettre.');
                    return false;
                }
                // Allow submit; controller will handle drawnImage if present
            });
        })();
    </script>
{% endblock %}
