{% extends 'base.html.twig' %}

{% block title %}Toutes les Œuvres - Midgar{% endblock %}

{% block body %}
<main>
    <section class="section">
        <div class="container">
            {% for message in app.flashes('success') %}
                <div style="background-color: #2d5c2d; border: 1px solid #4a8f4a; color: #90ee90; padding: 1rem; border-radius: 4px; margin-bottom: 2rem; text-align: center;">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div style="background-color: #5c2d2d; border: 1px solid #8f4a4a; color: #ee9090; padding: 1rem; border-radius: 4px; margin-bottom: 2rem; text-align: center;">
                    {{ message }}
                </div>
            {% endfor %}

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 style="margin-bottom: 0.5rem;">{{ myItems ? 'Mes Œuvres' : 'Toutes les Œuvres' }}</h1>
                    <p style="color: #B0B9B6; margin: 0;">{{ oeuvres|length }} œuvre(s) trouvée(s)</p>
                </div>
                <div style="display: flex; gap: 1rem; align-items: center;">
                    {% if currentUser %}
                        {% if myItems %}
                            <a href="{{ path('oeuvre_index') }}" style="padding: 12px 24px; background-color: #555; color: #fff; border: none; border-radius: 4px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.3s;">← Toutes les Œuvres</a>
                        {% else %}
                            <a href="{{ path('oeuvre_index', {my_items: 1}) }}" style="padding: 12px 24px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.3s;">Mes Œuvres</a>
                        {% endif %}
                    {% endif %}
                    <a href="{{ path('oeuvre_create') }}" style="padding: 12px 24px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.3s;">+ Créer une Œuvre</a>
                </div>
            </div>

            <div style="margin-bottom: 2rem;">
                <form method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
                    <input type="text" name="search" value="{{ search }}" placeholder="Rechercher par titre..." style="flex: 1; min-width: 200px; padding: 12px; background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-primary); font-size: 0.95rem;">
                    <button type="submit" style="padding: 12px 24px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; transition: all 0.3s;">Rechercher</button>
                    {% if search or type %}
                        <a href="{{ path('oeuvre_index') }}" style="padding: 12px 24px; background-color: var(--border-color); color: var(--text-primary); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.3s;">Réinitialiser</a>
                    {% endif %}
                </form>
            </div>

            <div style="display: grid; grid-template-columns: 250px 1fr; gap: 2rem;">
                <!-- Sidebar avec filtres -->
                <aside style="padding: 1.5rem; background-color: var(--bg-secondary); border-radius: 4px; border: 1px solid var(--border-color); height: fit-content;">
                    <h4 style="margin: 0 0 1.5rem 0; color: var(--accent-primary); text-transform: uppercase; font-size: 0.85rem;">Filtrer par type</h4>
                    <form method="GET">
                        {% if types|length > 0 %}
                            {% for filterType in types %}
                                <label style="display: block; margin-bottom: 0.75rem; cursor: pointer; color: var(--text-primary);">
                                    <input type="radio" name="type" value="{{ filterType }}" {% if type == filterType %}checked{% endif %} style="margin-right: 0.5rem; cursor: pointer; accent-color: var(--accent-primary);">
                                    <span>{{ filterType }}</span>
                                </label>
                            {% endfor %}
                            <label style="display: block; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color); cursor: pointer; color: var(--text-primary);">
                                <input type="radio" name="type" value="" {% if not type %}checked{% endif %} style="margin-right: 0.5rem; cursor: pointer; accent-color: var(--accent-primary);">
                                <span style="font-weight: 600;">Tous les types</span>
                            </label>
                        {% else %}
                            <p style="color: #B0B9B6; font-size: 0.9rem;">Aucun type disponible</p>
                        {% endif %}
                        {% if search %}
                            <input type="hidden" name="search" value="{{ search }}">
                        {% endif %}
                        <button type="submit" style="width: 100%; margin-top: 1rem; padding: 8px 16px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; font-weight: 600; cursor: pointer; font-size: 0.85rem;">Appliquer</button>
                    </form>
                </aside>

                <!-- Contenu principal -->
                <div>

            {% if oeuvres %}
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
                    {% for oeuvre in oeuvres %}
                        <div style="background-color: #1A1F1E; border-radius: 8px; overflow: hidden; border: 1px solid #2A3139; transition: all 0.3s; display: flex; flex-direction: column;">
                            {% if oeuvre.imageUrl %}
                                <img src="{{ oeuvre.imageUrl }}" alt="{{ oeuvre.title }}" style="width: 100%; height: 160px; object-fit: cover;">
                            {% else %}
                                <div style="width: 100%; height: 160px; background: linear-gradient(135deg, var(--accent-primary), #0DCF92); display: flex; align-items: center; justify-content: center; font-size: 3rem;">📖</div>
                            {% endif %}
                            
                            <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                                <h3 style="font-size: 1.2rem; font-weight: 700; color: #E6FFF6; margin: 0 0 0.5rem 0; line-height: 1.3;">{{ oeuvre.title }}</h3>
                                
                                <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem;">
                                    <span style="display: inline-block; padding: 4px 10px; background-color: #0B0F0E; border: 1px solid var(--accent-primary); color: var(--accent-primary); border-radius: 12px; font-size: 0.75rem; font-weight: 600;">{{ oeuvre.type }}</span>
                                </div>
                                
                                <p style="font-size: 0.85rem; color: #B0B9B6; margin-bottom: 1rem; flex: 1; line-height: 1.5;">{{ oeuvre.description|slice(0, 100) }}{% if oeuvre.description|length > 100 %}...{% endif %}</p>
                                
                                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: #B0B9B6; padding-top: 1rem; border-top: 1px solid #2A3139;">
                                    <div>
                                        <strong>{{ oeuvre.author }}</strong>
                                    </div>
                                    <div style="display: flex; gap: 0.5rem;">
                                        <a href="{{ path('oeuvre_show', {id: oeuvre.id}) }}" style="padding: 6px 12px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 3px; cursor: pointer; text-decoration: none; font-weight: 600; font-size: 0.8rem;">Voir</a>
                                        {% if currentUser and oeuvre.createdBy == currentUser %}
                                            <a href="{{ path('oeuvre_edit', {id: oeuvre.id}) }}" style="padding: 6px 12px; background-color: #3a6f3a; color: white; border: none; border-radius: 3px; cursor: pointer; text-decoration: none; font-weight: 600; font-size: 0.8rem;">Éditer</a>
                                            <form method="POST" action="{{ path('oeuvre_delete', {id: oeuvre.id}) }}" style="display: inline;" onsubmit="return confirm('Êtes-vous sûr?');">
                                                <button type="submit" style="padding: 6px 12px; background-color: #d32f2f; color: white; border: none; border-radius: 3px; cursor: pointer; font-weight: 600; font-size: 0.8rem;">Supprimer</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div style="text-align: center; padding: 3rem; color: #B0B9B6;">
                            <p style="font-size: 1.1rem; margin-bottom: 1rem;">😔 Aucune œuvre trouvée</p>
                            <a href="{{ path('oeuvre_create') }}" style="padding: 12px 24px; background-color: var(--accent-primary); color: var(--bg-primary); border: none; border-radius: 4px; font-weight: 700; cursor: pointer; text-decoration: none; display: inline-block;">Créer la première</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}



