


<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toutes les Œuvres - Midgar</title>
    
    <!-- Swiper CSS (si nécessaire) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    
    <style>
        /* ===== VARIABLES & RESET ===== */
        :root {
            --primary-color: #18E3A4;
            --primary-dark: #13c891;
            --text-color: #E6FFF6;
            --text-secondary: #B0B9B6;
            --bg-primary: #1A1F1E;
            --bg-dark: #0D0F0F;
            --card-bg: rgba(26, 31, 30, 0.7);
            --glass-bg: rgba(26, 31, 30, 0.5);
            --border-radius: 12px;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Arial', sans-serif;
        }
        
        body {
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        a {
            text-decoration: none;
            color: inherit;
        }
        
        ul {
            list-style: none;
        }
        
        .container {
            width: 90%;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        /* ===== BOUTONS ANIMÉS ===== */
        .btn {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            transition: all 0.3s ease;
            text-align: center;
            border: none;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            color: #000;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-secondary {
            background-color: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }
        
        .btn-secondary:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }
        
        .btn-sm {
            padding: 0.4rem 0.8rem;
            font-size: 0.9rem;
        }
        
        /* ===== BOUTONS MAGIQUES (magic-btn) ===== */
        .magic-btn {
            position: relative;
            overflow: hidden;
            display: inline-block;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            padding: 0.5rem 1rem;
            background: transparent;
            color: var(--text-color);
            border: 1px solid transparent;
        }
        
        .magic-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
            border-color: var(--primary-color);
            color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        .magic-btn.active {
            color: var(--primary-color);
            border-color: var(--primary-color);
            background: rgba(24, 227, 164, 0.1);
        }
        
        /* ===== ANIMATION PARTICULES ===== */
        .particle {
            position: absolute;
            width: 6px;
            height: 6px;
            background: radial-gradient(circle, var(--primary-color), var(--primary-dark));
            border-radius: 50%;
            pointer-events: none;
            animation: fly 0.6s forwards;
            opacity: 0.8;
            z-index: 1;
        }
        
        @keyframes fly {
            0% { 
                transform: translate(0, 0) scale(1); 
                opacity: 1; 
            }
            100% { 
                transform: translate(var(--x), var(--y)) scale(0); 
                opacity: 0; 
            }
        }
        
        /* ===== VIDEO BACKGROUND ===== */
        .video-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -2;
            pointer-events: none;
        }
        
        .video-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            z-index: -1;
        }
        
        .gradient-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, var(--bg-primary) 0%, var(--bg-dark) 100%);
            z-index: -3;
            pointer-events: none;
            display: none;
        }
        
        /* ===== HEADER STANDARD ===== */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(26, 31, 30, 0.9);
            backdrop-filter: blur(10px);
        }
        
        .logo {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary-color);
            cursor: pointer;
        }
        
        .logo:hover {
            animation: glow 1.5s infinite;
        }
        
        .logo svg {
            width: 32px;
            height: 32px;
        }
        
        @keyframes glow {
            0%, 100% {
                text-shadow: 0 0 5px var(--primary-color);
            }
            50% {
                text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--primary-color);
            }
        }
        
        nav ul {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        
        .auth-buttons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.3rem 0.6rem;
            transition: all 0.3s ease;
            border-radius: 8px;
        }
        
        .profile-link:hover {
            background: rgba(24, 227, 164, 0.1);
        }
        
        .avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid var(--primary-color);
            transition: transform 0.3s;
        }
        
        .avatar:hover {
            transform: scale(1.1);
        }
        
        .avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        /* ===== SITE CONTENT ===== */
        .site-content {
            position: relative;
            z-index: 1;
            min-height: 100vh;
        }
        
        main {
            padding-top: 80px;
            min-height: 100vh;
        }
        
        .section {
            padding: 4rem 0;
            background-color: var(--glass-bg);
            border-radius: 16px;
            margin: 2rem auto;
            backdrop-filter: blur(10px);
            max-width: 1200px;
            border: 1px solid rgba(24, 227, 164, 0.1);
            transition: border-color 0.3s;
        }
        
        .section:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }
        
        /* ===== STYLES SPÉCIFIQUES ŒUVRES ===== */
        .universes-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 2rem;
            margin-top: 2rem;
        }

        .filter-sidebar {
            background-color: var(--card-bg);
            padding: 1.5rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(24, 227, 164, 0.1);
            height: fit-content;
            position: sticky;
            top: 100px;
            backdrop-filter: blur(5px);
        }

        .filter-sidebar:hover {
            border-color: rgba(24, 227, 164, 0.3);
        }

        .filter-group {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid rgba(24, 227, 164, 0.1);
        }

        .filter-group:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .filter-group h4 {
            color: var(--primary-color);
            font-size: 0.9rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 1rem;
            margin-top: 0;
        }

        .filter-option {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
            cursor: pointer;
            align-items: center;
        }

        .filter-option input[type="checkbox"],
        .filter-option input[type="radio"] {
            cursor: pointer;
            accent-color: var(--primary-color);
            width: 18px;
            height: 18px;
        }

        .filter-option label {
            cursor: pointer;
            color: var(--text-color);
            font-size: 0.9rem;
            margin: 0;
            flex: 1;
        }

        .search-box {
            width: 100%;
            padding: 10px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(24, 227, 164, 0.3);
            border-radius: 6px;
            color: var(--text-color);
            font-size: 0.9rem;
            margin-bottom: 1rem;
            transition: all 0.3s;
        }

        .search-box::placeholder { 
            color: var(--text-secondary); 
        }
        
        .search-box:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }

        .filter-reset {
            width: 100%;
            padding: 10px;
            background: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s;
            display: block;
            text-align: center;
            text-decoration: none;
            margin-top: 1rem;
        }

        .filter-reset:hover {
            background-color: var(--primary-color);
            color: #000;
            transform: scale(1.02);
            box-shadow: 0 0 15px var(--primary-color);
        }

        .universes-section { 
            flex: 1; 
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .section-title { 
            margin: 0; 
        }

        .create-cta {
            padding: 12px 24px;
            background-color: var(--primary-color);
            color: #000;
            border: none;
            border-radius: var(--border-radius);
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }

        .create-cta:hover { 
            background-color: var(--primary-dark);
            transform: scale(1.05);
            box-shadow: 0 0 15px var(--primary-color);
        }

        .universes-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .universe-card {
            background-color: var(--card-bg);
            border-radius: var(--border-radius);
            overflow: hidden;
            border: 1px solid transparent;
            transition: all 0.3s ease;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            backdrop-filter: blur(5px);
        }

        .universe-card:hover {
            border-color: rgba(24, 227, 164, 0.2);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6), 0 0 20px rgba(24, 227, 164, 0.3);
            transform: translateY(-10px) scale(1.02);
        }

        .card-banner {
            width: 100%;
            height: 160px;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3rem;
            overflow: hidden;
        }
        
        .card-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
            transition: transform 0.5s ease;
        }
        
        .universe-card:hover .card-banner img {
            transform: scale(1.1);
        }
        
        /* Favorite button on card */
        .favorite-btn-card {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(0, 0, 0, 0.6);
            border: 2px solid rgba(255, 255, 255, 0.3);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            transition: all 0.3s ease;
            z-index: 10;
        }
        
        .favorite-btn-card:hover {
            background: rgba(220, 53, 69, 0.8);
            border-color: #dc3545;
            transform: scale(1.1);
        }
        
        .favorite-btn-card.favorited {
            background: rgba(220, 53, 69, 0.8);
            border-color: #dc3545;
        }
        
        .favorite-btn-card.favorited .heart-icon {
            animation: heartPop 0.3s ease;
        }
        
        @keyframes heartPop {
            0% { transform: scale(1); }
            50% { transform: scale(1.3); }
            100% { transform: scale(1); }
        }

        .card-content {
            padding: 1.5rem;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .card-title {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--primary-color);
            margin: 0 0 0.5rem 0;
            line-height: 1.3;
        }

        .card-genre-tags {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 0.75rem;
            flex-wrap: wrap;
        }

        .genre-tag {
            display: inline-block;
            padding: 4px 10px;
            background-color: rgba(24, 227, 164, 0.1);
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            transition: transform 0.2s;
        }
        
        .genre-tag:hover {
            transform: scale(1.05);
        }

        .card-description {
            font-size: 0.85rem;
            color: var(--text-secondary);
            margin-bottom: 1rem;
            flex: 1;
            line-height: 1.5;
        }

        .card-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.85rem;
            color: var(--text-secondary);
            padding-top: 1rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }

        .card-stats {
            display: flex;
            gap: 1rem;
        }

        .stat {
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }

        .creator-info {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .creator-avatar {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            color: #000;
            font-weight: 700;
        }

        .results-count { 
            color: var(--text-secondary); 
            font-size: 0.9rem; 
        }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-secondary);
        }

        .empty-state p { 
            font-size: 1.1rem; 
            margin-bottom: 1rem; 
        }

        .flash-success {
            background-color: rgba(24, 227, 164, 0.2);
            color: var(--primary-color);
            padding: 1rem;
            border-radius: var(--border-radius);
            margin-bottom: 1rem;
            font-weight: 600;
            border: 1px solid var(--primary-color);
        }

        .flash-error {
            background-color: rgba(220, 53, 69, 0.2);
            color: #ff6b6b;
            padding: 1rem;
            border-radius: var(--border-radius);
            margin-bottom: 1rem;
            font-weight: 600;
            border: 1px solid #ff6b6b;
        }
        
        /* ===== MODALES STANDARD ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.95);
            z-index: 1000;
            justify-content: center;
            align-items: center;
            animation: fadeIn 0.3s;
            backdrop-filter: blur(10px);
        }
        
        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }
        
        .modal-content {
            background: var(--bg-primary);
            padding: 2rem;
            border-radius: var(--border-radius);
            max-width: 500px;
            width: 90%;
            position: relative;
            border: 1px solid var(--primary-color);
            animation: slideUp 0.4s;
            box-shadow: 0 0 50px rgba(24, 227, 164, 0.3);
        }
        
        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(50px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .modal-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--primary-color);
            background: none;
            border: none;
            padding: 0.5rem;
            transition: all 0.3s;
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .modal-close:hover {
            background: var(--primary-color);
            color: #000;
            transform: rotate(90deg);
        }
        
        .modal-title {
            margin-bottom: 1rem;
            color: var(--primary-color);
            text-shadow: 0 0 10px rgba(24, 227, 164, 0.3);
        }
        
        /* ===== FOOTER ===== */
        footer {
            background-color: rgba(13, 15, 15, 0.5);
            padding: 3rem 0;
            margin-top: 4rem;
            border-radius: 16px;
            backdrop-filter: blur(8px);
            text-align: center;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        footer:hover {
            border-top-color: rgba(24, 227, 164, 0.3);
        }
        
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            margin-bottom: 2rem;
            text-align: left;
        }
        
        .footer-section h4 {
            color: var(--primary-color);
            margin-bottom: 1rem;
        }
        
        .footer-links {
            list-style: none;
        }
        
        .footer-links li {
            margin-bottom: 0.5rem;
        }
        
        .footer-links a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.3s;
        }
        
        .footer-links a:hover {
            color: var(--primary-color);
        }
        
        .footer-bottom {
            text-align: center;
            color: var(--text-secondary);
            padding-top: 2rem;
            border-top: 1px solid rgba(24, 227, 164, 0.1);
        }
        
        /* ===== RESPONSIVE ===== */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                padding: 1rem;
                gap: 1rem;
            }
            
            nav ul {
                justify-content: center;
            }
            
            .auth-buttons {
                justify-content: center;
            }
            
            main {
                padding-top: 120px;
            }
            
            .section {
                margin: 1rem;
                padding: 2rem 0;
            }
            
            .universes-container { 
                grid-template-columns: 1fr; 
            }
            
            .filter-sidebar { 
                position: static; 
            }
            
            .universes-grid { 
                grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); 
            }
            
            .modal-content {
                margin: 20% auto;
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- ===== BACKGROUND STANDARD ===== -->
    <div class="gradient-background" id="gradient-bg"></div>
    <div class="video-overlay"></div>
    <video id="bg-video" class="video-background" autoplay muted loop playsinline>
        <source src="{{ asset('uploads/dragon.mp4') }}" type="video/mp4">
        Votre navigateur ne supporte pas la vidéo HTML5.
    </video>
    
    <!-- ===== SITE CONTENT ===== -->
    <div class="site-content">
        <!-- ===== HEADER STANDARD AVEC MAGIC-BTN ===== -->
        <header>
            <div class="logo">
                <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                    <path d="M20,80 Q20,30 50,20 Q80,30 80,80 Z" fill="none" stroke="#18E3A4" stroke-width="2"/>
                    <line x1="50" y1="20" x2="50" y2="50" stroke="#18E3A4" stroke-width="1.5"/>
                    <circle cx="35" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="65" cy="40" r="3" fill="#18E3A4"/>
                    <circle cx="50" cy="60" r="4" fill="#18E3A4"/>
                    <circle cx="50" cy="70" r="3" fill="#18E3A4"/>
                </svg>
                Midgar
            </div>
            
            <nav>
                <ul>
                    <li><a href="{{ path('home') }}" class="magic-btn">Accueil</a></li>
                    <li><a href="/discover" class="magic-btn">Découvrir</a></li>
                    <li><a href="/universes" class="magic-btn">Univers</a></li>
                    <li><a href="/personnages" class="magic-btn">Personnages</a></li>
                    <li><a href="{{ path('oeuvre_index') }}" class="magic-btn active">Œuvre</a></li>
                    <li><a href="/artefact" class="magic-btn">Artefacts</a></li>
                    <li><a href="/shop" class="magic-btn">Boutique</a></li>
                    <li><a href="/challenges" class="magic-btn">Défis</a></li>
                </ul>
            </nav>
            
            <div class="auth-buttons">
                {% if app.user %}
                    <a href="{{ path('profile') }}" class="profile-link magic-btn">
                        <div class="avatar">
                            {% if app.user.avatar %}
                                <img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" alt="{{ app.user.username }}">
                            {% else %}
                                <img src="{{ asset('images/default-avatar.png') }}" alt="{{ app.user.username }}">
                            {% endif %}
                        </div>
                        <span>{{ app.user.username }}</span>
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-secondary btn-sm magic-btn">Déconnexion</a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-secondary btn-sm magic-btn">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary btn-sm magic-btn">S'inscrire</a>
                {% endif %}
            </div>
        </header>

        <!-- ===== MAIN CONTENT ===== -->
        <main>
            <section class="section">
                <div class="container">
                    {% for flash_message in app.flashes('success') %}
                        <div class="flash-success">{{ flash_message }}</div>
                    {% endfor %}

                    {% for flash_message in app.flashes('error') %}
                        <div class="flash-error">{{ flash_message }}</div>
                    {% endfor %}

                    <div class="section-header">
                        <div>
                            <h1 style="margin-bottom: 0.5rem; color: var(--primary-color);">{{ myItems ? 'Mes Œuvres' : 'Toutes les Œuvres' }}</h1>
                            <p style="color: var(--text-secondary); margin: 0;">{{ oeuvres|length }} œuvre(s) trouvée(s)</p>
                        </div>
                        <div class="create-ctas">
                            {% if currentUser %}
                                {% if myItems %}
                                    <a href="{{ path('oeuvre_index') }}" class="create-cta magic-btn" style="background-color: #555; border: none;">← Toutes les Œuvres</a>
                                {% else %}
                                    <a href="{{ path('oeuvre_index', {'my_items': 1}) }}" class="create-cta magic-btn">Mes Œuvres</a>
                                {% endif %}
                            {% endif %}
                            <a href="{{ path('oeuvre_create') }}" class="create-cta magic-btn">+ Créer une Œuvre</a>
                        </div>
                    </div>

                    <div class="universes-container">
                        <div class="filter-sidebar">
                            <form method="get" action="{{ path('oeuvre_index') }}">
                                <div class="filter-group">
                                    <input type="text" name="search" class="search-box" placeholder="Chercher par titre..." value="{{ search }}">
                                </div>

                                <div class="filter-group">
                                    <h4>Type</h4>
                                    {% if types|length > 0 %}
                                        {% for filterType in types %}
                                            <div class="filter-option">
                                                <input type="radio" name="type" value="{{ filterType }}" id="type-{{ filterType }}" {% if type == filterType %}checked{% endif %}>
                                                <label for="type-{{ filterType }}">{{ filterType }}</label>
                                            </div>
                                        {% endfor %}
                                        <div class="filter-option">
                                            <input type="radio" name="type" value="" id="type-all" {% if not type %}checked{% endif %}>
                                            <label for="type-all">Tous les types</label>
                                        </div>
                                    {% else %}
                                        <p style="color: var(--text-secondary); font-size: 0.9rem;">Aucun type disponible</p>
                                    {% endif %}
                                </div>

                                <button type="submit" class="filter-reset magic-btn">Filtrer</button>
                                <a href="{{ path('oeuvre_index') }}" class="filter-reset magic-btn">Réinitialiser</a>
                            </form>
                        </div>

                        <div class="universes-section">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(24, 227, 164, 0.1);">
                                <div>
                                    <h2 style="margin: 0; color: var(--primary-color);">Œuvres</h2>
                                    <p style="color: var(--text-secondary); margin: 0; font-size: 0.9rem;">
                                        Affichage: <a href="{{ path('oeuvre_index') }}" style="color: var(--primary-color);">Œuvres</a> • 
                                        <a href="{{ path('artefact_index') }}" style="color: var(--text-secondary);">Artefacts</a>
                                    </p>
                                </div>
                                <div class="results-count">
                                    <span>{{ oeuvres|length }}</span> œuvre(s)
                                </div>
                            </div>

                            <div class="universes-grid" id="universesGrid">
                                {% for oeuvre in oeuvres %}
                                    <div class="universe-card" onclick="location.href='{{ path('oeuvre_show', {'id': oeuvre.id}) }}'">
                                        <div class="card-banner">
                                            {% if oeuvre.imageUrl %}
                                                <img src="{{ oeuvre.imageUrl }}" alt="{{ oeuvre.title }}">
                                            {% else %}
                                                📖
                                            {% endif %}
                                            {% if app.user %}
                                                <button class="favorite-btn-card" 
                                                        onclick="event.stopPropagation(); toggleFavoriteCard('oeuvre', {{ oeuvre.id }}, this)"
                                                        data-oeuvre-id="{{ oeuvre.id }}">
                                                    <span class="heart-icon">🤍</span>
                                                </button>
                                            {% endif %}
                                        </div>
                                        <div class="card-content">
                                            <h3 class="card-title">{{ oeuvre.title }}</h3>
                                            <div class="card-genre-tags">
                                                <span class="genre-tag">{{ oeuvre.type }}</span>
                                            </div>
                                            <p class="card-description">{{ oeuvre.description[:100] }}{% if oeuvre.description|length > 100 %}...{% endif %}</p>
                                            <div class="card-footer">
                                                <div class="card-stats">
                                                    <div class="stat">{{ oeuvre.author }}</div>
                                                </div>
                                                <div class="creator-info">
                                                    <div class="creator-avatar">{{ oeuvre.author|first|upper }}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                {% else %}
                                    <div class="empty-state">
                                        <p>😔 Aucune œuvre trouvée.</p>
                                        <a href="{{ path('oeuvre_create') }}" class="create-cta magic-btn">Créer la première œuvre</a>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                </div>
            </section>
        </main>

        <!-- ===== FOOTER ===== -->
        <footer>
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-section">
                        <h4>À propos</h4>
                        <ul class="footer-links">
                            <li><a href="#">À propos de Midgar</a></li>
                            <li><a href="#">Notre mission</a></li>
                            <li><a href="#">Équipe</a></li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4>Ressources</h4>
                        <ul class="footer-links">
                            <li><a href="#">Aide & Support</a></li>
                            <li><a href="#">Documentation</a></li>
                            <li><a href="#">Blog</a></li>
                        </ul>
                    </div>
                    <div class="footer-section">
                        <h4>Légal</h4>
                        <ul class="footer-links">
                            <li><a href="#">Conditions d'utilisation</a></li>
                            <li><a href="#">Politique de confidentialité</a></li>
                            <li><a href="#">Cookies</a></li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; 2026 Midgar Fantasy Platform. Créez, partagez, vivez la magie.</p>
                </div>
            </div>
        </footer>
    </div>
    
    <!-- ===== MODALES STANDARD ===== -->
    <!-- Exemple de modale standard (à utiliser si besoin) -->
    <div id="genericModal" class="modal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeModal('genericModal')">&times;</button>
            <h3 class="modal-title">Titre de la modale</h3>
            <div class="modal-body">
                <p>Contenu de la modale...</p>
            </div>
            <div class="modal-actions" style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
                <button class="btn btn-secondary magic-btn" onclick="closeModal('genericModal')">Annuler</button>
                <button class="btn btn-primary magic-btn">Confirmer</button>
            </div>
        </div>
    </div>

    <script>
        // ===== MAGIC BUTTON PARTICLE EFFECT =====
        document.querySelectorAll('.magic-btn').forEach(btn => {
            btn.addEventListener('click', function(e) {
                // Effet de particules
                for(let i = 0; i < 8; i++) {
                    const particle = document.createElement('span');
                    particle.classList.add('particle');
                    const x = (Math.random() - 0.5) * 80 + 'px';
                    const y = (Math.random() - 0.5) * 80 + 'px';
                    particle.style.setProperty('--x', x);
                    particle.style.setProperty('--y', y);
                    
                    const rect = btn.getBoundingClientRect();
                    particle.style.left = (e.clientX - rect.left) + 'px';
                    particle.style.top = (e.clientY - rect.top) + 'px';
                    
                    const hue = Math.floor(Math.random() * 60) + 140;
                    particle.style.background = `radial-gradient(circle, hsl(${hue}, 100%, 60%), hsl(${hue}, 100%, 30%))`;
                    
                    btn.appendChild(particle);
                    setTimeout(() => particle.remove(), 600);
                }
            });
        });

        // ===== BACKGROUND INITIALIZATION =====
        document.addEventListener('DOMContentLoaded', function() {
            const bgVideo = document.getElementById('bg-video');
            const gradientBg = document.getElementById('gradient-bg');
            
            // Handle video load error
            if (bgVideo) {
                bgVideo.addEventListener('error', function() {
                    console.log('Background video failed to load, using gradient fallback');
                    if (gradientBg) {
                        gradientBg.style.display = 'block';
                    }
                });
                
                // Try to play video
                bgVideo.play().catch(function(error) {
                    console.log('Video autoplay prevented:', error);
                    if (gradientBg) {
                        gradientBg.style.display = 'block';
                    }
                });
            }
            
            // Pause/play video on visibility change
            document.addEventListener('visibilitychange', function() {
                if (bgVideo) {
                    if (document.hidden) {
                        bgVideo.pause();
                    } else {
                        bgVideo.play().catch(e => console.log('Video play error:', e));
                    }
                }
            });
        });

        // ===== MODAL FUNCTIONS =====
        function openModal(id) {
            document.getElementById(id).style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            document.getElementById(id).style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        // Close modal when clicking outside
        window.addEventListener('click', function(event) {
            const modals = document.querySelectorAll('.modal');
            modals.forEach(modal => {
                if (event.target === modal) {
                    closeModal(modal.id);
                }
            });
        });

        // Close modal with Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const modals = document.querySelectorAll('.modal');
                modals.forEach(modal => {
                    if (modal.style.display === 'flex') {
                        closeModal(modal.id);
                    }
                });
            }
        });

        // ===== HIGHLIGHT ACTIVE NAV LINK =====
        const currentPath = window.location.pathname;
        document.querySelectorAll('nav .magic-btn').forEach(link => {
            if (link.getAttribute('href') === currentPath || 
                (link.getAttribute('href') === '{{ path('home') }}' && currentPath === '/') ||
                (link.getAttribute('href') === '{{ path('oeuvre_index') }}' && currentPath.includes('/oeuvre'))) {
                link.classList.add('active');
            }
        });

        // ===== HOVER EFFECTS FOR CARDS =====
        document.querySelectorAll('.universe-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-10px) scale(1.02)';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0) scale(1)';
            });
        });

        // ===== FAVORITE BUTTON FUNCTIONALITY =====
        // Toggle favorite on card click
        async function toggleFavoriteCard(type, id, button) {
            try {
                const response = await fetch(`/favoris/${type}/${id}/toggle`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                });
                
                const data = await response.json();
                const heartIcon = button.querySelector('.heart-icon');
                
                if (data.success) {
                    if (data.favorited) {
                        button.classList.add('favorited');
                        heartIcon.textContent = '❤️';
                    } else {
                        button.classList.remove('favorited');
                        heartIcon.textContent = '🤍';
                    }
                } else {
                    alert('Erreur: ' + (data.message || 'Impossible de modifier les favoris'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Une erreur est survenue');
            }
        }

        // Check favorites status on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Check all oeuvre favorites
            {% if app.user %}
            fetch('/favoris/check/oeuvres')
                .then(response => response.json())
                .then(data => {
                    if (data.favoritedIds) {
                        data.favoritedIds.forEach(id => {
                            const btn = document.querySelector(`.favorite-btn-card[data-oeuvre-id="${id}"]`);
                            if (btn) {
                                btn.classList.add('favorited');
                                btn.querySelector('.heart-icon').textContent = '❤️';
                            }
                        });
                    }
                })
                .catch(err => console.log('Error checking favorites:', err));
            {% endif %}
        });
    </script>
</body>
</html>
